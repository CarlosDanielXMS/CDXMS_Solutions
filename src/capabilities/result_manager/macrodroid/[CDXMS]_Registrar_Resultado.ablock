    "m_actionList": [
      {
        "actionGroupName": "01 — Initialize Runtime",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false,
        "actionLabel": "01 — Initialize Runtime",
        "disableLogging": false,
        "m_SIGUID": -7091262484763327594,
        "m_classType": "ActionGroupAction",
        "m_comment": "01 — Build/Normalize/Validate Result: capability pura sem efeitos colaterais.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false
      },
      {
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "\nconst ARTIFACT_ID = \"result_manager\";\nconst VERSION = \"1.0.0\";\nconst SOURCE_NAME = \"[CDXMS] Registrar Resultado\";\nconst SUPPORTED = [\"build_result\",\"normalize_result\",\"validate_result\",\"propagate_result\",\"wrap_error\",\"register_result\"];\nconst STATUS = [\"success\",\"error\",\"cancelled\",\"skipped\",\"not_found\",\"partial\",\"blocked\"];\nconst ARTIFACT_TYPES = [\"core\",\"capability\",\"solution\",\"package\",\"catalog\"];\nconst REQUIRED = [\"schema_version\",\"namespace\",\"success\",\"status\",\"artifact_type\",\"artifact_id\",\"operation\",\"message\",\"data\",\"error\"];\nconst FORBIDDEN = [\"data_json\",\"error_code\",\"error_message\",\"error_json\"];\nfunction txt(v){ return String(v == null ? \"\" : v).trim(); }\nfunction bool(v){ const s = String(v == null ? \"\" : v).toLowerCase().trim(); return s === \"true\" || s === \"1\" || s === \"yes\" || s === \"sim\"; }\nfunction parseJson(raw, fallback, name){\n  const s = txt(raw);\n  if (!s) return fallback;\n  try { return JSON.parse(s); } catch(e) { throw { code:\"INVALID_JSON\", message:\"JSON inválido em \" + name + \".\", details:{ input:name, reason:String(e.message || e) }, recoverable:false }; }\n}\nfunction asObject(value){\n  if (value && typeof value === \"object\" && !Array.isArray(value)) return value;\n  if (value === null || value === undefined || value === \"\") return {};\n  return { value:value };\n}\nfunction normalizeError(value, fallbackCode, fallbackMessage){\n  if (value === null || value === undefined || value === \"\") return null;\n  if (typeof value === \"object\" && !Array.isArray(value)) {\n    return {\n      code: txt(value.code || fallbackCode || \"UNKNOWN_ERROR\") || \"UNKNOWN_ERROR\",\n      message: txt(value.message || fallbackMessage || \"Erro desconhecido.\") || \"Erro desconhecido.\",\n      details: value.details && typeof value.details === \"object\" && !Array.isArray(value.details) ? value.details : {},\n      recoverable: value.recoverable === true\n    };\n  }\n  return { code: fallbackCode || \"UNKNOWN_ERROR\", message: fallbackMessage || \"Erro desconhecido.\", details:{ value:value }, recoverable:false };\n}\nfunction meta(extra){\n  const m = { timestamp:new Date().toISOString(), source:SOURCE_NAME, version:VERSION, session_id:txt(`{lv=Session Id}`), correlation_id:txt(`{lv=Correlation Id}`) };\n  if (extra && typeof extra === \"object\" && !Array.isArray(extra)) {\n    for (const k in extra) m[k] = extra[k];\n  }\n  return m;\n}\nfunction makeResult(success, status, artifactType, artifactId, operation, message, data, error, metaExtra){\n  const ok = success === true;\n  let st = txt(status) || (ok ? \"success\" : \"error\");\n  if (STATUS.indexOf(st) < 0) st = ok ? \"success\" : \"error\";\n  let at = txt(artifactType) || \"capability\";\n  if (ARTIFACT_TYPES.indexOf(at) < 0) at = \"capability\";\n  return {\n    schema_version:1,\n    namespace:\"CDXMS\",\n    success:ok,\n    status:st,\n    artifact_type:at,\n    artifact_id:txt(artifactId) || ARTIFACT_ID,\n    operation:txt(operation),\n    message:txt(message) || (ok ? \"Operação executada com sucesso.\" : \"A operação não pôde ser concluída.\"),\n    data:asObject(data),\n    error:error || null,\n    meta:meta(metaExtra)\n  };\n}\nfunction contractIssues(obj, strict){\n  const missing = [];\n  const forbidden = [];\n  const warnings = [];\n  if (!obj || typeof obj !== \"object\" || Array.isArray(obj)) return { valid:false, missing_fields:REQUIRED.slice(), forbidden_fields:[], warnings:[\"root_not_object\"] };\n  for (const f of REQUIRED) if (!(f in obj)) missing.push(f);\n  for (const f of FORBIDDEN) if (f in obj) forbidden.push(f);\n  if (\"data\" in obj && (!obj.data || typeof obj.data !== \"object\" || Array.isArray(obj.data))) warnings.push(\"data_not_object\");\n  if (\"error\" in obj && obj.error !== null && (typeof obj.error !== \"object\" || Array.isArray(obj.error))) warnings.push(\"error_not_object\");\n  const valid = missing.length === 0 && (!strict || forbidden.length === 0) && warnings.indexOf(\"data_not_object\") < 0 && warnings.indexOf(\"error_not_object\") < 0;\n  return { valid, missing_fields:missing, forbidden_fields:forbidden, warnings };\n}\nfunction normalizeRawResult(raw, strict){\n  const obj = parseJson(raw, {}, \"Result Json\");\n  const issues = contractIssues(obj, strict);\n  if (strict && issues.forbidden_fields.length > 0) {\n    throw { code:\"RESULT_FORBIDDEN_TOP_LEVEL_FIELD\", message:\"O resultado contém campos de topo proibidos.\", details:{ forbidden_fields:issues.forbidden_fields }, recoverable:false };\n  }\n  if (issues.warnings.indexOf(\"data_not_object\") >= 0) {\n    throw { code:\"RESULT_DATA_NOT_OBJECT\", message:\"O campo data do resultado precisa ser um dicionário.\", details:{}, recoverable:false };\n  }\n  if (issues.warnings.indexOf(\"error_not_object\") >= 0) {\n    throw { code:\"RESULT_ERROR_NOT_OBJECT\", message:\"O campo error do resultado precisa ser nulo ou um dicionário.\", details:{}, recoverable:false };\n  }\n  const success = obj.success === true;\n  const data = obj.data && typeof obj.data === \"object\" && !Array.isArray(obj.data) ? obj.data : {};\n  return makeResult(success, obj.status, obj.artifact_type, obj.artifact_id, obj.operation, obj.message, data, normalizeError(obj.error), obj.meta && typeof obj.meta === \"object\" ? obj.meta : {});\n}\nfunction topLevelError(operation, e){\n  const er = normalizeError(e, e && e.code ? e.code : \"PROCESSING_FAILED\", e && e.message ? e.message : \"Falha ao processar resultado.\");\n  return makeResult(false, \"error\", \"capability\", ARTIFACT_ID, operation, er.message, {}, er, null);\n}\nconst op = txt(`{lv=Operation}`);\nconst strict = bool(`{lv=Strict Mode?}`);\nconst includeRaw = bool(`{lv=Include Raw Result?}`);\ntry {\n  if (!op) throw { code:\"MISSING_REQUIRED_INPUT\", message:\"A entrada obrigatória Operation não foi informada.\", details:{ input:\"Operation\" }, recoverable:false };\n  if (SUPPORTED.indexOf(op) < 0) throw { code:\"UNSUPPORTED_OPERATION\", message:\"A operação informada não é suportada pelo Result Manager.\", details:{ operation:op, supported_operations:SUPPORTED }, recoverable:false };\n  const sourceType = txt(`{lv=Source Artifact Type}`) || \"capability\";\n  const sourceId = txt(`{lv=Source Artifact Id}`) || ARTIFACT_ID;\n  const sourceOp = txt(`{lv=Source Operation}`) || op;\n  const message = txt(`{lv=Message}`);\n  const context = parseJson(`{lv=Context Json}`, {}, \"Context Json\");\n  let output;\n  if (op === \"build_result\") {\n    const success = bool(`{lv=Success?}`);\n    const status = txt(`{lv=Status}`) || (success ? \"success\" : \"error\");\n    const data = parseJson(`{lv=Data Json}`, {}, \"Data Json\");\n    const errorRaw = parseJson(`{lv=Error Json}`, null, \"Error Json\");\n    const error = success ? null : (normalizeError(errorRaw, \"UNKNOWN_ERROR\", message || \"A operação não pôde ser concluída.\"));\n    output = makeResult(success, status, sourceType, sourceId, sourceOp, message, Object.assign({}, asObject(data), Object.keys(context).length ? { context } : {}), error, null);\n  } else if (op === \"wrap_error\") {\n    const data = parseJson(`{lv=Data Json}`, {}, \"Data Json\");\n    const errorRaw = parseJson(`{lv=Error Json}`, null, \"Error Json\");\n    const error = normalizeError(errorRaw, \"UNKNOWN_ERROR\", message || \"A operação não pôde ser concluída.\");\n    output = makeResult(false, txt(`{lv=Status}`) || \"error\", sourceType, sourceId, sourceOp, message || error.message, Object.assign({}, asObject(data), Object.keys(context).length ? { context } : {}), error, null);\n  } else if (op === \"validate_result\") {\n    const raw = parseJson(`{lv=Result Json}`, {}, \"Result Json\");\n    const issues = contractIssues(raw, strict);\n    if (!issues.valid) {\n      let code = \"RESULT_INVALID_CONTRACT\";\n      if (issues.forbidden_fields.length > 0) code = \"RESULT_FORBIDDEN_TOP_LEVEL_FIELD\";\n      if (issues.warnings.indexOf(\"data_not_object\") >= 0) code = \"RESULT_DATA_NOT_OBJECT\";\n      if (issues.warnings.indexOf(\"error_not_object\") >= 0) code = \"RESULT_ERROR_NOT_OBJECT\";\n      output = makeResult(false, \"error\", \"capability\", ARTIFACT_ID, \"validate_result\", \"O resultado informado não atende ao contrato CDXMS.\", Object.assign({ valid:false }, issues), normalizeError({code, message:\"O resultado informado não atende ao contrato CDXMS.\", details:issues, recoverable:false}), null);\n    } else {\n      output = makeResult(true, \"success\", \"capability\", ARTIFACT_ID, \"validate_result\", \"Resultado validado com sucesso.\", Object.assign({ valid:true }, issues), null, null);\n    }\n  } else if (op === \"normalize_result\") {\n    const normalized = normalizeRawResult(`{lv=Result Json}`, strict);\n    output = makeResult(true, \"success\", \"capability\", ARTIFACT_ID, \"normalize_result\", \"Resultado normalizado com sucesso.\", { normalized:true, value:normalized, context:Object.keys(context).length ? context : undefined }, null, null);\n    if (output.data.context === undefined) delete output.data.context;\n  } else if (op === \"propagate_result\") {\n    const child = normalizeRawResult(`{lv=Result Json}`, strict);\n    const childSummary = { success:child.success, status:child.status, artifact_type:child.artifact_type, artifact_id:child.artifact_id, operation:child.operation, message:child.message, error_code:child.error ? child.error.code : null };\n    const data = { propagated:true, child_result_summary:childSummary, child_data:child.data };\n    if (Object.keys(context).length) data.context = context;\n    if (includeRaw) data.raw_result = child;\n    output = makeResult(child.success === true, child.status, sourceType, sourceId, sourceOp, message || child.message, data, child.error, { child_source: child.artifact_id });\n  } else if (op === \"register_result\") {\n    const normalized = normalizeRawResult(`{lv=Result Json}`, strict);\n    const data = { registered:true, value:normalized };\n    if (Object.keys(context).length) data.context = context;\n    if (includeRaw) data.raw_result = parseJson(`{lv=Result Json}`, {}, \"Result Json\");\n    output = makeResult(normalized.success === true, normalized.status, normalized.artifact_type, normalized.artifact_id, normalized.operation, message || normalized.message, data, normalized.error, normalized.meta || null);\n  }\n  JSON.stringify(output);\n} catch(e) {\n  JSON.stringify(topLevelError(op || \"unknown\", e));\n}\n",
        "stringVariableName": "Tmp_ResultJson",
        "disableLogging": false,
        "m_SIGUID": -5662873323362663032,
        "m_classType": "JavaScriptAction",
        "m_comment": "Executa dispatch por Operation e gera Tmp_ResultJson conforme contrato universal CDXMS.",
