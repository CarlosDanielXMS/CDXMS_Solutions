        "scriptText": "const ID=\"result_manager\", VERSION=\"1.0.0\";\nfunction t(v){return String(v==null?\"\":v).trim();}\nfunction b(v,d){let s=t(v).toLowerCase();if([\"true\",\"1\",\"sim\",\"s\",\"verdadeiro\"].indexOf(s)>=0)return true;if([\"false\",\"0\",\"não\",\"nao\",\"n\",\"falso\"].indexOf(s)>=0)return false;return d===true;}\nfunction p(v,d,n){let s=t(v);if(!s)return d;try{return JSON.parse(s)}catch(e){throw {code:\"INVALID_JSON\",message:\"JSON inválido em \"+n+\".\",details:{reason:String(e.message||e)}}}}\nfunction obj(v){return v&&typeof v===\"object\"&&!Array.isArray(v)?v:(v==null||v===\"\"?{}:{value:v});}\nfunction err(v,c,m){if(v==null||v===\"\")return null;if(v&&typeof v===\"object\"&&!Array.isArray(v))return {code:t(v.code)||c||\"UNKNOWN_ERROR\",message:t(v.message)||m||\"Erro desconhecido.\",details:obj(v.details),recoverable:v.recoverable===true};return {code:c||\"UNKNOWN_ERROR\",message:m||\"Erro desconhecido.\",details:{value:v},recoverable:false};}\nfunction out(ok,status,atype,aid,op,msg,data,error,extra){return {schema_version:1,namespace:\"CDXMS\",success:ok===true,status:t(status)||(ok?\"success\":\"error\"),artifact_type:t(atype)||\"capability\",artifact_id:t(aid)||ID,operation:t(op),message:t(msg)||(ok?\"Operação executada com sucesso.\":\"A operação não pôde ser concluída.\"),data:obj(data),error:error||null,meta:Object.assign({timestamp:new Date().toISOString(),source:\"[CDXMS] Registrar Resultado\",version:VERSION,session_id:t(`{lv=Session Id}`),correlation_id:t(`{lv=Correlation Id}`)},extra||{})};}\nconst required=[\"schema_version\",\"namespace\",\"success\",\"status\",\"artifact_type\",\"artifact_id\",\"operation\",\"message\",\"data\",\"error\"], forbidden=[\"data_json\",\"error_code\",\"error_message\",\"error_json\"];\nfunction issues(x,strict){let miss=[],bad=[],warn=[];if(!x||typeof x!==\"object\"||Array.isArray(x))return {valid:false,missing_fields:required.slice(),forbidden_fields:[],warnings:[\"root_not_object\"]};required.forEach(k=>{if(!(k in x))miss.push(k)});forbidden.forEach(k=>{if(k in x)bad.push(k)});if(\"data\" in x&&(!x.data||typeof x.data!==\"object\"||Array.isArray(x.data)))warn.push(\"data_not_object\");if(\"error\" in x&&x.error!==null&&(typeof x.error!==\"object\"||Array.isArray(x.error)))warn.push(\"error_not_object\");return {valid:miss.length===0&&(!strict||bad.length===0)&&warn.length===0,missing_fields:miss,forbidden_fields:bad,warnings:warn};}\nlet op=t(`{lv=Operation}`), strict=b(`{lv=Strict Mode?}`,true), res;\ntry{if([\"build_result\",\"normalize_result\",\"validate_result\",\"propagate_result\",\"wrap_error\",\"register_result\"].indexOf(op)<0)throw {code:\"UNSUPPORTED_OPERATION\",message:\"Operação não suportada.\"};let st=t(`{lv=Source Artifact Type}`)||\"capability\",si=t(`{lv=Source Artifact Id}`)||ID,so=t(`{lv=Source Operation}`)||op,msg=t(`{lv=Message}`),ctx=p(`{lv=Context Json}`,{},\"Context Json\");if(op===\"build_result\"){let ok=b(`{lv=Success?}`),data=p(`{lv=Data Json}`,{},\"Data Json\"),er=p(`{lv=Error Json}`,null,\"Error Json\");res=out(ok,t(`{lv=Status}`)||(ok?\"success\":\"error\"),st,si,so,msg,Object.assign({},obj(data),Object.keys(ctx).length?{context:ctx}:{}),ok?null:err(er,\"UNKNOWN_ERROR\",msg));}else if(op===\"wrap_error\"){let er=err(p(`{lv=Error Json}`,null,\"Error Json\"),\"UNKNOWN_ERROR\",msg);res=out(false,t(`{lv=Status}`)||\"error\",st,si,so,msg||er.message,p(`{lv=Data Json}`,{},\"Data Json\"),er);}else{let raw=p(`{lv=Result Json}`,{},\"Result Json\"),is=issues(raw,strict);if(op===\"validate_result\")res=out(is.valid,is.valid?\"success\":\"error\",\"capability\",ID,op,is.valid?\"Resultado validado com sucesso.\":\"O resultado não atende ao contrato CDXMS.\",Object.assign({valid:is.valid},is),is.valid?null:err({code:\"RESULT_INVALID_CONTRACT\",message:\"Contrato inválido.\",details:is}));else{if(!is.valid&&strict)throw {code:\"RESULT_INVALID_CONTRACT\",message:\"O resultado não atende ao contrato CDXMS.\",details:is};let norm=out(raw.success===true,raw.status,raw.artifact_type,raw.artifact_id,raw.operation,raw.message,raw.data,err(raw.error),raw.meta);if(op===\"normalize_result\")res=out(true,\"success\",\"capability\",ID,op,\"Resultado normalizado com sucesso.\",{normalized:true,value:norm},null);else if(op===\"propagate_result\")res=norm;else res=out(true,\"success\",\"capability\",ID,op,\"Resultado registrado logicamente.\",{registered:true,value:norm},null);}}\n}catch(e){let er=err(e,e.code||\"PROCESSING_FAILED\",e.message||\"Falha ao processar resultado.\");res=out(false,\"error\",\"capability\",ID,op,er.message,{},er);}return JSON.stringify(res);",
