{
  "schema_version": 1,
  "namespace": "CDXMS",
  "artifact_type": "capability_contract",
  "artifact_id": "result_manager",
  "version": "1.0.0",
  "action_block": "[CDXMS] Registrar Resultado",
  "description": "Contrato da capability [CDXMS] Registrar Resultado v1.0.0.",
  "inputs": [
    {
      "name": "Operation",
      "type": "string",
      "required": true,
      "description": "Operação técnica do Result Manager.",
      "options": [
        "build_result",
        "normalize_result",
        "validate_result",
        "propagate_result",
        "wrap_error",
        "register_result"
      ],
      "default": "build_result"
    },
    {
      "name": "Source Artifact Type",
      "type": "string",
      "required": false,
      "description": "Tipo do artifact de origem.",
      "default": "capability"
    },
    {
      "name": "Source Artifact Id",
      "type": "string",
      "required": false,
      "description": "Id do artifact de origem.",
      "default": "result_manager"
    },
    {
      "name": "Source Operation",
      "type": "string",
      "required": false,
      "description": "Operação original.",
      "default": "build_result"
    },
    {
      "name": "Success?",
      "type": "boolean",
      "required": false,
      "description": "Sucesso lógico.",
      "default": true
    },
    {
      "name": "Status",
      "type": "string",
      "required": false,
      "description": "Status padronizado.",
      "default": "success"
    },
    {
      "name": "Message",
      "type": "string",
      "required": false,
      "description": "Mensagem humana.",
      "default": "Operação executada com sucesso."
    },
    {
      "name": "Data Json",
      "type": "string",
      "required": false,
      "description": "Objeto JSON para Resultado.data.",
      "default": "{}"
    },
    {
      "name": "Error Json",
      "type": "string",
      "required": false,
      "description": "Erro estruturado ou null.",
      "default": "null"
    },
    {
      "name": "Result Json",
      "type": "string",
      "required": false,
      "description": "Resultado bruto.",
      "default": ""
    },
    {
      "name": "Context Json",
      "type": "string",
      "required": false,
      "description": "Contexto adicional.",
      "default": "{}"
    },
    {
      "name": "Strict Mode?",
      "type": "boolean",
      "required": false,
      "description": "Validação rigorosa.",
      "default": true
    },
    {
      "name": "Include Raw Result?",
      "type": "boolean",
      "required": false,
      "description": "Inclui bruto para debug.",
      "default": false
    },
    {
      "name": "Session Id",
      "type": "string",
      "required": false,
      "description": "Id de sessão.",
      "default": ""
    },
    {
      "name": "Correlation Id",
      "type": "string",
      "required": false,
      "description": "Id de correlação.",
      "default": ""
    }
  ],
  "outputs": [
    {
      "name": "Resultado",
      "type": "dictionary",
      "description": "Saída pública única no contrato CDXMS."
    }
  ],
  "operations": {
    "build_result": {
      "description": "Constrói Resultado a partir das entradas simples.",
      "required_inputs": [
        "Operation",
        "Source Artifact Type",
        "Source Artifact Id",
        "Source Operation",
        "Success?",
        "Message"
      ],
      "data_fields": [
        "value",
        "context"
      ]
    },
    "normalize_result": {
      "description": "Normaliza Result Json para o contrato universal.",
      "required_inputs": [
        "Operation",
        "Result Json"
      ],
      "data_fields": [
        "normalized",
        "legacy_fields_detected"
      ]
    },
    "validate_result": {
      "description": "Valida Result Json contra o contrato.",
      "required_inputs": [
        "Operation",
        "Result Json"
      ],
      "data_fields": [
        "valid",
        "missing_fields",
        "forbidden_fields",
        "warnings"
      ]
    },
    "propagate_result": {
      "description": "Propaga Resultado preservando status/erro e anexando contexto.",
      "required_inputs": [
        "Operation",
        "Result Json",
        "Source Artifact Type",
        "Source Artifact Id",
        "Source Operation"
      ],
      "data_fields": [
        "propagated",
        "child_result_summary",
        "context"
      ]
    },
    "wrap_error": {
      "description": "Cria Resultado de erro padronizado.",
      "required_inputs": [
        "Operation",
        "Source Artifact Type",
        "Source Artifact Id",
        "Source Operation",
        "Message"
      ],
      "data_fields": [
        "context"
      ]
    },
    "register_result": {
      "description": "Registra logicamente um Resultado sem persistir.",
      "required_inputs": [
        "Operation",
        "Result Json"
      ],
      "data_fields": [
        "registered",
        "context",
        "raw_result"
      ]
    }
  },
  "errors": [
    "MISSING_REQUIRED_INPUT",
    "INVALID_JSON",
    "INVALID_ENUM_VALUE",
    "UNSUPPORTED_OPERATION",
    "PROCESSING_FAILED"
  ],
  "result": {
    "output_variable": "Resultado",
    "top_level_fields": [
      "schema_version",
      "namespace",
      "success",
      "status",
      "artifact_type",
      "artifact_id",
      "operation",
      "message",
      "data",
      "error",
      "meta"
    ],
    "forbidden_top_level_fields": [
      "data_json",
      "error_code",
      "error_message",
      "error_json"
    ]
  },
  "side_effects": []
}
