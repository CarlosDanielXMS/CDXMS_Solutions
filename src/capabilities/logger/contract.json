{
  "schema_version": 1,
  "namespace": "CDXMS",
  "artifact_type": "capability_contract",
  "artifact_id": "logger",
  "version": "1.0.0",
  "action_block": "[CDXMS] Logger",
  "description": "Contrato da capability [CDXMS] Logger v1.0.0.",
  "inputs": [
    {
      "name": "Operation",
      "type": "string",
      "required": true,
      "description": "Operação técnica do Logger.",
      "options": [
        "log_event",
        "log_result",
        "log_error",
        "get_log_status"
      ],
      "default": "log_event"
    },
    {
      "name": "Level",
      "type": "string",
      "required": false,
      "description": "debug, info, warning, error ou critical.",
      "default": "info"
    },
    {
      "name": "Event Type",
      "type": "string",
      "required": false,
      "description": "Tipo lógico do evento.",
      "default": "event"
    },
    {
      "name": "Message",
      "type": "string",
      "required": false,
      "description": "Mensagem humana.",
      "default": "Evento CDXMS registrado."
    },
    {
      "name": "Source Artifact Type",
      "type": "string",
      "required": false,
      "description": "Tipo do artifact de origem.",
      "default": "capability"
    },
    {
      "name": "Source Artifact Id",
      "type": "string",
      "required": false,
      "description": "Id do artifact de origem.",
      "default": ""
    },
    {
      "name": "Source Operation",
      "type": "string",
      "required": false,
      "description": "Operação de origem.",
      "default": ""
    },
    {
      "name": "Result Json",
      "type": "string",
      "required": false,
      "description": "Resultado completo para log_result.",
      "default": ""
    },
    {
      "name": "Data Json",
      "type": "string",
      "required": false,
      "description": "Dados complementares.",
      "default": "{}"
    },
    {
      "name": "Error Json",
      "type": "string",
      "required": false,
      "description": "Erro estruturado.",
      "default": "null"
    },
    {
      "name": "Tags Json",
      "type": "string",
      "required": false,
      "description": "Tags JSON.",
      "default": "[]"
    },
    {
      "name": "Log Scope",
      "type": "string",
      "required": false,
      "description": "auto, events, results, errors, audit ou runtime.",
      "default": "auto"
    },
    {
      "name": "Log File Name",
      "type": "string",
      "required": false,
      "description": "Nome opcional do .jsonl.",
      "default": ""
    },
    {
      "name": "Config Json",
      "type": "string",
      "required": false,
      "description": "Config opcional.",
      "default": "{}"
    },
    {
      "name": "Strict Mode?",
      "type": "boolean",
      "required": false,
      "description": "Bloqueia JSON inválido.",
      "default": false
    },
    {
      "name": "Session Id",
      "type": "string",
      "required": false,
      "description": "Id de sessão.",
      "default": ""
    },
    {
      "name": "Correlation Id",
      "type": "string",
      "required": false,
      "description": "Id de correlação.",
      "default": ""
    }
  ],
  "outputs": [
    {
      "name": "Resultado",
      "type": "dictionary",
      "description": "Saída pública única no contrato CDXMS."
    }
  ],
  "operations": {
    "log_event": {
      "description": "Registra evento operacional em JSON Lines.",
      "writes_log": true
    },
    "log_result": {
      "description": "Registra Resultado de outra capability/macro.",
      "writes_log": true
    },
    "log_error": {
      "description": "Registra erro estruturado.",
      "writes_log": true
    },
    "get_log_status": {
      "description": "Retorna status/configuração sem gravar.",
      "writes_log": false
    }
  },
  "errors": [
    "LOGGER_INVALID_LEVEL",
    "LOGGER_INVALID_SCOPE",
    "LOGGER_WRITE_FAILED",
    "LOGGER_DISABLED",
    "LOGGER_INVALID_LOG_PAYLOAD",
    "INVALID_JSON",
    "PROCESSING_FAILED",
    "UNSUPPORTED_OPERATION"
  ],
  "result": {
    "output_variable": "Resultado",
    "top_level_fields": [
      "schema_version",
      "namespace",
      "success",
      "status",
      "artifact_type",
      "artifact_id",
      "operation",
      "message",
      "data",
      "error",
      "meta"
    ],
    "forbidden_top_level_fields": [
      "data_json",
      "error_code",
      "error_message",
      "error_json"
    ]
  },
  "storage": {
    "base_folder": "logs/<scope>/",
    "default_file_name": "cdxms-<scope>-YYYY-MM-DD.jsonl",
    "format": "json_lines",
    "device_target_root": "/storage/emulated/0/Documents/CDXMS_Solutions/"
  }
}
