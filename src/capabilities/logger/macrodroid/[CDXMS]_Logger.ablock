      {
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ID=\"logger\",VERSION=\"1.0.0\";function t(v){return String(v==null?\"\":v).trim()}function p(v,d,n,strict){let s=t(v);if(!s)return d;try{return JSON.parse(s)}catch(e){if(strict)throw {code:\"INVALID_JSON\",message:\"JSON inválido em \"+n+\".\"};return d}}function b(v){return [\"true\",\"1\",\"sim\",\"s\",\"verdadeiro\"].includes(t(v).toLowerCase())}function out(ok,status,op,msg,data,error){return {schema_version:1,namespace:\"CDXMS\",success:ok,status:status,artifact_type:\"capability\",artifact_id:ID,operation:op,message:msg,data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:\"[CDXMS] Logger\",version:VERSION,session_id:t(`{lv=Session Id}`),correlation_id:t(`{lv=Correlation Id}`)}}}let op=t(`{lv=Operation}`),strict=b(`{lv=Strict Mode?}`),res,scope=t(`{lv=Log Scope}`)||\"auto\";try{if(![\"log_event\",\"log_result\",\"log_error\",\"get_log_status\"].includes(op))throw {code:\"UNSUPPORTED_OPERATION\",message:\"Operação não suportada.\"};if(scope===\"auto\")scope=op===\"log_result\"?\"results\":op===\"log_error\"?\"errors\":\"events\";if(![\"events\",\"results\",\"errors\",\"audit\",\"runtime\"].includes(scope))throw {code:\"LOGGER_INVALID_SCOPE\",message:\"Escopo de log inválido.\"};let level=t(`{lv=Level}`)||\"info\";if(![\"debug\",\"info\",\"warning\",\"error\",\"critical\"].includes(level))throw {code:\"LOGGER_INVALID_LEVEL\",message:\"Nível de log inválido.\"};let file=t(`{lv=Log File Name}`)||(\"cdxms-\"+scope+\".jsonl\"),folder=\"/storage/emulated/0/Documents/CDXMS_Solutions/logs/\"+scope+\"/\";let entry={timestamp:new Date().toISOString(),level:level,event_type:t(`{lv=Event Type}`)||op,message:t(`{lv=Message}`),source:{artifact_type:t(`{lv=Source Artifact Type}`)||\"capability\",artifact_id:t(`{lv=Source Artifact Id}`),operation:t(`{lv=Source Operation}`)},data:p(`{lv=Data Json}`,{},\"Data Json\",strict),error:p(`{lv=Error Json}`,null,\"Error Json\",strict),result:p(`{lv=Result Json}`,null,\"Result Json\",strict),tags:p(`{lv=Tags Json}`,[],\"Tags Json\",strict),session_id:t(`{lv=Session Id}`),correlation_id:t(`{lv=Correlation Id}`)};let write=op!==\"get_log_status\";res=out(true,\"success\",op,write?\"Registro de log preparado com sucesso.\":\"Status do Logger obtido com sucesso.\",{enabled:true,should_write:write,folder_path:folder,file_name:file,line:JSON.stringify(entry),scope:scope,level:level},null)}catch(e){res=out(false,\"error\",op,e.message||\"Falha no Logger.\",{}, {code:e.code||\"LOGGER_WRITE_FAILED\",message:e.message||\"Falha no Logger.\",details:{},recoverable:true})}return JSON.stringify(res);",
