          {
            "allFilesPath": "/storage/emulated/0/Documents/CDXMS_Solutions/capabilities/json_config_manager/",
            "m_append": false,
            "m_filename": "manifest.json",
            "m_logText": "{\n  \"schema_version\": 1,\n  \"namespace\": \"CDXMS\",\n  \"artifact_type\": \"capability\",\n  \"capability\": {\n    \"id\": \"json_config_manager\",\n    \"name\": \"CDXMS Json Config Manager\",\n    \"version\": \"1.0.0-test.1\",\n    \"author\": \"Carlos Daniel X.M.S.\",\n    \"description\": \"Kernel primitivo de JSON/filesystem do CDXMS Solutions. Garante core mínimo e executa operações de leitura, escrita, validação, merge, existência, backup e criação básica de arquivos/pastas JSON.\",\n    \"enabled\": true,\n    \"has_config\": true\n  },\n  \"exports\": {\n    \"action_blocks\": [\n      {\n        \"name\": \"[CDXMS] Json Config Manager\",\n        \"operation\": \"manage_json_config\"\n      }\n    ]\n  },\n  \"files\": {\n    \"contract\": \"contract.json\",\n    \"config\": \"config.json\",\n    \"macrodroid_export\": \"macrodroid/[CDXMS]_Json_Config_Manager.ablock\",\n    \"readme\": \"README.md\"\n  },\n  \"macrodroid_export\": {\n    \"file_path\": \"capabilities/json_config_manager/macrodroid/[CDXMS]_Json_Config_Manager.ablock\",\n    \"kind\": \"action_block\",\n    \"expected_name\": \"[CDXMS] Json Config Manager\",\n    \"expected_is_action_block\": true,\n    \"manual_import_required\": true\n  },\n  \"requires\": {\n    \"core_min_version\": \"1.0.0\",\n    \"capabilities\": {}\n  },\n  \"created_at\": \"2026-06-16\",\n  \"updated_at\": \"2026-06-16\"\n}",
            "m_prepend": false,
            "overwrite": true,
            "useAllFilesAccess": true,
            "disableLogging": false,
            "m_SIGUID": -8458052748558100483,
            "m_classType": "WriteToFileAction",
            "m_comment": "ensure_core: grava manifest.json.",
            "m_constraintList": [],
            "m_isDisabled": false,
            "m_isOrCondition": false
          },
          {
            "allFilesPath": "/storage/emulated/0/Documents/CDXMS_Solutions/capabilities/json_config_manager/",
            "m_append": false,
            "m_filename": "contract.json",
            "m_logText": "{\n  \"schema_version\": 1,\n  \"namespace\": \"CDXMS\",\n  \"artifact_type\": \"capability_contract\",\n  \"capability_id\": \"json_config_manager\",\n  \"output_variable\": \"Resultado\",\n  \"operations\": {\n    \"ensure_core\": {\n      \"description\": \"Garante a estrutura base do CDXMS e grava seed mínimo do core.\",\n      \"required_inputs\": [],\n      \"optional_inputs\": [\n        \"pretty_print\"\n      ]\n    },\n    \"repair_core\": {\n      \"description\": \"Alias operacional para ensure_core nesta versão de teste.\",\n      \"required_inputs\": [],\n      \"optional_inputs\": [\n        \"pretty_print\"\n      ]\n    },\n    \"ensure_folder\": {\n      \"description\": \"Garante a existência lógica de uma pasta por ShellScriptAction mkdir -p.\",\n      \"required_inputs\": [\n        \"folder_path\"\n      ],\n      \"optional_inputs\": []\n    },\n    \"ensure_file\": {\n      \"description\": \"Cria arquivo JSON com default_json quando o conteúdo lido estiver vazio e create_if_missing=true.\",\n      \"required_inputs\": [\n        \"file_path\"\n      ],\n      \"optional_inputs\": [\n        \"default_json\",\n        \"create_if_missing\",\n        \"pretty_print\"\n      ]\n    },\n    \"read_json\": {\n      \"description\": \"Lê um arquivo JSON e retorna conteúdo estruturado em data.content.\",\n      \"required_inputs\": [\n        \"file_path\"\n      ],\n      \"optional_inputs\": []\n    },\n    \"write_json\": {\n      \"description\": \"Valida e escreve value_json no arquivo informado.\",\n      \"required_inputs\": [\n        \"file_path\",\n        \"value_json\"\n      ],\n      \"optional_inputs\": [\n        \"pretty_print\"\n      ]\n    },\n    \"merge_json\": {\n      \"description\": \"Lê JSON atual, mescla com value_json e regrava preservando usuário conforme merge_strategy.\",\n      \"required_inputs\": [\n        \"file_path\",\n        \"value_json\"\n      ],\n      \"optional_inputs\": [\n        \"merge_strategy\",\n        \"pretty_print\",\n        \"create_if_missing\",\n        \"default_json\"\n      ]\n    },\n    \"validate_json\": {\n      \"description\": \"Valida se value_json é JSON válido.\",\n      \"required_inputs\": [\n        \"value_json\"\n      ],\n      \"optional_inputs\": []\n    },\n    \"exists\": {\n      \"description\": \"Verifica existência aproximada por leitura de arquivo; arquivo vazio pode ser interpretado como ausente.\",\n      \"required_inputs\": [\n        \"file_path\"\n      ],\n      \"optional_inputs\": []\n    },\n    \"backup_file\": {\n      \"description\": \"Cria cópia .bak do arquivo informado no mesmo diretório.\",\n      \"required_inputs\": [\n        \"file_path\"\n      ],\n      \"optional_inputs\": []\n    },\n    \"delete_file\": {\n      \"description\": \"Remove arquivo por ShellScriptAction rm -f.\",\n      \"required_inputs\": [\n        \"file_path\"\n      ],\n      \"optional_inputs\": []\n    }\n  },\n  \"inputs\": {\n    \"operation\": {\n      \"type\": \"enum\",\n      \"required\": true,\n      \"enum_ref\": \"jcm_operation\",\n      \"description\": \"Operação primitiva do JCM.\"\n    },\n    \"file_path\": {\n      \"type\": \"string\",\n      \"required\": \"conditional\",\n      \"description\": \"Caminho absoluto do arquivo JSON manipulado.\"\n    },\n    \"folder_path\": {\n      \"type\": \"string\",\n      \"required\": \"conditional\",\n      \"description\": \"Caminho absoluto da pasta manipulada.\"\n    },\n    \"json_path\": {\n      \"type\": \"string\",\n      \"required\": false,\n      \"description\": \"Reservado para operações futuras por caminho lógico interno no JSON.\"\n    },\n    \"value_json\": {\n      \"type\": \"string|json\",\n      \"required\": \"conditional\",\n      \"description\": \"JSON usado em escrita, validação e merge.\"\n    },\n    \"default_json\": {\n      \"type\": \"string|json\",\n      \"required\": false,\n      \"description\": \"JSON padrão usado em criação/reparo.\"\n    },\n    \"create_if_missing\": {\n      \"type\": \"boolean\",\n      \"required\": false,\n      \"default\": false,\n      \"description\": \"Permite criar arquivo ausente com default_json quando aplicável.\"\n    },\n    \"pretty_print\": {\n      \"type\": \"boolean\",\n      \"required\": false,\n      \"default\": true,\n      \"description\": \"Formata JSON na escrita.\"\n    },\n    \"merge_strategy\": {\n      \"type\": \"enum\",\n      \"required\": false,\n      \"default\": \"deep_merge\",\n      \"enum_ref\": \"merge_strategy\",\n      \"description\": \"Estratégia de merge.\"\n    }\n  },\n  \"outputs\": {\n    \"Resultado\": {\n      \"type\": \"dictionary\",\n      \"contract_ref\": \"core/result_contract.json\"\n    }\n  },\n  \"possible_errors\": [\n    \"MISSING_REQUIRED_INPUT\",\n    \"INVALID_ENUM_VALUE\",\n    \"INVALID_JSON\",\n    \"FILE_NOT_FOUND\",\n    \"FILE_READ_ERROR\",\n    \"FILE_WRITE_ERROR\",\n    \"UNSUPPORTED_OPERATION\",\n    \"SECURITY_STOP\"\n  ],\n  \"version\": \"1.0.0\"\n}",
            "m_prepend": false,
            "overwrite": true,
            "useAllFilesAccess": true,
            "disableLogging": false,
            "m_SIGUID": -455434181859890524,
