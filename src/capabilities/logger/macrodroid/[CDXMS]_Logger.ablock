    "localVarsAlphabetical": true,
    "m_GUID": -5243109817748102241,
    "m_actionList": [
      {
        "actionGroupName": "01 — Prepare Log Entry",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false,
        "actionLabel": "01 — Prepare Log Entry",
        "disableLogging": false,
        "m_SIGUID": -467490942252040791,
        "m_classType": "ActionGroupAction",
        "m_comment": "Normaliza entradas, resolve escopo/arquivo e monta uma linha JSONL sem tocar em CDN ou lifecycle remoto.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false
      },
      {
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "\nconst ARTIFACT_ID = \"logger\";\nconst VERSION = \"1.0.0\";\nconst SOURCE_NAME = \"[CDXMS] Logger\";\nconst BASE_PATH = \"/storage/emulated/0/Documents/CDXMS_Solutions\";\nconst OPS = [\"log_event\",\"log_result\",\"log_error\",\"get_log_status\"];\nconst LEVELS = [\"debug\",\"info\",\"warning\",\"error\",\"critical\"];\nconst SCOPES = [\"events\",\"results\",\"errors\",\"audit\",\"runtime\"];\n\nfunction text(v) { return String(v === undefined || v === null ? \"\" : v).trim(); }\nfunction raw(v) { return String(v === undefined || v === null ? \"\" : v); }\nfunction nowIso() { return new Date().toISOString(); }\nfunction dateKey(ts) { return ts.slice(0, 10); }\nfunction cleanPart(value, fallback) {\n  const s = text(value || fallback).toLowerCase().replace(/[^a-z0-9_\\-]/g, \"_\");\n  return s || fallback;\n}\nfunction parseJsonMaybe(value, fallback, label, warnings, strict) {\n  const s = raw(value).trim();\n  if (!s) return fallback;\n  try { return JSON.parse(s); }\n  catch (e) {\n    warnings.push({ field: label, code: \"INVALID_JSON\", message: e.message });\n    if (strict) throw new Error(\"JSON inválido em \" + label + \": \" + e.message);\n    return fallback;\n  }\n}\nfunction asObject(value) {\n  return value && typeof value === \"object\" && !Array.isArray(value) ? value : {};\n}\nfunction resultError(code, message, details) {\n  return { code, message, details: details || {}, recoverable: true };\n}\nfunction buildData(obj) { return JSON.stringify(obj); }\nfunction work(success, status, resultMessage, data, error, shouldWrite, folderPath, fileName, logLine) {\n  return JSON.stringify({\n    success: success === true,\n    status: status || (success ? \"success\" : \"error\"),\n    result_message: resultMessage || \"\",\n    data_json: buildData(data || {}),\n    error_json: error ? JSON.stringify(error) : \"\",\n    should_write: shouldWrite === true,\n    folder_path: folderPath || (BASE_PATH + \"/logs/events/\"),\n    file_name: fileName || \"cdxms-events-unknown.jsonl\",\n    log_line: logLine || \"\"\n  });\n}\n\ntry {\n  const timestamp = nowIso();\n  let op = cleanPart(`{lv=Operation}`, \"log_event\");\n  const strict = String(`{lv=Strict Mode?}`).toLowerCase() === \"true\";\n  const warnings = [];\n\n  if (!OPS.includes(op)) {\n    const data = { accepted: false, operation: op, supported_operations: OPS };\n    const err = resultError(\"UNSUPPORTED_OPERATION\", \"Operação não suportada pelo Logger.\", { operation: op, supported_operations: OPS });\n    work(false, \"error\", \"A operação informada não é suportada pelo Logger.\", data, err, false, \"\", \"\", \"\");\n  } else {\n    let level = cleanPart(`{lv=Level}`, \"info\");\n    if (!LEVELS.includes(level)) level = \"info\";\n\n    const resultObj = parseJsonMaybe(`{lv=Result Json}`, null, \"Result Json\", warnings, strict);\n    const dataObj = parseJsonMaybe(`{lv=Data Json}`, {}, \"Data Json\", warnings, strict);\n    const errorObj = parseJsonMaybe(`{lv=Error Json}`, null, \"Error Json\", warnings, strict);\n    const tagsObj = parseJsonMaybe(`{lv=Tags Json}`, [], \"Tags Json\", warnings, strict);\n    const configObj = parseJsonMaybe(`{lv=Config Json}`, {}, \"Config Json\", warnings, false);\n\n    if (op === \"log_result\" && resultObj && resultObj.success === false && level === \"info\") level = \"error\";\n    if (op === \"log_error\" && (level === \"info\" || level === \"debug\")) level = \"error\";\n\n    let scope = cleanPart(`{lv=Log Scope}`, \"auto\");\n    if (scope === \"auto\") {\n      scope = op === \"log_error\" ? \"errors\" : op === \"log_result\" ? \"results\" : \"events\";\n    }\n    if (!SCOPES.includes(scope)) scope = \"events\";\n\n    const eventType = cleanPart(`{lv=Event Type}`, op);\n    const sourceArtifactType = cleanPart(`{lv=Source Artifact Type}`, \"capability\");\n    const sourceArtifactId = cleanPart(`{lv=Source Artifact Id}`, \"unknown\");\n    const sourceOperation = cleanPart(`{lv=Source Operation}`, \"unknown\");\n    const message = text(`{lv=Message}`) || (op === \"get_log_status\" ? \"Status do Logger solicitado.\" : \"Evento CDXMS registrado.\");\n    const sessionId = text(`{lv=Session Id}`);\n    const correlationId = text(`{lv=Correlation Id}`);\n    const date = dateKey(timestamp);\n\n    const cfg = asObject(configObj.config || configObj);\n    const basePath = text(cfg.base_path) || BASE_PATH;\n    const folderPath = basePath.replace(/\\/$/, \"\") + \"/logs/\" + scope + \"/\";\n    let fileName = text(`{lv=Log File Name}`);\n    if (!fileName) fileName = \"cdxms-\" + scope + \"-\" + date + \".jsonl\";\n    fileName = fileName.replace(/[^a-zA-Z0-9_\\.\\-]/g, \"_\");\n    if (!/\\.jsonl$/i.test(fileName)) fileName += \".jsonl\";\n\n    const shouldWrite = op !== \"get_log_status\";\n    const logEntry = {\n      schema_version: 1,\n      namespace: \"CDXMS\",\n      log_type: op,\n      level,\n      event_type: eventType,\n      message,\n      timestamp,\n      source: {\n        artifact_type: sourceArtifactType,\n        artifact_id: sourceArtifactId,\n        operation: sourceOperation\n      },\n      correlation_id: correlationId || null,\n      session_id: sessionId || null,\n      tags: tagsObj || [],\n      data: dataObj && typeof dataObj === \"object\" ? dataObj : { value: dataObj },\n      error: errorObj || null,\n      result: resultObj || null,\n      warnings\n    };\n\n    const logLine = shouldWrite ? JSON.stringify(logEntry) + \"\\n\" : \"\";\n    const resultData = {\n      logger: {\n        version: VERSION,\n        source: SOURCE_NAME,\n        operation: op,\n        level,\n        scope,\n        event_type: eventType,\n        written: shouldWrite,\n        format: \"jsonl\"\n      },\n      log_file: {\n        folder_path: folderPath,\n        file_name: fileName,\n        full_path: folderPath + fileName\n      },\n      log_entry: shouldWrite ? logEntry : null,\n      supported_operations: OPS,\n      supported_levels: LEVELS,\n      supported_scopes: SCOPES,\n      warnings\n    };\n\n    const resultMessage = shouldWrite\n      ? \"Evento registrado pelo Logger.\"\n      : \"Status do Logger retornado com sucesso.\";\n\n    work(true, \"success\", resultMessage, resultData, null, shouldWrite, folderPath, fileName, logLine);\n  }\n} catch (e) {\n  const err = resultError(\"PROCESSING_FAILED\", \"Falha ao preparar o registro de log.\", { message: e.message });\n  const data = { accepted: false, source: SOURCE_NAME, version: VERSION };\n  work(false, \"error\", \"Falha ao preparar o registro de log.\", data, err, false, \"\", \"\", \"\");\n}\n",
        "stringVariableName": "Tmp_LogWorkJson",
        "disableLogging": false,
        "m_SIGUID": -3368774058485240890,
        "m_classType": "JavaScriptAction",
        "m_comment": "Prepara instruções de log, linha JSONL e payload de Resultado para publicação via Result Manager.",
