          {
            "blockNextAction": true,
            "javascriptEngine": "JetPack JavascriptEngine",
            "scriptText": "\nconst ARTIFACT_ID = \"json_config_manager\";\nfunction result(success, status, operation, message, data, error) {\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success,\n    status,\n    artifact_type: \"capability\",\n    artifact_id: ARTIFACT_ID,\n    operation,\n    message,\n    data: data || {},\n    error: error || null,\n    meta: {\n      timestamp: new Date().toISOString(),\n      source: \"[CDXMS] Json Config Manager\",\n      version: \"1.0.0\"\n    }\n  });\n}\nfunction err(code, message, details, recoverable) {\n  return { code, message, details: details || {}, recoverable: recoverable === true };\n}\nfunction parse(value, name) {\n  if (value === null || value === undefined || String(value).trim() === \"\") throw new Error(\"Entrada vazia: \" + name);\n  return JSON.parse(String(value));\n}\nfunction pretty(obj, enabled) { return JSON.stringify(obj, null, enabled ? 2 : 0); }\nfunction isObj(v) { return v && typeof v === \"object\" && !Array.isArray(v); }\nfunction deepMerge(base, incoming, preserve) {\n  if (!isObj(base) || !isObj(incoming)) return preserve ? base : incoming;\n  const out = Array.isArray(base) ? base.slice() : { ...base };\n  Object.keys(incoming).forEach(k => {\n    if (isObj(out[k]) && isObj(incoming[k])) out[k] = deepMerge(out[k], incoming[k], preserve);\n    else if (!(preserve && Object.prototype.hasOwnProperty.call(out, k))) out[k] = incoming[k];\n  });\n  return out;\n}\nfunction normalizePath(raw, fallback) {\n  let p = String(raw || fallback || \"\").trim();\n  p = p.replace(/\\\\+/g, \"/\").replace(/\\/+/g, \"/\");\n  if (p.endsWith(\"/\") && p.length > 1) p = p.slice(0, -1);\n  return p;\n}\nfunction safePath(path, allowFile) {\n  if (!path) return false;\n  if (!path.startsWith(\"/storage/emulated/0/\")) return false;\n  if (path.includes(\"..\")) return false;\n  if (/[;`$<>|&\\r\\n]/.test(path)) return false;\n  if (allowFile && !/\\.json(\\.bak)?$/i.test(path)) return false;\n  return true;\n}\n\nconst op = \"backup_file\";\ntry {\n  const filePath = String(`{lv=Tmp_Work[file_path]}` || \"\");\n  const folderPath = String(`{lv=Tmp_Work[folder_path]}` || \"\");\n  const fileName = String(`{lv=Tmp_Work[file_name]}` || \"\");\n  const valid = String(`{lv=Tmp_Work[valid_file_path]}`).toLowerCase() === \"true\";\n  const raw = String(`{lv=Tmp_FileContent}` || \"\");\n  if (!valid) throw new Error(\"File Path inválido ou fora do escopo permitido.\");\n  if (raw.trim() === \"\") throw new Error(\"Arquivo não encontrado ou vazio.\");\n  const backupName = fileName + \".bak\";\n  JSON.stringify({ should_write: true, folder_path: folderPath, file_name: backupName, write_content: raw, result_json: result(true, \"success\", op, \"Backup criado com sucesso.\", { file_path: filePath, backup_path: folderPath + \"/\" + backupName }, null) });\n} catch(e) {\n  JSON.stringify({ should_write: false, result_json: result(false, \"error\", op, \"Não foi possível criar backup do arquivo.\", {}, err(\"FILE_READ_ERROR\", String(e.message || e), {}, true)) });\n}\n",
            "stringVariableName": "Tmp_WriteWorkJson",
            "disableLogging": false,
            "m_SIGUID": -116448663973191172,
            "m_classType": "JavaScriptAction",
            "m_comment": "backup_file: prepara escrita/resultado.",
            "m_constraintList": [],
            "m_isDisabled": false,
            "m_isOrCondition": false
          },
