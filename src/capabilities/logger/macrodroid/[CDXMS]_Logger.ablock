            "scriptText": "\nconst ARTIFACT_ID = \"json_config_manager\";\nfunction result(success, status, operation, message, data, error) {\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success,\n    status,\n    artifact_type: \"capability\",\n    artifact_id: ARTIFACT_ID,\n    operation,\n    message,\n    data: data || {},\n    error: error || null,\n    meta: {\n      timestamp: new Date().toISOString(),\n      source: \"[CDXMS] Json Config Manager\",\n      version: \"1.0.0\"\n    }\n  });\n}\nfunction err(code, message, details, recoverable) {\n  return { code, message, details: details || {}, recoverable: recoverable === true };\n}\n\nconst op = String(`{lv=Tmp_Work[operation]}` || \"\").trim();\nconst folderPath = String(`{lv=Tmp_Work[folder_path]}` || \"\").trim();\nresult(false, \"error\", op, \"O caminho da pasta é inválido ou inseguro para o Json Config Manager.\", { folder_path: folderPath }, err(\"INVALID_INPUT_TYPE\", \"Caminho de pasta inválido ou fora do escopo seguro.\", { folder_path: folderPath }, false));\n\n",
