            "m_logText": "{\n  \"schema_version\": 1,\n  \"namespace\": \"CDXMS\",\n  \"file_type\": \"root_sentinel\",\n  \"created_by\": \"CDXMS.JsonConfigManager\",\n  \"core_initialized\": true,\n  \"base_path\": \"/storage/emulated/0/Documents/CDXMS_Solutions\",\n  \"created_at\": \"\",\n  \"updated_at\": \"\"\n}",
