ath)) return false;\n  return true;\n}\n\nconst op = String(`{lv=Tmp_Work[operation]}` || \"\").trim();\nresult(false, \"error\", op, \"A operação informada não é suportada pelo Json Config Manager.\", {}, err(\"UNSUPPORTED_OPERATION\", \"Operação não suportada.\", { operation: op }, false));\n",
