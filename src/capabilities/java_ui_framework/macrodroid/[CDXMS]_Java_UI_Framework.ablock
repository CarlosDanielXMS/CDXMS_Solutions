= node.optString(\"key\", \"chip\");\n    boolean selected = juifState.has(key) ? juifState.optBoolean(key, false) : node.optBoolean(\"selected\", false);\n    juifSetStateValue(key, selected);\n    final TextView chip = juifText(node.optString(\"text\", node.optString(\"label\", \"Chip\")), 13f, selected ? JUIF_PRIMARY : JUIF_TEXT_MUTED, Typeface.BOLD);\n    chip.setGravity(Gravity.CENTER); chip.setPadding(dp(12), dp(7), dp(12), dp(7));\n    juifStyleNavigationItem(chip, selected, false);\n    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2); lp.setMargins(dp(3), dp(3), dp(3), dp(3)); chip.setLayoutParams(lp);\n    chip.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                boolean next = !juifState.optBoolean(key, false); juifSetStateValue(key, next); juifStyleNavigationItem(chip, next, false);\n                JSONObject extra = new JSONObject(); extra.put(\"key\", key); extra.put(\"value\", next);\n                juifEmit(node.optString(\"action\", \"chip_changed\"), extra);\n            } catch(Exception ignored) {}\n        }\n    });\n    return chip;\n}\n\nHorizontalScrollView JUIFChipGroup(final JSONObject node) throws Exception {\n    final HorizontalScrollView scroll = new HorizontalScrollView(appContext); scroll.setHorizontalScrollBarEnabled(false);\n    final LinearLayout row = new LinearLayout(appContext); row.setOrientation(LinearLayout.HORIZONTAL);\n    final String key = node.optString(\"key\", \"chip_group\");\n    final boolean multiple = \"multiple\".equals(node.optString(\"selection_mode\", \"single\"));\n    final JSONArray selectedMany = multiple && juifState.opt(key) instanceof JSONArray ? juifState.optJSONArray(key) : new JSONArray();\n    final String selectedOne = !multiple && juifState.has(key) ? String.valueOf(juifState.opt(key)) : node.optString(\"selected\", \"\");\n    JSONArray items = node.optJSONArray(\"items\");\n    if (items != null) {\n        for (int i = 0; i < items.length(); i++) {\n            final JSONObject item = items.getJSONObject(i); final String itemId = item.optString(\"id\", \"chip_\" + i);\n            boolean selected = multiple ? juifArrayContains(selectedMany, itemId) : itemId.equals(selectedOne);\n            TextView chip = juifText(item.optString(\"label\", itemId), 13f, JUIF_TEXT_MUTED, Typeface.BOLD);\n            chip.setTag(itemId); chip.setGravity(Gravity.CENTER); chip.setPadding(dp(12), dp(7), dp(12), dp(7)); juifStyleNavigationItem(chip, selected, false);\n            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2); lp.setMargins(dp(3), dp(3), dp(3), dp(3));\n            chip.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        if (multiple) {\n                            JSONArray current = juifState.opt(key) instanceof JSONArray ? juifState.optJSONArray(key) : new JSONArray();\n                            JSONArray next = new JSONArray(); boolean removed = false;\n                            for (int x = 0; x < current.length(); x++) { String existing = String.valueOf(current.opt(x)); if (itemId.equals(existing)) removed = true; else next.put(existing); }\n                            if (!removed) next.put(itemId); juifSetStateValue(key, next);\n                            for (int c = 0; c < row.getChildCount(); c++) { View child = row.getChildAt(c); if (child instanceof TextView) juifStyleNavigationItem((TextView)child, juifArrayContains(next, String.valueOf(child.getTag())), false); }\n                        } else {\n                            juifSetStateValue(key, itemId);\n                            for (int c = 0; c < row.getChildCount(); c++) { View child = row.getChildAt(c); if (child instanceof TextView) juifStyleNavigationItem((TextView)child, itemId.equals(String.valueOf(child.getTag())), false); }\n                        }\n                        JSONObject extra = new JSONObject(); extra.put(\"key\", key); extra.put(\"item_id\", itemId); extra.put(\"value\", juifState.opt(key));\n                        juifEmit(node.optString(\"action\", \"chip_group_changed\"), extra);\n                    } catch(Exception ignored) {}\n                }\n            });\n            row.addView(chip, lp);\n        }\n    }\n    scroll.addView(row, new HorizontalScrollView.LayoutParams(-2, -2)); juifApplyVerticalMargin(scroll, 5, 5); return scroll;\n}\n\nLinearLayout JUIFEmptyState(JSONObject node) throws Exception {\n    LinearLayout box = new LinearLayout(appContext); box.setOrientation(LinearLayout.VERTICAL); box.setGravity(Gravity.CENTER);\n    box.setPadding(dp(22), dp(28), dp(22), dp(28)); box.setBackground(juifBgStroke(JUIF_SURFACE, 24, JUIF_BORDER, 1)); juifApplyVerticalMargin(box, 10, 10);\n    String icon = node.optString(\"icon\", \"◇\"); if (icon.length() > 0) { TextView iconView = juifText(icon, 34f, JUIF_PRIMARY, Typeface.BOLD); iconView.setGravity(Gravity.CENTER); box.addView(iconView); box.addView(juifSpace(8)); }\n    TextView title = juifText(node.optString(\"title\", \"Nenhum item\"), 18f, JUIF_TEXT, Typeface.BOLD); title.setGravity(Gravity.CENTER); box.addView(title);\n    String message = node.optString(\"text\", node.optString(\"message\", \"\")); if (message.length() > 0) { TextView body = juifText(message, 14f, JUIF_TEXT_MUTED, Typeface.NORMAL); body.setGravity(Gravity.CENTER); body.setPadding(0, dp(7), 0, dp(7)); box.addView(body); }\n    JSONObject action = node.optJSONObject(\"action\"); if (action != null) box.addView(JUIFButton(action));\n    return box;\n}\n\nLinearLayout JUIFLoadingIndicator(JSONObject node) throws Exception {\n    LinearLayout wrap = new LinearLayout(appContext); wrap.setOrientation(LinearLayout.HORIZONTAL); wrap.setGravity(Gravity.CENTER_VERTICAL);\n    wrap.setPadding(dp(14), dp(12), dp(14), dp(12)); wrap.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER,