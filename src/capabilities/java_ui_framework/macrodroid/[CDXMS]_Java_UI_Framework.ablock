      {
        "actionGroupName": "02 — Renderizar e publicar Resultado",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false,
        "actionLabel": "02 — Renderizar e publicar Resultado",
        "disableLogging": false,
        "m_SIGUID": -3892070295765109184,
        "m_classType": "ActionGroupAction",
        "m_comment": "Renderiza a UI e publica diretamente em Resultado, sem saídas públicas paralelas.",
