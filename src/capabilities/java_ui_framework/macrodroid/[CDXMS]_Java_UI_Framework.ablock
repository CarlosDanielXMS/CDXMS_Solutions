turn JUIFCopyableText(node);\n    if (\"stat_card\".equals(type)) return JUIFStatCard(node);\n    if (\"progress_bar\".equals(type)) return JUIFProgressBar(node);\n    if (\"code_block\".equals(type)) return JUIFCodeBlock(node);\n    if (\"dynamic_list\".equals(type)) return JUIFDynamicList(node);\n    if (\"sandbox\".equals(type)) return JUIFSandbox(node);\n\n    if (\"top_app_bar\".equals(type)) return JUIFTopAppBar(node);\n    if (\"bottom_navigation\".equals(type)) return JUIFBottomNavigation(node);\n    if (\"navigation_rail\".equals(type)) return JUIFNavigationRail(node);\n    if (\"navigation_drawer\".equals(type)) return JUIFNavigationDrawer(node);\n    if (\"tab_bar\".equals(type)) return JUIFTabBar(node);\n    if (\"search_bar\".equals(type)) return JUIFSearchBar(node);\n    if (\"chip\".equals(type)) return JUIFChip(node);\n    if (\"chip_group\".equals(type)) return JUIFChipGroup(node);\n    if (\"empty_state\".equals(type)) return JUIFEmptyState(node);\n    if (\"loading_indicator\".equals(type)) return JUIFLoadingIndicator(node);\n\n    return juifText(\"Componente desconhecido: \" + type, 13f, JUIF_ERROR, Typeface.BOLD);\n}\n\n/* =========================\n   EXECUTION\n========================= */\n\njuifSetBoolean(\"Tmp_JuifVisible\", false);\njuifSetBoolean(\"Tmp_JuifClicked\", false);\njuifSetString(\"Tmp_JuifAction\", \"\");\njuifSetString(\"Tmp_JuifPayload\", \"{}\");\njuifSetString(\"Tmp_JuifState\", \"{}\");\njuifSetString(\"Tmp_JuifCurrentPage\", \"\");\n\ntry {\n    if (android.os.Build.VERSION.SDK_INT >= 23 && !Settings.canDrawOverlays(appContext)) {\n        JSONObject details = new JSONObject();\n        details.put(\"permission\", \"android.permission.SYSTEM_ALERT_WINDOW\");\n        details.put(\"required_for\", \"TYPE_APPLICATION_OVERLAY\");\n        JSONObject error = juifError(\n            \"PERMISSION_DENIED\",\n            \"A permissão para exibir sobre outros apps não está concedida.\",\n            details,\n            true\n        );\n        JSONObject result = juifResult(false, \"blocked\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    }\n\n    final String JUIF_DEFAULT_UI_JSON = \"{lv=Tmp_DefaultUiJson}\";\n\n    String raw = \"{lv=Tmp_JuifUiJsonEscaped}\";\n    boolean usingDefaultUi = false;\n\n    if (\n        raw == null ||\n        raw.trim().length() == 0 ||\n        raw.trim().startsWith(\"{lv=\")\n    ) {\n        raw = JUIF_DEFAULT_UI_JSON;\n        usingDefaultUi = true;\n    }\n\n    raw = raw.trim();\n\n    JSONObject ui = new JSONObject(raw);\n\n    JSONObject initialState = ui.optJSONObject(\"state\");\n\n    if (initialState != null) {\n        JSONArray stateNames = initialState.names();\n\n        if (stateNames != null) {\n            for (int i = 0; i < stateNames.length(); i++) {\n                String name = stateNames.getString(i);\n                juifState.put(name, initialState.get(name));\n            }\n        }\n    }\n\n    juifShell = ui.optJSONObject(\"shell\");\n    juifPages = ui.optJSONObject(\"pages\");\n\n    if (juifPages == null) {\n        juifPages = new JSONObject();\n\n        JSONObject legacyPage = new JSONObject();\n        legacyPage.put(\"title\", ui.optString(\"title\", \"JUIF\"));\n        legacyPage.put(\"subtitle\", ui.optString(\"subtitle\", \"\"));\n\n        JSONArray legacyComponents = ui.optJSONArray(\"components\");\n\n        if (legacyComponents == null) {\n            legacyComponents = new JSONArray();\n        }\n\n        legacyPage.put(\"components\", legacyComponents);\n        juifPages.put(\"main\", legacyPage);\n\n        juifCurrentPageId = \"main\";\n    } else {\n        juifCurrentPageId = ui.optString(\"initial_page\", \"\");\n\n        if (juifCurrentPageId.length() == 0) {\n            JSONArray pageNames = juifPages.names();\n\n            if (pageNames != null && pageNames.length() > 0) {\n                juifCurrentPageId = pageNames.getString(0);\n            }\n        }\n    }\n\n    juifOverlay = new FrameLayout(appContext);\n    juifOverlay.setBackgroundColor(JUIF_OVERLAY);\n    juifOverlay.setFocusable(true);\n    juifOverlay.setFocusableInTouchMode(true);\n\n    ScrollView scroll = new ScrollView(appContext);\n    scroll.setFillViewport(true);\n\n    juifPageContainer = new LinearLayout(appContext);\n    juifPageContainer.setOrientation(LinearLayout.VERTICAL);\n    juifPageContainer.setPadding(dp(22), dp(34), dp(22), dp(26));\n    juifPageContainer.setBackgroundColor(JUIF_BG);\n\n    scroll.addView(\n        juifPageContainer,\n        new FrameLayout.LayoutParams(\n            FrameLayout.LayoutParams.MATCH_PARENT,\n            FrameLayout.LayoutParams.WRAP_CONTENT\n        )\n    );\n\n    juifOverlay.addView(\n        scroll,\n        new FrameLayout.LayoutParams(\n            FrameLayout.LayoutParams.MATCH_PARENT,\n            FrameLayout.LayoutParams.MATCH_PARENT\n        )\n    );\n\n    juifOverlay.setOnLongClickListener(new View.OnLongClickListener() {\n        public boolean onLongClick(View v) {\n            juifCloseOverlay(juifOverlay);\n            return true;\n        }\n    });\n\n    WindowManager.LayoutParams params = new WindowManager.LayoutParams(\n        WindowManager.LayoutParams.MATCH_PARENT,\n        WindowManager.LayoutParams.MATCH_PARENT,\n        WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,\n        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,\n        PixelFormat.TRANSLUCENT\n    );\n\n    params.softInputMode =\n        WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE |\n        WindowManager.LayoutParams.SOFT_INPUT_STATE_UNSPECIFIED;\n\n    wm.addView(juifOverlay, params);\n\n    juifOverlay.requestFocus();\n\n    juifRenderPage(juifCurrentPageId);\n\n    juifOverlay.setAlpha(0f);\n    juifOverlay.animate().alpha(1f).setDuration(180);\n\n    juifSetBoolean(\"Tmp_JuifVisible\", true);\n    juifSetString(\"Tmp_JuifState\", juifState.toString());\n    juifSetString(\"Tmp_JuifCurrentPage\", juifCurrentPageId);\n\n    JSONObject data = new JSONObject();\n    data.put(\"current_page\", juifCurrentPageId);\n    data.put(\"state\", juifState);\n    data.put(\"using_default_ui\", usingDefaultUi);\n    data.put(\"component_catalog_version\", \"1.0.0\");\n    data.put(\"supported_component_count\", 36);\n    data.put(\"shell_enabled\", juifShell != null);\n\n    JSONObject ok = juifResult(true, \"success\", \"JUIF carregado com sucesso.\", data, null);\n    juifPublishResult(ok);\n\n    return ok.toString();\n\n} catch(JSONException e) {\n    try {\n        JSONObject details = new JSONObject();\n        details.put(\"reason\", String.valueOf(e.getMessage()));\n        JSONObject error = juifError(\"INVALID_JSON\", \"O JUIF UI Json informado é inválido.\", details, false);\n        JSONObject result = juifResult(false, \"error\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    } catch(Exception ignored) {\n        return \"{\\\"schema_version\\\":1,\\\"namespace\\\":\\\"CDXMS\\\",\\\"success\\\":false,\\\"status\\\":\\\"error\\\",\\\"artifact_type\\\":\\\"capability\\\",\\\"artifact_id\\\":\\\"java_ui_framework\\\",\\\"operation\\\":\\\"render_ui\\\",\\\"message\\\":\\\"O JUIF UI Json informado é inválido.\\\",\\\"data\\\":{},\\\"error\\\":{\\\"code\\\":\\\"INVALID_JSON\\\",\\\"message\\\":\\\"O JUIF UI Json informado é inválido.\\\",\\\"details\\\":{},\\\"recoverable\\\":false},\\\"meta\\\":{\\\"source\\\":\\\"[CDXMS] Java UI Framework\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"component_catalog_version\\\":\\\"1.0.0\\\"}}\";\n    }\n} catch(SecurityException e) {\n    try {\n        JSONObject details = new JSONObject();\n        details.put(\"reason\", String.valueOf(e.getMessage()));\n        JSONObject error = juifError(\"PERMISSION_DENIED\", \"O Android bloqueou a criação do overlay JUIF.\", details, true);\n        JSONObject result = juifResult(false, \"blocked\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    } catch(Exception ignored) {\n        return \"{\\\"schema_version\\\":1,\\\"namespace\\\":\\\"CDXMS\\\",\\\"success\\\":false,\\\"status\\\":\\\"blocked\\\",\\\"artifact_type\\\":\\\"capability\\\",\\\"artifact_id\\\":\\\"java_ui_framework\\\",\\\"operation\\\":\\\"render_ui\\\",\\\"message\\\":\\\"O Android bloqueou a criação do overlay JUIF.\\\",\\\"data\\\":{},\\\"error\\\":{\\\"code\\\":\\\"PERMISSION_DENIED\\\",\\\"message\\\":\\\"O Android bloqueou a criação do overlay JUIF.\\\",\\\"details\\\":{},\\\"recoverable\\\":true},\\\"meta\\\":{\\\"source\\\":\\\"[CDXMS] Java UI Framework\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"component_catalog_version\\\":\\\"1.0.0\\\"}}\";\n    }\n} catch(Exception e) {\n    try {\n        JSONObject details = new JSONObject();\n        details.put(\"reason\", String.valueOf(e.getMessage()));\n        JSONObject error = juifError(\"PROCESSING_FAILED\", \"Falha ao inicializar JUIF.\", details, false);\n        JSONObject result = juifResult(false, \"error\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    } catch(Exception ignored) {\n        return \"{\\\"schema_version\\\":1,\\\"namespace\\\":\\\"CDXMS\\\",\\\"success\\\":false,\\\"status\\\":\\\"error\\\",\\\"artifact_type\\\":\\\"capability\\\",\\\"artifact_id\\\":\\\"java_ui_framework\\\",\\\"operation\\\":\\\"render_ui\\\",\\\"message\\\":\\\"Falha crítica ao inicializar JUIF.\\\",\\\"data\\\":{},\\\"error\\\":{\\\"code\\\":\\\"UNKNOWN_ERROR\\\",\\\"message\\\":\\\"Falha crítica ao inicializar JUIF.\\\",\\\"details\\\":{},\\\"recoverable\\\":false},\\\"meta\\\":{\\\"source\\\":\\\"[CDXMS] Java UI Framework\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"component_catalog_version\\\":\\\"1.0.0\\\"}}\";\n    }\n}",
