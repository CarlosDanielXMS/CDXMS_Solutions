ert\",\"variant\":\"info\",\"title\":\"A própria documentação é o exemplo\",\"text\":\"Top App Bar, Tab Bar, Bottom Navigation e Navigation Drawer estão ativos como shell persistente desta interface.\"},{\"type\":\"section\",\"title\":\"Navigation Rail\",\"subtitle\":\"Indicado para layouts amplos ou fluxos com poucas áreas principais.\",\"children\":[{\"type\":\"navigation_rail\",\"key\":\"rail_demo\",\"selected\":\"navigation\",\"item_width\":72,\"items\":[{\"id\":\"home\",\"label\":\"Início\",\"target\":\"overview\",\"action\":\"replace\"},{\"id\":\"navigation\",\"label\":\"Navegação\",\"target\":\"catalog_navigation\",\"action\":\"replace\"},{\"id\":\"lab\",\"label\":\"Lab\",\"target\":\"playground\",\"action\":\"replace\"}]}]},{\"type\":\"section\",\"title\":\"Comportamento do shell\",\"children\":[{\"type\":\"key_value\",\"label\":\"Top App Bar\",\"value\":\"Contexto e ações globais\"},{\"type\":\"divider\"},{\"type\":\"key_value\",\"label\":\"Tab Bar\",\"value\":\"Categorias relacionadas\"},{\"type\":\"divider\"},{\"type\":\"key_value\",\"label\":\"Bottom Navigation\",\"value\":\"Áreas principais\"},{\"type\":\"divider\"},{\"type\":\"key_value\",\"label\":\"Drawer\",\"value\":\"Mapa completo da documentação\"}]},{\"type\":\"button\",\"text\":\"Abrir Navigation Drawer\",\"variant\":\"secondary\",\"action\":\"open_drawer\"}]},\"playground\":{\"title\":\"Laboratório\",\"subtitle\":\"Edite, formate, copie e renderize contratos JUIF.\",\"show_header\":false,\"components\":[{\"type\":\"container\",\"variant\":\"surface2\",\"radius\":24,\"children\":[{\"type\":\"text\",\"variant\":\"label\",\"text\":\"AMBIENTE DE TESTE\"},{\"type\":\"text\",\"variant\":\"title\",\"text\":\"Do schema ao preview\"},{\"type\":\"text\",\"variant\":\"subtitle\",\"text\":\"Use o exemplo mínimo como referência e experimente alterações no sandbox.\"}]},{\"type\":\"code_block\",\"id\":\"schema_example\",\"title\":\"UI Schema Json mínimo\",\"language\":\"json\",\"bind\":\"docs.schema_example\