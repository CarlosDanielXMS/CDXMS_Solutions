on\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"type\\\\\\\": \\\\\\\"code_block\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Meu JSON\\\\\\\", \\\\\\\"language\\\\\\\": \\\\\\\"json\\\\\\\", \\\\\\\"auto_indent\\\\\\\": true, \\\\\\\"code\\\\\\\": \\\\\\\"{\\\\\\\\\\\\\\\"hello\\\\\\\\\\\\\\\":\\\\\\\\\\\\\\\"world\\\\\\\\\\\\\\\"}\\\\\\\"}\\\"},{\\\"type\\\":\\\"copyable_text\\\",\\\"label\\\":\\\"Texto copiável\\\",\\\"text\\\":\\\"Use copyable_text para instruções, snippets curtos, tokens, ids e valores simples que o usuário precisa copiar.\\\"},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Quando usar cada um\\\",\\\"language\\\":\\\"text\\\",\\\"auto_indent\\\":false,\\\"code\\\":\\\"copyable_text: conteúdo curto e simples.\\\\ncode_block: JSON, código, scripts, exemplos longos.\\\\nsandbox: testar e renderizar um ui_json completo dentro da própria documentação.\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"sandbox\\\"}]}]},\\\"sandbox\\\":{\\\"title\\\":\\\"10 · Sandbox interativo\\\",\\\"subtitle\\\":\\\"Ambiente de prática para testar ui_json sem sair do framework.\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"success\\\",\\\"title\\\":\\\"Componente sandbox\\\",\\\"text\\\":\\\"O sandbox permite digitar um JSON, formatar, copiar, copiar escapado e renderizar um preview local usando os próprios componentes do JUIF.\\\"},{\\\"type\\\":\\\"sandbox\\\",\\\"key\\\":\\\"sandbox_json\\\",\\\"title\\\":\\\"Sandbox JUIF\\\",\\\"subtitle\\\":\\\"Edite o JSON abaixo, toque em Formatar ou Renderizar e copie a versão que precisar.\\\",\\\"min_lines\\\":8},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Como declarar o sandbox\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"type\\\\\\\": \\\\\\\"sandbox\\\\\\\", \\\\\\\"key\\\\\\\": \\\\\\\"sandbox_json\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Sandbox JUIF\\\\\\\", \\\\\\\"subtitle\\\\\\\": \\\\\\\"Teste seu ui_json aqui.\\\\\\\", \\\\\\\"min_lines\\\\\\\": 8}\\\"},{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"warning\\\",\\\"title\\\":\\\"Limite intencional\\\",\\\"text\\\":\\\"O preview do sandbox renderiza a primeira página do JSON informado. Persistência e ações externas continuam sendo responsabilidade da macro.\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"integracao\\\"}]}]},\\\"integracao\\\":{\\\"title\\\":\\\"11 · Integração CDXMS\\\",\\\"subtitle\\\":\\\"O JUIF renderiza. A macro orquestra, persiste e decide.\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"warning\\\",\\\"title\\\":\\\"Separação correta\\\",\\\"text\\\":\\\"O JUIF não deve chamar o Json Config Manager diretamente. A macro chama JCM, UI Builder, JUIF e depois aplica alterações.\\\"},{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"FLUXO RECOMENDADO\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"1\\\",\\\"value\\\":\\\"Macro lê config via JCM\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"2\\\",\\\"value\\\":\\\"Macro chama JUIF UI Builder\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"3\\\",\\\"value\\\":\\\"Builder gera juif_ui_json\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"4\\\",\\\"value\\\":\\\"JUIF renderiza e retorna state/eventos\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"5\\\",\\\"value\\\":\\\"Macro usa mapping_json para salvar alterações via JCM\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Contrato de saída do evento\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"Tmp_JuifAction\\\\\\\": \\\\\\\"salvar_config\\\\\\\", \\\\\\\"Tmp_JuifPayload\\\\\\\": {\\\\\\\"action\\\\\\\": \\\\\\\"salvar_config\\\\\\\", \\\\\\\"current_page\\\\\\\": \\\\\\\"config\\\\\\\", \\\\\\\"state\\\\\\\": {\\\\\\\"ativo\\\\\\\": true, \\\\\\\"timeout\\\\\\\": 10}}}\\\"},{\\\"type\\\":\\\"copyable_text\\\",\\\"label\\\":\\\"Regra de ouro\\\",\\\"text\\\":\\\"JUIF = Renderer. UI Builder = transforma config/schema em UI. Macro = orquestra e persiste. JCM = lê/escreve JSON.\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"receitas\\\"}]}]},\\\"receitas\\\":{\\\"title\\\":\\\"12 · Receitas prontas\\\",\\\"subtitle\\\":\\\"Modelos copiáveis para uso real.\\\",\\\"components\\\":[{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Confirmação segura\\\",\\\"children\\\":[{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"confirmacao.json\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"initial_page\\\\\\\": \\\\\\\"confirmar\\\\\\\", \\\\\\\"pages\\\\\\\": {\\\\\\\"confirmar\\\\\\\": {\\\\\\\"title\\\\\\\": \\\\\\\"Confirmar ação\\\\\\\", \\\\\\\"subtitle\\\\\\\": \\\\\\\"Revise antes de continuar.\\\\\\\", \\\\\\\"components\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"alert\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"warning\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Atenção\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Esta ação exige confirmação.\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button_group\\\\\\\", \\\\\\\"buttons\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Cancelar\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"ghost\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"close\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Confirmar\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"primary\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"confirmar_acao\\\\\\\"}]}]}}}\\\"}]},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Formulário padrão\\\",\\\"children\\\":[{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"formulario.json\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"initial_page\\\\\\\": \\\\\\\"form\\\\\\\", \\\\\\\"state\\\\\\\": {\\\\\\\"nome\\\\\\\": \\\\\\\"\\\\\\\", \\\\\\\"email\\\\\\\": \\\\\\\"\\\\\\\"}, \\\\\\\"pages\\\\\\\": {\\\\\\\"form\\\\\\\": {\\\\\\\"title\\\\\\\": \\\\\\\"Cadastro\\\\\\\", \\\\\\\"components\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"input\\\\\\\", \\\\\\\"key\\\\\\\": \\\\\\\"nome\\\\\\\", \\\\\\\"hint\\\\\\\": \\\\\\\"Nome\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"input\\\\\\\", \\\\\\\"key\\\\\\\": \\\\\\\"email\\\\\\\", \\\\\\\"hint\\\\\\\": \\\\\\\"E-mail\\\\\\\", \\\\\\\"input_type\\\\\\\": \\\\\\\"email\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Enviar\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"enviar_cadastro\\\\\\\"}]}}}\\\"}]},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Dashboard simples\\\",\\\"children\\\":[{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"dashboard.json\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"initial_page\\\\\\\": \\\\\\\"dash\\\\\\\", \\\\\\\"pages\\\\\\\": {\\\\\\\"dash\\\\\\\": {\\\\\\\"title\\\\\\\": \\\\\\\"Painel\\\\\\\", \\\\\\\"components\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"row\\\\\\\", \\\\\\\"children\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"stat_card\\\\\\\", \\\\\\\"label\\\\\\\": \\\\\\\"Ativas\\\\\\\", \\\\\\\"value\\\\\\\": \\\\\\\"3\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"stat_card\\\\\\\", \\\\\\\"label\\\\\\\": \\\\\\\"Falhas\\\\\\\", \\\\\\\"value\\\\\\\": \\\\\\\"0\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"success\\\\\\\"}]}, {\\\\\\\"type\\\\\\\": \\\\\\\"progress_bar\\\\\\\", \\\\\\\"label\\\\\\\": \\\\\\\"Configuração\\\\\\\", \\\\\\\"progress\\\\\\\": 75}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Fechar\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"ghost\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"close\\\\\\\"}]}}}\\\"}]},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"laboratorio\\\"}]}]},\\\"laboratorio\\\":{\\\"title\\\":\\\"13 · Laboratório interativo\\\",\\\"subtitle\\\":\\\"Teste uma interface real e observe os outputs.\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"info\\\",\\\"title\\\":\\\"Teste real\\\",\\\"text\\\":\\\"Preencha os campos e toque em Enviar. A macro poderá ler Tmp_JuifAction = enviar_laboratorio e o state completo em Tmp_JuifPayload.\\\"},{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"SOLICITAÇÃO\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"input\\\",\\\"key\\\":\\\"lab_titulo\\\",\\\"hint\\\":\\\"Título\\\"},{\\\"type\\\":\\\"select\\\",\\\"key\\\":\\\"lab_categoria\\\",\\\"label\\\":\\\"Categoria\\\",\\\"options\\\":[{\\\"label\\\":\\\"Operacional\\\",\\\"value\\\":\\\"operacional\\\"},{\\\"label\\\":\\\"Financeira\\\",\\\"value\\\":\\\"financeira\\\"},{\\\"label\\\":\\\"Técnica\\\",\\\"value\\\":\\\"tecnica\\\"},{\\\"label\\\":\\\"Comercial\\\",\\\"value\\\":\\\"comercial\\\"}]},{\\\"type\\\":\\\"radio_group\\\",\\\"key\\\":\\\"lab_prioridade\\\",\\\"options\\\":[{\\\"label\\\":\\\"Baixa\\\",\\\"value\\\":\\\"baixa\\\"},{\\\"label\\\":\\\"Média\\\",\\\"value\\\":\\\"media\\\"},{\\\"label\\\":\\\"Alta\\\",\\\"value\\\":\\\"alta\\\"}]},{\\\"type\\\":\\\"textarea\\\",\\\"key\\\":\\\"lab_descricao\\\",\\\"hint\\\":\\\"Descrição\\\",\\\"min_lines\\\":4},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"lab_confirmado\\\",\\\"text\\\":\\\"Revisei e confirmo os dados\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Enviar laboratório\\\",\\\"action\\\":\\\"enviar_laboratorio\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Evento esperado\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"action\\\\\\\": \\\\\\\"enviar_laboratorio\\\\\\\", \\\\\\\"current_page\\\\\\\": \\\\\\\"laboratorio\\\\\\\", \\\\\\\"state\\\\\\\": {\\\\\\\"lab_titulo\\\\\\\": \\\\\\\"Solicitação de aprovação\\\\\\\", \\\\\\\"lab_categoria\\\\\\\": \\\\\\\"operacional\\\\\\\", \\\\\\\"lab_prioridade\\\\\\\": \\\\\\\"media\\\\\\\", \\\\\\\"lab_confirmado\\\\\\\": true}}\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"checklist\\\"}]}]},\\\"checklist\\\":{\\\"title\\\":\\\"14 · Checklist de produção\\\",\\\"subtitle\\\":\\\"Valide antes de publicar uma UI em uma solution.\\\",\\\"components\\\":[{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"VALIDAÇÃO\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"check_json\\\",\\\"text\\\":\\\"JSON válido e parseável\\\"},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"check_escape\\\",\\\"text\\\":\\\"JSON escapado corretamente\\\"},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"check_pages\\\",\\\"text\\\":\\\"initial_page existe em pages\\\"},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"check_keys\\\",\\\"text\\\":\\\"keys estáveis e claras\\\"},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"check_actions\\\",\\\"text\\\":\\\"actions customizadas documentadas\\\"},{\\\"type\\\":\\\"checkbox\\\",\\\"key\\\":\\\"check_macro\\\",\\\"text\\\":\\\"macro trata Tmp_JuifAction e Tmp_JuifPayload\\\"}]},{\\\"type\\\":\\\"container\\\",\\\"variant\\\":\\\"surface2\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"PADRÕES RECOMENDADOS\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Páginas\\\",\\\"value\\\":\\\"pequenas e focadas\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Estado\\\",\\\"value\\\":\\\"inicialize defaults importantes\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Layout\\\",\\\"value\\\":\\\"card para foco, section para grupos\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Ações\\\",\\\"value\\\":\\\"nomes semânticos e estáveis\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Persistência\\\",\\\"value\\\":\\\"fora do JUIF, via macro + JCM\\\"}]},{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"success\\\",\\\"title\\\":\\\"Pronto\\\",\\\"text\\\":\\\"Com este padrão, o usuário aprende o framework, testa componentes, copia exemplos e entende a integração CDXMS.\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Fechar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"close\\\"}]}]}}}",
