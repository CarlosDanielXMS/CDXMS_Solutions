        "m_booleanValue": false,
        "m_decimalValue": 0.0,
        "m_intValue": 0,
        "m_name": "JUIF UI Json",
        "m_stringValue": "{\n  \"initial_page\": \"dashboard\",\n  \"state\": {\n    \"schema_version\": \"1\",\n\n    \"global_ativo\": true,\n    \"global_modo_debug\": false,\n\n    \"uber_nome\": \"Uber\",\n    \"uber_pacote\": \"com.ubercab\",\n    \"banco_nome\": \"Nubank\",\n    \"banco_pacote\": \"com.nu.production\",\n\n    \"timeout_busca_segundos\": \"10\",\n    \"intervalo_tentativa_ms\": \"500\",\n    \"tentativas_maximas\": \"3\",\n    \"aguardar_apos_abrir_app_ms\": \"2000\",\n    \"aguardar_apos_clique_ms\": \"800\",\n    \"aguardar_antes_leitura_ms\": \"300\",\n    \"normalizar_texto\": true,\n    \"persistir_busca\": true,\n\n    \"usar_locais_salvos_por_padrao\": true,\n    \"tipo_corrida_padrao\": \"UberX\",\n    \"permitir_tipo_corrida_alternativo\": true,\n\n    \"texto_campo_destino\": \"Para onde?\",\n    \"texto_locais_salvos\": \"Locais salvos\",\n    \"texto_pagamento\": \"Pagamento\",\n    \"texto_pix\": \"Pix\",\n    \"texto_copiar_codigo_pix\": \"Copiar código\",\n    \"texto_confirmar_corrida\": \"Confirmar\",\n\n    \"confirmar_antes_de_iniciar\": true,\n    \"parar_na_confirmacao_do_uber\": true,\n    \"permitir_confirmar_corrida\": false,\n    \"permitir_pagamento_automatico\": false,\n    \"abrir_banco_apos_pix\": true,\n    \"finalizacao_pix_manual\": true,\n    \"parar_em_caso_de_duvida\": true,\n\n    \"exigir_tela_desbloqueada\": true,\n    \"exigir_internet\": true,\n    \"bateria_minima\": \"20\",\n    \"permitir_em_chamada\": false,\n\n    \"automacao_nome\": \"Trabalho\",\n    \"automacao_ativo\": true,\n    \"automacao_categoria\": \"rotina\",\n\n    \"destino_nome\": \"Trabalho\",\n    \"destino_endereco\": \"Av. Exemplo, 100\",\n    \"destino_referencia_uber\": \"Trabalho\",\n\n    \"disparo_manual\": true,\n    \"disparo_exibir_na_lista\": true,\n    \"disparo_agendado\": true,\n    \"horario_1_dias\": \"SEG\",\n    \"horario_1_hora\": \"15:00\",\n    \"horario_2_dias\": \"QUI,SEX\",\n    \"horario_2_hora\": \"13:00\",\n\n    \"pagamento_tipo\": \"PIX\",\n    \"pagamento_referencia_uber\": \"Pix\",\n    \"pagamento_banco\": \"Nubank\",\n\n    \"pref_usar_local_salvo\": \"herdar\",\n    \"pref_tipo_corrida\": \"herdar\",\n    \"pref_confirmar_antes_de_iniciar\": \"herdar\",\n    \"pref_parar_na_confirmacao_do_uber\": \"herdar\",\n    \"pref_abrir_banco_apos_pix\": \"herdar\"\n  },\n  \"pages\": {\n    \"dashboard\": {\n      \"title\": \"Configuração Uber\",\n      \"subtitle\": \"Painel principal da automação\",\n      \"components\": [\n        {\n          \"type\": \"alert\",\n          \"variant\": \"info\",\n          \"title\": \"CDXMS JUIF\",\n          \"text\": \"Edite os parâmetros da automação. Ao salvar, a macro deve usar Tmp_JuifState para atualizar o JSON via Json Config Manager.\"\n        },\n        {\n          \"type\": \"card\",\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"Resumo\",\n              \"variant\": \"label\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Automação\",\n              \"value\": \"Trabalho\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Destino\",\n              \"value\": \"Av. Exemplo, 100\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Pagamento\",\n              \"value\": \"PIX • Nubank\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Global\",\n              \"variant\": \"secondary\",\n              \"action\": \"navigate\",\n              \"target\": \"global\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Automação\",\n              \"variant\": \"secondary\",\n              \"action\": \"navigate\",\n              \"target\": \"automacao\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Segurança\",\n              \"variant\": \"secondary\",\n              \"action\": \"navigate\",\n              \"target\": \"seguranca\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Runtime\",\n              \"variant\": \"secondary\",\n              \"action\": \"navigate\",\n              \"target\": \"runtime\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button\",\n          \"text\": \"Salvar Configuração\",\n          \"action\": \"save_config\"\n        },\n        {\n          \"type\": \"button\",\n          \"text\": \"Fechar\",\n          \"variant\": \"ghost\",\n          \"action\": \"close\"\n        }\n      ]\n    },\n    \"global\": {\n      \"title\": \"Global\",\n      \"subtitle\": \"Configurações gerais do sistema\",\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Estado geral\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"global_ativo\",\n              \"text\": \"Sistema ativo\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"global_modo_debug\",\n              \"text\": \"Modo debug\",\n              \"checked\": false\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Apps\",\n          \"subtitle\": \"Pacotes usados pela automação\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"uber_nome\",\n              \"hint\": \"Nome do app Uber\",\n              \"value\": \"Uber\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"uber_pacote\",\n              \"hint\": \"Pacote do Uber\",\n              \"value\": \"com.ubercab\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"banco_nome\",\n              \"hint\": \"Nome do banco\",\n              \"value\": \"Nubank\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"banco_pacote\",\n              \"hint\": \"Pacote do banco\",\n              \"value\": \"com.nu.production\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"ui\": {\n      \"title\": \"Interface e tempos\",\n      \"subtitle\": \"Parâmetros de busca e espera\",\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Busca\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"timeout_busca_segundos\",\n              \"hint\": \"Timeout de busca em segundos\",\n              \"input_type\": \"number\",\n              \"value\": \"10\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"intervalo_tentativa_ms\",\n              \"hint\": \"Intervalo entre tentativas em ms\",\n              \"input_type\": \"number\",\n              \"value\": \"500\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"tentativas_maximas\",\n              \"hint\": \"Tentativas máximas\",\n              \"input_type\": \"number\",\n              \"value\": \"3\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Aguardas\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"aguardar_apos_abrir_app_ms\",\n              \"hint\": \"Aguardar após abrir app em ms\",\n              \"input_type\": \"number\",\n              \"value\": \"2000\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"aguardar_apos_clique_ms\",\n              \"hint\": \"Aguardar após clique em ms\",\n              \"input_type\": \"number\",\n              \"value\": \"800\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"aguardar_antes_leitura_ms\",\n              \"hint\": \"Aguardar antes da leitura em ms\",\n              \"input_type\": \"number\",\n              \"value\": \"300\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Leitura\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"normalizar_texto\",\n              \"text\": \"Normalizar texto\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"persistir_busca\",\n              \"text\": \"Persistir busca\",\n              \"checked\": true\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"uber\": {\n      \"title\": \"Uber\",\n      \"subtitle\": \"Preferências e textos de tela\",\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Preferências\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"usar_locais_salvos_por_padrao\",\n              \"text\": \"Usar locais salvos por padrão\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"tipo_corrida_padrao\",\n              \"label\": \"Tipo de corrida padrão\",\n              \"value\": \"UberX\",\n              \"options\": [\n                {\n                  \"label\": \"UberX\",\n                  \"value\": \"UberX\"\n                },\n                {\n                  \"label\": \"Comfort\",\n                  \"value\": \"Comfort\"\n                },\n                {\n                  \"label\": \"Black\",\n                  \"value\": \"Black\"\n                }\n              ]\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"permitir_tipo_corrida_alternativo\",\n              \"text\": \"Permitir tipo alternativo\",\n              \"checked\": true\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Textos reconhecidos\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"texto_campo_destino\",\n              \"hint\": \"Campo destino\",\n              \"value\": \"Para onde?\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"texto_locais_salvos\",\n              \"hint\": \"Locais salvos\",\n              \"value\": \"Locais salvos\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"texto_pagamento\",\n              \"hint\": \"Pagamento\",\n              \"value\": \"Pagamento\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"texto_pix\",\n              \"hint\": \"Pix\",\n              \"value\": \"Pix\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"texto_copiar_codigo_pix\",\n              \"hint\": \"Copiar código Pix\",\n              \"value\": \"Copiar código\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"texto_confirmar_corrida\",\n              \"hint\": \"Confirmar corrida\",\n              \"value\": \"Confirmar\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"seguranca\": {\n      \"title\": \"Segurança\",\n      \"subtitle\": \"Limites operacionais da automação\",\n      \"components\": [\n        {\n          \"type\": \"alert\",\n          \"variant\": \"warning\",\n          \"title\": \"Atenção\",\n          \"text\": \"Essas opções controlam se a automação pode confirmar corrida e pagamento automaticamente.\"\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Confirmações\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"confirmar_antes_de_iniciar\",\n              \"text\": \"Confirmar antes de iniciar\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"parar_na_confirmacao_do_uber\",\n              \"text\": \"Parar na confirmação do Uber\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"permitir_confirmar_corrida\",\n              \"text\": \"Permitir confirmar corrida\",\n              \"checked\": false\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"permitir_pagamento_automatico\",\n              \"text\": \"Permitir pagamento automático\",\n              \"checked\": false\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Pix e dúvidas\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"abrir_banco_apos_pix\",\n              \"text\": \"Abrir banco após Pix\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"finalizacao_pix_manual\",\n              \"text\": \"Finalização Pix manual\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"parar_em_caso_de_duvida\",\n              \"text\": \"Parar em caso de dúvida\",\n              \"checked\": true\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Restrições\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"exigir_tela_desbloqueada\",\n              \"text\": \"Exigir tela desbloqueada\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"exigir_internet\",\n              \"text\": \"Exigir internet\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"bateria_minima\",\n              \"hint\": \"Bateria mínima\",\n              \"input_type\": \"number\",\n              \"value\": \"20\"\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"permitir_em_chamada\",\n              \"text\": \"Permitir em chamada\",\n              \"checked\": false\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"automacao\": {\n      \"title\": \"Automação\",\n      \"subtitle\": \"Configuração da rotina Trabalho\",\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Identificação\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"automacao_nome\",\n              \"hint\": \"Nome da automação\",\n              \"value\": \"Trabalho\"\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"automacao_ativo\",\n              \"text\": \"Automação ativa\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"automacao_categoria\",\n              \"label\": \"Categoria\",\n              \"value\": \"rotina\",\n              \"options\": [\n                {\n                  \"label\": \"Rotina\",\n                  \"value\": \"rotina\"\n                },\n                {\n                  \"label\": \"Manual\",\n                  \"value\": \"manual\"\n                },\n                {\n                  \"label\": \"Teste\",\n                  \"value\": \"teste\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Destino\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"destino_nome\",\n              \"hint\": \"Nome do destino\",\n              \"value\": \"Trabalho\"\n            },\n            {\n              \"type\": \"textarea\",\n              \"key\": \"destino_endereco\",\n              \"hint\": \"Endereço\",\n              \"value\": \"Av. Exemplo, 100\",\n              \"min_lines\": 3\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"destino_referencia_uber\",\n              \"hint\": \"Referência no Uber\",\n              \"value\": \"Trabalho\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Disparos\",\n              \"variant\": \"secondary\",\n              \"action\": \"navigate\",\n              \"target\": \"disparos\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Pagamento\",\n              \"variant\": \"secondary\",\n              \"action\": \"navigate\",\n              \"target\": \"pagamento\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"disparos\": {\n      \"title\": \"Disparos\",\n      \"subtitle\": \"Manual, lista e agendamento\",\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Canais de disparo\",\n          \"children\": [\n            {\n              \"type\": \"switch\",\n              \"key\": \"disparo_manual\",\n              \"text\": \"Permitir disparo manual\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"disparo_exibir_na_lista\",\n              \"text\": \"Exibir na lista\",\n              \"checked\": true\n            },\n            {\n              \"type\": \"switch\",\n              \"key\": \"disparo_agendado\",\n              \"text\": \"Ativar agendamento\",\n              \"checked\": true\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Horário 1\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"horario_1_dias\",\n              \"hint\": \"Dias\",\n              \"value\": \"SEG\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"horario_1_hora\",\n              \"hint\": \"Hora\",\n              \"value\": \"15:00\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Horário 2\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"key\": \"horario_2_dias\",\n              \"hint\": \"Dias\",\n              \"value\": \"QUI,SEX\"\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"horario_2_hora\",\n              \"hint\": \"Hora\",\n              \"value\": \"13:00\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"pagamento\": {\n      \"title\": \"Pagamento\",\n      \"subtitle\": \"Preferência da automação Trabalho\",\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Pagamento padrão\",\n          \"children\": [\n            {\n              \"type\": \"select\",\n              \"key\": \"pagamento_tipo\",\n              \"label\": \"Tipo\",\n              \"value\": \"PIX\",\n              \"options\": [\n                {\n                  \"label\": \"PIX\",\n                  \"value\": \"PIX\"\n                },\n                {\n                  \"label\": \"Cartão\",\n                  \"value\": \"CARTAO\"\n                },\n                {\n                  \"label\": \"Dinheiro\",\n                  \"value\": \"DINHEIRO\"\n                }\n              ]\n            },\n            {\n              \"type\": \"input\",\n              \"key\": \"pagamento_referencia_uber\",\n              \"hint\": \"Referência no Uber\",\n              \"value\": \"Pix\"\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"pagamento_banco\",\n              \"label\": \"Banco\",\n              \"value\": \"Nubank\",\n              \"options\": [\n                {\n                  \"label\": \"Nubank\",\n                  \"value\": \"Nubank\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Preferências opcionais\",\n          \"subtitle\": \"Use Herdar para manter o valor global\",\n          \"children\": [\n            {\n              \"type\": \"select\",\n              \"key\": \"pref_usar_local_salvo\",\n              \"label\": \"Usar local salvo\",\n              \"value\": \"herdar\",\n              \"options\": [\n                {\n                  \"label\": \"Herdar\",\n                  \"value\": \"herdar\"\n                },\n                {\n                  \"label\": \"Sim\",\n                  \"value\": \"true\"\n                },\n                {\n                  \"label\": \"Não\",\n                  \"value\": \"false\"\n                }\n              ]\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"pref_tipo_corrida\",\n              \"label\": \"Tipo de corrida\",\n              \"value\": \"herdar\",\n              \"options\": [\n                {\n                  \"label\": \"Herdar\",\n                  \"value\": \"herdar\"\n                },\n                {\n                  \"label\": \"UberX\",\n                  \"value\": \"UberX\"\n                },\n                {\n                  \"label\": \"Comfort\",\n                  \"value\": \"Comfort\"\n                },\n                {\n                  \"label\": \"Black\",\n                  \"value\": \"Black\"\n                }\n              ]\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"pref_confirmar_antes_de_iniciar\",\n              \"label\": \"Confirmar antes de iniciar\",\n              \"value\": \"herdar\",\n              \"options\": [\n                {\n                  \"label\": \"Herdar\",\n                  \"value\": \"herdar\"\n                },\n                {\n                  \"label\": \"Sim\",\n                  \"value\": \"true\"\n                },\n                {\n                  \"label\": \"Não\",\n                  \"value\": \"false\"\n                }\n              ]\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"pref_parar_na_confirmacao_do_uber\",\n              \"label\": \"Parar na confirmação\",\n              \"value\": \"herdar\",\n              \"options\": [\n                {\n                  \"label\": \"Herdar\",\n                  \"value\": \"herdar\"\n                },\n                {\n                  \"label\": \"Sim\",\n                  \"value\": \"true\"\n                },\n                {\n                  \"label\": \"Não\",\n                  \"value\": \"false\"\n                }\n              ]\n            },\n            {\n              \"type\": \"select\",\n              \"key\": \"pref_abrir_banco_apos_pix\",\n              \"label\": \"Abrir banco após Pix\",\n              \"value\": \"herdar\",\n              \"options\": [\n                {\n                  \"label\": \"Herdar\",\n                  \"value\": \"herdar\"\n                },\n                {\n                  \"label\": \"Sim\",\n                  \"value\": \"true\"\n                },\n                {\n                  \"label\": \"Não\",\n                  \"value\": \"false\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"type\": \"button\",\n              \"text\": \"Voltar\",\n              \"variant\": \"secondary\",\n              \"action\": \"back\"\n            },\n            {\n              \"type\": \"button\",\n              \"text\": \"Salvar\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ]\n    },\n    \"runtime\": {\n      \"title\": \"Runtime\",\n      \"subtitle\": \"Somente leitura / diagnóstico\",\n      \"components\": [\n        {\n          \"type\": \"alert\",\n          \"variant\": \"info\",\n          \"title\": \"Runtime\",\n          \"text\": \"Esses campos representam estado temporário. Em geral, não devem ser editados manualmente.\"\n        },\n        {\n          \"type\": \"card\",\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"Estado atual\",\n              \"variant\": \"label\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Em execução\",\n              \"value\": \"false\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Automação atual\",\n              \"value\": \"\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Origem\",\n              \"value\": \"\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Etapa\",\n              \"value\": \"\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button\",\n          \"text\": \"Voltar\",\n          \"variant\": \"secondary\",\n          \"action\": \"back\"\n        }\n      ]\n    }\n  }\n}",
        "m_type": 2,
        "supportsInput": true,
        "supportsOutput": false
      },
