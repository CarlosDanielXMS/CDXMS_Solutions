      {
        "description": "UI mínima usada apenas quando a entrada vier vazia ou não mapeada.",
        "dictionary": {
          "entries": [],
          "isArray": false,
          "variableType": 4,
          "type": "Dictionary"
        },
        "isActionBlockWorkingVar": true,
        "isLocalVar": true,
        "isSecure": false,
        "m_booleanValue": false,
        "m_decimalValue": 0.0,
        "m_intValue": 0,
        "m_name": "Tmp_DefaultUiJson",
        "m_stringValue": "{\\\"initial_page\\\":\\\"home\\\",\\\"state\\\":{\\\"demo_nome\\\":\\\"Usuário JUIF\\\",\\\"demo_email\\\":\\\"\\\",\\\"demo_projeto\\\":\\\"Minha automação\\\",\\\"demo_tipo\\\":\\\"formulario\\\",\\\"demo_aceite\\\":false,\\\"demo_notificar\\\":true,\\\"demo_nivel\\\":\\\"intermediario\\\",\\\"demo_msg\\\":\\\"Descreva aqui o que sua interface deve fazer.\\\",\\\"lab_titulo\\\":\\\"Solicitação de aprovação\\\",\\\"lab_categoria\\\":\\\"operacional\\\",\\\"lab_prioridade\\\":\\\"media\\\",\\\"lab_confirmado\\\":false,\\\"demo_items\\\":[{\\\"title\\\":\\\"Formulário\\\",\\\"subtitle\\\":\\\"Coleta dados e retorna state.\\\",\\\"value\\\":\\\"form\\\"},{\\\"title\\\":\\\"Dashboard\\\",\\\"subtitle\\\":\\\"Mostra cards, status e listas.\\\",\\\"value\\\":\\\"dashboard\\\"},{\\\"title\\\":\\\"Confirmação\\\",\\\"subtitle\\\":\\\"Pergunta antes de uma ação sensível.\\\",\\\"value\\\":\\\"confirm\\\"}],\\\"sandbox_json\\\":\\\"{\\\\\\\"initial_page\\\\\\\":\\\\\\\"home\\\\\\\",\\\\\\\"pages\\\\\\\":{\\\\\\\"home\\\\\\\":{\\\\\\\"title\\\\\\\":\\\\\\\"Teste no Sandbox\\\\\\\",\\\\\\\"subtitle\\\\\\\":\\\\\\\"Renderização local\\\\\\\",\\\\\\\"components\\\\\\\":[{\\\\\\\"type\\\\\\\":\\\\\\\"alert\\\\\\\",\\\\\\\"variant\\\\\\\":\\\\\\\"success\\\\\\\",\\\\\\\"title\\\\\\\":\\\\\\\"Funcionou\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"Este JSON foi renderizado no sandbox.\\\\\\\"},{\\\\\\\"type\\\\\\\":\\\\\\\"button\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"Emitir evento\\\\\\\",\\\\\\\"action\\\\\\\":\\\\\\\"sandbox_action\\\\\\\"}]}}}\\\"},\\\"pages\\\":{\\\"home\\\":{\\\"title\\\":\\\"JUIF Framework\\\",\\\"subtitle\\\":\\\"Documentação profissional embutida, referência completa de componentes, sandbox e integração CDXMS.\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"success\\\",\\\"title\\\":\\\"Bem-vindo ao JUIF\\\",\\\"text\\\":\\\"Esta é a UI padrão do framework. Ela ensina como montar interfaces JSON, navegar entre páginas, coletar estado, testar componentes no sandbox e integrar eventos com macros do MacroDroid.\\\"},{\\\"type\\\":\\\"row\\\",\\\"children\\\":[{\\\"type\\\":\\\"stat_card\\\",\\\"label\\\":\\\"Componentes\\\",\\\"value\\\":\\\"21+\\\"},{\\\"type\\\":\\\"stat_card\\\",\\\"label\\\":\\\"Contrato\\\",\\\"value\\\":\\\"JSON\\\",\\\"variant\\\":\\\"info\\\"},{\\\"type\\\":\\\"stat_card\\\",\\\"label\\\":\\\"Estado\\\",\\\"value\\\":\\\"Live\\\",\\\"variant\\\":\\\"success\\\"}]},{\\\"type\\\":\\\"progress_bar\\\",\\\"label\\\":\\\"Cobertura da documentação\\\",\\\"progress\\\":100,\\\"variant\\\":\\\"success\\\"},{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"O QUE É O JUIF\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Java UI Framework para MacroDroid\\\",\\\"variant\\\":\\\"title\\\"},{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"O JUIF recebe um ui_json escapado, renderiza uma overlay Android, mantém um estado local em tempo real e publica eventos para a macro orquestradora consumir.\\\",\\\"variant\\\":\\\"body\\\"},{\\\"type\\\":\\\"row\\\",\\\"children\\\":[{\\\"type\\\":\\\"badge\\\",\\\"text\\\":\\\"Renderer\\\"},{\\\"type\\\":\\\"badge\\\",\\\"text\\\":\\\"State\\\",\\\"variant\\\":\\\"success\\\"},{\\\"type\\\":\\\"badge\\\",\\\"text\\\":\\\"Events\\\",\\\"variant\\\":\\\"info\\\"}]}]},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Índice lógico\\\",\\\"subtitle\\\":\\\"A ordem abaixo vai do básico até produção.\\\",\\\"children\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"01 · Visão geral e contrato\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"visao\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"02 · Começo rápido\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"quickstart\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"03 · Anatomia do ui_json\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"anatomia\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"04 · Navegação e páginas\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"navegacao\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"05 · Catálogo de componentes\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"componentes\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"06 · Inputs, estado e eventos\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"estado\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"07 · Layout, feedback e dados visuais\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"layout_display\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"08 · Listas dinâmicas\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"listas\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"09 · Code blocks e cópia\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"codigo\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"10 · Sandbox interativo\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"sandbox\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"11 · Integração CDXMS\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"integracao\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"12 · Receitas prontas\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"receitas\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"13 · Laboratório interativo\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"laboratorio\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"14 · Checklist de produção\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"checklist\\\"}]},{\\\"type\\\":\\\"container\\\",\\\"variant\\\":\\\"surface2\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"VARIÁVEIS DO ACTION BLOCK\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Entrada principal\\\",\\\"value\\\":\\\"Tmp_JuifUiJsonEscaped\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Fallback\\\",\\\"value\\\":\\\"Tmp_DefaultUiJson\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Estado\\\",\\\"value\\\":\\\"Tmp_JuifState\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Ação\\\",\\\"value\\\":\\\"Tmp_JuifAction\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Payload\\\",\\\"value\\\":\\\"Tmp_JuifPayload\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Resultado\\\",\\\"value\\\":\\\"Tmp_ResultJson\\\"}]},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Começar\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"visao\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Fechar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"close\\\"}]}]},\\\"visao\\\":{\\\"title\\\":\\\"01 · Visão geral e contrato\\\",\\\"subtitle\\\":\\\"Responsabilidades corretas dentro do ecossistema CDXMS.\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"info\\\",\\\"title\\\":\\\"Papel do JUIF\\\",\\\"text\\\":\\\"O JUIF é apenas o renderer de interface. Ele não lê arquivos, não grava configurações e não executa regras de negócio.\\\"},{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"SEPARAÇÃO DE RESPONSABILIDADES\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Macro\\\",\\\"value\\\":\\\"orquestra o fluxo\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"JCM\\\",\\\"value\\\":\\\"lê e escreve JSON\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"UI Builder\\\",\\\"value\\\":\\\"transforma config/schema em ui_json\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"JUIF\\\",\\\"value\\\":\\\"renderiza UI e devolve eventos\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Capability\\\",\\\"value\\\":\\\"executa função reutilizável\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Contrato universal de resposta\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"success\\\\\\\": true, \\\\\\\"status\\\\\\\": \\\\\\\"success\\\\\\\", \\\\\\\"artifact_type\\\\\\\": \\\\\\\"capability\\\\\\\", \\\\\\\"artifact_id\\\\\\\": \\\\\\\"juif\\\\\\\", \\\\\\\"operation\\\\\\\": \\\\\\\"render_ui\\\\\\\", \\\\\\\"message\\\\\\\": \\\\\\\"JUIF carregado com sucesso.\\\\\\\", \\\\\\\"data\\\\\\\": {\\\\\\\"current_page\\\\\\\": \\\\\\\"home\\\\\\\", \\\\\\\"state\\\\\\\": {}}, \\\\\\\"error\\\\\\\": null}\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"quickstart\\\"}]}]},\\\"quickstart\\\":{\\\"title\\\":\\\"02 · Começo rápido\\\",\\\"subtitle\\\":\\\"O menor JSON possível para abrir uma interface.\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"info\\\",\\\"title\\\":\\\"Fluxo básico\\\",\\\"text\\\":\\\"Crie um objeto JSON com initial_page e pages. Dentro da página, adicione components. Escape o JSON e passe para Tmp_JuifUiJsonEscaped.\\\"},{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"PASSO A PASSO\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"1\\\",\\\"value\\\":\\\"Monte um JSON válido\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"2\\\",\\\"value\\\":\\\"Valide o parse\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"3\\\",\\\"value\\\":\\\"Escape para String Java\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"4\\\",\\\"value\\\":\\\"Passe em Tmp_JuifUiJsonEscaped\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"5\\\",\\\"value\\\":\\\"Leia Tmp_JuifAction e Tmp_JuifPayload\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"UI mínima\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"initial_page\\\\\\\": \\\\\\\"home\\\\\\\", \\\\\\\"pages\\\\\\\": {\\\\\\\"home\\\\\\\": {\\\\\\\"title\\\\\\\": \\\\\\\"Minha UI\\\\\\\", \\\\\\\"subtitle\\\\\\\": \\\\\\\"Exemplo mínimo\\\\\\\", \\\\\\\"components\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"text\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"body\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Olá, JUIF!\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Fechar\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"ghost\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"close\\\\\\\"}]}}}\\\"},{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"warning\\\",\\\"title\\\":\\\"Atenção ao escape\\\",\\\"text\\\":\\\"Quando o JSON for inserido dentro do código Java como texto, aspas internas precisam estar escapadas. Use o code_block ou o sandbox para copiar a versão escapada.\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"anatomia\\\"}]}]},\\\"anatomia\\\":{\\\"title\\\":\\\"03 · Anatomia do ui_json\\\",\\\"subtitle\\\":\\\"Estrutura oficial usada pelo renderer.\\\",\\\"components\\\":[{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"RAIZ\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"initial_page\\\",\\\"value\\\":\\\"id da primeira página\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"state\\\",\\\"value\\\":\\\"valores iniciais opcionais\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"pages\\\",\\\"value\\\":\\\"objeto de páginas por id\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Estrutura recomendada\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"initial_page\\\\\\\": \\\\\\\"home\\\\\\\", \\\\\\\"state\\\\\\\": {\\\\\\\"nome\\\\\\\": \\\\\\\"\\\\\\\", \\\\\\\"ativo\\\\\\\": true}, \\\\\\\"pages\\\\\\\": {\\\\\\\"home\\\\\\\": {\\\\\\\"title\\\\\\\": \\\\\\\"Título\\\\\\\", \\\\\\\"subtitle\\\\\\\": \\\\\\\"Subtítulo\\\\\\\", \\\\\\\"components\\\\\\\": []}}}\\\"},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Objeto page\\\",\\\"children\\\":[{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"title\\\",\\\"value\\\":\\\"Título visual da página\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"subtitle\\\",\\\"value\\\":\\\"Descrição curta\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"components\\\",\\\"value\\\":\\\"Array de nodes renderizáveis\\\"}]},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Objeto component\\\",\\\"children\\\":[{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"type\\\",\\\"value\\\":\\\"tipo do componente\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"key\\\",\\\"value\\\":\\\"chave usada no state\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"children\\\",\\\"value\\\":\\\"componentes filhos\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"action\\\",\\\"value\\\":\\\"evento emitido\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"target\\\",\\\"value\\\":\\\"página de destino\\\"}]},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"navegacao\\\"}]}]},\\\"navegacao\\\":{\\\"title\\\":\\\"04 · Navegação e páginas\\\",\\\"subtitle\\\":\\\"Como montar fluxos com várias telas.\\\",\\\"components\\\":[{\\\"type\\\":\\\"card\\\",\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"AÇÕES INTERNAS\\\",\\\"variant\\\":\\\"label\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"navigate\\\",\\\"value\\\":\\\"abre target e empilha histórico\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"replace\\\",\\\"value\\\":\\\"abre target sem empilhar\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"back\\\",\\\"value\\\":\\\"volta para a página anterior\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"close\\\",\\\"value\\\":\\\"fecha a overlay\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"title\\\":\\\"Botões de navegação\\\",\\\"language\\\":\\\"json\\\",\\\"auto_indent\\\":true,\\\"code\\\":\\\"{\\\\\\\"type\\\\\\\": \\\\\\\"button_group\\\\\\\", \\\\\\\"buttons\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Detalhes\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"navigate\\\\\\\", \\\\\\\"target\\\\\\\": \\\\\\\"detalhes\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Home\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"secondary\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"replace\\\\\\\", \\\\\\\"target\\\\\\\": \\\\\\\"home\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Voltar\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"ghost\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"back\\\\\\\"}]}\\\"},{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"warning\\\",\\\"title\\\":\\\"Target inexistente\\\",\\\"text\\\":\\\"Se o target não existir em pages, o JUIF emite navigation_error com o target solicitado.\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Voltar\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"back\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Home\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"home\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Próximo\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"navigate\\\",\\\"target\\\":\\\"componentes\\\"}]}]},\\\"componentes\\\":{\\\"title\\\":\\\"05 · Catálogo de componentes\\\",\\\"subtitle\\\":\\\"Referência rápida dos tipos suportados.\\\",\\\"components\\\":[{\\\"type\\\":\\\"dynamic_list\\\",\\\"items\\\":[{\\\"title\\\":\\\"text\\\",\\\"subtitle\\\":\\\"Texto com variants: title, subtitle, label, body, muted, success, warning, error e info.\\\",\\\"value\\\":\\\"text\\\"},{\\\"title\\\":\\\"button / button_group\\\",\\\"subtitle\\\":\\\"Ações, navegação, confirmação e eventos customizados.\\\",\\\"value\\\":\\\"button\\\"},{\\\"title\\\":\\\"input / textarea\\\",\\\"subtitle\\\":\\\"Campos de texto com key e atualização automática do state.\\\",\\\"value\\\":\\\"input\\\"},{\\\"title\\\":\\\"checkbox / switch\\\",\\\"subtitle\\\":\\\"Valores booleanos no state.\\\",\\\"value\\\":\\\"boolean\\\"},{\\\"title\\\":\\\"select / radio_group\\\",\\\"subtitle\\\":\\\"Escolhas controladas por options. Aceitam objetos ou strings simples.\\\",\\\"value\\\":\\\"choice\\\"},{\\\"title\\\":\\\"card / section / container / row / column\\\",\\\"subtitle\\\":\\\"Layout e agrupamento visual.\\\",\\\"value\\\":\\\"layout\\\"},{\\\"title\\\":\\\"spacer / divider\\\",\\\"subtitle\\\":\\\"Espaçamento e separação visual.\\\",\\\"value\\\":\\\"structure\\\"},{\\\"title\\\":\\\"alert / badge / key_value\\\",\\\"subtitle\\\":\\\"Feedback e informações pontuais.\\\",\\\"value\\\":\\\"display\\\"},{\\\"title\\\":\\\"stat_card / progress_bar\\\",\\\"subtitle\\\":\\