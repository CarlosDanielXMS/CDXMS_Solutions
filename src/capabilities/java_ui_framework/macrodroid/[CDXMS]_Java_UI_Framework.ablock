      {
        "blockNextAction": true,
        "consoleVariableName": "",
        "responseVariableName": "Tmp_ResultJson",
        "runInBackgroundThread": false,
        "scriptText": "import android.view.*;\nimport android.view.WindowManager;\nimport android.view.inputmethod.InputMethodManager;\nimport android.view.inputmethod.EditorInfo;\nimport android.content.Context;\nimport android.provider.Settings;\nimport android.content.ClipData;\nimport android.content.ClipboardManager;\nimport android.graphics.*;\nimport android.graphics.drawable.*;\nimport android.content.res.ColorStateList;\nimport android.widget.*;\nimport android.text.*;\nimport org.json.*;\n\nfinal WindowManager wm = (WindowManager) appContext.getSystemService(Context.WINDOW_SERVICE);\n\n/* =========================\n   THEME\n========================= */\n\nfinal int JUIF_BG = 0xFF090A0C;\nfinal int JUIF_OVERLAY = 0xE6000000;\nfinal int JUIF_SURFACE = 0xFF111318;\nfinal int JUIF_SURFACE_2 = 0xFF181B22;\nfinal int JUIF_SURFACE_3 = 0xFF222631;\nfinal int JUIF_SURFACE_ELEVATED = 0xFF292E39;\nfinal int JUIF_PRIMARY = 0xFFD6A536;\nfinal int JUIF_PRIMARY_DARK = 0xFF9E7524;\nfinal int JUIF_PRIMARY_SOFT = 0x332F2818;\nfinal int JUIF_TEXT = 0xFFF4F1E8;\nfinal int JUIF_TEXT_MUTED = 0xFF9B9A94;\nfinal int JUIF_TEXT_DISABLED = 0xFF686A70;\nfinal int JUIF_BORDER = 0xFF2B2F38;\nfinal int JUIF_DIVIDER = 0xFF242832;\nfinal int JUIF_ERROR = 0xFFE35D5D;\nfinal int JUIF_SUCCESS = 0xFF4CAF7D;\nfinal int JUIF_WARNING = 0xFFFFC857;\nfinal int JUIF_INFO = 0xFF5DADE2;\n\n/* =========================\n   RUNTIME\n========================= */\n\nfinal JSONObject juifState = new JSONObject();\n\nJSONObject juifPages = null;\nString juifCurrentPageId = \"\";\nJSONArray juifNavigationStack = new JSONArray();\n\nFrameLayout juifOverlay = null;\nLinearLayout juifRootContainer = null;\nLinearLayout juifTopHost = null;\nLinearLayout juifTabHost = null;\nLinearLayout juifBodyContainer = null;\nLinearLayout juifRailHost = null;\nScrollView juifContentScroll = null;\nLinearLayout juifPageContainer = null;\nLinearLayout juifBottomHost = null;\nFrameLayout juifDrawerLayer = null;\nLinearLayout juifDrawerPanel = null;\nView juifDrawerScrim = null;\nJSONObject juifDrawerNode = null;\nJSONObject juifShell = null;\n\n/* =========================\n   OUTPUT\n========================= */\n\nvoid juifSetString(String name, String value) {\n    try {\n        variableSetter.setString(name, value == null ? \"\" : value);\n    } catch(Exception ignored) {}\n}\n\nvoid juifSetBoolean(String name, boolean value) {\n    try {\n        variableSetter.setBoolean(name, value);\n    } catch(Exception ignored) {}\n}\n\nJSONObject juifResult(boolean success, String status, String message, JSONObject data, JSONObject error) {\n    JSONObject result = new JSONObject();\n\n    try {\n        JSONObject safeData = data == null ? new JSONObject() : data;\n        JSONObject meta = new JSONObject();\n        meta.put(\"source\", \"[CDXMS] Java UI Framework\");\n        meta.put(\"version\", \"1.0.0\");\n        meta.put(\"component_catalog_version\", \"1.0.0\");\n\n        result.put(\"schema_version\", 1);\n        result.put(\"namespace\", \"CDXMS\");\n        result.put(\"success\", success);\n        result.put(\"status\", status == null || status.length() == 0 ? (success ? \"success\" : \"error\") : status);\n        result.put(\"artifact_type\", \"capability\");\n        result.put(\"artifact_id\", \"java_ui_framework\");\n        result.put(\"operation\", \"render_ui\");\n        result.put(\"message\", message == null ? \"\" : message);\n        result.put(\"data\", safeData);\n        result.put(\"error\", error == null ? JSONObject.NULL : error);\n        result.put(\"meta\", meta);\n    } catch(Exception ignored) {}\n\n    return result;\n}\n\nJSONObject juifError(String code, String message, JSONObject details, boolean recoverable) {\n    JSONObject error = new JSONObject();\n    try {\n        error.put(\"code\", code == null || code.length() == 0 ? \"UNKNOWN_ERROR\" : code);\n        error.put(\"message\", message == null ? \"Erro desconhecido.\" : message);\n        error.put(\"details\", details == null ? new JSONObject() : details);\n        error.put(\"recoverable\", recoverable);\n    } catch(Exception ignored) {}\n    return error;\n}\n\nvoid juifPublishResult(JSONObject result) {\n    juifSetString(\"Tmp_ResultJson\", result.toString());\n}\n\n/* =========================\n   HELPERS\n========================= */\n\nint dp(int v) {\n    return (int)(v * appContext.getResources().getDisplayMetrics().density);\n}\n\nint juifVariantColor(String variant) {\n    if (\"error\".equals(variant) || \"danger\".equals(variant)) return JUIF_ERROR;\n    if (\"success\".equals(variant)) return JUIF_SUCCESS;\n    if (\"warning\".equals(variant)) return JUIF_WARNING;\n    if (\"info\".equals(variant)) return JUIF_INFO;\n    return JUIF_PRIMARY;\n}\n\nGradientDrawable juifBg(int color, int radius) {\n    GradientDrawable g = new GradientDrawable();\n    g.setColor(color);\n    g.setCornerRadius(dp(radius));\n    return g;\n}\n\nGradientDrawable juifBgStroke(int color, int radius, int strokeColor, int stroke) {\n    GradientDrawable g = juifBg(color, radius);\n    g.setStroke(dp(stroke), strokeColor);\n    return g;\n}\n\nTextView juifText(String value, float size, int color, int style) {\n    TextView t = new TextView(appContext);\n    t.setText(value == null ? \"\" : value);\n    t.setTextSize(size);\n    t.setTextColor(color);\n    t.setTypeface(Typeface.create(\"sans-serif\", style));\n    t.setIncludeFontPadding(true);\n    return t;\n}\n\nTextView juifMonoText(String value, float size, int color, int style) {\n    TextView t = juifText(value, size, color, style);\n    t.setTypeface(Typeface.MONOSPACE, style);\n    return t;\n}\n\nSpace juifSpace(int h) {\n    Space s = new Space(appContext);\n    s.setLayoutParams(new LinearLayout.LayoutParams(1, dp(h)));\n    return s;\n}\n\nLinearLayout.LayoutParams juifLpFull() {\n    return new LinearLayout.LayoutParams(\n        LinearLayout.LayoutParams.MATCH_PARENT,\n        LinearLayout.LayoutParams.WRAP_CONTENT\n    );\n}\n\nvoid juifApplyVerticalMargin(View v, int top, int bottom) {\n    LinearLayout.LayoutParams lp = juifLpFull();\n    lp.setMargins(0, dp(top), 0, dp(bottom));\n    v.setLayoutParams(lp);\n}\n\nint juifColorWithAlpha(int color, int alpha) {\n    int safeAlpha = Math.max(0, Math.min(255, alpha));\n    return (color & 0x00FFFFFF) | (safeAlpha << 24);\n}\n\nDrawable juifPressableBackground(int color, int radius, int strokeColor, int stroke) {\n    GradientDrawable content = juifBgStroke(color, radius, strokeColor, stroke);\n    if (android.os.Build.VERSION.SDK_INT >= 21) {\n        return new RippleDrawable(\n            ColorStateList.valueOf(juifColorWithAlpha(JUIF_PRIMARY, 44)),\n            content,\n            null\n        );\n    }\n    return content;\n}\n\nvoid juifApplyElevation(View view, float elevationDp) {\n    try {\n        if (android.os.Build.VERSION.SDK_INT >= 21) {\n            view.setElevation(dp((int)elevationDp));\n        }\n    } catch(Exception ignored) {}\n}\n\nboolean juifJsonArrayContains(JSONArray values, String expected) {\n    try {\n        if (values == null || expected == null) return false;\n        for (int i = 0; i < values.length(); i++) {\n            if (expected.equals(String.valueOf(values.opt(i)))) return true;\n        }\n    } catch(Exception ignored) {}\n    return false;\n}\n\nboolean juifVisibleOnPage(JSONObject node, String pageId) {\n    try {\n        JSONArray visiblePages = node.optJSONArray(\"visible_pages\");\n        if (visiblePages != null && visiblePages.length() > 0 && !juifJsonArrayContains(visiblePages, pageId)) {\n            return false;\n        }\n\n        JSONArray hiddenPages = node.optJSONArray(\"hidden_pages\");\n        if (hiddenPages != null && juifJsonArrayContains(hiddenPages, pageId)) {\n            return false;\n        }\n    } catch(Exception ignored) {}\n    return true;\n}\n\nboolean juifNavigationItemSelected(JSONObject item, String itemId, String selected, String pageId) {\n    try {\n        String target = item.optString(\"target\", \"\");\n        if (target.length() > 0 && target.equals(pageId)) return true;\n\n        JSONArray activePages = item.optJSONArray(\"active_pages\");\n        if (activePages != null && juifJsonArrayContains(activePages, pageId)) return true;\n\n        String activePrefix = item.optString(\"active_prefix\", \"\");\n        if (activePrefix.length() > 0 && pageId != null && pageId.startsWith(activePrefix)) return true;\n\n        return itemId != null && itemId.equals(selected);\n    } catch(Exception ignored) {\n        return itemId != null && itemId.equals(selected);\n    }\n}\n\nJSONObject juifCloneObject(JSONObject source) {\n    try {\n        return source == null ? new JSONObject() : new JSONObject(source.toString());\n    } catch(Exception ignored) {\n        return new JSONObject();\n    }\n}\n\nView juifDividerView() {\n    View divider = new View(appContext);\n    divider.setBackgroundColor(JUIF_DIVIDER);\n    divider.setLayoutParams(new LinearLayout.LayoutParams(\n        LinearLayout.LayoutParams.MATCH_PARENT,\n        dp(1)\n    ));\n    return divider;\n}\n\nTextView juifNavigationGlyph(String value, boolean selected) {\n    TextView glyph = juifText(\n        value == null ? \"\" : value,\n        17f,\n        selected ? JUIF_PRIMARY : JUIF_TEXT_MUTED,\n        Typeface.BOLD\n    );\n    glyph.setGravity(Gravity.CENTER);\n    return glyph;\n}\n\nvoid juifStyleChipView(TextView chip, boolean selected) {\n    chip.setTextColor(selected ? JUIF_PRIMARY : JUIF_TEXT_MUTED);\n    chip.setTypeface(Typeface.create(\"sans-serif-medium\", selected ? Typeface.BOLD : Typeface.NORMAL));\n    chip.setBackground(\n        juifPressableBackground(\n            selected ? juifColorWithAlpha(JUIF_PRIMARY, 28) : JUIF_SURFACE_2,\n            999,\n            selected ? JUIF_PRIMARY_DARK : JUIF_BORDER,\n            1\n        )\n    );\n}\n\n\nString juifRepeat(String value, int count) {\n    String out = \"\";\n\n    for (int i = 0; i < count; i++) {\n        out += value;\n    }\n\n    return out;\n}\n\nString juifPrettyCode(String raw) {\n    try {\n        if (raw == null) return \"\";\n\n        String value = raw.trim();\n\n        if (value.length() == 0) return \"\";\n\n        if (value.startsWith(\"{\")) {\n            return new JSONObject(value).toString(2);\n        }\n\n        if (value.startsWith(\"[\")) {\n            return new JSONArray(value).toString(2);\n        }\n\n        String[] lines = value.replace(\"\\r\", \"\").split(\"\\n\");\n        StringBuilder out = new StringBuilder();\n\n        int indent = 0;\n\n        for (int i = 0; i < lines.length; i++) {\n            String line = lines[i].trim();\n\n            if (\n                line.startsWith(\"}\") ||\n                line.startsWith(\"]\") ||\n                line.startsWith(\")\") ||\n                line.startsWith(\"</\")\n            ) {\n                indent = Math.max(0, indent - 1);\n            }\n\n            out.append(juifRepeat(\"  \", indent));\n            out.append(line);\n\n            if (i < lines.length - 1) {\n                out.append(\"\\n\");\n            }\n\n            if (\n                line.endsWith(\"{\") ||\n                line.endsWith(\"[\") ||\n                line.endsWith(\"(\")\n            ) {\n                indent++;\n            }\n        }\n\n        return out.toString();\n\n    } catch(Exception ignored) {\n        return raw == null ? \"\" : raw;\n    }\n}\n\nString juifEscapeJavaString(String raw) {\n    try {\n        if (raw == null) return \"\";\n\n        return raw\n            .replace(\"\\\\\", \"\\\\\\\\\")\n            .replace(\"\\\"\", \"\\\\\\\"\")\n            .replace(\"\\r\", \"\\\\r\")\n            .replace(\"\\n\", \"\\\\n\")\n            .replace(\"\\t\", \"\\\\t\");\n\n    } catch(Exception ignored) {\n        return raw == null ? \"\" : raw;\n    }\n}\n\nString juifUnescapeBasic(String raw) {\n    try {\n        if (raw == null) return \"\";\n\n        return raw\n            .replace(\"\\\\n\", \"\\n\")\n            .replace(\"\\\\r\", \"\\r\")\n            .replace(\"\\\\t\", \"\\t\")\n            .replace(\"\\\\\\\"\", \"\\\"\")\n            .replace(\"\\\\\\\\\", \"\\\\\");\n\n    } catch(Exception ignored) {\n        return raw == null ? \"\" : raw;\n    }\n}\n\nvoid juifCopyToClipboard(String label, String value) {\n    try {\n        ClipboardManager clipboard =\n            (ClipboardManager) appContext.getSystemService(Context.CLIPBOARD_SERVICE);\n\n        if (clipboard != null) {\n            ClipData clip = ClipData.newPlainText(label == null ? \"JUIF\" : label, value == null ? \"\" : value);\n            clipboard.setPrimaryClip(clip);\n            Toast.makeText(appContext, \"Copiado.\", Toast.LENGTH_SHORT).show();\n        }\n    } catch(Exception ignored) {}\n}\n\nString juifTemplate(String template, JSONObject item) {\n    try {\n        if (template == null) return \"\";\n\n        String result = template;\n        JSONArray names = item.names();\n\n        if (names != null) {\n            for (int i = 0; i < names.length(); i++) {\n                String name = names.getString(i);\n                Object value = item.opt(name);\n\n                result = result.replace(\n                    \"{{\" + name + \"}}\",\n                    value == null || value == JSONObject.NULL ? \"\" : String.valueOf(value)\n                );\n            }\n        }\n\n        return result;\n\n    } catch(Exception ignored) {\n        return template == null ? \"\" : template;\n    }\n}\n\nObject juifApplyTemplateValue(Object value, JSONObject item) throws Exception {\n    if (value instanceof String) {\n        return juifTemplate(String.valueOf(value), item);\n    }\n\n    if (value instanceof JSONObject) {\n        JSONObject source = (JSONObject) value;\n        JSONObject out = new JSONObject();\n\n        JSONArray names = source.names();\n\n        if (names != null) {\n            for (int i = 0; i < names.length(); i++) {\n                String name = names.getString(i);\n                out.put(name, juifApplyTemplateValue(source.get(name), item));\n            }\n        }\n\n        return out;\n    }\n\n    if (value instanceof JSONArray) {\n        JSONArray source = (JSONArray) value;\n        JSONArray out = new JSONArray();\n\n        for (int i = 0; i < source.length(); i++) {\n            out.put(juifApplyTemplateValue(source.get(i), item));\n        }\n\n        return out;\n    }\n\n    return value;\n}\n\nJSONObject juifApplyTemplateNode(JSONObject template, JSONObject item) throws Exception {\n    return (JSONObject) juifApplyTemplateValue(template, item);\n}\n\n/* =========================\n   STATE / EVENTS\n========================= */\n\nvoid juifSetStateValue(String key, Object value) {\n    try {\n        if (key == null || key.trim().length() == 0) return;\n\n        juifState.put(key, value == null ? JSONObject.NULL : value);\n        juifSetString(\"Tmp_JuifState\", juifState.toString());\n    } catch(Exception ignored) {}\n}\n\nJSONObject juifCloneState() throws Exception {\n    return new JSONObject(juifState.toString());\n}\n\nJSONObject juifBasePayload(String action) throws Exception {\n    JSONObject payload = new JSONObject();\n    payload.put(\"action\", action);\n    payload.put(\"current_page\", juifCurrentPageId);\n    payload.put(\"state\", juifCloneState());\n    return payload;\n}\n\nvoid juifEmit(String action, JSONObject extra) {\n    try {\n        JSONObject payload = juifBasePayload(action);\n\n        if (extra != null) {\n            JSONArray names = extra.names();\n\n            if (names != null) {\n                for (int i = 0; i < names.length(); i++) {\n                    String name = names.getString(i);\n                    payload.put(name, extra.get(name));\n                }\n            }\n        }\n\n        juifSetString(\"Tmp_JuifAction\", action);\n        juifSetString(\"Tmp_JuifPayload\", payload.toString());\n        juifSetBoolean(\"Tmp_JuifClicked\", true);\n\n        JSONObject data = new JSONObject();\n        data.put(\"action\", action);\n        data.put(\"payload\", payload);\n\n        juifPublishResult(\n            juifResult(true, \"success\", \"Evento emitido.\", data, null)\n        );\n    } catch(Exception ignored) {}\n}\n\nvoid juifEmitSimple(String action) {\n    juifEmit(action, null);\n}\n\nvoid juifCloseOverlay(final View targetOverlay) {\n    try {\n        if (targetOverlay == null) return;\n\n        targetOverlay.animate()\n            .alpha(0f)\n            .setDuration(160)\n            .withEndAction(new Runnable() {\n                public void run() {\n                    try {\n                        wm.removeView(targetOverlay);\n                    } catch(Exception ignored) {}\n\n                    juifSetBoolean(\"Tmp_JuifVisible\", false);\n                    juifEmitSimple(\"closed\");\n                }\n            });\n    } catch(Exception ignored) {}\n}\n\nvoid juifDispatchAction(String action, String target, JSONObject extra) {\n    try {\n        String safeAction = action == null ? \"\" : action;\n        String safeTarget = target == null ? \"\" : target;\n\n        if (\"open_drawer\".equals(safeAction)) { juifOpenDrawer(); return; }\n        if (\"close_drawer\".equals(safeAction)) { juifCloseDrawer(true); return; }\n        if (\"navigate\".equals(safeAction)) { juifCloseDrawer(false); juifNavigateTo(safeTarget); return; }\n        if (\"replace\".equals(safeAction)) { juifCloseDrawer(false); juifReplaceWith(safeTarget); return; }\n        if (\"back\".equals(safeAction)) { juifCloseDrawer(false); juifNavigateBack(); return; }\n        if (\"close\".equals(safeAction)) { juifCloseDrawer(false); juifCloseOverlay(juifOverlay); return; }\n\n        juifEmit(safeAction.length() == 0 ? \"action\" : safeAction, extra);\n    } catch(Exception ignored) {}\n}\n\nvoid juifCloseDrawer(boolean emitEvent) {\n    try {\n        if (juifDrawerLayer == null || juifDrawerLayer.getVisibility() != View.VISIBLE) return;\n\n        final boolean shouldEmit = emitEvent;\n        final LinearLayout panel = juifDrawerPanel;\n        final View scrim = juifDrawerScrim;\n\n        if (panel == null) {\n            juifDrawerLayer.setVisibility(View.GONE);\n            juifDrawerLayer.removeAllViews();\n            if (shouldEmit) juifEmitSimple(\"drawer_closed\");\n            return;\n        }\n\n        int width = panel.getWidth() > 0 ? panel.getWidth() : dp(304);\n        panel.animate().translationX(-width).setDuration(180);\n        if (scrim != null) scrim.animate().alpha(0f).setDuration(180);\n\n        panel.animate().withEndAction(new Runnable() {\n            public void run() {\n                try {\n                    juifDrawerLayer.setVisibility(View.GONE);\n                    juifDrawerLayer.removeAllViews();\n                    juifDrawerPanel = null;\n                    juifDrawerScrim = null;\n                    if (shouldEmit) juifEmitSimple(\"drawer_closed\");\n                } catch(Exception ignored) {}\n            }\n        });\n    } catch(Exception ignored) {}\n}\n\nvoid juifOpenDrawer() {\n    try {\n        if (juifDrawerLayer == null || juifDrawerNode == null) {\n            juifEmitSimple(\"drawer_unavailable\");\n            return;\n        }\n\n        juifDrawerLayer.removeAllViews();\n        juifDrawerLayer.setVisibility(View.VISIBLE);\n        juifDrawerLayer.bringToFront();\n\n        juifDrawerScrim = new View(appContext);\n        juifDrawerScrim.setBackgroundColor(juifColorWithAlpha(Color.BLACK, 188));\n        juifDrawerScrim.setAlpha(0f);\n        juifDrawerScrim.setOnClickListener(new View.OnClickListener() {\n            public void onClick(View v) {\n                juifCloseDrawer(true);\n            }\n        });\n\n        juifDrawerLayer.addView(\n            juifDrawerScrim,\n            new FrameLayout.LayoutParams(\n                FrameLayout.LayoutParams.MATCH_PARENT,\n                FrameLayout.LayoutParams.MATCH_PARENT\n            )\n        );\n\n        juifDrawerPanel = JUIFNavigationDrawer(juifDrawerNode);\n        int screenWidth = appContext.getResources().getDisplayMetrics().widthPixels;\n        int preferredWidth = dp(juifDrawerNode.optInt(\"width\", 304));\n        int maxWidth = (int)(screenWidth * 0.88f);\n        int panelWidth = Math.min(preferredWidth, maxWidth);\n\n        FrameLayout.LayoutParams panelLp = new FrameLayout.LayoutParams(\n            panelWidth,\n            FrameLayout.LayoutParams.MATCH_PARENT,\n            Gravity.START\n        );\n        juifDrawerLayer.addView(juifDrawerPanel, panelLp);\n\n        juifDrawerPanel.setTranslationX(-panelWidth);\n        juifDrawerPanel.animate().translationX(0f).setDuration(210);\n        juifDrawerScrim.animate().alpha(1f).setDuration(210);\n\n        juifEmitSimple(\"drawer_opened\");\n    } catch(Exception e) {\n        try {\n            JSONObject details = new JSONObject();\n            details.put(\"reason\", String.valueOf(e.getMessage()));\n            juifEmit(\"drawer_error\", details);\n        } catch(Exception ignored) {}\n    }\n}\n\nvoid juifClearHost(LinearLayout host) {\n    if (host == null) return;\n    host.removeAllViews();\n    host.setVisibility(View.GONE);\n}\n\nvoid juifRenderShell(JSONObject page) throws Exception {\n    juifClearHost(juifTopHost);\n    juifClearHost(juifTabHost);\n    juifClearHost(juifRailHost);\n    juifClearHost(juifBottomHost);\n    juifDrawerNode = null;\n\n    if (juifShell == null) return;\n\n    JSONObject topBar = juifShell.optJSONObject(\"top_app_bar\");\n    if (topBar != null && juifVisibleOnPage(topBar, juifCurrentPageId)) {\n        JSONObject resolvedTopBar = juifCloneObject(topBar);\n        if (resolvedTopBar.optBoolean(\"use_page_title\", false)) {\n            resolvedTopBar.put(\"title\", page.optString(\"title\", resolvedTopBar.optString(\"title\", \"JUIF\")));\n            resolvedTopBar.put(\"subtitle\", page.optString(\"subtitle\", resolvedTopBar.optString(\"subtitle\", \"\")));\n        }\n        juifTopHost.addView(JUIFTopAppBar(resolvedTopBar));\n        juifTopHost.setVisibility(View.VISIBLE);\n    }\n\n    JSONObject tabBar = juifShell.optJSONObject(\"tab_bar\");\n    if (tabBar != null && juifVisibleOnPage(tabBar, juifCurrentPageId)) {\n        juifTabHost.addView(JUIFTabBar(tabBar));\n        juifTabHost.setVisibility(View.VISIBLE);\n    }\n\n    JSONObject rail = juifShell.optJSONObject(\"navigation_rail\");\n    if (rail != null && juifVisibleOnPage(rail, juifCurrentPageId)) {\n        juifRailHost.addView(JUIFNavigationRail(rail));\n        juifRailHost.setVisibility(View.VISIBLE);\n    }\n\n    JSONObject bottomBar = juifShell.optJSONObject(\"bottom_navigation\");\n    if (bottomBar != null && juifVisibleOnPage(bottomBar, juifCurrentPageId)) {\n        juifBottomHost.addView(JUIFBottomNavigation(bottomBar));\n        juifBottomHost.setVisibility(View.VISIBLE);\n    }\n\n    JSONObject drawer = juifShell.optJSONObject(\"navigation_drawer\");\n    if (drawer != null && juifVisibleOnPage(drawer, juifCurrentPageId)) {\n        juifDrawerNode = juifCloneObject(drawer);\n    }\n}\n\n\nboolean juifArrayContains(JSONArray values, String expected) {\n    try {\n        if (values == null) return false;\n        for (int i = 0; i < values.length(); i++) {\n            if (expected.equals(String.valueOf(values.opt(i)))) return true;\n        }\n    } catch(Exception ignored) {}\n    return false;\n}\n\nString juifSelectedValue(JSONObject node, String fallback) {\n    try {\n        String key = node.optString(\"key\", \"\");\n        if (key.length() > 0 && juifState.has(key)) return String.valueOf(juifState.opt(key));\n        String selected = node.optString(\"selected\", fallback == null ? \"\" : fallback);\n        if (selected.length() > 0) return selected;\n    } catch(Exception ignored) {}\n    return fallback == null ? \"\" : fallback;\n}\n\n/* =========================\n   NAVIGATION\n========================= */\n\nboolean juifHasPage(String pageId) {\n    return pageId != null\n        && pageId.length() > 0\n        && juifPages != null\n        && juifPages.has(pageId);\n}\n\nvoid juifRenderPage(String pageId) {\n    try {\n        if (juifPageContainer == null) return;\n\n        if (!juifHasPage(pageId)) {\n            juifPageContainer.removeAllViews();\n            juifPageContainer.addView(\n                juifText(\"Página não encontrada: \" + pageId, 15f, JUIF_ERROR, Typeface.BOLD)\n            );\n            return;\n        }\n\n        juifCurrentPageId = pageId;\n        JSONObject page = juifPages.getJSONObject(pageId);\n\n        juifPageContainer.removeAllViews();\n        juifRenderShell(page);\n\n        boolean showHeader = page.optBoolean(\"show_header\", true);\n        if (showHeader) {\n            TextView eyebrow = juifText(\n                page.optString(\"eyebrow\", \"JUIF\"),\n                11f,\n                JUIF_PRIMARY,\n                Typeface.BOLD\n            );\n            eyebrow.setLetterSpacing(0.12f);\n            juifPageContainer.addView(eyebrow);\n            juifPageContainer.addView(juifSpace(7));\n\n            TextView title = juifText(\n                page.optString(\"title\", \"JUIF\"),\n                26f,\n                JUIF_TEXT,\n                Typeface.BOLD\n            );\n            juifPageContainer.addView(title);\n\n            String subtitleValue = page.optString(\"subtitle\", \"\");\n            if (subtitleValue.length() > 0) {\n                TextView subtitle = juifText(\n                    subtitleValue,\n                    14f,\n                    JUIF_TEXT_MUTED,\n                    Typeface.NORMAL\n                );\n                subtitle.setLineSpacing(0f, 1.08f);\n                subtitle.setPadding(0, dp(5), 0, 0);\n                juifPageContainer.addView(subtitle);\n            }\n\n            juifPageContainer.addView(juifSpace(18));\n        }\n\n        JSONArray components = page.optJSONArray(\"components\");\n        if (components != null) {\n            for (int i = 0; i < components.length(); i++) {\n                juifPageContainer.addView(juifRenderNode(components.getJSONObject(i)));\n            }\n        }\n\n        juifSetString(\"Tmp_JuifCurrentPage\", juifCurrentPageId);\n\n        if (juifContentScroll != null) {\n            juifContentScroll.post(new Runnable() {\n                public void run() {\n                    try { juifContentScroll.scrollTo(0, 0); } catch(Exception ignored) {}\n                }\n            });\n        }\n\n    } catch(Exception e) {\n        try {\n            juifPageContainer.removeAllViews();\n            LinearLayout errorBox = new LinearLayout(appContext);\n            errorBox.setOrientation(LinearLayout.VERTICAL);\n            errorBox.setPadding(dp(18), dp(18), dp(18), dp(18));\n            errorBox.setBackground(juifBgStroke(JUIF_SURFACE, 22, JUIF_ERROR, 1));\n            errorBox.addView(juifText(\"Falha ao renderizar esta página\", 17f, JUIF_ERROR, Typeface.BOLD));\n            errorBox.addView(juifSpace(6));\n            errorBox.addView(juifText(String.valueOf(e.getMessage()), 13f, JUIF_TEXT_MUTED, Typeface.NORMAL));\n            juifPageContainer.addView(errorBox);\n        } catch(Exception ignored) {}\n    }\n}\n\nvoid juifNavigateTo(String target) {\n    try {\n        if (!juifHasPage(target)) {\n            JSONObject extra = new JSONObject();\n            extra.put(\"target\", target);\n            juifEmit(\"navigation_error\", extra);\n            return;\n        }\n\n        if (juifCurrentPageId != null && juifCurrentPageId.length() > 0) {\n            juifNavigationStack.put(juifCurrentPageId);\n        }\n\n        juifRenderPage(target);\n\n        JSONObject extra = new JSONObject();\n        extra.put(\"page\", target);\n\n        juifEmit(\"navigated\", extra);\n    } catch(Exception ignored) {}\n}\n\nvoid juifReplaceWith(String target) {\n    try {\n        if (!juifHasPage(target)) {\n            JSONObject extra = new JSONObject();\n            extra.put(\"target\", target);\n            juifEmit(\"navigation_error\", extra);\n            return;\n        }\n\n        juifRenderPage(target);\n\n        JSONObject extra = new JSONObject();\n        extra.put(\"page\", target);\n\n        juifEmit(\"replaced\", extra);\n    } catch(Exception ignored) {}\n}\n\nvoid juifNavigateBack() {\n    try {\n        if (juifNavigationStack.length() == 0) {\n            juifEmitSimple(\"back_empty\");\n            return;\n        }\n\n        String previous = juifNavigationStack.getString(juifNavigationStack.length() - 1);\n        JSONArray nextStack = new JSONArray();\n\n        for (int i = 0; i < juifNavigationStack.length() - 1; i++) {\n            nextStack.put(juifNavigationStack.get(i));\n        }\n\n        juifNavigationStack = nextStack;\n        juifRenderPage(previous);\n\n        JSONObject extra = new JSONObject();\n        extra.put(\"page\", previous);\n\n        juifEmit(\"back\", extra);\n    } catch(Exception ignored) {}\n}\n\n/* =========================\n   BASIC COMPONENTS\n========================= */\n\nTextView JUIFText(JSONObject node) throws Exception {\n    String value = node.optString(\"text\", \"\");\n    String variant = node.optString(\"variant\", \"body\");\n\n    if (\"title\".equals(variant)) return juifText(value, 24f, JUIF_TEXT, Typeface.BOLD);\n    if (\"subtitle\".equals(variant)) return juifText(value, 14f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n\n    if (\"label\".equals(variant)) {\n        TextView t = juifText(value.toUpperCase(), 12f, JUIF_PRIMARY, Typeface.BOLD);\n        t.setLetterSpacing(0.08f);\n        return t;\n    }\n\n    if (\"error\".equals(variant)) return juifText(value, 13f, JUIF_ERROR, Typeface.BOLD);\n    if (\"success\".equals(variant)) return juifText(value, 13f, JUIF_SUCCESS, Typeface.BOLD);\n    if (\"warning\".equals(variant)) return juifText(value, 13f, JUIF_WARNING, Typeface.BOLD);\n    if (\"info\".equals(variant)) return juifText(value, 13f, JUIF_INFO, Typeface.BOLD);\n    if (\"muted\".equals(variant)) return juifText(value, 14f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n\n    return juifText(value, 15f, JUIF_TEXT, Typeface.NORMAL);\n}\n\nTextView JUIFButton(JSONObject node) throws Exception {\n    String label = node.optString(\"text\", \"Button\");\n    String variant = node.optString(\"variant\", \"primary\");\n\n    final String action = node.optString(\"action\", \"\");\n    final String target = node.optString(\"target\", \"\");\n\n    int bgColor = JUIF_PRIMARY;\n    int txtColor = JUIF_BG;\n    int strokeColor = JUIF_PRIMARY;\n\n    if (\"secondary\".equals(variant)) {\n        bgColor = JUIF_SURFACE_2;\n        txtColor = JUIF_PRIMARY;\n        strokeColor = JUIF_PRIMARY_DARK;\n    }\n\n    if (\"danger\".equals(variant)) {\n        bgColor = JUIF_ERROR;\n        txtColor = Color.WHITE;\n        strokeColor = JUIF_ERROR;\n    }\n\n    if (\"ghost\".equals(variant)) {\n        bgColor = JUIF_BG;\n        txtColor = JUIF_TEXT_MUTED;\n        strokeColor = JUIF_BORDER;\n    }\n\n    TextView btn = juifText(label, 15f, txtColor, Typeface.BOLD);\n    btn.setGravity(Gravity.CENTER);\n    btn.setPadding(dp(18), dp(13), dp(18), dp(13));\n    btn.setBackground(juifBgStroke(bgColor, 16, strokeColor, 1));\n\n    juifApplyVerticalMargin(btn, 8, 8);\n\n    btn.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            juifDispatchAction(action, target, null);\n        }\n    });\n\n    return btn;\n}\n\nLinearLayout JUIFButtonGroup(JSONObject node) throws Exception {\n    LinearLayout group = new LinearLayout(appContext);\n    group.setOrientation(LinearLayout.HORIZONTAL);\n    group.setGravity(Gravity.CENTER);\n\n    juifApplyVerticalMargin(group, 8, 8);\n\n    JSONArray buttons = node.optJSONArray(\"buttons\");\n\n    if (buttons != null) {\n        for (int i = 0; i < buttons.length(); i++) {\n            View button = JUIFButton(buttons.getJSONObject(i));\n\n            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, -2, 1f);\n            lp.setMargins(dp(4), 0, dp(4), 0);\n\n            group.addView(button, lp);\n        }\n    }\n\n    return group;\n}\n\n/* =========================\n   INPUTS\n========================= */\n\nEditText JUIFInputBase(JSONObject node, boolean multiline) throws Exception {\n    final String key = node.optString(\"key\", \"input\");\n\n    String hint = node.optString(\"hint\", \"\");\n    String value = node.optString(\"value\", \"\");\n    String inputType = node.optString(\"input_type\", \"text\");\n\n    if (juifState.has(key)) {\n        value = String.valueOf(juifState.opt(key));\n    } else {\n        juifSetStateValue(key, value);\n    }\n\n    final EditText input = new EditText(appContext);\n\n    input.setHint(hint);\n    input.setText(value);\n    input.setTextSize(15f);\n    input.setTextColor(JUIF_TEXT);\n    input.setHintTextColor(JUIF_TEXT_MUTED);\n    input.setPadding(dp(15), dp(12), dp(15), dp(12));\n    input.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n    input.setFocusable(true);\n    input.setFocusableInTouchMode(true);\n    input.setClickable(true);\n\n    if (multiline) {\n        input.setSingleLine(false);\n        input.setMinLines(node.optInt(\"min_lines\", 3));\n        input.setGravity(Gravity.TOP | Gravity.START);\n        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);\n    } else {\n        input.setSingleLine(true);\n\n        if (\"number\".equals(inputType)) {\n            input.setInputType(InputType.TYPE_CLASS_NUMBER);\n        } else if (\"decimal\".equals(inputType)) {\n            input.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_FLAG_DECIMAL);\n        } else if (\"password\".equals(inputType)) {\n            input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_PASSWORD);\n        } else if (\"phone\".equals(inputType)) {\n            input.setInputType(InputType.TYPE_CLASS_PHONE);\n        } else if (\"email\".equals(inputType)) {\n            input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS);\n        } else {\n            input.setInputType(InputType.TYPE_CLASS_TEXT);\n        }\n    }\n\n    juifApplyVerticalMargin(input, 8, 8);\n\n    input.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                input.requestFocus();\n\n                input.postDelayed(new Runnable() {\n                    public void run() {\n                        try {\n                            InputMethodManager imm =\n                                (InputMethodManager) appContext.getSystemService(Context.INPUT_METHOD_SERVICE);\n\n                            if (imm != null) {\n                                imm.showSoftInput(input, InputMethodManager.SHOW_IMPLICIT);\n                            }\n                        } catch(Exception ignored) {}\n                    }\n                }, 120);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    input.addTextChangedListener(new TextWatcher() {\n        public void beforeTextChanged(CharSequence s, int start, int count, int after) {}\n\n        public void onTextChanged(CharSequence s, int start, int before, int count) {\n            try {\n                String value = s.toString();\n\n                juifSetStateValue(key, value);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", value);\n\n                juifEmit(\"input_changed\", extra);\n            } catch(Exception ignored) {}\n        }\n\n        public void afterTextChanged(Editable s) {}\n    });\n\n    return input;\n}\n\nEditText JUIFInput(JSONObject node) throws Exception {\n    return JUIFInputBase(node, false);\n}\n\nEditText JUIFTextarea(JSONObject node) throws Exception {\n    return JUIFInputBase(node, true);\n}\n\nCheckBox JUIFCheckbox(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"checkbox\");\n\n    String label = node.optString(\"text\", \"\");\n    boolean checked = node.optBoolean(\"checked\", false);\n\n    if (juifState.has(key)) {\n        checked = juifState.optBoolean(key, checked);\n    } else {\n        juifSetStateValue(key, checked);\n    }\n\n    CheckBox cb = new CheckBox(appContext);\n    cb.setText(label);\n    cb.setTextColor(JUIF_TEXT);\n    cb.setTextSize(15f);\n    cb.setChecked(checked);\n    cb.setButtonTintList(ColorStateList.valueOf(JUIF_PRIMARY));\n\n    juifApplyVerticalMargin(cb, 6, 6);\n\n    cb.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {\n        public void onCheckedChanged(CompoundButton b, boolean isChecked) {\n            try {\n                juifSetStateValue(key, isChecked);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", isChecked);\n\n                juifEmit(\"input_changed\", extra);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    return cb;\n}\n\nSwitch JUIFSwitch(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"switch\");\n\n    String label = node.optString(\"text\", \"\");\n    boolean checked = node.optBoolean(\"checked\", false);\n\n    if (juifState.has(key)) {\n        checked = juifState.optBoolean(key, checked);\n    } else {\n        juifSetStateValue(key, checked);\n    }\n\n    Switch sw = new Switch(appContext);\n    sw.setText(label);\n    sw.setTextColor(JUIF_TEXT);\n    sw.setTextSize(15f);\n    sw.setChecked(checked);\n\n    juifApplyVerticalMargin(sw, 6, 6);\n\n    sw.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {\n        public void onCheckedChanged(CompoundButton b, boolean isChecked) {\n            try {\n                juifSetStateValue(key, isChecked);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", isChecked);\n\n                juifEmit(\"input_changed\", extra);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    return sw;\n}\n\nLinearLayout JUIFSelect(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"select\");\n\n    LinearLayout wrap = new LinearLayout(appContext);\n    wrap.setOrientation(LinearLayout.VERTICAL);\n    wrap.setPadding(dp(14), dp(12), dp(14), dp(12));\n    wrap.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(wrap, 8, 8);\n\n    String label = node.optString(\"label\", \"\");\n\n    if (label.length() > 0) {\n        TextView labelView = juifText(label.toUpperCase(), 11f, JUIF_PRIMARY, Typeface.BOLD);\n        labelView.setLetterSpacing(0.08f);\n        wrap.addView(labelView);\n        wrap.addView(juifSpace(6));\n    }\n\n    JSONArray options = node.optJSONArray(\"options\");\n    final JSONArray labels = new JSONArray();\n    final JSONArray values = new JSONArray();\n\n    String selectedValue = node.optString(\"value\", \"\");\n\n    if (juifState.has(key)) {\n        selectedValue = String.valueOf(juifState.opt(key));\n    }\n\n    String selectedLabel = \"\";\n\n    if (options != null) {\n        for (int i = 0; i < options.length(); i++) {\n            Object rawOption = options.get(i);\n\n            String optLabel = \"\";\n            String optValue = \"\";\n\n            if (rawOption instanceof JSONObject) {\n                JSONObject option = (JSONObject) rawOption;\n                optLabel = option.optString(\"label\", \"\");\n                optValue = option.optString(\"value\", optLabel);\n            } else {\n                optLabel = String.valueOf(rawOption);\n                optValue = optLabel;\n            }\n\n            labels.put(optLabel);\n            values.put(optValue);\n\n            if (optValue.equals(selectedValue)) {\n                selectedLabel = optLabel;\n            }\n        }\n    }\n\n    if (labels.length() == 0) {\n        labels.put(\"Nenhuma opção\");\n        values.put(\"\");\n    }\n\n    if (selectedLabel.length() == 0) {\n        selectedLabel = labels.optString(0, \"\");\n        selectedValue = values.optString(0, \"\");\n    }\n\n    juifSetStateValue(key, selectedValue);\n\n    final TextView selected = juifText(selectedLabel + \"   ▾\", 15f, JUIF_TEXT, Typeface.BOLD);\n    selected.setGravity(Gravity.CENTER_VERTICAL);\n    selected.setPadding(0, dp(8), 0, dp(8));\n\n    selected.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                final PopupWindow popup = new PopupWindow(appContext);\n\n                LinearLayout list = new LinearLayout(appContext);\n                list.setOrientation(LinearLayout.VERTICAL);\n                list.setPadding(dp(8), dp(8), dp(8), dp(8));\n                list.setBackground(juifBgStroke(JUIF_SURFACE, 18, JUIF_BORDER, 1));\n\n                for (int i = 0; i < labels.length(); i++) {\n                    final int index = i;\n\n                    TextView item = juifText(labels.optString(i, \"\"), 15f, JUIF_TEXT, Typeface.BOLD);\n                    item.setPadding(dp(14), dp(12), dp(14), dp(12));\n                    item.setBackground(juifBgStroke(JUIF_SURFACE_2, 14, JUIF_BORDER, 1));\n\n                    LinearLayout.LayoutParams itemLp = new LinearLayout.LayoutParams(-1, -2);\n                    itemLp.setMargins(0, dp(4), 0, dp(4));\n                    item.setLayoutParams(itemLp);\n\n                    item.setOnClickListener(new View.OnClickListener() {\n                        public void onClick(View view) {\n                            try {\n                                String label = labels.optString(index, \"\");\n                                String value = values.optString(index, \"\");\n\n                                selected.setText(label + \"   ▾\");\n                                juifSetStateValue(key, value);\n\n                                JSONObject extra = new JSONObject();\n                                extra.put(\"key\", key);\n                                extra.put(\"value\", value);\n                                extra.put(\"label\", label);\n\n                                juifEmit(\"input_changed\", extra);\n\n                                popup.dismiss();\n                            } catch(Exception ignored) {}\n                        }\n                    });\n\n                    list.addView(item);\n                }\n\n                popup.setContentView(list);\n                popup.setWidth(v.getWidth());\n                popup.setHeight(WindowManager.LayoutParams.WRAP_CONTENT);\n                popup.setFocusable(true);\n                popup.setOutsideTouchable(true);\n                popup.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));\n                popup.showAsDropDown(v, 0, dp(6));\n\n            } catch(Exception ignored) {}\n        }\n    });\n\n    wrap.addView(selected);\n\n    return wrap;\n}\n\nRadioGroup JUIFRadioGroup(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"radio\");\n\n    JSONArray options = node.optJSONArray(\"options\");\n    String selectedValue = node.optString(\"value\", \"\");\n\n    if (juifState.has(key)) {\n        selectedValue = String.valueOf(juifState.opt(key));\n    }\n\n    final JSONArray values = new JSONArray();\n\n    RadioGroup group = new RadioGroup(appContext);\n    group.setOrientation(RadioGroup.VERTICAL);\n    group.setPadding(dp(6), dp(4), dp(6), dp(4));\n\n    juifApplyVerticalMargin(group, 8, 8);\n\n    if (options != null) {\n        for (int i = 0; i < options.length(); i++) {\n            Object rawOption = options.get(i);\n\n            String optLabel = \"\";\n            String optValue = \"\";\n\n            if (rawOption instanceof JSONObject) {\n                JSONObject option = (JSONObject) rawOption;\n                optLabel = option.optString(\"label\", \"\");\n                optValue = option.optString(\"value\", optLabel);\n            } else {\n                optLabel = String.valueOf(rawOption);\n                optValue = optLabel;\n            }\n\n            values.put(optValue);\n\n            RadioButton rb = new RadioButton(appContext);\n            rb.setText(optLabel);\n            rb.setTextColor(JUIF_TEXT);\n            rb.setTextSize(15f);\n            rb.setId(10000 + i);\n            rb.setButtonTintList(ColorStateList.valueOf(JUIF_PRIMARY));\n\n            group.addView(rb);\n\n            if (optValue.equals(selectedValue)) {\n                group.check(10000 + i);\n                juifSetStateValue(key, optValue);\n            }\n        }\n    }\n\n    group.setOnCheckedChangeListener(new RadioGroup.OnCheckedChangeListener() {\n        public void onCheckedChanged(RadioGroup group, int checkedId) {\n            try {\n                int index = checkedId - 10000;\n                String value = values.optString(index, \"\");\n\n                juifSetStateValue(key, value);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", value);\n\n                juifEmit(\"input_changed\", extra);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    return group;\n}\n\n/* =========================\n   LAYOUT\n========================= */\n\nLinearLayout JUIFCard(JSONObject node) throws Exception {\n    LinearLayout card = new LinearLayout(appContext);\n    card.setOrientation(LinearLayout.VERTICAL);\n    card.setPadding(dp(18), dp(16), dp(18), dp(16));\n    card.setBackground(juifBgStroke(JUIF_SURFACE, 24, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(card, 10, 10);\n\n    JSONArray children = node.optJSONArray(\"children\");\n\n    if (children != null) {\n        for (int i = 0; i < children.length(); i++) {\n            card.addView(juifRenderNode(children.getJSONObject(i)));\n        }\n    }\n\n    return card;\n}\n\nLinearLayout JUIFSection(JSONObject node) throws Exception {\n    LinearLayout section = new LinearLayout(appContext);\n    section.setOrientation(LinearLayout.VERTICAL);\n    section.setPadding(0, dp(8), 0, dp(4));\n\n    juifApplyVerticalMargin(section, 12, 8);\n\n    String title = node.optString(\"title\", \"\");\n    String subtitle = node.optString(\"subtitle\", \"\");\n\n    if (title.length() > 0) {\n        section.addView(juifText(title, 19f, JUIF_TEXT, Typeface.BOLD));\n    }\n\n    if (subtitle.length() > 0) {\n        section.addView(juifText(subtitle, 13f, JUIF_TEXT_MUTED, Typeface.NORMAL));\n    }\n\n    JSONArray children = node.optJSONArray(\"children\");\n\n    if (children != null) {\n        section.addView(juifSpace(8));\n\n        for (int i = 0; i < children.length(); i++) {\n            section.addView(juifRenderNode(children.getJSONObject(i)));\n        }\n    }\n\n    return section;\n}\n\nLinearLayout JUIFContainer(JSONObject node) throws Exception {\n    LinearLayout box = new LinearLayout(appContext);\n    box.setOrientation(LinearLayout.VERTICAL);\n    box.setPadding(\n        dp(node.optInt(\"padding_left\", 16)),\n        dp(node.optInt(\"padding_top\", 14)),\n        dp(node.optInt(\"padding_right\", 16)),\n        dp(node.optInt(\"padding_bottom\", 14))\n    );\n\n    String variant = node.optString(\"variant\", \"surface\");\n\n    if (\"surface2\".equals(variant)) {\n        box.setBackground(juifBgStroke(JUIF_SURFACE_2, node.optInt(\"radius\", 20), JUIF_BORDER, 1));\n    } else if (\"surface3\".equals(variant)) {\n        box.setBackground(juifBgStroke(JUIF_SURFACE_3, node.optInt(\"radius\", 20), JUIF_BORDER, 1));\n    } else if (!\"plain\".equals(variant)) {\n        box.setBackground(juifBgStroke(JUIF_SURFACE, node.optInt(\"radius\", 20), JUIF_BORDER, 1));\n    }\n\n    LinearLayout.LayoutParams lp = juifLpFull();\n    lp.setMargins(\n        0,\n        dp(node.optInt(\"margin_top\", 8)),\n        0,\n        dp(node.optInt(\"margin_bottom\", 8))\n    );\n\n    box.setLayoutParams(lp);\n\n    JSONArray children = node.optJSONArray(\"children\");\n\n    if (children != null) {\n        for (int i = 0; i < children.length(); i++) {\n            box.addView(juifRenderNode(children.getJSONObject(i)));\n        }\n    }\n\n    return box;\n}\n\nLinearLayout JUIFColumn(JSONObject node) throws Exception {\n    LinearLayout col = new LinearLayout(appContext);\n    col.setOrientation(LinearLayout.VERTICAL);\n\n    JSONArray children = node.optJSONArray(\"children\");\n\n    if (children != null) {\n        for (int i = 0; i < children.length(); i++) {\n            col.addView(juifRenderNode(children.getJSONObject(i)));\n        }\n    }\n\n    return col;\n}\n\nLinearLayout JUIFRow(JSONObject node) throws Exception {\n    LinearLayout row = new LinearLayout(appContext);\n    row.setOrientation(LinearLayout.HORIZONTAL);\n    row.setGravity(Gravity.CENTER_VERTICAL);\n\n    juifApplyVerticalMargin(row, 6, 6);\n\n    JSONArray children = node.optJSONArray(\"children\");\n\n    if (children != null) {\n        for (int i = 0; i < children.length(); i++) {\n            View child = juifRenderNode(children.getJSONObject(i));\n\n            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(0, -2, 1f);\n            lp.setMargins(dp(4), 0, dp(4), 0);\n\n            row.addView(child, lp);\n        }\n    }\n\n    return row;\n}\n\nView JUIFSpacer(JSONObject node) {\n    return juifSpace(node.optInt(\"height\", 12));\n}\n\nView JUIFDivider() {\n    View d = new View(appContext);\n    d.setBackgroundColor(JUIF_BORDER);\n\n    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-1, dp(1));\n    lp.setMargins(0, dp(12), 0, dp(12));\n\n    d.setLayoutParams(lp);\n\n    return d;\n}\n\n/* =========================\n   DISPLAY\n========================= */\n\nLinearLayout JUIFAlert(JSONObject node) throws Exception {\n    String variant = node.optString(\"variant\", \"info\");\n    int color = juifVariantColor(variant);\n\n    LinearLayout alert = new LinearLayout(appContext);\n    alert.setOrientation(LinearLayout.VERTICAL);\n    alert.setPadding(dp(15), dp(13), dp(15), dp(13));\n    alert.setBackground(juifBgStroke(JUIF_SURFACE_2, 20, color, 1));\n\n    juifApplyVerticalMargin(alert, 8, 8);\n\n    String title = node.optString(\"title\", \"\");\n    String body = node.optString(\"text\", \"\");\n\n    if (title.length() > 0) {\n        alert.addView(juifText(title, 15f, color, Typeface.BOLD));\n    }\n\n    if (body.length() > 0) {\n        alert.addView(juifText(body, 14f, JUIF_TEXT, Typeface.NORMAL));\n    }\n\n    return alert;\n}\n\nTextView JUIFBadge(JSONObject node) throws Exception {\n    String value = node.optString(\"text\", \"\");\n    String variant = node.optString(\"variant\", \"primary\");\n    int color = juifVariantColor(variant);\n\n    TextView badge = juifText(value, 12f, color, Typeface.BOLD);\n    badge.setGravity(Gravity.CENTER);\n    badge.setPadding(dp(10), dp(5), dp(10), dp(5));\n    badge.setBackground(juifBgStroke(JUIF_SURFACE_2, 999, color, 1));\n\n    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);\n    lp.setMargins(0, dp(4), 0, dp(4));\n    badge.setLayoutParams(lp);\n\n    return badge;\n}\n\nLinearLayout JUIFKeyValue(JSONObject node) throws Exception {\n    LinearLayout row = new LinearLayout(appContext);\n    row.setOrientation(LinearLayout.HORIZONTAL);\n    row.setGravity(Gravity.CENTER_VERTICAL);\n    row.setPadding(0, dp(7), 0, dp(7));\n\n    TextView key = juifText(node.optString(\"label\", \"\"), 14f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n\n    TextView value = juifText(node.optString(\"value\", \"\"), 14f, JUIF_TEXT, Typeface.BOLD);\n    value.setGravity(Gravity.RIGHT);\n\n    row.addView(key, new LinearLayout.LayoutParams(0, -2, 1f));\n    row.addView(value, new LinearLayout.LayoutParams(0, -2, 1f));\n\n    return row;\n}\n\nTextView JUIFListItem(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"\");\n\n    String title = node.optString(\"title\", \"\");\n    String subtitle = node.optString(\"subtitle\", \"\");\n\n    final String action = node.optString(\"action\", \"item_selected\");\n    final String value = node.optString(\"value\", title);\n\n    TextView item = juifText(\n        title + (subtitle.length() > 0 ? \"\\n\" + subtitle : \"\"),\n        15f,\n        JUIF_TEXT,\n        Typeface.NORMAL\n    );\n\n    item.setPadding(dp(16), dp(14), dp(16), dp(14));\n    item.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(item, 6, 6);\n\n    item.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                if (key.length() > 0) {\n                    juifSetStateValue(key, value);\n                }\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", value);\n\n                juifEmit(action, extra);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    return item;\n}\n\nLinearLayout JUIFCopyableText(JSONObject node) throws Exception {\n    final String label = node.optString(\"label\", \"Texto\");\n    final String value = node.optString(\"text\", \"\");\n\n    LinearLayout box = new LinearLayout(appContext);\n    box.setOrientation(LinearLayout.VERTICAL);\n    box.setPadding(dp(15), dp(13), dp(15), dp(13));\n    box.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(box, 8, 8);\n\n    LinearLayout header = new LinearLayout(appContext);\n    header.setOrientation(LinearLayout.HORIZONTAL);\n    header.setGravity(Gravity.CENTER_VERTICAL);\n\n    TextView labelView = juifText(label, 13f, JUIF_PRIMARY, Typeface.BOLD);\n    TextView copy = juifText(node.optString(\"copy_text\", \"Copiar\"), 13f, JUIF_PRIMARY, Typeface.BOLD);\n    copy.setGravity(Gravity.RIGHT);\n\n    header.addView(labelView, new LinearLayout.LayoutParams(0, -2, 1f));\n    header.addView(copy, new LinearLayout.LayoutParams(0, -2, 1f));\n\n    TextView content = juifText(value, 14f, JUIF_TEXT, Typeface.NORMAL);\n    content.setPadding(0, dp(8), 0, 0);\n\n    copy.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                juifCopyToClipboard(label, value);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"label\", label);\n                extra.put(\"value\", value);\n\n                juifEmit(\"copied\", extra);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    box.addView(header);\n    box.addView(content);\n\n    return box;\n}\n\nLinearLayout JUIFStatCard(JSONObject node) throws Exception {\n    String label = node.optString(\"label\", \"\");\n    String value = node.optString(\"value\", \"\");\n    String variant = node.optString(\"variant\", \"primary\");\n    int color = juifVariantColor(variant);\n\n    LinearLayout card = new LinearLayout(appContext);\n    card.setOrientation(LinearLayout.VERTICAL);\n    card.setPadding(dp(16), dp(14), dp(16), dp(14));\n    card.setBackground(juifBgStroke(JUIF_SURFACE, 22, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(card, 8, 8);\n\n    card.addView(juifText(label.toUpperCase(), 11f, JUIF_TEXT_MUTED, Typeface.BOLD));\n    card.addView(juifText(value, 24f, color, Typeface.BOLD));\n\n    return card;\n}\n\nLinearLayout JUIFProgressBar(JSONObject node) throws Exception {\n    final int progressValue;\n    int rawProgress = node.optInt(\"progress\", 0);\n\n    if (rawProgress < 0) rawProgress = 0;\n    if (rawProgress > 100) rawProgress = 100;\n\n    progressValue = rawProgress;\n\n    String label = node.optString(\"label\", \"\");\n    String variant = node.optString(\"variant\", \"primary\");\n    final int color = juifVariantColor(variant);\n\n    LinearLayout wrap = new LinearLayout(appContext);\n    wrap.setOrientation(LinearLayout.VERTICAL);\n    wrap.setPadding(dp(14), dp(12), dp(14), dp(12));\n    wrap.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(wrap, 8, 8);\n\n    if (label.length() > 0) {\n        LinearLayout header = new LinearLayout(appContext);\n        header.setOrientation(LinearLayout.HORIZONTAL);\n        header.setGravity(Gravity.CENTER_VERTICAL);\n\n        TextView labelView = juifText(label, 13f, JUIF_TEXT, Typeface.BOLD);\n        TextView valueView = juifText(progressValue + \"%\", 13f, color, Typeface.BOLD);\n        valueView.setGravity(Gravity.RIGHT);\n\n        header.addView(labelView, new LinearLayout.LayoutParams(0, -2, 1f));\n        header.addView(valueView, new LinearLayout.LayoutParams(0, -2, 1f));\n\n        wrap.addView(header);\n        wrap.addView(juifSpace(8));\n    }\n\n    final FrameLayout track = new FrameLayout(appContext);\n    track.setBackground(juifBg(JUIF_SURFACE_3, 999));\n\n    LinearLayout.LayoutParams trackLp = new LinearLayout.LayoutParams(-1, dp(10));\n    track.setLayoutParams(trackLp);\n\n    final View fill = new View(appContext);\n    fill.setBackground(juifBg(color, 999));\n\n    FrameLayout.LayoutParams initialFillLp = new FrameLayout.LayoutParams(0, dp(10));\n    track.addView(fill, initialFillLp);\n\n    track.post(new Runnable() {\n        public void run() {\n            try {\n                int trackWidth = track.getWidth();\n                int fillWidth = (int)(trackWidth * (progressValue / 100.0f));\n\n                if (progressValue > 0 && fillWidth < dp(4)) {\n                    fillWidth = dp(4);\n                }\n\n                FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(fillWidth, dp(10));\n                fill.setLayoutParams(lp);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    wrap.addView(track);\n\n    return wrap;\n}\n\n/* =========================\n   CODE\n========================= */\n\nLinearLayout JUIFCodeBlock(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"\");\n    final String title = node.optString(\"title\", \"Código\");\n    final String language = node.optString(\"language\", \"\");\n    final boolean autoIndent = node.optBoolean(\"auto_indent\", true);\n\n    String code = node.optString(\"code\", \"\");\n\n    if (key.length() > 0 && juifState.has(key)) {\n        code = String.valueOf(juifState.opt(key));\n    }\n\n    final String formattedCode = autoIndent ? juifPrettyCode(code) : code;\n    final String escapedCode = juifEscapeJavaString(formattedCode);\n\n    LinearLayout box = new LinearLayout(appContext);\n    box.setOrientation(LinearLayout.VERTICAL);\n    box.setPadding(dp(14), dp(12), dp(14), dp(12));\n    box.setBackground(juifBgStroke(JUIF_SURFACE, 22, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(box, 10, 10);\n\n    LinearLayout header = new LinearLayout(appContext);\n    header.setOrientation(LinearLayout.HORIZONTAL);\n    header.setGravity(Gravity.CENTER_VERTICAL);\n\n    String headerText = title;\n\n    if (language.length() > 0) {\n        headerText = title + \" · \" + language.toUpperCase();\n    }\n\n    TextView labelView = juifText(headerText, 13f, JUIF_PRIMARY, Typeface.BOLD);\n\n    final TextView copyMenuButton = juifText(\"Copiar ▾\", 13f, JUIF_PRIMARY, Typeface.BOLD);\n    copyMenuButton.setGravity(Gravity.CENTER);\n    copyMenuButton.setPadding(dp(12), dp(6), dp(12), dp(6));\n    copyMenuButton.setBackground(juifBgStroke(JUIF_SURFACE_2, 999, JUIF_PRIMARY_DARK, 1));\n\n    header.addView(labelView, new LinearLayout.LayoutParams(0, -2, 1f));\n    header.addView(copyMenuButton, new LinearLayout.LayoutParams(-2, -2));\n\n    box.addView(header);\n    box.addView(juifSpace(10));\n\n    HorizontalScrollView horizontal = new HorizontalScrollView(appContext);\n    horizontal.setFillViewport(true);\n\n    TextView codeView = juifMonoText(formattedCode, 13f, JUIF_TEXT, Typeface.NORMAL);\n    codeView.setTextIsSelectable(true);\n    codeView.setPadding(dp(14), dp(12), dp(14), dp(12));\n    codeView.setBackground(juifBgStroke(JUIF_SURFACE_2, 16, JUIF_BORDER, 1));\n\n    horizontal.addView(\n        codeView,\n        new ViewGroup.LayoutParams(\n            ViewGroup.LayoutParams.WRAP_CONTENT,\n            ViewGroup.LayoutParams.WRAP_CONTENT\n        )\n    );\n\n    box.addView(horizontal);\n\n    copyMenuButton.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                final PopupWindow popup = new PopupWindow(appContext);\n\n                LinearLayout menu = new LinearLayout(appContext);\n                menu.setOrientation(LinearLayout.VERTICAL);\n                menu.setPadding(dp(8), dp(8), dp(8), dp(8));\n                menu.setBackground(juifBgStroke(JUIF_SURFACE, 18, JUIF_BORDER, 1));\n\n                TextView copyFormatted = juifText(\"Copiar formatado\", 14f, JUIF_TEXT, Typeface.BOLD);\n                copyFormatted.setPadding(dp(14), dp(12), dp(14), dp(12));\n                copyFormatted.setBackground(juifBgStroke(JUIF_SURFACE_2, 14, JUIF_BORDER, 1));\n\n                LinearLayout.LayoutParams itemLp1 = new LinearLayout.LayoutParams(-1, -2);\n                itemLp1.setMargins(0, 0, 0, dp(6));\n                copyFormatted.setLayoutParams(itemLp1);\n\n                TextView copyEscaped = juifText(\"Copiar escapado\", 14f, JUIF_TEXT, Typeface.BOLD);\n                copyEscaped.setPadding(dp(14), dp(12), dp(14), dp(12));\n                copyEscaped.setBackground(juifBgStroke(JUIF_SURFACE_2, 14, JUIF_BORDER, 1));\n\n                LinearLayout.LayoutParams itemLp2 = new LinearLayout.LayoutParams(-1, -2);\n                itemLp2.setMargins(0, dp(6), 0, 0);\n                copyEscaped.setLayoutParams(itemLp2);\n\n                copyFormatted.setOnClickListener(new View.OnClickListener() {\n                    public void onClick(View view) {\n                        try {\n                            juifCopyToClipboard(title, formattedCode);\n\n                            JSONObject extra = new JSONObject();\n                            extra.put(\"key\", key);\n                            extra.put(\"title\", title);\n                            extra.put(\"language\", language);\n                            extra.put(\"format\", \"formatted\");\n\n                            juifEmit(\"code_copied\", extra);\n                            popup.dismiss();\n                        } catch(Exception ignored) {}\n                    }\n                });\n\n                copyEscaped.setOnClickListener(new View.OnClickListener() {\n                    public void onClick(View view) {\n                        try {\n                            juifCopyToClipboard(title + \" escaped\", escapedCode);\n\n                            JSONObject extra = new JSONObject();\n                            extra.put(\"key\", key);\n                            extra.put(\"title\", title);\n                            extra.put(\"language\", language);\n                            extra.put(\"format\", \"escaped\");\n\n                            juifEmit(\"code_copied\", extra);\n                            popup.dismiss();\n                        } catch(Exception ignored) {}\n                    }\n                });\n\n                menu.addView(copyFormatted);\n                menu.addView(copyEscaped);\n\n                popup.setContentView(menu);\n                popup.setWidth(Math.max(dp(190), v.getWidth()));\n                popup.setHeight(WindowManager.LayoutParams.WRAP_CONTENT);\n                popup.setFocusable(true);\n                popup.setOutsideTouchable(true);\n                popup.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));\n                popup.showAsDropDown(v, 0, dp(6));\n\n            } catch(Exception ignored) {}\n        }\n    });\n\n    return box;\n}\n\n/* =========================\n   DYNAMIC\n========================= */\n\nLinearLayout JUIFDynamicList(JSONObject node) throws Exception {\n    String source = node.optString(\"source\", \"\");\n    String emptyText = node.optString(\"empty_text\", \"Nenhum item encontrado.\");\n\n    JSONArray items = null;\n\n    if (source.length() > 0 && juifState.has(source)) {\n        Object value = juifState.opt(source);\n\n        if (value instanceof JSONArray) {\n            items = (JSONArray) value;\n        }\n    }\n\n    if (items == null) {\n        items = node.optJSONArray(\"items\");\n    }\n\n    LinearLayout list = new LinearLayout(appContext);\n    list.setOrientation(LinearLayout.VERTICAL);\n\n    juifApplyVerticalMargin(list, 6, 6);\n\n    if (items == null || items.length() == 0) {\n        TextView empty = juifText(emptyText, 14f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n        empty.setPadding(dp(14), dp(12), dp(14), dp(12));\n        empty.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n        list.addView(empty);\n        return list;\n    }\n\n    JSONObject itemTemplate = node.optJSONObject(\"item_template\");\n\n    if (itemTemplate == null) {\n        itemTemplate = new JSONObject();\n        itemTemplate.put(\"type\", \"list_item\");\n        itemTemplate.put(\"title\", \"{{title}}\");\n        itemTemplate.put(\"subtitle\", \"{{subtitle}}\");\n        itemTemplate.put(\"value\", \"{{value}}\");\n        itemTemplate.put(\"action\", \"item_selected\");\n    }\n\n    for (int i = 0; i < items.length(); i++) {\n        JSONObject item;\n\n        Object rawItem = items.get(i);\n\n        if (rawItem instanceof JSONObject) {\n            item = (JSONObject) rawItem;\n        } else {\n            item = new JSONObject();\n            item.put(\"title\", String.valueOf(rawItem));\n            item.put(\"value\", String.valueOf(rawItem));\n            item.put(\"index\", i);\n        }\n\n        item.put(\"index\", i);\n\n        JSONObject rendered = juifApplyTemplateNode(itemTemplate, item);\n\n        list.addView(juifRenderNode(rendered));\n    }\n\n    return list;\n}\n\n/* =========================\n   SANDBOX\n========================= */\n\nvoid juifRenderSandboxPreview(String rawJson, LinearLayout preview, TextView status) {\n    try {\n        preview.removeAllViews();\n\n        String cleaned = rawJson == null ? \"\" : rawJson.trim();\n\n        if (cleaned.length() == 0) {\n            status.setText(\"Informe um JSON para renderizar.\");\n            status.setTextColor(JUIF_WARNING);\n            return;\n        }\n\n        JSONObject ui = new JSONObject(cleaned);\n\n        JSONObject pages = ui.optJSONObject(\"pages\");\n        JSONObject page = null;\n\n        if (pages != null) {\n            String pageId = ui.optString(\"initial_page\", \"\");\n\n            if (pageId.length() == 0) {\n                JSONArray names = pages.names();\n\n                if (names != null && names.length() > 0) {\n                    pageId = names.getString(0);\n                }\n            }\n\n            if (pageId.length() > 0 && pages.has(pageId)) {\n                page = pages.getJSONObject(pageId);\n            }\n        }\n\n        if (page == null) {\n            page = new JSONObject();\n            page.put(\"title\", ui.optString(\"title\", \"Sandbox\"));\n            page.put(\"subtitle\", ui.optString(\"subtitle\", \"\"));\n            JSONArray comps = ui.optJSONArray(\"components\");\n\n            if (comps == null) {\n                comps = new JSONArray();\n            }\n\n            page.put(\"components\", comps);\n        }\n\n        String title = page.optString(\"title\", \"\");\n\n        if (title.length() > 0) {\n            preview.addView(juifText(title, 22f, JUIF_TEXT, Typeface.BOLD));\n        }\n\n        String subtitle = page.optString(\"subtitle\", \"\");\n\n        if (subtitle.length() > 0) {\n            preview.addView(juifText(subtitle, 13f, JUIF_TEXT_MUTED, Typeface.NORMAL));\n        }\n\n        if (title.length() > 0 || subtitle.length() > 0) {\n            preview.addView(juifSpace(12));\n        }\n\n        JSONArray components = page.optJSONArray(\"components\");\n\n        if (components != null) {\n            for (int i = 0; i < components.length(); i++) {\n                preview.addView(juifRenderNode(components.getJSONObject(i)));\n            }\n        }\n\n        status.setText(\"Preview renderizado com sucesso.\");\n        status.setTextColor(JUIF_SUCCESS);\n\n    } catch(Exception e) {\n        try {\n            preview.removeAllViews();\n            preview.addView(\n                juifText(\"Não foi possível renderizar o JSON.\", 14f, JUIF_ERROR, Typeface.BOLD)\n            );\n\n            status.setText(e.getMessage());\n            status.setTextColor(JUIF_ERROR);\n\n        } catch(Exception ignored) {}\n    }\n}\n\nLinearLayout JUIFSandbox(JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"sandbox_json\");\n    String initialJson = node.optString(\n        \"value\",\n        \"{\\\"initial_page\\\":\\\"home\\\",\\\"pages\\\":{\\\"home\\\":{\\\"title\\\":\\\"Sandbox JUIF\\\",\\\"subtitle\\\":\\\"Teste rápido\\\",\\\"components\\\":[{\\\"type\\\":\\\"alert\\\",\\\"variant\\\":\\\"success\\\",\\\"title\\\":\\\"Funcionou\\\",\\\"text\\\":\\\"Este JSON foi renderizado dentro do sandbox.\\\"},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Ação de teste\\\",\\\"variant\\\":\\\"primary\\\",\\\"action\\\":\\\"sandbox_action\\\"}]}}}\"\n    );\n\n    if (juifState.has(key)) {\n        initialJson = String.valueOf(juifState.opt(key));\n    } else {\n        juifSetStateValue(key, initialJson);\n    }\n\n    LinearLayout box = new LinearLayout(appContext);\n    box.setOrientation(LinearLayout.VERTICAL);\n    box.setPadding(dp(16), dp(14), dp(16), dp(14));\n    box.setBackground(juifBgStroke(JUIF_SURFACE, 24, JUIF_PRIMARY_DARK, 1));\n\n    juifApplyVerticalMargin(box, 10, 10);\n\n    box.addView(juifText(node.optString(\"title\", \"Sandbox JUIF\"), 18f, JUIF_TEXT, Typeface.BOLD));\n    box.addView(juifText(node.optString(\"subtitle\", \"Digite, formate, escape, copie e renderize um ui_json.\"), 13f, JUIF_TEXT_MUTED, Typeface.NORMAL));\n    box.addView(juifSpace(10));\n\n    final EditText editor = new EditText(appContext);\n    editor.setText(initialJson);\n    editor.setTextSize(13f);\n    editor.setTypeface(Typeface.MONOSPACE);\n    editor.setTextColor(JUIF_TEXT);\n    editor.setHintTextColor(JUIF_TEXT_MUTED);\n    editor.setMinLines(node.optInt(\"min_lines\", 8));\n    editor.setGravity(Gravity.TOP | Gravity.START);\n    editor.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);\n    editor.setPadding(dp(14), dp(12), dp(14), dp(12));\n    editor.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n\n    editor.setFocusable(true);\n    editor.setFocusableInTouchMode(true);\n    editor.setClickable(true);\n\n    editor.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                editor.requestFocus();\n\n                editor.postDelayed(new Runnable() {\n                    public void run() {\n                        try {\n                            InputMethodManager imm =\n                                (InputMethodManager) appContext.getSystemService(Context.INPUT_METHOD_SERVICE);\n\n                            if (imm != null) {\n                                imm.showSoftInput(editor, InputMethodManager.SHOW_IMPLICIT);\n                            }\n                        } catch(Exception ignored) {}\n                    }\n                }, 120);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    editor.addTextChangedListener(new TextWatcher() {\n        public void beforeTextChanged(CharSequence s, int start, int count, int after) {}\n\n        public void onTextChanged(CharSequence s, int start, int before, int count) {\n            try {\n                juifSetStateValue(key, s.toString());\n            } catch(Exception ignored) {}\n        }\n\n        public void afterTextChanged(Editable s) {}\n    });\n\n    box.addView(editor);\n\n    final TextView status = juifText(\"Sandbox pronto.\", 13f, JUIF_TEXT_MUTED, Typeface.BOLD);\n    status.setPadding(0, dp(8), 0, dp(8));\n    box.addView(status);\n\n    LinearLayout actions1 = new LinearLayout(appContext);\n    actions1.setOrientation(LinearLayout.HORIZONTAL);\n\n    TextView formatBtn = juifText(\"Formatar\", 13f, JUIF_BG, Typeface.BOLD);\n    formatBtn.setGravity(Gravity.CENTER);\n    formatBtn.setPadding(dp(8), dp(10), dp(8), dp(10));\n    formatBtn.setBackground(juifBgStroke(JUIF_PRIMARY, 14, JUIF_PRIMARY, 1));\n\n    TextView renderBtn = juifText(\"Renderizar\", 13f, JUIF_BG, Typeface.BOLD);\n    renderBtn.setGravity(Gravity.CENTER);\n    renderBtn.setPadding(dp(8), dp(10), dp(8), dp(10));\n    renderBtn.setBackground(juifBgStroke(JUIF_PRIMARY, 14, JUIF_PRIMARY, 1));\n\n    LinearLayout.LayoutParams halfLp1 = new LinearLayout.LayoutParams(0, -2, 1f);\n    halfLp1.setMargins(0, dp(4), dp(4), dp(4));\n\n    LinearLayout.LayoutParams halfLp2 = new LinearLayout.LayoutParams(0, -2, 1f);\n    halfLp2.setMargins(dp(4), dp(4), 0, dp(4));\n\n    actions1.addView(formatBtn, halfLp1);\n    actions1.addView(renderBtn, halfLp2);\n\n    box.addView(actions1);\n\n    LinearLayout actions2 = new LinearLayout(appContext);\n    actions2.setOrientation(LinearLayout.HORIZONTAL);\n\n    TextView copyBtn = juifText(\"Copiar\", 13f, JUIF_PRIMARY, Typeface.BOLD);\n    copyBtn.setGravity(Gravity.CENTER);\n    copyBtn.setPadding(dp(8), dp(10), dp(8), dp(10));\n    copyBtn.setBackground(juifBgStroke(JUIF_SURFACE_2, 14, JUIF_PRIMARY_DARK, 1));\n\n    TextView copyEscapedBtn = juifText(\"Copiar escaped\", 13f, JUIF_PRIMARY, Typeface.BOLD);\n    copyEscapedBtn.setGravity(Gravity.CENTER);\n    copyEscapedBtn.setPadding(dp(8), dp(10), dp(8), dp(10));\n    copyEscapedBtn.setBackground(juifBgStroke(JUIF_SURFACE_2, 14, JUIF_PRIMARY_DARK, 1));\n\n    LinearLayout.LayoutParams halfLp3 = new LinearLayout.LayoutParams(0, -2, 1f);\n    halfLp3.setMargins(0, dp(4), dp(4), dp(4));\n\n    LinearLayout.LayoutParams halfLp4 = new LinearLayout.LayoutParams(0, -2, 1f);\n    halfLp4.setMargins(dp(4), dp(4), 0, dp(4));\n\n    actions2.addView(copyBtn, halfLp3);\n    actions2.addView(copyEscapedBtn, halfLp4);\n\n    box.addView(actions2);\n\n    box.addView(juifSpace(10));\n    box.addView(juifText(\"PREVIEW\", 12f, JUIF_PRIMARY, Typeface.BOLD));\n\n    final LinearLayout preview = new LinearLayout(appContext);\n    preview.setOrientation(LinearLayout.VERTICAL);\n    preview.setPadding(dp(14), dp(14), dp(14), dp(14));\n    preview.setBackground(juifBgStroke(JUIF_BG, 20, JUIF_BORDER, 1));\n\n    juifApplyVerticalMargin(preview, 8, 8);\n\n    box.addView(preview);\n\n    formatBtn.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                String formatted = juifPrettyCode(editor.getText().toString());\n                editor.setText(formatted);\n                juifSetStateValue(key, formatted);\n                status.setText(\"JSON formatado.\");\n                status.setTextColor(JUIF_SUCCESS);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                juifEmit(\"sandbox_formatted\", extra);\n\n            } catch(Exception ignored) {}\n        }\n    });\n\n    renderBtn.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                String current = editor.getText().toString();\n                juifSetStateValue(key, current);\n                juifRenderSandboxPreview(current, preview, status);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                juifEmit(\"sandbox_rendered\", extra);\n\n            } catch(Exception ignored) {}\n        }\n    });\n\n    copyBtn.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                String current = editor.getText().toString();\n                juifCopyToClipboard(\"JUIF Sandbox JSON\", current);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"format\", \"raw\");\n                juifEmit(\"sandbox_copied\", extra);\n\n            } catch(Exception ignored) {}\n        }\n    });\n\n    copyEscapedBtn.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                String current = editor.getText().toString();\n                String formatted = juifPrettyCode(current);\n                String escaped = juifEscapeJavaString(formatted);\n\n                juifCopyToClipboard(\"JUIF Sandbox Escaped JSON\", escaped);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"format\", \"escaped\");\n                juifEmit(\"sandbox_copied\", extra);\n\n            } catch(Exception ignored) {}\n        }\n    });\n\n    juifRenderSandboxPreview(initialJson, preview, status);\n\n    return box;\n}\n\n\n\n/* =========================\n   EXTENDED COMPONENT CATALOG\n========================= */\n\nvoid juifStyleNavigationItem(TextView item, boolean selected, boolean compact) {\n    int color = selected ? JUIF_PRIMARY : JUIF_TEXT_MUTED;\n    int background = selected ? JUIF_SURFACE_3 : Color.TRANSPARENT;\n    item.setTextColor(color);\n    item.setTypeface(Typeface.create(\"sans-serif\", selected ? Typeface.BOLD : Typeface.NORMAL));\n    item.setBackground(juifBgStroke(background, compact ? 14 : 18, selected ? JUIF_PRIMARY_DARK : Color.TRANSPARENT, selected ? 1 : 0));\n}\n\nString juifNavigationLabel(JSONObject item) {\n    String icon = item.optString(\"icon\", \"\");\n    String label = item.optString(\"label\", item.optString(\"text\", item.optString(\"id\", \"Item\")));\n    return icon.length() > 0 ? icon + \"\\n\" + label : label;\n}\n\nLinearLayout JUIFTopAppBar(final JSONObject node) throws Exception {\n    LinearLayout outer = new LinearLayout(appContext);\n    outer.setOrientation(LinearLayout.VERTICAL);\n    outer.setBackgroundColor(JUIF_BG);\n\n    LinearLayout bar = new LinearLayout(appContext);\n    bar.setOrientation(LinearLayout.HORIZONTAL);\n    bar.setGravity(Gravity.CENTER_VERTICAL);\n    bar.setPadding(\n        dp(14),\n        dp(node.optInt(\"safe_top\", 18)),\n        dp(14),\n        dp(10)\n    );\n\n    final String navigationAction = node.optString(\"navigation_action\", \"\");\n    final String navigationTarget = node.optString(\"navigation_target\", \"\");\n    String navigationText = node.optString(\"navigation_text\", \"\");\n    if (navigationText.length() == 0 && \"back\".equals(navigationAction)) navigationText = \"‹\";\n    if (navigationText.length() == 0 && \"open_drawer\".equals(navigationAction)) navigationText = \"≡\";\n\n    if (navigationAction.length() > 0) {\n        TextView nav = juifText(navigationText, 23f, JUIF_TEXT, Typeface.NORMAL);\n        nav.setGravity(Gravity.CENTER);\n        nav.setPadding(0, 0, 0, dp(2));\n        nav.setBackground(juifPressableBackground(JUIF_SURFACE_2, 15, JUIF_BORDER, 1));\n        nav.setOnClickListener(new View.OnClickListener() {\n            public void onClick(View v) {\n                juifDispatchAction(navigationAction, navigationTarget, null);\n            }\n        });\n        LinearLayout.LayoutParams navLp = new LinearLayout.LayoutParams(dp(42), dp(42));\n        navLp.setMargins(0, 0, dp(12), 0);\n        bar.addView(nav, navLp);\n    }\n\n    LinearLayout titles = new LinearLayout(appContext);\n    titles.setOrientation(LinearLayout.VERTICAL);\n    titles.setGravity(Gravity.CENTER_VERTICAL);\n\n    TextView title = juifText(node.optString(\"title\", \"JUIF\"), 18f, JUIF_TEXT, Typeface.BOLD);\n    title.setSingleLine(true);\n    title.setEllipsize(TextUtils.TruncateAt.END);\n    titles.addView(title);\n\n    String subtitleValue = node.optString(\"subtitle\", \"\");\n    if (subtitleValue.length() > 0) {\n        TextView subtitle = juifText(subtitleValue, 11.5f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n        subtitle.setSingleLine(true);\n        subtitle.setEllipsize(TextUtils.TruncateAt.END);\n        subtitle.setPadding(0, dp(2), 0, 0);\n        titles.addView(subtitle);\n    }\n\n    bar.addView(titles, new LinearLayout.LayoutParams(0, -2, 1f));\n\n    JSONArray actions = node.optJSONArray(\"actions\");\n    if (actions != null) {\n        for (int i = 0; i < actions.length(); i++) {\n            final JSONObject actionNode = actions.getJSONObject(i);\n            String actionText = actionNode.optString(\"icon\", actionNode.optString(\"text\", actionNode.optString(\"label\", \"•\")));\n            TextView actionView = juifText(actionText, 17f, JUIF_TEXT, Typeface.BOLD);\n            actionView.setGravity(Gravity.CENTER);\n            actionView.setBackground(juifPressableBackground(JUIF_SURFACE_2, 15, JUIF_BORDER, 1));\n            actionView.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        JSONObject extra = new JSONObject();\n                        extra.put(\"source\", \"top_app_bar\");\n                        juifDispatchAction(\n                            actionNode.optString(\"action\", \"app_bar_action\"),\n                            actionNode.optString(\"target\", \"\"),\n                            extra\n                        );\n                    } catch(Exception ignored) {}\n                }\n            });\n            LinearLayout.LayoutParams actionLp = new LinearLayout.LayoutParams(dp(42), dp(42));\n            actionLp.setMargins(dp(8), 0, 0, 0);\n            bar.addView(actionView, actionLp);\n        }\n    }\n\n    outer.addView(bar, new LinearLayout.LayoutParams(-1, -2));\n    outer.addView(juifDividerView());\n    juifApplyElevation(outer, 4f);\n    return outer;\n}\n\nLinearLayout JUIFBottomNavigation(final JSONObject node) throws Exception {\n    final LinearLayout outer = new LinearLayout(appContext);\n    outer.setOrientation(LinearLayout.VERTICAL);\n    outer.setBackgroundColor(JUIF_SURFACE);\n    outer.addView(juifDividerView());\n\n    final LinearLayout bar = new LinearLayout(appContext);\n    bar.setOrientation(LinearLayout.HORIZONTAL);\n    bar.setGravity(Gravity.CENTER);\n    bar.setPadding(dp(10), dp(7), dp(10), dp(node.optInt(\"safe_bottom\", 11)));\n\n    final String key = node.optString(\"key\", \"bottom_navigation\");\n    final String selected = juifSelectedValue(node, \"\");\n    JSONArray items = node.optJSONArray(\"items\");\n\n    if (items != null) {\n        for (int i = 0; i < items.length(); i++) {\n            final JSONObject item = items.getJSONObject(i);\n            final String itemId = item.optString(\"id\", \"item_\" + i);\n            boolean active = juifNavigationItemSelected(item, itemId, selected, juifCurrentPageId);\n\n            final LinearLayout cell = new LinearLayout(appContext);\n            cell.setOrientation(LinearLayout.VERTICAL);\n            cell.setGravity(Gravity.CENTER);\n            cell.setTag(itemId);\n            cell.setPadding(dp(5), dp(4), dp(5), dp(5));\n            cell.setBackground(\n                juifPressableBackground(\n                    active ? juifColorWithAlpha(JUIF_PRIMARY, 20) : Color.TRANSPARENT,\n                    16,\n                    Color.TRANSPARENT,\n                    0\n                )\n            );\n\n            View indicator = new View(appContext);\n            indicator.setBackground(juifBg(active ? JUIF_PRIMARY : Color.TRANSPARENT, 999));\n            LinearLayout.LayoutParams indicatorLp = new LinearLayout.LayoutParams(dp(24), dp(3));\n            indicatorLp.setMargins(0, 0, 0, dp(5));\n            cell.addView(indicator, indicatorLp);\n\n            String iconValue = item.optString(\"icon\", \"\");\n            if (iconValue.length() > 0) {\n                TextView icon = juifNavigationGlyph(iconValue, active);\n                cell.addView(icon, new LinearLayout.LayoutParams(-2, dp(22)));\n            }\n\n            TextView label = juifText(\n                item.optString(\"label\", itemId),\n                10.5f,\n                active ? JUIF_PRIMARY : JUIF_TEXT_MUTED,\n                active ? Typeface.BOLD : Typeface.NORMAL\n            );\n            label.setGravity(Gravity.CENTER);\n            label.setSingleLine(true);\n            label.setEllipsize(TextUtils.TruncateAt.END);\n            cell.addView(label, new LinearLayout.LayoutParams(-1, dp(22)));\n\n            cell.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        juifSetStateValue(key, itemId);\n                        JSONObject extra = new JSONObject();\n                        extra.put(\"key\", key);\n                        extra.put(\"item_id\", itemId);\n                        extra.put(\"source\", \"bottom_navigation\");\n                        String target = item.optString(\"target\", \"\");\n                        String action = item.optString(\n                            \"action\",\n                            target.length() > 0 ? \"replace\" : \"navigation_selected\"\n                        );\n                        juifDispatchAction(action, target, extra);\n                        if (target.length() == 0 && juifHasPage(juifCurrentPageId)) {\n                            juifRenderShell(juifPages.getJSONObject(juifCurrentPageId));\n                        }\n                    } catch(Exception ignored) {}\n                }\n            });\n\n            LinearLayout.LayoutParams cellLp = new LinearLayout.LayoutParams(0, dp(58), 1f);\n            cellLp.setMargins(dp(3), 0, dp(3), 0);\n            bar.addView(cell, cellLp);\n        }\n    }\n\n    outer.addView(bar, new LinearLayout.LayoutParams(-1, -2));\n    juifApplyElevation(outer, 8f);\n    return outer;\n}\n\nLinearLayout JUIFNavigationRail(final JSONObject node) throws Exception {\n    final LinearLayout rail = new LinearLayout(appContext);\n    rail.setOrientation(LinearLayout.VERTICAL);\n    rail.setGravity(Gravity.TOP | Gravity.CENTER_HORIZONTAL);\n    rail.setPadding(dp(8), dp(12), dp(8), dp(12));\n    rail.setBackground(juifBgStroke(JUIF_SURFACE, 0, JUIF_DIVIDER, 1));\n\n    final String key = node.optString(\"key\", \"navigation_rail\");\n    final String selected = juifSelectedValue(node, \"\");\n    JSONArray items = node.optJSONArray(\"items\");\n\n    if (items != null) {\n        for (int i = 0; i < items.length(); i++) {\n            final JSONObject item = items.getJSONObject(i);\n            final String itemId = item.optString(\"id\", \"item_\" + i);\n            boolean active = juifNavigationItemSelected(item, itemId, selected, juifCurrentPageId);\n\n            LinearLayout cell = new LinearLayout(appContext);\n            cell.setOrientation(LinearLayout.VERTICAL);\n            cell.setGravity(Gravity.CENTER);\n            cell.setTag(itemId);\n            cell.setPadding(dp(5), dp(8), dp(5), dp(7));\n            cell.setBackground(\n                juifPressableBackground(\n                    active ? juifColorWithAlpha(JUIF_PRIMARY, 24) : Color.TRANSPARENT,\n                    16,\n                    active ? JUIF_PRIMARY_DARK : Color.TRANSPARENT,\n                    active ? 1 : 0\n                )\n            );\n\n            String iconValue = item.optString(\"icon\", \"\");\n            if (iconValue.length() == 0) {\n                String labelValue = item.optString(\"label\", itemId);\n                iconValue = labelValue.length() > 0 ? labelValue.substring(0, 1).toUpperCase() : \"•\";\n            }\n\n            TextView icon = juifNavigationGlyph(iconValue, active);\n            icon.setBackground(\n                juifBg(\n                    active ? juifColorWithAlpha(JUIF_PRIMARY, 26) : JUIF_SURFACE_2,\n                    999\n                )\n            );\n            cell.addView(icon, new LinearLayout.LayoutParams(dp(34), dp(34)));\n\n            TextView label = juifText(\n                item.optString(\"label\", itemId),\n                10f,\n                active ? JUIF_PRIMARY : JUIF_TEXT_MUTED,\n                active ? Typeface.BOLD : Typeface.NORMAL\n            );\n            label.setGravity(Gravity.CENTER);\n            label.setSingleLine(true);\n            label.setEllipsize(TextUtils.TruncateAt.END);\n            label.setPadding(0, dp(4), 0, 0);\n            cell.addView(label, new LinearLayout.LayoutParams(-1, dp(22)));\n\n            cell.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        juifSetStateValue(key, itemId);\n                        JSONObject extra = new JSONObject();\n                        extra.put(\"key\", key);\n                        extra.put(\"item_id\", itemId);\n                        extra.put(\"source\", \"navigation_rail\");\n                        String target = item.optString(\"target\", \"\");\n                        juifDispatchAction(\n                            item.optString(\"action\", target.length() > 0 ? \"replace\" : \"navigation_selected\"),\n                            target,\n                            extra\n                        );\n                    } catch(Exception ignored) {}\n                }\n            });\n\n            LinearLayout.LayoutParams cellLp = new LinearLayout.LayoutParams(\n                dp(node.optInt(\"item_width\", 68)),\n                dp(72)\n            );\n            cellLp.setMargins(0, dp(3), 0, dp(3));\n            rail.addView(cell, cellLp);\n        }\n    }\n\n    return rail;\n}\n\nLinearLayout JUIFNavigationDrawer(final JSONObject node) throws Exception {\n    final LinearLayout drawer = new LinearLayout(appContext);\n    drawer.setOrientation(LinearLayout.VERTICAL);\n    drawer.setPadding(dp(18), dp(node.optInt(\"safe_top\", 24)), dp(18), dp(18));\n    drawer.setBackgroundColor(JUIF_SURFACE);\n    juifApplyElevation(drawer, 18f);\n\n    LinearLayout header = new LinearLayout(appContext);\n    header.setOrientation(LinearLayout.HORIZONTAL);\n    header.setGravity(Gravity.CENTER_VERTICAL);\n\n    LinearLayout titles = new LinearLayout(appContext);\n    titles.setOrientation(LinearLayout.VERTICAL);\n    TextView title = juifText(node.optString(\"title\", \"JUIF\"), 20f, JUIF_TEXT, Typeface.BOLD);\n    titles.addView(title);\n    String subtitleValue = node.optString(\"subtitle\", \"\");\n    if (subtitleValue.length() > 0) {\n        TextView subtitle = juifText(subtitleValue, 12f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n        subtitle.setPadding(0, dp(3), 0, 0);\n        titles.addView(subtitle);\n    }\n    header.addView(titles, new LinearLayout.LayoutParams(0, -2, 1f));\n\n    if (node.optBoolean(\"show_close\", true)) {\n        TextView close = juifText(\"×\", 20f, JUIF_TEXT, Typeface.NORMAL);\n        close.setGravity(Gravity.CENTER);\n        close.setBackground(juifPressableBackground(JUIF_SURFACE_2, 14, JUIF_BORDER, 1));\n        close.setOnClickListener(new View.OnClickListener() {\n            public void onClick(View v) { juifCloseDrawer(true); }\n        });\n        header.addView(close, new LinearLayout.LayoutParams(dp(40), dp(40)));\n    }\n\n    drawer.addView(header);\n    drawer.addView(juifSpace(18));\n    drawer.addView(juifDividerView());\n    drawer.addView(juifSpace(10));\n\n    final String key = node.optString(\"key\", \"navigation_drawer\");\n    final String selected = juifSelectedValue(node, \"\");\n    JSONArray items = node.optJSONArray(\"items\");\n\n    if (items != null) {\n        for (int i = 0; i < items.length(); i++) {\n            final JSONObject item = items.getJSONObject(i);\n            final String itemId = item.optString(\"id\", \"item_\" + i);\n            boolean active = juifNavigationItemSelected(item, itemId, selected, juifCurrentPageId);\n\n            LinearLayout row = new LinearLayout(appContext);\n            row.setOrientation(LinearLayout.HORIZONTAL);\n            row.setGravity(Gravity.CENTER_VERTICAL);\n            row.setPadding(dp(10), dp(8), dp(10), dp(8));\n            row.setTag(itemId);\n            row.setBackground(\n                juifPressableBackground(\n                    active ? juifColorWithAlpha(JUIF_PRIMARY, 22) : Color.TRANSPARENT,\n                    16,\n                    active ? JUIF_PRIMARY_DARK : Color.TRANSPARENT,\n                    active ? 1 : 0\n                )\n            );\n\n            String iconValue = item.optString(\"icon\", \"\");\n            if (iconValue.length() == 0) {\n                String labelValue = item.optString(\"label\", itemId);\n                iconValue = labelValue.length() > 0 ? labelValue.substring(0, 1).toUpperCase() : \"•\";\n            }\n            TextView icon = juifNavigationGlyph(iconValue, active);\n            icon.setBackground(\n                juifBg(\n                    active ? juifColorWithAlpha(JUIF_PRIMARY, 28) : JUIF_SURFACE_2,\n                    12\n                )\n            );\n            LinearLayout.LayoutParams iconLp = new LinearLayout.LayoutParams(dp(38), dp(38));\n            iconLp.setMargins(0, 0, dp(12), 0);\n            row.addView(icon, iconLp);\n\n            LinearLayout copy = new LinearLayout(appContext);\n            copy.setOrientation(LinearLayout.VERTICAL);\n            TextView label = juifText(\n                item.optString(\"label\", itemId),\n                14f,\n                active ? JUIF_PRIMARY : JUIF_TEXT,\n                active ? Typeface.BOLD : Typeface.NORMAL\n            );\n            copy.addView(label);\n            String itemSubtitle = item.optString(\"subtitle\", \"\");\n            if (itemSubtitle.length() > 0) {\n                TextView subtitle = juifText(itemSubtitle, 11.5f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n                subtitle.setPadding(0, dp(2), 0, 0);\n                copy.addView(subtitle);\n            }\n            row.addView(copy, new LinearLayout.LayoutParams(0, -2, 1f));\n\n            TextView chevron = juifText(\"›\", 19f, active ? JUIF_PRIMARY : JUIF_TEXT_DISABLED, Typeface.NORMAL);\n            chevron.setGravity(Gravity.CENTER);\n            row.addView(chevron, new LinearLayout.LayoutParams(dp(24), dp(32)));\n\n            row.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        juifSetStateValue(key, itemId);\n                        JSONObject extra = new JSONObject();\n                        extra.put(\"key\", key);\n                        extra.put(\"item_id\", itemId);\n                        extra.put(\"source\", \"navigation_drawer\");\n                        String target = item.optString(\"target\", \"\");\n                        String action = item.optString(\n                            \"action\",\n                            target.length() > 0 ? \"replace\" : \"navigation_selected\"\n                        );\n                        juifCloseDrawer(false);\n                        juifDispatchAction(action, target, extra);\n                    } catch(Exception ignored) {}\n                }\n            });\n\n            LinearLayout.LayoutParams rowLp = new LinearLayout.LayoutParams(-1, -2);\n            rowLp.setMargins(0, dp(3), 0, dp(3));\n            drawer.addView(row, rowLp);\n        }\n    }\n\n    String footer = node.optString(\"footer\", \"\");\n    if (footer.length() > 0) {\n        Space flex = new Space(appContext);\n        drawer.addView(flex, new LinearLayout.LayoutParams(1, 0, 1f));\n        drawer.addView(juifDividerView());\n        TextView footerView = juifText(footer, 11f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n        footerView.setPadding(0, dp(12), 0, 0);\n        drawer.addView(footerView);\n    }\n\n    return drawer;\n}\n\nHorizontalScrollView JUIFTabBar(final JSONObject node) throws Exception {\n    final HorizontalScrollView scroll = new HorizontalScrollView(appContext);\n    scroll.setHorizontalScrollBarEnabled(false);\n    scroll.setFillViewport(false);\n    scroll.setBackgroundColor(JUIF_BG);\n\n    final LinearLayout row = new LinearLayout(appContext);\n    row.setOrientation(LinearLayout.HORIZONTAL);\n    row.setGravity(Gravity.CENTER_VERTICAL);\n    row.setPadding(dp(12), dp(2), dp(12), 0);\n\n    final String key = node.optString(\"key\", \"tab_bar\");\n    final String selected = juifSelectedValue(node, \"\");\n    JSONArray items = node.optJSONArray(\"items\");\n\n    if (items != null) {\n        for (int i = 0; i < items.length(); i++) {\n            final JSONObject item = items.getJSONObject(i);\n            final String itemId = item.optString(\"id\", \"tab_\" + i);\n            boolean active = juifNavigationItemSelected(item, itemId, selected, juifCurrentPageId);\n\n            LinearLayout tab = new LinearLayout(appContext);\n            tab.setOrientation(LinearLayout.VERTICAL);\n            tab.setGravity(Gravity.CENTER);\n            tab.setTag(itemId);\n            tab.setPadding(dp(4), dp(8), dp(4), 0);\n            tab.setBackground(juifPressableBackground(Color.TRANSPARENT, 12, Color.TRANSPARENT, 0));\n\n            TextView label = juifText(\n                item.optString(\"label\", itemId),\n                13f,\n                active ? JUIF_PRIMARY : JUIF_TEXT_MUTED,\n                active ? Typeface.BOLD : Typeface.NORMAL\n            );\n            label.setGravity(Gravity.CENTER);\n            label.setSingleLine(true);\n            tab.addView(label, new LinearLayout.LayoutParams(-2, dp(30)));\n\n            View indicator = new View(appContext);\n            indicator.setBackground(juifBg(active ? JUIF_PRIMARY : Color.TRANSPARENT, 999));\n            LinearLayout.LayoutParams indicatorLp = new LinearLayout.LayoutParams(-1, dp(3));\n            indicatorLp.setMargins(dp(4), 0, dp(4), 0);\n            tab.addView(indicator, indicatorLp);\n\n            tab.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        juifSetStateValue(key, itemId);\n                        JSONObject extra = new JSONObject();\n                        extra.put(\"key\", key);\n                        extra.put(\"item_id\", itemId);\n                        extra.put(\"source\", \"tab_bar\");\n                        String target = item.optString(\"target\", \"\");\n                        String action = item.optString(\n                            \"action\",\n                            target.length() > 0 ? \"replace\" : \"tab_selected\"\n                        );\n                        juifDispatchAction(action, target, extra);\n                        if (target.length() == 0 && juifHasPage(juifCurrentPageId)) {\n                            juifRenderShell(juifPages.getJSONObject(juifCurrentPageId));\n                        }\n                    } catch(Exception ignored) {}\n                }\n            });\n\n            LinearLayout.LayoutParams tabLp = new LinearLayout.LayoutParams(-2, dp(49));\n            tabLp.setMargins(dp(5), 0, dp(5), 0);\n            row.addView(tab, tabLp);\n        }\n    }\n\n    scroll.addView(row, new HorizontalScrollView.LayoutParams(-2, dp(49)));\n    return scroll;\n}\n\nLinearLayout JUIFSearchBar(final JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"search\");\n    String value = juifState.has(key) ? String.valueOf(juifState.opt(key)) : node.optString(\"value\", \"\");\n\n    final LinearLayout shell = new LinearLayout(appContext);\n    shell.setOrientation(LinearLayout.HORIZONTAL);\n    shell.setGravity(Gravity.CENTER_VERTICAL);\n    shell.setPadding(dp(13), dp(4), dp(7), dp(4));\n    shell.setBackground(juifPressableBackground(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n    juifApplyVerticalMargin(shell, 8, 8);\n\n    TextView icon = juifText(\"⌕\", 20f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n    icon.setGravity(Gravity.CENTER);\n    LinearLayout.LayoutParams iconLp = new LinearLayout.LayoutParams(dp(30), dp(44));\n    iconLp.setMargins(0, 0, dp(4), 0);\n    shell.addView(icon, iconLp);\n\n    final EditText search = new EditText(appContext);\n    search.setSingleLine(true);\n    search.setText(value);\n    search.setHint(node.optString(\"hint\", \"Pesquisar\"));\n    search.setTextColor(JUIF_TEXT);\n    search.setHintTextColor(JUIF_TEXT_MUTED);\n    search.setTextSize(14.5f);\n    search.setPadding(0, 0, 0, 0);\n    search.setBackgroundColor(Color.TRANSPARENT);\n    search.setInputType(InputType.TYPE_CLASS_TEXT);\n    search.setImeOptions(EditorInfo.IME_ACTION_SEARCH);\n    shell.addView(search, new LinearLayout.LayoutParams(0, dp(48), 1f));\n\n    final TextView clear = juifText(\"×\", 18f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n    clear.setGravity(Gravity.CENTER);\n    clear.setBackground(juifPressableBackground(Color.TRANSPARENT, 12, Color.TRANSPARENT, 0));\n    clear.setVisibility(value.length() > 0 && node.optBoolean(\"clearable\", true) ? View.VISIBLE : View.GONE);\n    clear.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            search.setText(\"\");\n            search.requestFocus();\n        }\n    });\n    shell.addView(clear, new LinearLayout.LayoutParams(dp(38), dp(38)));\n\n    search.addTextChangedListener(new TextWatcher() {\n        public void beforeTextChanged(CharSequence s, int start, int count, int after) {}\n        public void onTextChanged(CharSequence s, int start, int before, int count) {\n            try {\n                String current = s.toString();\n                juifSetStateValue(key, current);\n                clear.setVisibility(current.length() > 0 && node.optBoolean(\"clearable\", true) ? View.VISIBLE : View.GONE);\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", current);\n                juifEmit(node.optString(\"change_action\", \"search_changed\"), extra);\n            } catch(Exception ignored) {}\n        }\n        public void afterTextChanged(Editable s) {}\n    });\n\n    search.setOnEditorActionListener(new TextView.OnEditorActionListener() {\n        public boolean onEditorAction(TextView v, int actionId, android.view.KeyEvent event) {\n            if (actionId == EditorInfo.IME_ACTION_SEARCH) {\n                try {\n                    JSONObject extra = new JSONObject();\n                    extra.put(\"key\", key);\n                    extra.put(\"value\", search.getText().toString());\n                    juifEmit(node.optString(\"submit_action\", \"search_submitted\"), extra);\n                } catch(Exception ignored) {}\n                return true;\n            }\n            return false;\n        }\n    });\n\n    return shell;\n}\n\nTextView JUIFChip(final JSONObject node) throws Exception {\n    final String key = node.optString(\"key\", \"chip\");\n    boolean selected = juifState.has(key)\n        ? juifState.optBoolean(key, false)\n        : node.optBoolean(\"selected\", false);\n\n    juifSetStateValue(key, selected);\n\n    String label = node.optString(\"text\", node.optString(\"label\", \"Filtro\"));\n    String leading = node.optString(\"leading\", \"\");\n    if (leading.length() > 0) label = leading + \"  \" + label;\n\n    final TextView chip = juifText(\n        label,\n        12.5f,\n        selected ? JUIF_PRIMARY : JUIF_TEXT_MUTED,\n        selected ? Typeface.BOLD : Typeface.NORMAL\n    );\n    chip.setGravity(Gravity.CENTER);\n    chip.setPadding(dp(14), dp(8), dp(14), dp(8));\n    juifStyleChipView(chip, selected);\n\n    LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);\n    lp.setMargins(dp(3), dp(4), dp(3), dp(4));\n    chip.setLayoutParams(lp);\n\n    chip.setOnClickListener(new View.OnClickListener() {\n        public void onClick(View v) {\n            try {\n                boolean next = !juifState.optBoolean(key, false);\n                juifSetStateValue(key, next);\n                juifStyleChipView(chip, next);\n\n                JSONObject extra = new JSONObject();\n                extra.put(\"key\", key);\n                extra.put(\"value\", next);\n                juifEmit(node.optString(\"action\", \"chip_changed\"), extra);\n            } catch(Exception ignored) {}\n        }\n    });\n\n    return chip;\n}\n\nHorizontalScrollView JUIFChipGroup(final JSONObject node) throws Exception {\n    final HorizontalScrollView scroll = new HorizontalScrollView(appContext);\n    scroll.setHorizontalScrollBarEnabled(false);\n    scroll.setFillViewport(false);\n\n    final LinearLayout row = new LinearLayout(appContext);\n    row.setOrientation(LinearLayout.HORIZONTAL);\n    row.setGravity(Gravity.CENTER_VERTICAL);\n    row.setPadding(dp(1), dp(2), dp(8), dp(2));\n\n    final String key = node.optString(\"key\", \"chip_group\");\n    final boolean multiple = \"multiple\".equals(node.optString(\"selection_mode\", \"single\"));\n\n    final JSONArray selectedMany;\n    final String selectedOne;\n\n    if (multiple) {\n        if (juifState.opt(key) instanceof JSONArray) {\n            selectedMany = juifState.optJSONArray(key);\n        } else {\n            selectedMany = node.optJSONArray(\"selected\");\n            if (selectedMany == null) selectedMany = new JSONArray();\n            juifSetStateValue(key, selectedMany);\n        }\n        selectedOne = \"\";\n    } else {\n        selectedMany = new JSONArray();\n        selectedOne = juifState.has(key)\n            ? String.valueOf(juifState.opt(key))\n            : node.optString(\"selected\", \"\");\n        if (!juifState.has(key) && selectedOne.length() > 0) {\n            juifSetStateValue(key, selectedOne);\n        }\n    }\n\n    JSONArray items = node.optJSONArray(\"items\");\n    if (items != null) {\n        for (int i = 0; i < items.length(); i++) {\n            final JSONObject item = items.getJSONObject(i);\n            final String itemId = item.optString(\"id\", \"chip_\" + i);\n            boolean selected = multiple\n                ? juifJsonArrayContains(selectedMany, itemId)\n                : itemId.equals(selectedOne);\n\n            String labelValue = item.optString(\"label\", itemId);\n            String leading = item.optString(\"leading\", \"\");\n            if (leading.length() > 0) labelValue = leading + \"  \" + labelValue;\n\n            TextView chip = juifText(\n                labelValue,\n                12.5f,\n                selected ? JUIF_PRIMARY : JUIF_TEXT_MUTED,\n                selected ? Typeface.BOLD : Typeface.NORMAL\n            );\n            chip.setTag(itemId);\n            chip.setGravity(Gravity.CENTER);\n            chip.setPadding(dp(14), dp(8), dp(14), dp(8));\n            juifStyleChipView(chip, selected);\n\n            LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(-2, -2);\n            lp.setMargins(dp(3), dp(3), dp(3), dp(3));\n\n            chip.setOnClickListener(new View.OnClickListener() {\n                public void onClick(View v) {\n                    try {\n                        if (multiple) {\n                            JSONArray current = juifState.opt(key) instanceof JSONArray\n                                ? juifState.optJSONArray(key)\n                                : new JSONArray();\n                            JSONArray next = new JSONArray();\n                            boolean removed = false;\n\n                            for (int x = 0; x < current.length(); x++) {\n                                String existing = String.valueOf(current.opt(x));\n                                if (itemId.equals(existing)) removed = true;\n                                else next.put(existing);\n                            }\n                            if (!removed) next.put(itemId);\n                            juifSetStateValue(key, next);\n\n                            for (int c = 0; c < row.getChildCount(); c++) {\n                                View child = row.getChildAt(c);\n                                if (child instanceof TextView) {\n                                    juifStyleChipView(\n                                        (TextView)child,\n                                        juifJsonArrayContains(next, String.valueOf(child.getTag()))\n                                    );\n                                }\n                            }\n                        } else {\n                            juifSetStateValue(key, itemId);\n                            for (int c = 0; c < row.getChildCount(); c++) {\n                                View child = row.getChildAt(c);\n                                if (child instanceof TextView) {\n                                    juifStyleChipView(\n                                        (TextView)child,\n                                        itemId.equals(String.valueOf(child.getTag()))\n                                    );\n                                }\n                            }\n                        }\n\n                        JSONObject extra = new JSONObject();\n                        extra.put(\"key\", key);\n                        extra.put(\"item_id\", itemId);\n                        extra.put(\"value\", juifState.opt(key));\n                        juifEmit(node.optString(\"action\", \"chip_group_changed\"), extra);\n                    } catch(Exception ignored) {}\n                }\n            });\n\n            row.addView(chip, lp);\n        }\n    }\n\n    scroll.addView(row, new HorizontalScrollView.LayoutParams(-2, -2));\n    juifApplyVerticalMargin(scroll, 5, 5);\n    return scroll;\n}\n\nLinearLayout JUIFEmptyState(JSONObject node) throws Exception {\n    LinearLayout box = new LinearLayout(appContext);\n    box.setOrientation(LinearLayout.VERTICAL);\n    box.setGravity(Gravity.CENTER_HORIZONTAL);\n    box.setPadding(dp(22), dp(24), dp(22), dp(22));\n    box.setBackground(juifBgStroke(JUIF_SURFACE, 24, JUIF_BORDER, 1));\n    juifApplyVerticalMargin(box, 10, 10);\n\n    String eyebrowValue = node.optString(\"eyebrow\", \"\");\n    if (eyebrowValue.length() > 0) {\n        TextView eyebrow = juifText(eyebrowValue.toUpperCase(), 10.5f, JUIF_PRIMARY, Typeface.BOLD);\n        eyebrow.setLetterSpacing(0.12f);\n        eyebrow.setGravity(Gravity.CENTER);\n        box.addView(eyebrow);\n        box.addView(juifSpace(10));\n    }\n\n    String iconValue = node.optString(\"icon\", \"\");\n    if (iconValue.length() > 0) {\n        TextView icon = juifText(iconValue, 23f, JUIF_PRIMARY, Typeface.BOLD);\n        icon.setGravity(Gravity.CENTER);\n        icon.setBackground(juifBgStroke(JUIF_SURFACE_2, 999, JUIF_PRIMARY_DARK, 1));\n        box.addView(icon, new LinearLayout.LayoutParams(dp(54), dp(54)));\n        box.addView(juifSpace(12));\n    }\n\n    TextView title = juifText(node.optString(\"title\", \"Nenhum item\"), 18f, JUIF_TEXT, Typeface.BOLD);\n    title.setGravity(Gravity.CENTER);\n    box.addView(title);\n\n    String message = node.optString(\"text\", node.optString(\"message\", \"\"));\n    if (message.length() > 0) {\n        TextView body = juifText(message, 13.5f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n        body.setGravity(Gravity.CENTER);\n        body.setLineSpacing(0f, 1.1f);\n        body.setPadding(0, dp(7), 0, dp(8));\n        box.addView(body);\n    }\n\n    JSONObject action = node.optJSONObject(\"action\");\n    if (action != null) {\n        LinearLayout actionWrap = new LinearLayout(appContext);\n        actionWrap.setGravity(Gravity.CENTER);\n        View actionButton = JUIFButton(action);\n        actionWrap.addView(actionButton, new LinearLayout.LayoutParams(-1, -2));\n        LinearLayout.LayoutParams actionLp = new LinearLayout.LayoutParams(-1, -2);\n        actionLp.setMargins(0, dp(6), 0, 0);\n        box.addView(actionWrap, actionLp);\n    }\n\n    juifApplyElevation(box, 2f);\n    return box;\n}\n\nLinearLayout JUIFLoadingIndicator(JSONObject node) throws Exception {\n    LinearLayout wrap = new LinearLayout(appContext);\n    wrap.setOrientation(LinearLayout.HORIZONTAL);\n    wrap.setGravity(Gravity.CENTER_VERTICAL);\n    wrap.setPadding(dp(15), dp(13), dp(15), dp(13));\n    wrap.setBackground(juifBgStroke(JUIF_SURFACE_2, 18, JUIF_BORDER, 1));\n    juifApplyVerticalMargin(wrap, 8, 8);\n\n    ProgressBar progress = new ProgressBar(\n        appContext,\n        null,\n        android.R.attr.progressBarStyleSmall\n    );\n    progress.setIndeterminate(true);\n    progress.setIndeterminateTintList(\n        ColorStateList.valueOf(\n            juifVariantColor(node.optString(\"variant\", \"primary\"))\n        )\n    );\n    wrap.addView(progress, new LinearLayout.LayoutParams(dp(26), dp(26)));\n\n    LinearLayout copy = new LinearLayout(appContext);\n    copy.setOrientation(LinearLayout.VERTICAL);\n    copy.setPadding(dp(12), 0, 0, 0);\n\n    TextView title = juifText(\n        node.optString(\"text\", node.optString(\"title\", \"Carregando\")),\n        14f,\n        JUIF_TEXT,\n        Typeface.BOLD\n    );\n    copy.addView(title);\n\n    String subtitleValue = node.optString(\"subtitle\", \"\");\n    if (subtitleValue.length() > 0) {\n        TextView subtitle = juifText(subtitleValue, 11.5f, JUIF_TEXT_MUTED, Typeface.NORMAL);\n        subtitle.setPadding(0, dp(2), 0, 0);\n        copy.addView(subtitle);\n    }\n\n    wrap.addView(copy, new LinearLayout.LayoutParams(0, -2, 1f));\n    return wrap;\n}\n\n/* =========================\n   RENDERER\n========================= */\n\nView juifRenderNode(JSONObject node) throws Exception {\n    String type = node.optString(\"type\", \"text\");\n\n    if (\"text\".equals(type)) return JUIFText(node);\n\n    if (\"button\".equals(type)) return JUIFButton(node);\n    if (\"button_group\".equals(type)) return JUIFButtonGroup(node);\n\n    if (\"input\".equals(type)) return JUIFInput(node);\n    if (\"textarea\".equals(type)) return JUIFTextarea(node);\n    if (\"checkbox\".equals(type)) return JUIFCheckbox(node);\n    if (\"switch\".equals(type)) return JUIFSwitch(node);\n    if (\"select\".equals(type)) return JUIFSelect(node);\n    if (\"radio_group\".equals(type)) return JUIFRadioGroup(node);\n\n    if (\"card\".equals(type)) return JUIFCard(node);\n    if (\"section\".equals(type)) return JUIFSection(node);\n    if (\"container\".equals(type)) return JUIFContainer(node);\n    if (\"column\".equals(type)) return JUIFColumn(node);\n    if (\"row\".equals(type)) return JUIFRow(node);\n    if (\"spacer\".equals(type)) return JUIFSpacer(node);\n    if (\"divider\".equals(type)) return JUIFDivider();\n\n    if (\"alert\".equals(type)) return JUIFAlert(node);\n    if (\"badge\".equals(type)) return JUIFBadge(node);\n    if (\"key_value\".equals(type)) return JUIFKeyValue(node);\n    if (\"list_item\".equals(type)) return JUIFListItem(node);\n\n    if (\"copyable_text\".equals(type)) return JUIFCopyableText(node);\n    if (\"stat_card\".equals(type)) return JUIFStatCard(node);\n    if (\"progress_bar\".equals(type)) return JUIFProgressBar(node);\n    if (\"code_block\".equals(type)) return JUIFCodeBlock(node);\n    if (\"dynamic_list\".equals(type)) return JUIFDynamicList(node);\n    if (\"sandbox\".equals(type)) return JUIFSandbox(node);\n\n    if (\"top_app_bar\".equals(type)) return JUIFTopAppBar(node);\n    if (\"bottom_navigation\".equals(type)) return JUIFBottomNavigation(node);\n    if (\"navigation_rail\".equals(type)) return JUIFNavigationRail(node);\n    if (\"navigation_drawer\".equals(type)) return JUIFNavigationDrawer(node);\n    if (\"tab_bar\".equals(type)) return JUIFTabBar(node);\n    if (\"search_bar\".equals(type)) return JUIFSearchBar(node);\n    if (\"chip\".equals(type)) return JUIFChip(node);\n    if (\"chip_group\".equals(type)) return JUIFChipGroup(node);\n    if (\"empty_state\".equals(type)) return JUIFEmptyState(node);\n    if (\"loading_indicator\".equals(type)) return JUIFLoadingIndicator(node);\n\n    return juifText(\"Componente desconhecido: \" + type, 13f, JUIF_ERROR, Typeface.BOLD);\n}\n\n/* =========================\n   EXECUTION\n========================= */\n\njuifSetBoolean(\"Tmp_JuifVisible\", false);\njuifSetBoolean(\"Tmp_JuifClicked\", false);\njuifSetString(\"Tmp_JuifAction\", \"\");\njuifSetString(\"Tmp_JuifPayload\", \"{}\");\njuifSetString(\"Tmp_JuifState\", \"{}\");\njuifSetString(\"Tmp_JuifCurrentPage\", \"\");\n\ntry {\n    if (android.os.Build.VERSION.SDK_INT >= 23 && !Settings.canDrawOverlays(appContext)) {\n        JSONObject details = new JSONObject();\n        details.put(\"permission\", \"android.permission.SYSTEM_ALERT_WINDOW\");\n        details.put(\"required_for\", \"TYPE_APPLICATION_OVERLAY\");\n        JSONObject error = juifError(\n            \"PERMISSION_DENIED\",\n            \"A permissão para exibir sobre outros apps não está concedida.\",\n            details,\n            true\n        );\n        JSONObject result = juifResult(false, \"blocked\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    }\n\n    final String JUIF_DEFAULT_UI_JSON = \"{lv=Tmp_DefaultUiJson}\";\n\n    String raw = \"{lv=Tmp_JuifUiJsonEscaped}\";\n    boolean usingDefaultUi = false;\n\n    if (\n        raw == null ||\n        raw.trim().length() == 0 ||\n        raw.trim().startsWith(\"{lv=\")\n    ) {\n        raw = JUIF_DEFAULT_UI_JSON;\n        usingDefaultUi = true;\n    }\n\n    raw = raw.trim();\n\n    JSONObject ui = new JSONObject(raw);\n\n    JSONObject initialState = ui.optJSONObject(\"state\");\n\n    if (initialState != null) {\n        JSONArray stateNames = initialState.names();\n\n        if (stateNames != null) {\n            for (int i = 0; i < stateNames.length(); i++) {\n                String name = stateNames.getString(i);\n                juifState.put(name, initialState.get(name));\n            }\n        }\n    }\n\n    juifShell = ui.optJSONObject(\"shell\");\n    juifPages = ui.optJSONObject(\"pages\");\n\n    if (juifPages == null) {\n        juifPages = new JSONObject();\n\n        JSONObject legacyPage = new JSONObject();\n        legacyPage.put(\"title\", ui.optString(\"title\", \"JUIF\"));\n        legacyPage.put(\"subtitle\", ui.optString(\"subtitle\", \"\"));\n\n        JSONArray legacyComponents = ui.optJSONArray(\"components\");\n\n        if (legacyComponents == null) {\n            legacyComponents = new JSONArray();\n        }\n\n        legacyPage.put(\"components\", legacyComponents);\n        juifPages.put(\"main\", legacyPage);\n\n        juifCurrentPageId = \"main\";\n    } else {\n        juifCurrentPageId = ui.optString(\"initial_page\", \"\");\n\n        if (juifCurrentPageId.length() == 0) {\n            JSONArray pageNames = juifPages.names();\n\n            if (pageNames != null && pageNames.length() > 0) {\n                juifCurrentPageId = pageNames.getString(0);\n            }\n        }\n    }\n\n    juifOverlay = new FrameLayout(appContext);\n    juifOverlay.setBackgroundColor(JUIF_OVERLAY);\n    juifOverlay.setFocusable(true);\n    juifOverlay.setFocusableInTouchMode(true);\n\n    juifRootContainer = new LinearLayout(appContext);\n    juifRootContainer.setOrientation(LinearLayout.VERTICAL);\n    juifRootContainer.setBackgroundColor(JUIF_BG);\n\n    juifTopHost = new LinearLayout(appContext);\n    juifTopHost.setOrientation(LinearLayout.VERTICAL);\n    juifTopHost.setVisibility(View.GONE);\n\n    juifTabHost = new LinearLayout(appContext);\n    juifTabHost.setOrientation(LinearLayout.VERTICAL);\n    juifTabHost.setVisibility(View.GONE);\n\n    juifBodyContainer = new LinearLayout(appContext);\n    juifBodyContainer.setOrientation(LinearLayout.HORIZONTAL);\n    juifBodyContainer.setBackgroundColor(JUIF_BG);\n\n    juifRailHost = new LinearLayout(appContext);\n    juifRailHost.setOrientation(LinearLayout.VERTICAL);\n    juifRailHost.setVisibility(View.GONE);\n\n    juifContentScroll = new ScrollView(appContext);\n    juifContentScroll.setFillViewport(true);\n    juifContentScroll.setClipToPadding(false);\n    juifContentScroll.setBackgroundColor(JUIF_BG);\n\n    juifPageContainer = new LinearLayout(appContext);\n    juifPageContainer.setOrientation(LinearLayout.VERTICAL);\n    juifPageContainer.setPadding(dp(20), dp(20), dp(20), dp(28));\n    juifPageContainer.setBackgroundColor(JUIF_BG);\n\n    juifContentScroll.addView(\n        juifPageContainer,\n        new FrameLayout.LayoutParams(\n            FrameLayout.LayoutParams.MATCH_PARENT,\n            FrameLayout.LayoutParams.WRAP_CONTENT\n        )\n    );\n\n    juifBodyContainer.addView(\n        juifRailHost,\n        new LinearLayout.LayoutParams(\n            LinearLayout.LayoutParams.WRAP_CONTENT,\n            LinearLayout.LayoutParams.MATCH_PARENT\n        )\n    );\n    juifBodyContainer.addView(\n        juifContentScroll,\n        new LinearLayout.LayoutParams(\n            0,\n            LinearLayout.LayoutParams.MATCH_PARENT,\n            1f\n        )\n    );\n\n    juifBottomHost = new LinearLayout(appContext);\n    juifBottomHost.setOrientation(LinearLayout.VERTICAL);\n    juifBottomHost.setVisibility(View.GONE);\n\n    juifRootContainer.addView(\n        juifTopHost,\n        new LinearLayout.LayoutParams(\n            LinearLayout.LayoutParams.MATCH_PARENT,\n            LinearLayout.LayoutParams.WRAP_CONTENT\n        )\n    );\n    juifRootContainer.addView(\n        juifTabHost,\n        new LinearLayout.LayoutParams(\n            LinearLayout.LayoutParams.MATCH_PARENT,\n            LinearLayout.LayoutParams.WRAP_CONTENT\n        )\n    );\n    juifRootContainer.addView(\n        juifBodyContainer,\n        new LinearLayout.LayoutParams(\n            LinearLayout.LayoutParams.MATCH_PARENT,\n            0,\n            1f\n        )\n    );\n    juifRootContainer.addView(\n        juifBottomHost,\n        new LinearLayout.LayoutParams(\n            LinearLayout.LayoutParams.MATCH_PARENT,\n            LinearLayout.LayoutParams.WRAP_CONTENT\n        )\n    );\n\n    juifOverlay.addView(\n        juifRootContainer,\n        new FrameLayout.LayoutParams(\n            FrameLayout.LayoutParams.MATCH_PARENT,\n            FrameLayout.LayoutParams.MATCH_PARENT\n        )\n    );\n\n    juifDrawerLayer = new FrameLayout(appContext);\n    juifDrawerLayer.setVisibility(View.GONE);\n    juifOverlay.addView(\n        juifDrawerLayer,\n        new FrameLayout.LayoutParams(\n            FrameLayout.LayoutParams.MATCH_PARENT,\n            FrameLayout.LayoutParams.MATCH_PARENT\n        )\n    );\n\n    juifOverlay.setOnLongClickListener(new View.OnLongClickListener() {\n        public boolean onLongClick(View v) {\n            juifCloseOverlay(juifOverlay);\n            return true;\n        }\n    });\n\n    WindowManager.LayoutParams params = new WindowManager.LayoutParams(\n        WindowManager.LayoutParams.MATCH_PARENT,\n        WindowManager.LayoutParams.MATCH_PARENT,\n        WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,\n        WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,\n        PixelFormat.TRANSLUCENT\n    );\n\n    params.softInputMode =\n        WindowManager.LayoutParams.SOFT_INPUT_ADJUST_RESIZE |\n        WindowManager.LayoutParams.SOFT_INPUT_STATE_UNSPECIFIED;\n\n    wm.addView(juifOverlay, params);\n\n    juifOverlay.requestFocus();\n\n    juifRenderPage(juifCurrentPageId);\n\n    juifOverlay.setAlpha(0f);\n    juifOverlay.animate().alpha(1f).setDuration(180);\n\n    juifSetBoolean(\"Tmp_JuifVisible\", true);\n    juifSetString(\"Tmp_JuifState\", juifState.toString());\n    juifSetString(\"Tmp_JuifCurrentPage\", juifCurrentPageId);\n\n    JSONObject data = new JSONObject();\n    data.put(\"current_page\", juifCurrentPageId);\n    data.put(\"state\", juifState);\n    data.put(\"using_default_ui\", usingDefaultUi);\n    data.put(\"component_catalog_version\", \"1.0.0\");\n    data.put(\"supported_component_count\", 36);\n    data.put(\"shell_enabled\", juifShell != null);\n    data.put(\"shell_mode\", \"persistent_hosts\");\n    data.put(\"drawer_available\", juifDrawerNode != null);\n\n    JSONObject ok = juifResult(true, \"success\", \"JUIF carregado com sucesso.\", data, null);\n    juifPublishResult(ok);\n\n    return ok.toString();\n\n} catch(JSONException e) {\n    try {\n        JSONObject details = new JSONObject();\n        details.put(\"reason\", String.valueOf(e.getMessage()));\n        JSONObject error = juifError(\"INVALID_JSON\", \"O JUIF UI Json informado é inválido.\", details, false);\n        JSONObject result = juifResult(false, \"error\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    } catch(Exception ignored) {\n        return \"{\\\"schema_version\\\":1,\\\"namespace\\\":\\\"CDXMS\\\",\\\"success\\\":false,\\\"status\\\":\\\"error\\\",\\\"artifact_type\\\":\\\"capability\\\",\\\"artifact_id\\\":\\\"java_ui_framework\\\",\\\"operation\\\":\\\"render_ui\\\",\\\"message\\\":\\\"O JUIF UI Json informado é inválido.\\\",\\\"data\\\":{},\\\"error\\\":{\\\"code\\\":\\\"INVALID_JSON\\\",\\\"message\\\":\\\"O JUIF UI Json informado é inválido.\\\",\\\"details\\\":{},\\\"recoverable\\\":false},\\\"meta\\\":{\\\"source\\\":\\\"[CDXMS] Java UI Framework\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"component_catalog_version\\\":\\\"1.0.0\\\"}}\";\n    }\n} catch(SecurityException e) {\n    try {\n        JSONObject details = new JSONObject();\n        details.put(\"reason\", String.valueOf(e.getMessage()));\n        JSONObject error = juifError(\"PERMISSION_DENIED\", \"O Android bloqueou a criação do overlay JUIF.\", details, true);\n        JSONObject result = juifResult(false, \"blocked\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    } catch(Exception ignored) {\n        return \"{\\\"schema_version\\\":1,\\\"namespace\\\":\\\"CDXMS\\\",\\\"success\\\":false,\\\"status\\\":\\\"blocked\\\",\\\"artifact_type\\\":\\\"capability\\\",\\\"artifact_id\\\":\\\"java_ui_framework\\\",\\\"operation\\\":\\\"render_ui\\\",\\\"message\\\":\\\"O Android bloqueou a criação do overlay JUIF.\\\",\\\"data\\\":{},\\\"error\\\":{\\\"code\\\":\\\"PERMISSION_DENIED\\\",\\\"message\\\":\\\"O Android bloqueou a criação do overlay JUIF.\\\",\\\"details\\\":{},\\\"recoverable\\\":true},\\\"meta\\\":{\\\"source\\\":\\\"[CDXMS] Java UI Framework\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"component_catalog_version\\\":\\\"1.0.0\\\"}}\";\n    }\n} catch(Exception e) {\n    try {\n        JSONObject details = new JSONObject();\n        details.put(\"reason\", String.valueOf(e.getMessage()));\n        JSONObject error = juifError(\"PROCESSING_FAILED\", \"Falha ao inicializar JUIF.\", details, false);\n        JSONObject result = juifResult(false, \"error\", error.optString(\"message\"), new JSONObject(), error);\n        juifPublishResult(result);\n        return result.toString();\n    } catch(Exception ignored) {\n        return \"{\\\"schema_version\\\":1,\\\"namespace\\\":\\\"CDXMS\\\",\\\"success\\\":false,\\\"status\\\":\\\"error\\\",\\\"artifact_type\\\":\\\"capability\\\",\\\"artifact_id\\\":\\\"java_ui_framework\\\",\\\"operation\\\":\\\"render_ui\\\",\\\"message\\\":\\\"Falha crítica ao inicializar JUIF.\\\",\\\"data\\\":{},\\\"error\\\":{\\\"code\\\":\\\"UNKNOWN_ERROR\\\",\\\"message\\\":\\\"Falha crítica ao inicializar JUIF.\\\",\\\"details\\\":{},\\\"recoverable\\\":false},\\\"meta\\\":{\\\"source\\\":\\\"[CDXMS] Java UI Framework\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"component_catalog_version\\\":\\\"1.0.0\\\"}}\";\n    }\n}",
