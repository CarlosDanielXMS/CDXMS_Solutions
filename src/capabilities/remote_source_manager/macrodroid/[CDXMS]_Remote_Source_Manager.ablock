      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120012,
        "m_classType": "ActionGroupAction",
        "m_comment": "Consolida transporte, schema, identidade e verificação JCM.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "03 — Finalizar Resultado",
        "actionGroupName": "03 — Finalize Result",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120013,
        "m_classType": "JavaScriptAction",
        "m_comment": "Consolida Resultado remoto por variável de saída e última expressão, sem return no escopo principal.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Consolidar Resultado remoto",
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ARTIFACT_ID = \"remote_source_manager\";\nconst VERSION = \"1.0.0\";\nconst SOURCE_NAME = \"[CDXMS] Remote Source Manager\";\nfunction raw(v){ return String(v == null ? \"\" : v); }\nfunction text(v){ return raw(v).trim(); }\nfunction parse(rawValue, fallback){\n  const s=text(rawValue);\n  if(!s) return fallback;\n  try { return JSON.parse(s); } catch(e) { return fallback; }\n}\nfunction num(v){ const n=Number(v); return isFinite(n)?n:0; }\nfunction result(success,status,operation,message,data,error){\n  return JSON.stringify({schema_version:1,namespace:\"CDXMS\",success:success===true,status:status||(success?\"success\":\"error\"),artifact_type:\"capability\",artifact_id:ARTIFACT_ID,operation:operation||\"\",message:message||\"\",data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:SOURCE_NAME,version:VERSION,session_id:text(`{lv=Session Id}`),correlation_id:text(`{lv=Correlation Id}`)}});\n}\nfunction err(code,message,details,recoverable){ return {code:code,message:message,details:details||{},recoverable:recoverable!==false}; }\n\nlet __rsmOutput = \"\";\nconst work = parse(`{lv=Tmp_RequestWorkJson}`, {});\nconst pre = work.pre_result && typeof work.pre_result === \"object\" && !Array.isArray(work.pre_result)\n  ? work.pre_result\n  : null;\nif (pre) {\n  __rsmOutput = JSON.stringify(pre);\n} else {\n  const op = text(work.operation || `{lv=Operation}`);\n  const statusCode = num(`{lv=Tmp_HttpStatusCode}`);\n  const responseText = raw(`{lv=Tmp_ResponseText}`);\n  const document = parse(responseText, null);\n  const jcm = parse(`{lv=Tmp_JcmReadResultJson}`, {});\n  const schemaVersion = document && typeof document === \"object\" ? num(document.schema_version) : 0;\n  const namespace = document && typeof document === \"object\" ? text(document.namespace) : \"\";\n  const fileType = document && typeof document === \"object\" ? text(document.file_type) : \"\";\n  const artifactType = document && typeof document === \"object\" ? text(document.artifact_type) : \"\";\n  const artifactId = document && typeof document === \"object\" ? text(document.artifact_id) : \"\";\n  const version = document && typeof document === \"object\" ? text(document.version) : \"\";\n  const releaseId = document && typeof document === \"object\" ? text(document.release_id) : \"\";\n  const expectedFileType = text((work.request && work.request.expected_file_type) || \"\");\n  const jcmSuccess = jcm && jcm.success === true;\n  const jcmStatus = text(jcm && jcm.status);\n  const jcmMessage = text(jcm && jcm.message);\n  const strict = work.strict_mode === true;\n\n  const statusValid = statusCode === 200;\n  const bodyPresent = responseText.trim().length > 0;\n  const jsonParsed = document !== null && typeof document === \"object\";\n  const jsonIdentityValid = jsonParsed && schemaVersion === 1 && namespace === \"CDXMS\";\n  let semanticValid = true;\n  let semanticExpectation = expectedFileType || \"cdxms_json_document\";\n  if (op === \"fetch_catalog\") semanticValid = fileType === \"local_catalog\";\n  else if (op === \"fetch_remote_manifest\") semanticValid = fileType === \"remote_artifact_manifest\";\n  else if (op === \"fetch_release_manifest\") semanticValid = artifactType === \"package\" && version.length > 0;\n  else if (op === \"fetch_json\" && expectedFileType) semanticValid = fileType === expectedFileType;\n\n  const valid = statusValid && bodyPresent && jsonIdentityValid && semanticValid && jcmSuccess;\n  const source = work.source || {};\n  const request = work.request || {};\n  const staging = work.staging || {};\n  const data = {\n    source:{id:text(source.id),type:text(source.type),repository:text(source.repository),ref:text(source.ref),base_raw_url:text(source.base_raw_url)},\n    request:{method:\"GET\",url:text(request.url),remote_path:text(request.remote_path),timeout_seconds:num(request.timeout_seconds)},\n    http:{status_code:statusCode,expected_status:200,headers_captured:true,body_present:bodyPresent},\n    validation:{valid:valid,status_valid:statusValid,json_parsed:jsonParsed,schema_version:schemaVersion,schema_valid:schemaVersion===1,namespace:namespace,namespace_valid:namespace===\"CDXMS\",expected_document_type:semanticExpectation,actual_file_type:fileType,semantic_valid:semanticValid,jcm_read_verified:jcmSuccess,strict_mode:strict},\n    cache:{state:valid?\"staged_verified\":\"staging_invalid\",root_path:text(staging.root_path),folder_path:text(staging.folder_path),file_name:text(staging.file_name),file_path:text(staging.file_path),verified_by:\"json_config_manager\",jcm_status:jcmStatus,jcm_message:jcmMessage},\n    document_summary:{file_type:fileType,artifact_type:artifactType,artifact_id:artifactId,version:version,release_id:releaseId},\n    scope:{control_plane_only:true,artifact_payload_download_enabled:false,checksum_verification:\"deferred_until_native_or_dedicated_capability\"}\n  };\n\n  if (valid) {\n    __rsmOutput = result(true,\"success\",op,\"Documento remoto baixado, validado e preparado em staging com sucesso.\",data,null);\n  } else {\n    let code=\"HTTP_INVALID_RESPONSE\";\n    let message=\"O documento remoto não passou na validação.\";\n    if (!statusValid) {\n      code=statusCode===0?\"HTTP_REQUEST_FAILED\":\"HTTP_UNEXPECTED_STATUS\";\n      message=statusCode===0?\"A requisição HTTP não produziu um código de resposta válido.\":\"A requisição HTTP retornou status inesperado.\";\n    } else if (!bodyPresent) {\n      code=\"HTTP_EMPTY_RESPONSE\";\n      message=\"A requisição HTTP retornou corpo vazio.\";\n    } else if (!jsonParsed) {\n      code=\"HTTP_JSON_PARSE_FAILED\";\n      message=\"A resposta HTTP não contém JSON válido.\";\n    } else if (!jsonIdentityValid || !semanticValid) {\n      code=\"HTTP_INVALID_RESPONSE\";\n      message=\"A resposta HTTP não atende ao schema/identidade esperados.\";\n    } else if (!jcmSuccess) {\n      code=\"REMOTE_CACHE_VERIFICATION_FAILED\";\n      message=\"O arquivo temporário não pôde ser relido e verificado pelo Json Config Manager.\";\n    }\n    __rsmOutput = result(false,strict?\"error\":\"partial\",op,message,data,err(code,message,{status_code:statusCode,request_url:text(request.url),staging_file_path:text(staging.file_path),body_present:bodyPresent,json_parsed:jsonParsed,schema_version:schemaVersion,namespace:namespace,file_type:fileType,expected_file_type:expectedFileType,jcm_status:jcmStatus},true));\n  }\n}\n__rsmOutput;\n",
        "stringVariableName": "Tmp_ResultJson"
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120014,
        "m_classType": "JsonParseAction",
        "m_comment": "Publica a saída única Resultado.",
