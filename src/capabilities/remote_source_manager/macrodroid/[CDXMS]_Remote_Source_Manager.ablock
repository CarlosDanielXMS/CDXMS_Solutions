        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Verificar staging via JCM",
        "actionBlockId": -8263168847136168061,
        "actionBlockName": "[CDXMS] Json Config Manager",
        "continueActionsWithoutWaiting": false,
        "inputDictionaryMap": {},
        "inputVarsMap": {
          "Operation": "read_json",
          "File Path": "{lv=Tmp_RequestWork[staging][file_path]}",
          "Folder Path": "",
          "Json Path": "$",
          "Value Json": "",
          "Default Json": "",
          "Create If Missing?": "false",
          "Pretty Print?": "true",
          "Merge Strategy": "deep_merge"
        },
        "outputDictionaryMap": {
