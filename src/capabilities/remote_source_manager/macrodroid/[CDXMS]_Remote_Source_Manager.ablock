      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120001,
        "m_classType": "ActionGroupAction",
        "m_comment": "Valida fonte, operação, URL, path e staging antes de tocar a rede.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "01 — Preparar fonte e request",
        "actionGroupName": "01 — Prepare Remote Request",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120002,
        "m_classType": "JavaScriptAction",
        "m_comment": "Falha cedo e gera plano de request/staging.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Validar fonte e montar request",
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ARTIFACT_ID = \"remote_source_manager\";\nconst VERSION = \"1.0.0\";\nconst SOURCE_NAME = \"[CDXMS] Remote Source Manager\";\nconst BASE_PATH = \"/storage/emulated/0/Documents/CDXMS_Solutions\";\nconst DEFAULT_SOURCE = {\n  id: \"cdxms_official_github\",\n  name: \"CDXMS Official GitHub\",\n  type: \"github_raw\",\n  enabled: true,\n  repository: \"CarlosDanielXMS/CDXMS_Solutions\",\n  ref: \"develop\",\n  base_raw_url: \"https://raw.githubusercontent.com/CarlosDanielXMS/CDXMS_Solutions/develop/src\",\n  catalog_path: \"catalogs/local_catalog.default.json\"\n};\nconst SUPPORTED = [\"validate_source\", \"get_source_status\", \"fetch_catalog\", \"fetch_release_manifest\", \"fetch_remote_manifest\", \"fetch_json\"];\nconst FETCH_OPS = [\"fetch_catalog\", \"fetch_release_manifest\", \"fetch_remote_manifest\", \"fetch_json\"];\n\nfunction raw(v){ return String(v == null ? \"\" : v); }\nfunction txt(v){ return raw(v).trim(); }\nfunction bool(v, fallback){\n  const s = txt(v).toLowerCase();\n  if ([\"true\",\"1\",\"yes\",\"y\",\"sim\",\"s\",\"verdadeiro\"].indexOf(s) >= 0) return true;\n  if ([\"false\",\"0\",\"no\",\"n\",\"nao\",\"não\",\"falso\"].indexOf(s) >= 0) return false;\n  return fallback === true;\n}\nfunction parseJson(value, fallback, name){\n  const s = txt(value);\n  if (!s) return fallback;\n  try { return JSON.parse(s); }\n  catch(e){ throw { code:\"INVALID_JSON\", message:\"JSON inválido em \" + name + \".\", details:{ field:name, reason:String(e.message || e) } }; }\n}\nfunction result(success, status, operation, message, data, error){\n  return JSON.stringify({\n    schema_version:1,\n    namespace:\"CDXMS\",\n    success:success === true,\n    status:status || (success ? \"success\" : \"error\"),\n    artifact_type:\"capability\",\n    artifact_id:ARTIFACT_ID,\n    operation:operation || \"\",\n    message:message || \"\",\n    data:data || {},\n    error:error || null,\n    meta:{\n      timestamp:new Date().toISOString(),\n      source:SOURCE_NAME,\n      version:VERSION,\n      session_id:txt(`{lv=Session Id}`),\n      correlation_id:txt(`{lv=Correlation Id}`)\n    }\n  });\n}\nfunction error(code, message, details, recoverable){\n  return { code:code, message:message, details:details || {}, recoverable:recoverable !== false };\n}\nfunction safePathSegmentPath(value){\n  const p = txt(value).replace(/^\\/+/, \"\");\n  if (!p) return { valid:false, value:\"\", reason:\"empty\" };\n  if (p.indexOf(\"..\") >= 0 || p.indexOf(\"\\\\\") >= 0 || /[\\r\\n?#]/.test(p) || /^https?:\\/\\//i.test(p)) return { valid:false, value:p, reason:\"unsafe_path\" };\n  if (/\\s/.test(p)) return { valid:false, value:p, reason:\"unescaped_space\" };\n  return { valid:true, value:p, reason:\"\" };\n}\nfunction safeCacheRoot(value){\n  let p = txt(value) || (BASE_PATH + \"/packages/downloaded/remote_source_manager\");\n  p = p.replace(/\\\\+/g, \"/\").replace(/\\/+$/g, \"\");\n  const ok = p.indexOf(BASE_PATH + \"/\") === 0 && p.indexOf(\"..\") < 0 && !/[;`$<>|&\\r\\n]/.test(p);\n  return { valid:ok, value:p };\n}\nfunction encodeRemotePath(path){ return path.split(\"/\").map(function(x){ return encodeURIComponent(x); }).join(\"/\"); }\nfunction cacheFileName(path){\n  let name = path.replace(/\\/+|\\\\+/g, \"__\").replace(/[^A-Za-z0-9._-]/g, \"_\");\n  if (!/\\.json$/i.test(name)) name += \".json\";\n  return name;\n}\n\nconst op = txt(`{lv=Operation}`).toLowerCase();\nconst strict = bool(`{lv=Strict Mode?}`, true);\nlet preResult = \"\";\ntry {\n  if (!op) throw { code:\"MISSING_REQUIRED_INPUT\", message:\"A entrada Operation é obrigatória.\", details:{ input:\"Operation\" } };\n  if (SUPPORTED.indexOf(op) < 0) throw { code:\"UNSUPPORTED_OPERATION\", message:\"A operação informada não é suportada pelo Remote Source Manager.\", details:{ operation:op, supported_operations:SUPPORTED } };\n\n  const sourceInput = parseJson(`{lv=Source Json}`, null, \"Source Json\");\n  const source = sourceInput && typeof sourceInput === \"object\" && !Array.isArray(sourceInput) ? sourceInput : Object.assign({}, DEFAULT_SOURCE);\n  const sourceIdInput = txt(`{lv=Source Id}`) || DEFAULT_SOURCE.id;\n  const sourceErrors = [];\n  const sourceWarnings = [];\n  const sourceId = txt(source.id || sourceIdInput);\n  const sourceType = txt(source.type);\n  const repository = txt(source.repository);\n  const ref = txt(source.ref);\n  const baseRawUrl = txt(source.base_raw_url).replace(/\\/+$/g, \"\");\n  const enabled = source.enabled !== false;\n\n  if (!sourceId) sourceErrors.push({ field:\"source.id\", message:\"Id da fonte ausente.\" });\n  if (sourceIdInput && sourceId && sourceIdInput !== sourceId) sourceErrors.push({ field:\"Source Id\", message:\"Source Id não corresponde à fonte informada.\", expected:sourceIdInput, actual:sourceId });\n  if (sourceType !== \"github_raw\") sourceErrors.push({ field:\"source.type\", message:\"Somente github_raw é suportado nesta versão.\", actual:sourceType });\n  if (!/^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$/.test(repository)) sourceErrors.push({ field:\"source.repository\", message:\"Repository inválido.\" });\n  if (!ref || /\\.\\.|[?#\\\\\\r\\n]/.test(ref)) sourceErrors.push({ field:\"source.ref\", message:\"Ref inválido.\" });\n  if (!baseRawUrl.startsWith(\"https://raw.githubusercontent.com/\")) sourceErrors.push({ field:\"source.base_raw_url\", message:\"A URL deve usar HTTPS e raw.githubusercontent.com.\" });\n  if (baseRawUrl.indexOf(\"/blob/\") >= 0) sourceErrors.push({ field:\"source.base_raw_url\", message:\"URLs GitHub /blob/ são proibidas para download raw.\" });\n  if (repository && ref) {\n    const prefix = \"https://raw.githubusercontent.com/\" + repository + \"/\" + ref + \"/\";\n    if (baseRawUrl && !baseRawUrl.startsWith(prefix)) sourceErrors.push({ field:\"source.base_raw_url\", message:\"base_raw_url não corresponde a repository/ref.\" });\n  }\n  if (!enabled) sourceWarnings.push({ code:\"REMOTE_SOURCE_DISABLED\", message:\"A fonte está desabilitada.\" });\n\n  let remotePath = txt(`{lv=Remote Path}`);\n  let expectedFileType = txt(`{lv=Expected File Type}`);\n  if (op === \"fetch_catalog\") {\n    remotePath = remotePath || txt(source.catalog_path) || \"catalogs/local_catalog.default.json\";\n    expectedFileType = expectedFileType || \"local_catalog\";\n  } else if (op === \"fetch_release_manifest\") {\n    remotePath = remotePath || \"release.json\";\n  } else if (op === \"fetch_remote_manifest\") {\n    expectedFileType = expectedFileType || \"remote_artifact_manifest\";\n  }\n\n  const fetchRequested = FETCH_OPS.indexOf(op) >= 0;\n  let remotePathCheck = { valid:true, value:\"\", reason:\"\" };\n  if (fetchRequested) {\n    remotePathCheck = safePathSegmentPath(remotePath);\n    if (!remotePathCheck.valid) sourceErrors.push({ field:\"Remote Path\", message:\"Remote Path ausente ou inseguro.\", reason:remotePathCheck.reason, value:remotePath });\n    if (remotePathCheck.valid && !/\\.json$/i.test(remotePathCheck.value)) sourceErrors.push({ field:\"Remote Path\", message:\"A v1.0.0 aceita somente documentos JSON de controle remoto.\", value:remotePathCheck.value });\n  }\n\n  const cacheRoot = safeCacheRoot(`{lv=Cache Root Path}`);\n  if (!cacheRoot.valid) sourceErrors.push({ field:\"Cache Root Path\", message:\"Cache Root Path fora do base_path CDXMS ou inseguro.\" });\n\n  let timeout = Number(`{lv=Timeout Seconds}`);\n  if (!isFinite(timeout) || timeout < 5 || timeout > 120) {\n    sourceWarnings.push({ code:\"INVALID_INPUT_TYPE\", message:\"Timeout Seconds fora da faixa; aplicado default 30.\", value:timeout });\n    timeout = 30;\n  }\n\n  const sourceValid = sourceErrors.length === 0;\n  const shouldRequest = fetchRequested && sourceValid && enabled;\n  const normalizedPath = remotePathCheck.value;\n  const folderPath = cacheRoot.value + \"/\" + (sourceId || \"unknown\");\n  const fileName = normalizedPath ? cacheFileName(normalizedPath) : \"source-status.json\";\n  const filePath = folderPath + \"/\" + fileName;\n  const url = shouldRequest ? baseRawUrl + \"/\" + encodeRemotePath(normalizedPath) : \"\";\n\n  const sourceSummary = {\n    id:sourceId,\n    name:txt(source.name),\n    type:sourceType,\n    enabled:enabled,\n    repository:repository,\n    ref:ref,\n    base_raw_url:baseRawUrl,\n    catalog_path:txt(source.catalog_path)\n  };\n\n  if (!fetchRequested || !shouldRequest) {\n    const ok = sourceValid && enabled;\n    const status = ok ? \"success\" : (sourceValid && !enabled ? \"blocked\" : \"error\");\n    const message = ok\n      ? (op === \"get_source_status\" ? \"Status da fonte remota retornado com sucesso.\" : \"Fonte remota validada com sucesso.\")\n      : (sourceValid && !enabled ? \"A fonte remota está desabilitada.\" : \"A fonte remota não passou na validação.\");\n    const code = sourceValid && !enabled ? \"REMOTE_SOURCE_DISABLED\" : \"REMOTE_SOURCE_INVALID\";\n    preResult = result(ok, status, op, message, {\n      source:sourceSummary,\n      validation:{ valid:sourceValid, errors:sourceErrors, warnings:sourceWarnings },\n      supported_operations:SUPPORTED,\n      control_plane_only:true,\n      artifact_payload_download_enabled:false\n    }, ok ? null : error(code, message, { errors:sourceErrors, warnings:sourceWarnings }, true));\n  }\n\n  return JSON.stringify({\n    operation:op,\n    strict_mode:strict,\n    source_valid:sourceValid,\n    source_enabled:enabled,\n    should_request:shouldRequest,\n    pre_result_json:preResult,\n    source:sourceSummary,\n    validation:{ errors:sourceErrors, warnings:sourceWarnings },\n    request:{ method:\"GET\", url:url, remote_path:normalizedPath, accept:\"application/json\", timeout_seconds:timeout, expected_file_type:expectedFileType },\n    staging:{ root_path:cacheRoot.value, folder_path:folderPath, file_name:fileName, file_path:filePath }\n  });\n} catch(e) {\n  const er = error(e.code || \"PROCESSING_FAILED\", e.message || \"Falha ao preparar a fonte remota.\", e.details || { reason:String(e) }, true);\n  const r = result(false, \"error\", op, er.message, { supported_operations:SUPPORTED }, er);\n  return JSON.stringify({ operation:op, strict_mode:strict, source_valid:false, source_enabled:false, should_request:false, pre_result_json:r, source:{}, validation:{ errors:[er], warnings:[] }, request:{}, staging:{} });\n}",
        "stringVariableName": "Tmp_RequestWorkJson"
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120003,
        "m_classType": "JsonParseAction",
        "m_comment": "Converte o plano JSON em dicionário.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Publicar contexto de request",
        "dictionaryKeys": {
          "keys": []
        },
        "dictionaryVarName": "Tmp_RequestWork",
        "stringVarName": "Tmp_RequestWorkJson"
      },
