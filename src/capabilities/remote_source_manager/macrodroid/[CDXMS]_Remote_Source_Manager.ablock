        }
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120011,
        "m_classType": "ActionGroupEndAction",
        "m_comment": "Fecha execução de transporte.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Fim — Download HTTP"
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120012,
        "m_classType": "ActionGroupAction",
        "m_comment": "Consolida transporte, schema, identidade e verificação JCM.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "03 — Finalizar Resultado",
        "actionGroupName": "03 — Finalize Result",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false
      },
      {
        "disableLogging": false,
        "m_SIGUID": -611028407650120013,
        "m_classType": "JavaScriptAction",
        "m_comment": "Monta Resultado sem expor o documento completo; o conteúdo permanece no staging validado.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Consolidar Resultado remoto",
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ARTIFACT_ID = \"remote_source_manager\";\nconst VERSION = \"1.0.0\";\nconst SOURCE_NAME = \"[CDXMS] Remote Source Manager\";\nfunction raw(v){ return String(v == null ? \"\" : v); }\nfunction magic(v){ const s = raw(v).trim(); return /^\\{lv=/.test(s) ? \"\" : s; }\nfunction bool(v){ const s=magic(v).toLowerCase(); return [\"true\",\"1\",\"yes\",\"sim\",\"verdadeiro\"].indexOf(s)>=0; }\nfunction num(v){ const n=Number(magic(v)); return isFinite(n)?n:0; }\nfunction result(success,status,operation,message,data,error){\n  return JSON.stringify({schema_version:1,namespace:\"CDXMS\",success:success===true,status:status|| (success?\"success\":\"error\"),artifact_type:\"capability\",artifact_id:ARTIFACT_ID,operation:operation||\"\",message:message||\"\",data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:SOURCE_NAME,version:VERSION,session_id:magic(`{lv=Session Id}`),correlation_id:magic(`{lv=Correlation Id}`)}});\n}\nfunction err(code,message,details,recoverable){ return {code:code,message:message,details:details||{},recoverable:recoverable!==false}; }\n\nconst pre = magic(`{lv=Tmp_RequestWork[pre_result_json]}`);\nif (pre) {\n  pre;\n} else {\n  const op = magic(`{lv=Tmp_RequestWork[operation]}`) || magic(`{lv=Operation}`);\n  const statusCode = num(`{lv=Tmp_HttpStatusCode}`);\n  const schemaVersion = num(`{lv=Tmp_ParsedResponse[schema_version]}`);\n  const namespace = magic(`{lv=Tmp_ParsedResponse[namespace]}`);\n  const fileType = magic(`{lv=Tmp_ParsedResponse[file_type]}`);\n  const artifactType = magic(`{lv=Tmp_ParsedResponse[artifact_type]}`);\n  const artifactId = magic(`{lv=Tmp_ParsedResponse[artifact_id]}`);\n  const version = magic(`{lv=Tmp_ParsedResponse[version]}`);\n  const releaseId = magic(`{lv=Tmp_ParsedResponse[release_id]}`);\n  const expectedFileType = magic(`{lv=Tmp_RequestWork[request][expected_file_type]}`);\n  const jcmSuccess = bool(`{lv=Tmp_JcmReadResult[success]}`);\n  const jcmStatus = magic(`{lv=Tmp_JcmReadResult[status]}`);\n  const jcmMessage = magic(`{lv=Tmp_JcmReadResult[message]}`);\n  const strict = bool(`{lv=Tmp_RequestWork[strict_mode]}`);\n\n  const statusValid = statusCode === 200;\n  const jsonIdentityValid = schemaVersion === 1 && namespace === \"CDXMS\";\n  let semanticValid = true;\n  let semanticExpectation = expectedFileType || \"cdxms_json_document\";\n  if (op === \"fetch_catalog\") semanticValid = fileType === \"local_catalog\";\n  else if (op === \"fetch_remote_manifest\") semanticValid = fileType === \"remote_artifact_manifest\";\n  else if (op === \"fetch_release_manifest\") semanticValid = artifactType === \"package\" && version.length > 0;\n  else if (op === \"fetch_json\" && expectedFileType) semanticValid = fileType === expectedFileType;\n\n  const valid = statusValid && jsonIdentityValid && semanticValid && jcmSuccess;\n  const data = {\n    source:{\n      id:magic(`{lv=Tmp_RequestWork[source][id]}`),\n      type:magic(`{lv=Tmp_RequestWork[source][type]}`),\n      repository:magic(`{lv=Tmp_RequestWork[source][repository]}`),\n      ref:magic(`{lv=Tmp_RequestWork[source][ref]}`),\n      base_raw_url:magic(`{lv=Tmp_RequestWork[source][base_raw_url]}`)\n    },\n    request:{\n      method:\"GET\",\n      url:magic(`{lv=Tmp_RequestWork[request][url]}`),\n      remote_path:magic(`{lv=Tmp_RequestWork[request][remote_path]}`),\n      timeout_seconds:num(`{lv=Tmp_RequestWork[request][timeout_seconds]}`)\n    },\n    http:{ status_code:statusCode, expected_status:200, headers_captured:true },\n    validation:{\n      valid:valid,\n      status_valid:statusValid,\n      schema_version:schemaVersion,\n      schema_valid:schemaVersion===1,\n      namespace:namespace,\n      namespace_valid:namespace===\"CDXMS\",\n      expected_document_type:semanticExpectation,\n      actual_file_type:fileType,\n      semantic_valid:semanticValid,\n      jcm_read_verified:jcmSuccess,\n      strict_mode:strict\n    },\n    cache:{\n      state:valid?\"staged_verified\":\"staging_invalid\",\n      root_path:magic(`{lv=Tmp_RequestWork[staging][root_path]}`),\n      folder_path:magic(`{lv=Tmp_RequestWork[staging][folder_path]}`),\n      file_name:magic(`{lv=Tmp_RequestWork[staging][file_name]}`),\n      file_path:magic(`{lv=Tmp_RequestWork[staging][file_path]}`),\n      verified_by:\"json_config_manager\",\n      jcm_status:jcmStatus,\n      jcm_message:jcmMessage\n    },\n    document_summary:{ file_type:fileType, artifact_type:artifactType, artifact_id:artifactId, version:version, release_id:releaseId },\n    scope:{ control_plane_only:true, artifact_payload_download_enabled:false, checksum_verification:\"deferred_until_native_or_dedicated_capability\" }\n  };\n\n  if (valid) {\n    result(true,\"success\",op,\"Documento remoto baixado, validado e preparado em staging com sucesso.\",data,null);\n  } else {\n    let code = \"HTTP_INVALID_RESPONSE\";\n    let message = \"O documento remoto não passou na validação.\";\n    if (!statusValid) {\n      code = statusCode === 0 ? \"HTTP_REQUEST_FAILED\" : \"HTTP_UNEXPECTED_STATUS\";\n      message = statusCode === 0 ? \"A requisição HTTP não produziu um código de resposta válido.\" : \"A requisição HTTP retornou status inesperado.\";\n    } else if (!jsonIdentityValid || !semanticValid) {\n      code = \"HTTP_INVALID_RESPONSE\";\n      message = \"A resposta HTTP não atende ao schema/identidade esperados.\";\n    } else if (!jcmSuccess) {\n      code = \"REMOTE_CACHE_VERIFICATION_FAILED\";\n      message = \"O arquivo temporário não pôde ser relido e verificado pelo Json Config Manager.\";\n    }\n    result(false, strict?\"error\":\"partial\",op,message,data,err(code,message,{status_code:statusCode,schema_version:schemaVersion,namespace:namespace,file_type:fileType,expected_file_type:expectedFileType,jcm_status:jcmStatus},true));\n  }\n}",
        "stringVariableName": "Tmp_ResultJson"
      },
      {
        "disableLogging": false,
