    "m_actionList": [
      {
        "actionGroupName": "01 — Processar Artifact",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false,
        "actionLabel": "01 — Processar Artifact Manager",
        "disableLogging": false,
        "m_SIGUID": -1402621072237265938,
        "m_classType": "ActionGroupAction",
        "m_comment": "Processa operação local do Artifact Manager.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false
      },
      {
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "\nconst ARTIFACT_ID = \"artifact_manager\";\nconst VERSION = \"1.0.0\";\nconst HARDENING_REVISION = \"capability_hardening_2026_06_17\";\nconst SOURCE_NAME = \"[CDXMS] Artifact Manager\";\nconst BASE_PATH = \"/storage/emulated/0/Documents/CDXMS_Solutions\";\nconst SUPPORTED_OPERATIONS = [\n  \"validate_artifact\",\n  \"get_artifact_status\",\n  \"build_registry_entry\",\n  \"build_install_plan\",\n  \"get_target_paths\",\n  \"register_artifact\",\n  \"unregister_artifact\",\n  \"ensure_artifact_files\",\n  \"install_local_artifact\"\n];\nconst ARTIFACT_TYPES = [\"core\", \"capability\", \"solution\", \"package\", \"catalog\"];\n\nfunction txt(v){ return String(v == null ? \"\" : v).trim(); }\nfunction bool(v, fallback){\n  const s = String(v == null ? \"\" : v).trim().toLowerCase();\n  if ([\"true\",\"1\",\"yes\",\"y\",\"sim\",\"s\",\"verdadeiro\"].indexOf(s) >= 0) return true;\n  if ([\"false\",\"0\",\"no\",\"n\",\"nao\",\"não\",\"falso\"].indexOf(s) >= 0) return false;\n  return fallback === true;\n}\nfunction safeParse(raw, fallback, name, errors, required){\n  const s = String(raw == null ? \"\" : raw).trim();\n  if (!s) {\n    if (required) errors.push({ code:\"MISSING_REQUIRED_INPUT\", field:name, message:\"A entrada \" + name + \" é obrigatória.\" });\n    return fallback;\n  }\n  try { return JSON.parse(s); }\n  catch(e){ errors.push({ code:\"INVALID_JSON\", field:name, message:\"JSON inválido em \" + name + \".\", details:{ reason:String(e.message || e) } }); return fallback; }\n}\nfunction asObj(v){ return (v && typeof v === \"object\" && !Array.isArray(v)) ? v : {}; }\nfunction normId(v){ return txt(v).toLowerCase().normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g,\"\").replace(/[^a-z0-9]+/g,\"_\").replace(/^_+|_+$/g,\"\"); }\nfunction joinPath(){ return Array.prototype.slice.call(arguments).map(function(p){ return String(p||\"\").replace(/^\\/+|\\/+$/g,\"\"); }).filter(Boolean).join(\"/\"); }\nfunction makeMeta(){ return { timestamp:new Date().toISOString(), source:SOURCE_NAME, version:VERSION, session_id:txt(`{lv=Session Id}`), correlation_id:txt(`{lv=Correlation Id}`) }; }\nfunction makeResult(success, status, op, message, data, error){\n  return { schema_version:1, namespace:\"CDXMS\", success:success === true, status:status || (success ? \"success\" : \"error\"), artifact_type:\"capability\", artifact_id:ARTIFACT_ID, operation:op, message:message, data:data || {}, error:error || null, meta:makeMeta() };\n}\nfunction validationError(op, message, errors, data){\n  const first = errors && errors.length ? errors[0] : { code:\"PROCESSING_FAILED\", message:message };\n  return makeResult(false, \"error\", op, message, data || {}, { code:first.code || \"PROCESSING_FAILED\", message:first.message || message, details:{ errors:errors || [] }, recoverable:true });\n}\nfunction getManifestArtifact(manifest){\n  const obj = asObj(manifest);\n  const type = txt(obj.artifact_type || obj.type || `{lv=Artifact Type}`) || \"capability\";\n  const cap = asObj(obj.capability);\n  const sol = asObj(obj.solution);\n  const pkg = asObj(obj.package);\n  const node = Object.keys(cap).length ? cap : (Object.keys(sol).length ? sol : (Object.keys(pkg).length ? pkg : obj));\n  const id = txt(node.id || obj.artifact_id || `{lv=Artifact Id}`);\n  const version = txt(node.version || obj.version || \"1.0.0\");\n  const displayName = txt(node.display_name || node.name || id);\n  return { artifact_type:type, artifact_id:id, version:version, display_name:displayName };\n}\nfunction validateManifest(manifest, strict){\n  const errors=[]; const warnings=[];\n  const obj=asObj(manifest);\n  if (!Object.keys(obj).length) errors.push({code:\"MISSING_REQUIRED_INPUT\", field:\"Manifest Json\", message:\"Manifest Json é obrigatório para esta operação.\"});\n  if (obj.namespace && obj.namespace !== \"CDXMS\") warnings.push({code:\"ARTIFACT_NAMESPACE_UNEXPECTED\", message:\"Namespace diferente de CDXMS.\", value:obj.namespace});\n  const a=getManifestArtifact(obj);\n  if (!a.artifact_id) errors.push({code:\"MISSING_REQUIRED_INPUT\", field:\"artifact_id\", message:\"Artifact Id ausente no manifest.\"});\n  if (ARTIFACT_TYPES.indexOf(a.artifact_type) < 0) errors.push({code:\"INVALID_ENUM_VALUE\", field:\"artifact_type\", message:\"Artifact Type inválido.\", value:a.artifact_type});\n  if (!a.version) errors.push({code:\"MISSING_REQUIRED_INPUT\", field:\"version\", message:\"Version ausente no manifest.\"});\n  if (strict && !obj.schema_version) errors.push({code:\"UNSUPPORTED_SCHEMA_VERSION\", field:\"schema_version\", message:\"schema_version ausente no manifest.\"});\n  return { valid: errors.length === 0, errors:errors, warnings:warnings, artifact:a, manifest:obj };\n}\nfunction targetPaths(artifactType, artifactId, root){\n  const id=normId(artifactId);\n  let base;\n  if (artifactType === \"capability\") base=joinPath(root,\"capabilities\",id);\n  else if (artifactType === \"solution\") base=joinPath(root,\"solutions\",id);\n  else if (artifactType === \"core\") base=joinPath(root,\"core\");\n  else if (artifactType === \"catalog\") base=joinPath(root,\"catalogs\",id);\n  else base=joinPath(root,\"packages\",id);\n  return {\n    artifact_root: base,\n    manifest: joinPath(base,\"manifest.json\"),\n    contract: joinPath(base,\"contract.json\"),\n    config: joinPath(base,\"config.json\"),\n    macrodroid: joinPath(base,\"macrodroid\"),\n    registry: joinPath(root,\"core\",\"registry.json\"),\n    runtime_state: joinPath(root,\"runtime\", artifactType + \"s\", id + \".state.json\"),\n    installed_marker: joinPath(root,\"packages\",\"installed\", artifactType + \"s\", id, \"install_manifest.json\"),\n    backup_root: joinPath(root,\"backups\", artifactType + \"s\", id)\n  };\n}\nfunction registryCollection(type){\n  if (type === \"capability\") return \"installed_capabilities\";\n  if (type === \"solution\") return \"installed_solutions\";\n  if (type === \"package\") return \"installed_packages\";\n  if (type === \"catalog\") return \"catalogs\";\n  return \"installed_packages\";\n}\nfunction registryEntry(artifact, manifest, paths, status){\n  return {\n    artifact_type:artifact.artifact_type,\n    artifact_id:artifact.artifact_id,\n    version:artifact.version,\n    display_name:artifact.display_name,\n    status:status || \"planned\",\n    enabled:status === \"disabled\" ? false : true,\n    installed_at:\"\",\n    updated_at:new Date().toISOString(),\n    paths:paths,\n    manifest_summary:{\n      schema_version:asObj(manifest).schema_version || 1,\n      has_config: !!(asObj(asObj(manifest).capability).has_config || asObj(asObj(manifest).solution).has_config),\n      macrodroid_export: asObj(manifest).macrodroid_export || null,\n      requires: asObj(manifest).requires || {}\n    }\n  };\n}\nfunction normalizeResolutionPlan(raw){\n  const obj = asObj(raw);\n  const data = asObj(obj.data);\n  const directPlan = asObj(obj.resolution_plan);\n  const dataPlan = asObj(data.resolution_plan);\n  const plan = Object.keys(dataPlan).length ? dataPlan : (Object.keys(directPlan).length ? directPlan : obj);\n  const blocked = plan.blocked === true || data.blocked === true || obj.status === \"blocked\" || obj.success === false;\n  const missing = Array.isArray(plan.missing_dependencies) ? plan.missing_dependencies : (Array.isArray(data.missing_dependencies) ? data.missing_dependencies : []);\n  const present = Array.isArray(plan.present_dependencies) ? plan.present_dependencies : (Array.isArray(data.present_dependencies) ? data.present_dependencies : []);\n  const conflicts = Array.isArray(plan.conflicts) ? plan.conflicts : (Array.isArray(plan.version_conflicts) ? plan.version_conflicts : []);\n  const cycles = Array.isArray(plan.cycles) ? plan.cycles : [];\n  const order = Array.isArray(plan.install_order) ? plan.install_order : [];\n  return { provided:Object.keys(obj).length > 0, source_status:txt(obj.status || data.status || \"\"), source_success:obj.success, blocked:blocked, missing_dependencies:missing, present_dependencies:present, conflicts:conflicts, cycles:cycles, install_order:order, resolution_plan:plan };\n}\nfunction buildMergedRegistry(registry, artifact, entry, operation){\n  const r = JSON.parse(JSON.stringify(asObj(registry)));\n  r.schema_version = r.schema_version || 1;\n  r.namespace = r.namespace || \"CDXMS\";\n  r.file_type = r.file_type || \"core_registry\";\n  r.updated_at = new Date().toISOString();\n  r.installed_capabilities = asObj(r.installed_capabilities);\n  r.installed_solutions = asObj(r.installed_solutions);\n  r.installed_packages = asObj(r.installed_packages);\n  r.catalogs = asObj(r.catalogs);\n  const col = registryCollection(artifact.artifact_type);\n  if (operation === \"unregister_artifact\") {\n    const disabled = JSON.parse(JSON.stringify(entry));\n    disabled.status = \"disabled\";\n    disabled.enabled = false;\n    disabled.unregistered_at = new Date().toISOString();\n    r[col][artifact.artifact_id] = disabled;\n  } else {\n    const installed = JSON.parse(JSON.stringify(entry));\n    installed.status = \"installed\";\n    installed.enabled = true;\n    installed.installed_at = installed.installed_at || new Date().toISOString();\n    r[col][artifact.artifact_id] = installed;\n  }\n  return r;\n}\nfunction buildPlan(operation, artifact, manifest, paths, dryRun, applyChanges, preserveUserConfig, dependencyResolution){\n  const files = [\n    { kind:\"manifest\", source:\"Manifest Json\", target:paths.manifest, write_policy:\"overwrite_versioned\" },\n    { kind:\"contract\", source:\"Contract Json\", target:paths.contract, write_policy:\"overwrite_versioned\" },\n    { kind:\"config\", source:\"Config Json\", target:paths.config, write_policy:preserveUserConfig ? \"create_if_missing_or_merge\" : \"overwrite_existing\" },\n    { kind:\"registry\", source:\"Registry Json + registry_entry\", target:paths.registry, write_policy:\"merge_preserve_user\" }\n  ];\n  const dep = dependencyResolution || { provided:false, blocked:false, missing_dependencies:[], present_dependencies:[], conflicts:[], cycles:[], install_order:[] };\n  const applyEligible = [\"register_artifact\",\"unregister_artifact\",\"ensure_artifact_files\",\"install_local_artifact\"].indexOf(operation) >= 0;\n  const shouldApply = applyEligible && dryRun === false && applyChanges === true && dep.blocked !== true;\n  let applyReason = \"not_apply_operation\";\n  if (applyEligible && dryRun === true) applyReason = \"dry_run_enabled\";\n  else if (applyEligible && applyChanges !== true) applyReason = \"apply_changes_gate_disabled\";\n  else if (applyEligible && dep.blocked === true) applyReason = \"dependency_resolution_blocked\";\n  else if (shouldApply) applyReason = \"double_gate_authorized\";\n  const steps=[\"validate_manifest\",\"compute_target_paths\",\"build_registry_entry\"];\n  if (dep.provided) steps.push(\"consume_dependency_resolution\");\n  steps.push(\"prepare_file_plan\");\n  if (dep.blocked) steps.push(\"block_on_dependency_resolution\");\n  if (shouldApply) steps.push(\"apply_local_files_and_registry\");\n  else steps.push(dryRun ? \"return_plan_only\" : \"await_explicit_apply_changes_gate\");\n  return {\n    operation:operation,\n    dry_run:dryRun,\n    apply_changes:applyChanges,\n    preserve_user_config:preserveUserConfig,\n    steps:steps,\n    files:files,\n    dependency_resolution:dep,\n    blocked:dep.blocked === true,\n    side_effects_enabled:shouldApply,\n    apply_gate:{\n      apply_eligible:applyEligible,\n      dry_run:dryRun,\n      apply_changes:applyChanges,\n      should_apply:shouldApply,\n      reason:applyReason,\n      safety_root:paths.artifact_root\n    },\n    note:shouldApply ? \"Efeitos colaterais locais habilitados por double-gate: Dry Run? = false e Apply Changes? = true.\" : \"Plano seguro sem aplicação física.\",\n    local_apply_contract_revision:HARDENING_REVISION\n  };\n}\nfunction stateDoc(artifact, operation, paths, dep){\n  return { schema_version:1, namespace:\"CDXMS\", file_type:\"artifact_runtime_state\", artifact_type:artifact.artifact_type, artifact_id:artifact.artifact_id, version:artifact.version, operation:operation, status:operation === \"unregister_artifact\" ? \"disabled\" : \"installed\", updated_at:new Date().toISOString(), paths:paths, dependency_resolution_summary:{ provided:dep.provided, blocked:dep.blocked, missing_count:dep.missing_dependencies.length, conflicts_count:dep.conflicts.length, cycles_count:dep.cycles.length } };\n}\nfunction installMarker(artifact, operation, paths, dep){\n  return { schema_version:1, namespace:\"CDXMS\", file_type:\"artifact_install_manifest\", artifact_type:artifact.artifact_type, artifact_id:artifact.artifact_id, version:artifact.version, operation:operation, installed_at:new Date().toISOString(), manual_import_required:true, paths:paths, dependency_resolution:dep };\n}\n\nconst op = txt(`{lv=Operation}`) || \"validate_artifact\";\nconst strictRaw = `{lv=Strict Mode?}`;\nconst dryRunRaw = `{lv=Dry Run?}`;\nconst applyChangesRaw = `{lv=Apply Changes?}`;\nconst preserveUserConfigRaw = `{lv=Preserve User Config?}`;\nconst strict = bool(strictRaw, false);\nconst dryRun = bool(dryRunRaw, true);\nconst applyChanges = bool(applyChangesRaw, false);\nconst preserveUserConfig = bool(preserveUserConfigRaw, true);\nconst targetRoot = txt(`{lv=Target Root Path}`) || BASE_PATH;\nconst debugInputs = {\n  operation_raw:`{lv=Operation}`,\n  dry_run_raw:String(dryRunRaw),\n  dry_run_parsed:dryRun,\n  apply_changes_raw:String(applyChangesRaw),\n  apply_changes_parsed:applyChanges,\n  strict_mode_raw:String(strictRaw),\n  strict_mode_parsed:strict,\n  preserve_user_config_raw:String(preserveUserConfigRaw),\n  preserve_user_config_parsed:preserveUserConfig,\n  target_root:targetRoot,\n  local_apply_contract_revision:HARDENING_REVISION\n};\nconst parseErrors=[];\nconst manifest = safeParse(`{lv=Manifest Json}`, {}, \"Manifest Json\", parseErrors, [\"validate_artifact\",\"build_registry_entry\",\"build_install_plan\",\"get_target_paths\",\"register_artifact\",\"ensure_artifact_files\",\"install_local_artifact\"].indexOf(op)>=0);\nconst contract = safeParse(`{lv=Contract Json}`, {}, \"Contract Json\", parseErrors, false);\nconst config = safeParse(`{lv=Config Json}`, {}, \"Config Json\", parseErrors, false);\nconst registry = safeParse(`{lv=Registry Json}`, {}, \"Registry Json\", parseErrors, false);\nconst packageManifest = safeParse(`{lv=Package Manifest Json}`, {}, \"Package Manifest Json\", parseErrors, false);\nconst dependencyResolutionInput = safeParse(`{lv=Dependency Resolution Json}`, {}, \"Dependency Resolution Json\", parseErrors, false);\nconst dependencyResolution = normalizeResolutionPlan(dependencyResolutionInput);\nlet output;\ntry {\n  if (SUPPORTED_OPERATIONS.indexOf(op) < 0) {\n    output = makeResult(false, \"error\", op, \"Operação não suportada pelo Artifact Manager.\", { supported_operations:SUPPORTED_OPERATIONS }, { code:\"UNSUPPORTED_OPERATION\", message:\"Operation inválida.\", details:{ operation:op }, recoverable:false });\n  } else if (parseErrors.length) {\n    output = validationError(op, \"Entradas inválidas para o Artifact Manager.\", parseErrors, { supported_operations:SUPPORTED_OPERATIONS });\n  } else {\n    const validation = validateManifest(manifest, strict);\n    const artifact = validation.artifact;\n    const inputType = txt(`{lv=Artifact Type}`); if (inputType && !artifact.artifact_type) artifact.artifact_type = inputType;\n    const inputId = txt(`{lv=Artifact Id}`); if (inputId && !artifact.artifact_id) artifact.artifact_id = inputId;\n    const paths = targetPaths(artifact.artifact_type || \"capability\", artifact.artifact_id || \"unknown_artifact\", targetRoot);\n    const entryStatus = op === \"unregister_artifact\" ? \"disabled\" : \"planned\";\n    const entry = registryEntry(artifact, manifest, paths, entryStatus);\n    const plan = buildPlan(op, artifact, manifest, paths, dryRun, applyChanges, preserveUserConfig, dependencyResolution);\n    const mergedRegistry = buildMergedRegistry(registry, artifact, entry, op);\n    const applyPayload = {\n      should_apply: plan.apply_gate.should_apply,\n      write_files: plan.apply_gate.should_apply && [\"ensure_artifact_files\",\"install_local_artifact\"].indexOf(op) >= 0,\n      write_registry: plan.apply_gate.should_apply && [\"register_artifact\",\"unregister_artifact\",\"install_local_artifact\"].indexOf(op) >= 0,\n      write_state: plan.apply_gate.should_apply,\n      write_marker: plan.apply_gate.should_apply && op !== \"unregister_artifact\",\n      manifest_json: JSON.stringify(manifest, null, 2),\n      contract_json: Object.keys(contract).length ? JSON.stringify(contract, null, 2) : \"{}\",\n      config_json: Object.keys(config).length ? JSON.stringify(config, null, 2) : \"{}\",\n      registry_json: JSON.stringify(mergedRegistry, null, 2),\n      runtime_state_json: JSON.stringify(stateDoc(artifact, op, paths, dependencyResolution), null, 2),\n      install_marker_json: JSON.stringify(installMarker(artifact, op, paths, dependencyResolution), null, 2),\n      has_contract: Object.keys(contract).length > 0,\n      has_config: Object.keys(config).length > 0\n    };\n\n    if (op === \"validate_artifact\") {\n      output = validation.valid ? makeResult(true,\"success\",op,\"Artifact validado com sucesso.\",{ valid:true, artifact:artifact, warnings:validation.warnings, manifest_summary:entry.manifest_summary },null) : validationError(op,\"Artifact inválido.\", validation.errors, { valid:false, artifact:artifact, warnings:validation.warnings });\n    } else if (op === \"get_artifact_status\") {\n      const installed = !!(asObj(registry.installed_capabilities)[artifact.artifact_id] || asObj(registry.installed_solutions)[artifact.artifact_id] || asObj(registry.installed_packages)[artifact.artifact_id] || asObj(registry.catalogs)[artifact.artifact_id]);\n      output = makeResult(true,\"success\",op,\"Status do artifact obtido.\",{ artifact:artifact, installed:installed, status: installed ? \"installed\" : \"not_installed\", registry_available:Object.keys(registry).length>0 },null);\n    } else if (op === \"get_target_paths\") {\n      output = makeResult(true,\"success\",op,\"Paths de destino calculados.\",{ artifact:artifact, target_root:targetRoot, paths:paths },null);\n    } else if (op === \"build_registry_entry\") {\n      if (!validation.valid) output = validationError(op,\"Não foi possível gerar registry entry porque o artifact é inválido.\", validation.errors, { artifact:artifact });\n      else output = makeResult(true,\"success\",op,\"Registry entry construída com sucesso.\",{ artifact:artifact, registry_entry:entry },null);\n    } else if (op === \"build_install_plan\" || op === \"register_artifact\" || op === \"ensure_artifact_files\" || op === \"install_local_artifact\") {\n      const lifecycleRequiresApplyGate = [\"register_artifact\",\"ensure_artifact_files\",\"install_local_artifact\"].indexOf(op) >= 0;\n      const gateBlocked = lifecycleRequiresApplyGate && dryRun === false && applyChanges !== true;\n      if (!validation.valid) output = validationError(op,\"Não foi possível montar plano porque o artifact é inválido.\", validation.errors, { artifact:artifact, debug_inputs:debugInputs });\n      else if (dependencyResolution.provided && dependencyResolution.blocked && strict) output = makeResult(false,\"blocked\",op,\"Plano de lifecycle bloqueado pela resolução de dependências.\",{ artifact:artifact, registry_entry:entry, install_plan:plan, dependency_resolution:dependencyResolution, local_package_path:txt(`{lv=Local Package Path}`), package_manifest:packageManifest, paths:paths, apply:plan.apply_gate, apply_payload:applyPayload, side_effects_delegated_to_shell:false, debug_inputs:debugInputs },{ code:\"DEPENDENCY_RESOLUTION_BLOCKED\", message:\"Dependency Resolution Json indica bloqueio do plano.\", details:{ missing_dependencies:dependencyResolution.missing_dependencies, conflicts:dependencyResolution.conflicts, cycles:dependencyResolution.cycles }, recoverable:true });\n      else if (gateBlocked && strict) output = makeResult(false,\"blocked\",op,\"Aplicação física bloqueada porque Apply Changes? não foi habilitado explicitamente.\",{ artifact:artifact, registry_entry:entry, install_plan:plan, dependency_resolution:dependencyResolution, local_package_path:txt(`{lv=Local Package Path}`), package_manifest:packageManifest, paths:paths, apply:plan.apply_gate, apply_payload:applyPayload, side_effects_delegated_to_shell:false, debug_inputs:debugInputs },{ code:\"ARTIFACT_APPLY_GATE_DISABLED\", message:\"Para aplicar fisicamente, use Dry Run? = false e Apply Changes? = true.\", details:{ dry_run:dryRun, apply_changes:applyChanges, reason:plan.apply_gate.reason }, recoverable:true });\n      else output = makeResult(true,\"success\",op, plan.apply_gate.should_apply ? \"Lifecycle local autorizado e delegado para escrita física controlada.\" : \"Plano de lifecycle do artifact gerado com sucesso.\",{ artifact:artifact, registry_entry:entry, install_plan:plan, dependency_resolution:dependencyResolution, local_package_path:txt(`{lv=Local Package Path}`), package_manifest:packageManifest, paths:paths, apply:plan.apply_gate, apply_payload:applyPayload, side_effects_delegated_to_shell:plan.apply_gate.should_apply, debug_inputs:debugInputs },null);\n    } else if (op === \"unregister_artifact\") {\n      const gateBlocked = dryRun === false && applyChanges !== true;\n      if (gateBlocked && strict) output = makeResult(false,\"blocked\",op,\"Desregistro físico bloqueado porque Apply Changes? não foi habilitado explicitamente.\",{ artifact:artifact, registry_entry:entry, install_plan:plan, dependency_resolution:dependencyResolution, paths:paths, apply:plan.apply_gate, apply_payload:applyPayload, side_effects_delegated_to_shell:false, debug_inputs:debugInputs },{ code:\"ARTIFACT_APPLY_GATE_DISABLED\", message:\"Para desregistrar fisicamente, use Dry Run? = false e Apply Changes? = true.\", details:{ dry_run:dryRun, apply_changes:applyChanges, reason:plan.apply_gate.reason }, recoverable:true });\n      else output = makeResult(true,\"success\",op, plan.apply_gate.should_apply ? \"Desregistro local autorizado e delegado para escrita física controlada.\" : \"Plano de remoção lógica do artifact gerado com sucesso.\",{ artifact:artifact, registry_entry:entry, install_plan:plan, dependency_resolution:dependencyResolution, paths:paths, apply:plan.apply_gate, apply_payload:applyPayload, side_effects_delegated_to_shell:plan.apply_gate.should_apply, debug_inputs:debugInputs },null);\n    }\n  }\n} catch(e) {\n  output = makeResult(false,\"error\",op,\"Falha ao processar artifact.\",{}, { code:\"PROCESSING_FAILED\", message:\"Falha interna no Artifact Manager.\", details:{ reason:String(e.message || e) }, recoverable:true });\n}\nJSON.stringify(output);\n",
