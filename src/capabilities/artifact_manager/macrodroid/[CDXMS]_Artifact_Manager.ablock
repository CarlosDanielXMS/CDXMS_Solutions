        "m_script": "set -eu\nis_true() {\n  case \"$1\" in\n    true|True|TRUE|Verdadeiro|verdadeiro|1|sim|Sim|SIM|yes|Yes|YES) return 0 ;;\n    *) return 1 ;;\n  esac\n}\nSHOULD_APPLY=\"{lv=Tmp_ArtifactWork[data][apply][should_apply]}\"\nif is_true \"$SHOULD_APPLY\"; then\n  ARTIFACT_ROOT=\"{lv=Tmp_ArtifactWork[data][paths][artifact_root]}\"\n  MACRODROID_DIR=\"{lv=Tmp_ArtifactWork[data][paths][macrodroid]}\"\n  BACKUP_ROOT=\"{lv=Tmp_ArtifactWork[data][paths][backup_root]}\"\n  MANIFEST_PATH=\"{lv=Tmp_ArtifactWork[data][paths][manifest]}\"\n  CONTRACT_PATH=\"{lv=Tmp_ArtifactWork[data][paths][contract]}\"\n  CONFIG_PATH=\"{lv=Tmp_ArtifactWork[data][paths][config]}\"\n  REGISTRY_PATH=\"{lv=Tmp_ArtifactWork[data][paths][registry]}\"\n  STATE_PATH=\"{lv=Tmp_ArtifactWork[data][paths][runtime_state]}\"\n  MARKER_PATH=\"{lv=Tmp_ArtifactWork[data][paths][installed_marker]}\"\n\n  mkdir -p \"$ARTIFACT_ROOT\" \"$MACRODROID_DIR\" \"$BACKUP_ROOT\" \"$(dirname \"$REGISTRY_PATH\")\" \"$(dirname \"$STATE_PATH\")\" \"$(dirname \"$MARKER_PATH\")\"\n\n  if is_true \"{lv=Tmp_ArtifactWork[data][apply_payload][write_files]}\"; then\n    cat > \"$MANIFEST_PATH\" <<'CDXMS_MANIFEST_JSON_EOF'\n{lv=Tmp_ArtifactWork[data][apply_payload][manifest_json]}\nCDXMS_MANIFEST_JSON_EOF\n    if is_true \"{lv=Tmp_ArtifactWork[data][apply_payload][has_contract]}\"; then\n      cat > \"$CONTRACT_PATH\" <<'CDXMS_CONTRACT_JSON_EOF'\n{lv=Tmp_ArtifactWork[data][apply_payload][contract_json]}\nCDXMS_CONTRACT_JSON_EOF\n    fi\n    if is_true \"{lv=Tmp_ArtifactWork[data][apply_payload][has_config]}\"; then\n      if [ ! -f \"$CONFIG_PATH\" ]; then\n        cat > \"$CONFIG_PATH\" <<'CDXMS_CONFIG_JSON_EOF'\n{lv=Tmp_ArtifactWork[data][apply_payload][config_json]}\nCDXMS_CONFIG_JSON_EOF\n      fi\n    fi\n  fi\n\n  if is_true \"{lv=Tmp_ArtifactWork[data][apply_payload][write_registry]}\"; then\n    cat > \"$REGISTRY_PATH\" <<'CDXMS_REGISTRY_JSON_EOF'\n{lv=Tmp_ArtifactWork[data][apply_payload][registry_json]}\nCDXMS_REGISTRY_JSON_EOF\n  fi\n\n  if is_true \"{lv=Tmp_ArtifactWork[data][apply_payload][write_state]}\"; then\n    cat > \"$STATE_PATH\" <<'CDXMS_STATE_JSON_EOF'\n{lv=Tmp_ArtifactWork[data][apply_payload][runtime_state_json]}\nCDXMS_STATE_JSON_EOF\n  fi\n\n  if is_true \"{lv=Tmp_ArtifactWork[data][apply_payload][write_marker]}\"; then\n    cat > \"$MARKER_PATH\" <<'CDXMS_MARKER_JSON_EOF'\n{lv=Tmp_ArtifactWork[data][apply_payload][install_marker_json]}\nCDXMS_MARKER_JSON_EOF\n  fi\nfi\n",
