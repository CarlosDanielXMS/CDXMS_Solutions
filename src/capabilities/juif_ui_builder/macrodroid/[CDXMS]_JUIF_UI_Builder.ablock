        "actionLabel": "01 — Build and Publish Resultado",
        "disableLogging": false,
        "m_SIGUID": -6532639098365696273,
        "m_classType": "ActionGroupAction",
        "m_comment": "Constrói o contrato JUIF v1.0.0 a partir das entradas, sem persistência nem efeitos colaterais.",
        "m_constraintList": [],
        "m_isDisabled": false,
