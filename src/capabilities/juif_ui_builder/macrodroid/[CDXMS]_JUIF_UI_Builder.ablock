      {
        "description": "Schema declarativo JUIF multipágina. Aceita sections, fields, lists, components e shell de navegação.",
        "dictionary": {
          "entries": [],
          "isArray": false,
          "variableType": 4,
          "type": "Dictionary"
        },
        "isActionBlockWorkingVar": false,
        "isLocalVar": true,
        "isSecure": false,
        "m_booleanValue": false,
        "m_decimalValue": 0.0,
        "m_intValue": 0,
        "m_name": "UI Schema Json",
        "m_stringValue": "{\n  \"schema_version\": 1,\n  \"title\": \"Demonstração JUIF\",\n  \"initial_page\": \"home\",\n  \"pages\": [\n    {\n      \"id\": \"home\",\n      \"title\": \"JUIF / Java UI Framework\",\n      \"subtitle\": \"Todos os componentes suportados pelo renderer\",\n      \"sections\": [\n        {\n          \"title\": \"Campos vinculados\",\n          \"subtitle\": \"Campos geram state e mapping_json.\",\n          \"fields\": [\n            {\n              \"id\": \"name\",\n              \"label\": \"Nome\",\n              \"component\": \"input\",\n              \"bind\": \"form.name\"\n            },\n            {\n              \"id\": \"bio\",\n              \"label\": \"Descrição\",\n              \"component\": \"textarea\",\n              \"bind\": \"form.bio\"\n            },\n            {\n              \"id\": \"enabled\",\n              \"label\": \"Sistema ativo\",\n              \"component\": \"switch\",\n              \"bind\": \"form.enabled\",\n              \"value_type\": \"boolean\"\n            },\n            {\n              \"id\": \"accept\",\n              \"label\": \"Aceite\",\n              \"component\": \"checkbox\",\n              \"bind\": \"form.accept\",\n              \"value_type\": \"boolean\"\n            },\n            {\n              \"id\": \"level\",\n              \"label\": \"Nível\",\n              \"component\": \"select\",\n              \"bind\": \"form.level\",\n              \"options\": [\n                \"basic\",\n                \"advanced\"\n              ]\n            },\n            {\n              \"id\": \"choice\",\n              \"label\": \"Escolha\",\n              \"component\": \"radio_group\",\n              \"bind\": \"form.choice\",\n              \"options\": [\n                {\n                  \"label\": \"Opção A\",\n                  \"value\": \"a\"\n                },\n                {\n                  \"label\": \"Opção B\",\n                  \"value\": \"b\"\n                }\n              ]\n            }\n          ],\n          \"lists\": [\n            {\n              \"id\": \"items\",\n              \"bind\": \"items\",\n              \"item_template\": {\n                \"type\": \"list_item\",\n                \"title\": \"{{title}}\",\n                \"subtitle\": \"{{subtitle}}\",\n                \"value\": \"{{value}}\",\n                \"action\": \"item_selected\"\n              }\n            }\n          ],\n          \"children\": [\n            {\n              \"type\": \"button_group\",\n              \"buttons\": [\n                {\n                  \"text\": \"Voltar\",\n                  \"variant\": \"ghost\",\n                  \"action\": \"back\"\n                },\n                {\n                  \"text\": \"Confirmar\",\n                  \"action\": \"submit\"\n                }\n              ]\n            }\n          ],\n          \"actions\": [\n            {\n              \"text\": \"Salvar\",\n              \"variant\": \"primary\",\n              \"action\": \"save_config\"\n            }\n          ]\n        }\n      ],\n      \"components\": [\n        {\n          \"type\": \"text\",\n          \"variant\": \"label\",\n          \"text\": \"Componentes informativos\"\n        },\n        {\n          \"type\": \"alert\",\n          \"variant\": \"info\",\n          \"title\": \"Alerta\",\n          \"text\": \"Mensagem informativa.\"\n        },\n        {\n          \"type\": \"badge\",\n          \"variant\": \"success\",\n          \"text\": \"Ativo\"\n        },\n        {\n          \"type\": \"key_value\",\n          \"label\": \"Namespace\",\n          \"value\": \"CDXMS\"\n        },\n        {\n          \"type\": \"copyable_text\",\n          \"title\": \"Copiar texto\",\n          \"bind\": \"texts.copy\"\n        },\n        {\n          \"type\": \"stat_card\",\n          \"label\": \"Total\",\n          \"bind\": \"stats.count\",\n          \"value_type\": \"number\"\n        },\n        {\n          \"type\": \"progress_bar\",\n          \"label\": \"Progresso\",\n          \"bind\": \"stats.progress\",\n          \"value_type\": \"number\"\n        },\n        {\n          \"type\": \"code_block\",\n          \"title\": \"JSON\",\n          \"language\": \"json\",\n          \"bind\": \"texts.code\"\n        },\n        {\n          \"type\": \"sandbox\",\n          \"bind\": \"texts.sandbox\"\n        },\n        {\n          \"type\": \"spacer\",\n          \"height\": 8\n        },\n        {\n          \"type\": \"divider\"\n        },\n        {\n          \"type\": \"card\",\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"text\": \"Card com children.\"\n            }\n          ]\n        },\n        {\n          \"type\": \"container\",\n          \"variant\": \"surface2\",\n          \"components\": [\n            {\n              \"type\": \"column\",\n              \"children\": [\n                {\n                  \"type\": \"row\",\n                  \"children\": [\n                    {\n                      \"type\": \"text\",\n                      \"text\": \"Linha A\"\n                    },\n                    {\n                      \"type\": \"text\",\n                      \"text\": \"Linha B\"\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"button\",\n          \"text\": \"Fechar\",\n          \"variant\": \"ghost\",\n          \"action\": \"close\"\n        }\n      ]\n    }\n  ]\n}",
        "m_type": 2,
        "supportsInput": true,
        "supportsOutput": false
      },
