        "m_intValue": 0,
        "m_name": "Config Json",
        "m_stringValue": "{\n  \"profile\": {\n    \"name\": \"Usuário JUIF\",\n    \"email\": \"usuario@exemplo.com\",\n    \"description\": \"Interfaces declarativas, modulares e orientadas a estado para automações profissionais.\",\n    \"notifications\": true,\n    \"terms\": true,\n    \"level\": \"intermediate\",\n    \"theme\": \"dark_gold\"\n  },\n  \"tutorial\": {\n    \"search\": \"\",\n    \"interactive_only\": false,\n    \"filters\": [\n      \"navigation\",\n      \"forms\"\n    ],\n    \"experience\": \"intermediate\"\n  },\n  \"metrics\": {\n    \"components\": 36,\n    \"categories\": 6,\n    \"coverage\": 100\n  },\n  \"catalog\": {\n    \"items\": [\n      {\n        \"title\": \"Composição declarativa\",\n        \"subtitle\": \"Estruture páginas com primitives previsíveis.\",\n        \"value\": \"layout\"\n      },\n      {\n        \"title\": \"Estado e bindings\",\n        \"subtitle\": \"Conecte Config Json, state e eventos sem acoplamento.\",\n        \"value\": \"forms\"\n      },\n      {\n        \"title\": \"Navegação de aplicação\",\n        \"subtitle\": \"Use shell persistente, drawer, tabs e bottom navigation.\",\n        \"value\": \"navigation\"\n      }\n    ]\n  },\n  \"docs\": {\n    \"flow\": \"UI Schema Json → JUIF UI Builder → JUIF UI Json → Java UI Framework → Resultado\",\n    \"schema_example\": \"{\\\"schema_version\\\": 1, \\\"initial_page\\\": \\\"home\\\", \\\"pages\\\": [{\\\"id\\\": \\\"home\\\", \\\"title\\\": \\\"Minha interface\\\", \\\"components\\\": [{\\\"type\\\": \\\"text\\\", \\\"variant\\\": \\\"title\\\", \\\"text\\\": \\\"Olá, JUIF\\\"}, {\\\"type\\\": \\\"button\\\", \\\"text\\\": \\\"Continuar\\\", \\\"variant\\\": \\\"primary\\\", \\\"action\\\": \\\"continue\\\"}]}]}\",\n    \"sandbox\": \"{\\\"initial_page\\\": \\\"preview\\\", \\\"state\\\": {\\\"enabled\\\": true}, \\\"pages\\\": {\\\"preview\\\": {\\\"title\\\": \\\"Preview JUIF\\\", \\\"subtitle\\\": \\\"Contrato renderizado pelo sandbox.\\\", \\\"components\\\": [{\\\"type\\\": \\\"alert\\\", \\\"variant\\\": \\\"success\\\", \\\"title\\\": \\\"Tudo certo\\\", \\\"text\\\": \\\"O contrato é válido e está pronto para interação.\\\"}, {\\\"type\\\": \\\"switch\\\", \\\"key\\\": \\\"enabled\\\", \\\"text\\\": \\\"Recurso habilitado\\\", \\\"checked\\\": true}, {\\\"type\\\": \\\"button\\\", \\\"text\\\": \\\"Emitir evento\\\", \\\"variant\\\": \\\"primary\\\", \\\"action\\\": \\\"preview_action\\\"}]}}}\"\n  }\n}",
        "m_type": 2,
        "supportsInput": true,
        "supportsOutput": false
      },
      {
        "description": "Schema declarativo JUIF multipágina. Aceita sections, fields, lists, components e shell de navegação.",
        "dictionary": {
          "entries": [],
          "isArray": false,
          "variableType": 4,
          "type": "Dictionary"
        },
        "isActionBlockWorkingVar": false,
        "isLocalVar": true,
        "isSecure": false,
        "m_booleanValue": false,
        "m_decimalValue": 0.0,
        "m_intValue": 0,
        "m_name": "UI Schema Json",
        "m_stringValue": "{\n  \"schema_version\": 1,\n  \"title\": \"JUIF — Guia interativo\",\n  \"initial_page\": \"overview\",\n  \"state\": {\n    \"primary_navigation\": \"overview\",\n    \"catalog_section\": \"layout\",\n    \"drawer_navigation\": \"overview\"\n  },\n  \"shell\": {\n    \"top_app_bar\": {\n      \"use_page_title\": true,\n      \"navigation_action\": \"open_drawer\",\n      \"navigation_text\": \"≡\",\n      \"actions\": [\n        {\n          \"text\": \"×\",\n          \"action\": \"close\"\n        }\n      ]\n    },\n    \"tab_bar\": {\n      \"key\": \"catalog_section\",\n      \"selected\": \"layout\",\n      \"visible_pages\": [\n        \"catalog_layout\",\n        \"catalog_forms\",\n        \"catalog_data\",\n        \"catalog_feedback\",\n        \"catalog_navigation\"\n      ],\n      \"items\": [\n        {\n          \"id\": \"layout\",\n          \"label\": \"Layout\",\n          \"target\": \"catalog_layout\"\n        },\n        {\n          \"id\": \"forms\",\n          \"label\": \"Formulários\",\n          \"target\": \"catalog_forms\"\n        },\n        {\n          \"id\": \"data\",\n          \"label\": \"Dados\",\n          \"target\": \"catalog_data\"\n        },\n        {\n          \"id\": \"feedback\",\n          \"label\": \"Feedback\",\n          \"target\": \"catalog_feedback\"\n        },\n        {\n          \"id\": \"navigation\",\n          \"label\": \"Navegação\",\n          \"target\": \"catalog_navigation\"\n        }\n      ]\n    },\n    \"bottom_navigation\": {\n      \"key\": \"primary_navigation\",\n      \"selected\": \"overview\",\n      \"items\": [\n        {\n          \"id\": \"overview\",\n          \"label\": \"Início\",\n          \"target\": \"overview\",\n          \"active_pages\": [\n            \"overview\"\n          ]\n        },\n        {\n          \"id\": \"catalog\",\n          \"label\": \"Catálogo\",\n          \"target\": \"catalog_layout\",\n          \"active_pages\": [\n            \"catalog_layout\",\n            \"catalog_forms\",\n            \"catalog_data\",\n            \"catalog_feedback\",\n            \"catalog_navigation\"\n          ]\n        },\n        {\n          \"id\": \"playground\",\n          \"label\": \"Laboratório\",\n          \"target\": \"playground\",\n          \"active_pages\": [\n            \"playground\"\n          ]\n        }\n      ]\n    },\n    \"navigation_drawer\": {\n      \"key\": \"drawer_navigation\",\n      \"title\": \"JUIF\",\n      \"subtitle\": \"Java UI Framework\",\n      \"footer\": \"CDXMS Solutions · capability v1.0.0\",\n      \"width\": 304,\n      \"items\": [\n        {\n          \"id\": \"overview\",\n          \"label\": \"Visão geral\",\n          \"subtitle\": \"Arquitetura e fluxo da capability\",\n          \"target\": \"overview\"\n        },\n        {\n          \"id\": \"layout\",\n          \"label\": \"Layout\",\n          \"subtitle\": \"Composição, tipografia e superfícies\",\n          \"target\": \"catalog_layout\"\n        },\n        {\n          \"id\": \"forms\",\n          \"label\": \"Formulários\",\n          \"subtitle\": \"Bindings, entradas e filtros\",\n          \"target\": \"catalog_forms\"\n        },\n        {\n          \"id\": \"data\",\n          \"label\": \"Dados\",\n          \"subtitle\": \"Métricas, listas e conteúdo\",\n          \"target\": \"catalog_data\"\n        },\n        {\n          \"id\": \"feedback\",\n          \"label\": \"Feedback\",\n          \"subtitle\": \"Estados e comunicação visual\",\n          \"target\": \"catalog_feedback\"\n        },\n        {\n          \"id\": \"navigation\",\n          \"label\": \"Navegação\",\n          \"subtitle\": \"Shell, abas, rail e drawer\",\n          \"target\": \"catalog_navigation\"\n        },\n        {\n          \"id\": \"playground\",\n          \"label\": \"Laboratório\",\n          \"subtitle\": \"Edite e renderize contratos\",\n          \"target\": \"playground\"\n        }\n      ]\n    }\n  },\n  \"pages\": [\n    {\n      \"id\": \"overview\",\n      \"title\": \"JUIF\",\n      \"subtitle\": \"Interfaces declarativas sofisticadas para o ecossistema CDXMS.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"container\",\n          \"variant\": \"surface2\",\n          \"radius\": 26,\n          \"padding_left\": 20,\n          \"padding_top\": 20,\n          \"padding_right\": 20,\n          \"padding_bottom\": 20,\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"variant\": \"label\",\n              \"text\": \"CAPABILITY DE INTERFACE\"\n            },\n            {\n              \"type\": \"spacer\",\n              \"height\": 6\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"title\",\n              \"text\": \"Uma camada visual consistente para todas as solutions\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"subtitle\",\n              \"text\": \"Defina páginas, estado, bindings e eventos em JSON. O JUIF transforma o contrato em uma experiência móvel elegante e previsível.\"\n            },\n            {\n              \"type\": \"spacer\",\n              \"height\": 12\n            },\n            {\n              \"type\": \"row\",\n              \"children\": [\n                {\n                  \"type\": \"stat_card\",\n                  \"label\": \"Componentes\",\n                  \"bind\": \"metrics.components\",\n                  \"value_type\": \"number\",\n                  \"variant\": \"primary\"\n                },\n                {\n                  \"type\": \"stat_card\",\n                  \"label\": \"Cobertura\",\n                  \"bind\": \"metrics.coverage\",\n                  \"value_type\": \"number\",\n                  \"variant\": \"success\"\n                }\n              ]\n            },\n            {\n              \"type\": \"progress_bar\",\n              \"label\": \"Catálogo documentado\",\n              \"bind\": \"metrics.coverage\",\n              \"value_type\": \"number\",\n              \"variant\": \"success\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Arquitetura em quatro etapas\",\n          \"subtitle\": \"Cada capability mantém uma responsabilidade clara.\",\n          \"children\": [\n            {\n              \"type\": \"key_value\",\n              \"label\": \"01 · Dados\",\n              \"value\": \"Config Json\"\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"02 · Estrutura\",\n              \"value\": \"UI Schema Json\"\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"03 · Normalização\",\n              \"value\": \"JUIF UI Builder\"\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"04 · Runtime\",\n              \"value\": \"Java UI Framework\"\n            }\n          ]\n        },\n        {\n          \"type\": \"alert\",\n          \"variant\": \"info\",\n          \"title\": \"Contrato antes de aparência\",\n          \"text\": \"O schema descreve intenção, estado e comportamento. O renderer aplica o padrão visual oficial do ecossistema.\"\n        },\n        {\n          \"type\": \"card\",\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"variant\": \"label\",\n              \"text\": \"PRÓXIMO PASSO\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"body\",\n              \"text\": \"Explore o catálogo por categoria ou abra o laboratório para editar um contrato real.\"\n            },\n            {\n              \"type\": \"button_group\",\n              \"buttons\": [\n                {\n                  \"text\": \"Explorar catálogo\",\n                  \"variant\": \"primary\",\n                  \"action\": \"replace\",\n                  \"target\": \"catalog_layout\"\n                },\n                {\n                  \"text\": \"Abrir laboratório\",\n                  \"variant\": \"secondary\",\n                  \"action\": \"replace\",\n                  \"target\": \"playground\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"copyable_text\",\n          \"label\": \"Fluxo completo\",\n          \"bind\": \"docs.flow\",\n          \"copy_text\": \"Copiar fluxo\"\n        }\n      ]\n    },\n    {\n      \"id\": \"catalog_layout\",\n      \"title\": \"Layout\",\n      \"subtitle\": \"Hierarquia, superfícies, ritmo e tipografia.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Tipografia semântica\",\n          \"subtitle\": \"Use variantes em vez de tamanhos e cores soltos.\",\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"variant\": \"label\",\n              \"text\": \"RÓTULO DE CONTEXTO\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"title\",\n              \"text\": \"Título principal\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"subtitle\",\n              \"text\": \"Subtítulo para contexto adicional.\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"body\",\n              \"text\": \"Texto de corpo para instruções, descrições e conteúdo corrente.\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"muted\",\n              \"text\": \"Informação secundária com menor ênfase.\"\n            }\n          ]\n        },\n        {\n          \"type\": \"container\",\n          \"variant\": \"surface3\",\n          \"radius\": 24,\n          \"children\": [\n            {\n              \"type\": \"column\",\n              \"children\": [\n                {\n                  \"type\": \"text\",\n                  \"variant\": \"label\",\n                  \"text\": \"COMPOSIÇÃO\"\n                },\n                {\n                  \"type\": \"text\",\n                  \"variant\": \"body\",\n                  \"text\": \"Container → Column → Row → Card\"\n                },\n                {\n                  \"type\": \"spacer\",\n                  \"height\": 10\n                },\n                {\n                  \"type\": \"row\",\n                  \"children\": [\n                    {\n                      \"type\": \"card\",\n                      \"children\": [\n                        {\n                          \"type\": \"badge\",\n                          \"variant\": \"success\",\n                          \"text\": \"Estável\"\n                        },\n                        {\n                          \"type\": \"text\",\n                          \"variant\": \"body\",\n                          \"text\": \"Primeiro bloco\"\n                        }\n                      ]\n                    },\n                    {\n                      \"type\": \"card\",\n                      \"children\": [\n                        {\n                          \"type\": \"badge\",\n                          \"variant\": \"info\",\n                          \"text\": \"Modular\"\n                        },\n                        {\n                          \"type\": \"text\",\n                          \"variant\": \"body\",\n                          \"text\": \"Segundo bloco\"\n                        }\n                      ]\n                    }\n                  ]\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Ritmo visual\",\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"variant\": \"body\",\n              \"text\": \"Spacer cria respiro. Divider separa grupos sem introduzir uma nova superfície.\"\n            },\n            {\n              \"type\": \"spacer\",\n              \"height\": 12\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"spacer\",\n              \"height\": 8\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"muted\",\n              \"text\": \"Conteúdo após a separação.\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"catalog_forms\",\n      \"title\": \"Formulários\",\n      \"subtitle\": \"Entradas consistentes, filtros e estado vinculado.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Busca e filtros\",\n          \"subtitle\": \"Os controles atualizam state e emitem eventos estruturados.\",\n          \"children\": [\n            {\n              \"type\": \"search_bar\",\n              \"id\": \"tutorial_search\",\n              \"label\": \"Pesquisar componentes\",\n              \"bind\": \"tutorial.search\",\n              \"clearable\": true\n            },\n            {\n              \"type\": \"chip\",\n              \"id\": \"interactive_only\",\n              \"text\": \"Somente interativos\",\n              \"bind\": \"tutorial.interactive_only\",\n              \"value_type\": \"boolean\"\n            },\n            {\n              \"type\": \"chip_group\",\n              \"id\": \"category_filters\",\n              \"bind\": \"tutorial.filters\",\n              \"value_type\": \"array\",\n              \"selection_mode\": \"multiple\",\n              \"items\": [\n                {\n                  \"id\": \"navigation\",\n                  \"label\": \"Navegação\"\n                },\n                {\n                  \"id\": \"forms\",\n                  \"label\": \"Formulários\"\n                },\n                {\n                  \"id\": \"feedback\",\n                  \"label\": \"Feedback\"\n                },\n                {\n                  \"id\": \"data\",\n                  \"label\": \"Dados\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Dados do exemplo\",\n          \"children\": [\n            {\n              \"type\": \"input\",\n              \"id\": \"profile_name\",\n              \"label\": \"Nome\",\n              \"bind\": \"profile.name\"\n            },\n            {\n              \"type\": \"input\",\n              \"id\": \"profile_email\",\n              \"label\": \"E-mail\",\n              \"bind\": \"profile.email\"\n            },\n            {\n              \"type\": \"textarea\",\n              \"id\": \"profile_description\",\n              \"label\": \"Descrição\",\n              \"bind\": \"profile.description\",\n              \"min_lines\": 4\n            },\n            {\n              \"type\": \"select\",\n              \"id\": \"profile_level\",\n              \"label\": \"Nível de experiência\",\n              \"bind\": \"profile.level\",\n              \"options\": [\n                {\n                  \"label\": \"Iniciante\",\n                  \"value\": \"beginner\"\n                },\n                {\n                  \"label\": \"Intermediário\",\n                  \"value\": \"intermediate\"\n                },\n                {\n                  \"label\": \"Avançado\",\n                  \"value\": \"advanced\"\n                }\n              ]\n            },\n            {\n              \"type\": \"radio_group\",\n              \"id\": \"profile_theme\",\n              \"label\": \"Tema\",\n              \"bind\": \"profile.theme\",\n              \"options\": [\n                {\n                  \"label\": \"Dark Gold\",\n                  \"value\": \"dark_gold\"\n                },\n                {\n                  \"label\": \"Dark Neutral\",\n                  \"value\": \"dark_neutral\"\n                }\n              ]\n            },\n            {\n              \"type\": \"switch\",\n              \"id\": \"profile_notifications\",\n              \"label\": \"Receber eventos de demonstração\",\n              \"bind\": \"profile.notifications\",\n              \"value_type\": \"boolean\"\n            },\n            {\n              \"type\": \"checkbox\",\n              \"id\": \"profile_terms\",\n              \"label\": \"Entendi o contrato de state\",\n              \"bind\": \"profile.terms\",\n              \"value_type\": \"boolean\"\n            },\n            {\n              \"type\": \"button_group\",\n              \"buttons\": [\n                {\n                  \"text\": \"Validar exemplo\",\n                  \"variant\": \"primary\",\n                  \"action\": \"validate_tutorial_form\"\n                },\n                {\n                  \"text\": \"Limpar evento\",\n                  \"variant\": \"ghost\",\n                  \"action\": \"clear_tutorial_event\"\n                }\n              ]\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"id\": \"catalog_data\",\n      \"title\": \"Dados\",\n      \"subtitle\": \"Métricas, listas e conteúdo estruturado.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"row\",\n          \"children\": [\n            {\n              \"type\": \"stat_card\",\n              \"label\": \"Componentes\",\n              \"bind\": \"metrics.components\",\n              \"value_type\": \"number\",\n              \"variant\": \"primary\"\n            },\n            {\n              \"type\": \"stat_card\",\n              \"label\": \"Categorias\",\n              \"bind\": \"metrics.categories\",\n              \"value_type\": \"number\",\n              \"variant\": \"info\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Metadados\",\n          \"children\": [\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Schema\",\n              \"value\": \"1\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Namespace\",\n              \"value\": \"CDXMS\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Renderer\",\n              \"value\": \"Java UI Framework\"\n            },\n            {\n              \"type\": \"badge\",\n              \"variant\": \"success\",\n              \"text\": \"Contrato válido\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Itens estáticos\",\n          \"children\": [\n            {\n              \"type\": \"list_item\",\n              \"title\": \"Contrato universal\",\n              \"subtitle\": \"Resultado com data e error estruturados.\",\n              \"value\": \"result_contract\",\n              \"action\": \"open_topic\"\n            },\n            {\n              \"type\": \"list_item\",\n              \"title\": \"Bindings declarativos\",\n              \"subtitle\": \"Config Json hidratando state e propriedades.\",\n              \"value\": \"bindings\",\n              \"action\": \"open_topic\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Lista dinâmica\",\n          \"subtitle\": \"O item template é repetido para cada objeto da fonte.\",\n          \"children\": [\n            {\n              \"type\": \"dynamic_list\",\n              \"id\": \"catalog_topics\",\n              \"bind\": \"catalog.items\",\n              \"value_type\": \"array\",\n              \"item_template\": {\n                \"type\": \"list_item\",\n                \"title\": \"{{title}}\",\n                \"subtitle\": \"{{subtitle}}\",\n                \"value\": \"{{value}}\",\n                \"action\": \"catalog_topic_selected\"\n              }\n            }\n          ]\n        },\n        {\n          \"type\": \"copyable_text\",\n          \"label\": \"Pipeline da UI\",\n          \"bind\": \"docs.flow\",\n          \"copy_text\": \"Copiar pipeline\"\n        }\n      ]\n    },\n    {\n      \"id\": \"catalog_feedback\",\n      \"title\": \"Feedback\",\n      \"subtitle\": \"Comunique estado, progresso e ausência de conteúdo.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"section\",\n          \"title\": \"Mensagens contextuais\",\n          \"children\": [\n            {\n              \"type\": \"alert\",\n              \"variant\": \"success\",\n              \"title\": \"Sucesso\",\n              \"text\": \"A operação foi concluída e o estado está consistente.\"\n            },\n            {\n              \"type\": \"alert\",\n              \"variant\": \"info\",\n              \"title\": \"Informação\",\n              \"text\": \"Este feedback explica o próximo passo sem interromper o fluxo.\"\n            },\n            {\n              \"type\": \"alert\",\n              \"variant\": \"warning\",\n              \"title\": \"Atenção\",\n              \"text\": \"Revise os dados antes de continuar.\"\n            },\n            {\n              \"type\": \"alert\",\n              \"variant\": \"error\",\n              \"title\": \"Erro\",\n              \"text\": \"A operação não pôde ser concluída.\"\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Processamento\",\n          \"children\": [\n            {\n              \"type\": \"loading_indicator\",\n              \"variant\": \"primary\",\n              \"text\": \"Atualizando interface\",\n              \"subtitle\": \"Sincronizando state e componentes.\"\n            },\n            {\n              \"type\": \"progress_bar\",\n              \"label\": \"Preparação do catálogo\",\n              \"bind\": \"metrics.coverage\",\n              \"value_type\": \"number\",\n              \"variant\": \"success\"\n            }\n          ]\n        },\n        {\n          \"type\": \"empty_state\",\n          \"eyebrow\": \"ESTADO VAZIO\",\n          \"icon\": \"—\",\n          \"title\": \"Nenhum resultado encontrado\",\n          \"text\": \"Ajuste os filtros ou restaure a visualização completa do catálogo.\",\n          \"action\": {\n            \"text\": \"Restaurar catálogo\",\n            \"variant\": \"secondary\",\n            \"action\": \"restore_catalog\"\n          }\n        }\n      ]\n    },\n    {\n      \"id\": \"catalog_navigation\",\n      \"title\": \"Navegação\",\n      \"subtitle\": \"Um shell coerente mantém contexto e reduz complexidade.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"alert\",\n          \"variant\": \"info\",\n          \"title\": \"A própria documentação é o exemplo\",\n          \"text\": \"Top App Bar, Tab Bar, Bottom Navigation e Navigation Drawer estão ativos como shell persistente desta interface.\"\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Navigation Rail\",\n          \"subtitle\": \"Indicado para layouts amplos ou fluxos com poucas áreas principais.\",\n          \"children\": [\n            {\n              \"type\": \"navigation_rail\",\n              \"key\": \"rail_demo\",\n              \"selected\": \"navigation\",\n              \"item_width\": 72,\n              \"items\": [\n                {\n                  \"id\": \"home\",\n                  \"label\": \"Início\",\n                  \"target\": \"overview\"\n                },\n                {\n                  \"id\": \"navigation\",\n                  \"label\": \"Navegação\",\n                  \"target\": \"catalog_navigation\"\n                },\n                {\n                  \"id\": \"lab\",\n                  \"label\": \"Lab\",\n                  \"target\": \"playground\"\n                }\n              ]\n            }\n          ]\n        },\n        {\n          \"type\": \"section\",\n          \"title\": \"Comportamento do shell\",\n          \"children\": [\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Top App Bar\",\n              \"value\": \"Contexto e ações globais\"\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Tab Bar\",\n              \"value\": \"Categorias relacionadas\"\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Bottom Navigation\",\n              \"value\": \"Áreas principais\"\n            },\n            {\n              \"type\": \"divider\"\n            },\n            {\n              \"type\": \"key_value\",\n              \"label\": \"Drawer\",\n              \"value\": \"Mapa completo da documentação\"\n            }\n          ]\n        },\n        {\n          \"type\": \"button\",\n          \"text\": \"Abrir Navigation Drawer\",\n          \"variant\": \"secondary\",\n          \"action\": \"open_drawer\"\n        }\n      ]\n    },\n    {\n      \"id\": \"playground\",\n      \"title\": \"Laboratório\",\n      \"subtitle\": \"Edite, formate, copie e renderize contratos JUIF.\",\n      \"show_header\": false,\n      \"components\": [\n        {\n          \"type\": \"container\",\n          \"variant\": \"surface2\",\n          \"radius\": 24,\n          \"children\": [\n            {\n              \"type\": \"text\",\n              \"variant\": \"label\",\n              \"text\": \"AMBIENTE DE TESTE\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"title\",\n              \"text\": \"Do schema ao preview\"\n            },\n            {\n              \"type\": \"text\",\n              \"variant\": \"subtitle\",\n              \"text\": \"Use o exemplo mínimo como referência e experimente alterações no sandbox.\"\n            }\n          ]\n        },\n        {\n          \"type\": \"code_block\",\n          \"id\": \"schema_example\",\n          \"title\": \"UI Schema Json mínimo\",\n          \"language\": \"json\",\n          \"bind\": \"docs.schema_example\",\n          \"auto_indent\": true\n        },\n        {\n          \"type\": \"sandbox\",\n          \"id\": \"tutorial_sandbox\",\n          \"bind\": \"docs.sandbox\"\n        },\n        {\n          \"type\": \"button_group\",\n          \"buttons\": [\n            {\n              \"text\": \"Voltar ao início\",\n              \"variant\": \"ghost\",\n              \"action\": \"replace\",\n              \"target\": \"overview\"\n            },\n            {\n              \"text\": \"Abrir catálogo\",\n              \"variant\": \"secondary\",\n              \"action\": \"replace\",\n              \"target\": \"catalog_layout\"\n            }\n          ]\n        }\n      ]\n    }\n  ]\n}",
        "m_type": 2,
        "supportsInput": true,
        "supportsOutput": false
      },
      {
