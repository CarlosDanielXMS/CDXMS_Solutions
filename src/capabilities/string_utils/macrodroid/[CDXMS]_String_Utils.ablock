      },
      {
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ID=\"string_utils\",VERSION=\"1.0.0\";function t(v){return String(v==null?\"\":v)}function tr(v){return t(v).trim()}function b(v,d){let s=tr(v).toLowerCase();if([\"true\",\"1\",\"sim\",\"s\",\"verdadeiro\"].includes(s))return true;if([\"false\",\"0\",\"não\",\"nao\",\"n\",\"falso\"].includes(s))return false;return d===true}function norm(s){return tr(s).normalize(\"NFD\").replace(/[\\u0300-\\u036f]/g,\"\").replace(/\\s+/g,\" \")}function snake(s){return norm(s).replace(/([a-z0-9])([A-Z])/g,\"$1_$2\").replace(/[^A-Za-z0-9]+/g,\"_\").replace(/^_+|_+$/g,\"\").toLowerCase()}function kebab(s){return snake(s).replace(/_/g,\"-\")}function out(ok,op,msg,data,error){return {schema_version:1,namespace:\"CDXMS\",success:ok,status:ok?\"success\":\"error\",artifact_type:\"capability\",artifact_id:ID,operation:op,message:msg,data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:\"[CDXMS] String Utils\",version:VERSION,session_id:tr(`{lv=Session Id}`),correlation_id:tr(`{lv=Correlation Id}`)}}}let op=tr(`{lv=Operation}`),x=t(`{lv=Text}`),q=t(`{lv=Search Text}`),r=t(`{lv=Replace Text}`),rx=t(`{lv=Regex Pattern}`),rf=t(`{lv=Regex Flags}`)||\"g\",allowSlash=b(`{lv=Allow Slash?}`),mode=tr(`{lv=Comparison Mode}`)||\"case_sensitive\",cm=tr(`{lv=Case Mode}`)||\"none\",max=parseInt(tr(`{lv=Max Length}`)||\"0\",10),res;try{let value=x,boolean_value=null;if(op===\"escape_json_string\")value=JSON.stringify(x).slice(1,-1);else if(op===\"unescape_json_string\")value=JSON.parse('\"'+x.replace(/\"/g,'\\\\\"')+'\"');else if(op===\"normalize_text\")value=norm(x);else if(op===\"normalize_id\"||op===\"to_snake_case\")value=snake(x);else if(op===\"to_kebab_case\")value=kebab(x);else if(op===\"trim\")value=tr(x);else if(op===\"collapse_whitespace\")value=x.replace(/\\s+/g,\" \").trim();else if(op===\"replace_text\"){if(!q)throw {code:\"STRING_EMPTY_SEARCH_TEXT\",message:\"Search Text é obrigatório.\"};value=rx?x.replace(new RegExp(rx,rf.indexOf(\"g\")>=0?rf:rf+\"g\"),r):x.split(q).join(r)}else if([\"contains_text\",\"equals_text\",\"starts_with\",\"ends_with\"].includes(op)){let a=x,c=q;if(mode===\"case_insensitive\"){a=a.toLowerCase();c=c.toLowerCase()}else if(mode===\"normalized\"){a=norm(a).toLowerCase();c=norm(c).toLowerCase()}if(op===\"contains_text\")boolean_value=a.indexOf(c)>=0;if(op===\"equals_text\")boolean_value=a===c;if(op===\"starts_with\")boolean_value=a.indexOf(c)===0;if(op===\"ends_with\")boolean_value=c===\"\"||a.slice(-c.length)===c;value=boolean_value}else if(op===\"is_blank\"){boolean_value=tr(x)===\"\";value=boolean_value}else if(op===\"sanitize_file_name\")value=tr(x).replace(/[\\\\/:*?\"<>|\\x00-\\x1F]/g,\"_\").replace(/\\.+$/g,\"\")||\"unnamed\";else if(op===\"sanitize_path_segment\")value=allowSlash?tr(x).split(\"/\").map(v=>v.replace(/[\\\\\\x00-\\x1F]/g,\"_\").replace(/^\\.+|\\.+$/g,\"\")||\"segment\").join(\"/\"):tr(x).replace(/[\\\\/\\x00-\\x1F]/g,\"_\").replace(/^\\.+|\\.+$/g,\"\")||\"segment\";else if(op===\"truncate\"){if(isNaN(max)||max<0)throw {code:\"STRING_INVALID_MAX_LENGTH\",message:\"Max Length inválido.\"};value=max===0?\"\":Array.from(x).slice(0,max).join(\"\")}else throw {code:\"UNSUPPORTED_OPERATION\",message:\"Operação não suportada.\"};if(typeof value===\"string\"){if(cm===\"lower\")value=value.toLowerCase();if(cm===\"upper\")value=value.toUpperCase();if(cm===\"title\")value=value.toLowerCase().replace(/(^|\\s)\\S/g,m=>m.toUpperCase())}res=out(true,op,\"Operação de texto executada com sucesso.\",{value:value,boolean_value:boolean_value,length:typeof value===\"string\"?Array.from(value).length:null},null)}catch(e){res=out(false,op,e.message||\"Falha ao transformar texto.\",{}, {code:e.code||\"STRING_TRANSFORM_FAILED\",message:e.message||\"Falha ao transformar texto.\",details:{},recoverable:true})}return JSON.stringify(res);",
        "stringVariableName": "Tmp_StringWorkJson",
