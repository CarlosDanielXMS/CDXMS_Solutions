        "actionLabel": "01 — Processar [CDXMS] String Utils",
        "disableLogging": false,
        "m_SIGUID": -705584347448475128,
        "m_classType": "ActionGroupAction",
        "m_comment": "Capability pura para transformação, normalização, comparação e sanitização de textos.",
        "m_constraintList": [],
