        "m_isOrCondition": false,
        "actionLabel": "Calcular SHA-256 homologado",
        "blockNextAction": true,
        "m_nonRoot": true,
        "m_script": "#!/system/bin/sh\nFILE_PATH=\"{lv=Tmp_NormalizedFilePath}\"\nREPORT_PATH=\"{lv=Tmp_ReportFilePath}\"\nEXECUTOR=\"/system/bin/sha256sum\"\nEXISTS=false\nREGULAR=false\nREADABLE=false\nAVAILABLE=false\nEXIT_CODE=127\nACTUAL=\"\"\nOUTPUT_VALID=false\nif [ -e \"$FILE_PATH\" ]; then EXISTS=true; fi\nif [ -f \"$FILE_PATH\" ]; then REGULAR=true; fi\nif [ -r \"$FILE_PATH\" ]; then READABLE=true; fi\nif [ -x \"$EXECUTOR\" ]; then AVAILABLE=true; fi\nif [ \"$EXISTS\" = true ] && [ \"$REGULAR\" = true ] && [ \"$READABLE\" = true ] && [ \"$AVAILABLE\" = true ]; then\n  OUTPUT=$($EXECUTOR \"$FILE_PATH\" 2>/dev/null)\n  EXIT_CODE=$?\n  set -- $OUTPUT\n  RAW_HASH=\"${1:-}\"\n  ACTUAL=$(printf '%s' \"$RAW_HASH\" | tr 'A-F' 'a-f')\n  case \"$ACTUAL\" in\n    ''|*[!0-9a-f]*) ACTUAL=\"\" ;;\n    *) if [ \"${#ACTUAL}\" -eq 64 ]; then OUTPUT_VALID=true; else ACTUAL=\"\"; fi ;;\n  esac\nfi\nGENERATED_AT=$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)\nprintf '{\"schema_version\":1,\"namespace\":\"CDXMS\",\"file_type\":\"file_integrity_runtime_report\",\"generated_at\":\"%s\",\"executor\":\"%s\",\"execution_context\":{\"non_root\":true,\"use_helper\":false,\"use_shizuku\":false},\"file\":{\"exists\":%s,\"regular\":%s,\"readable\":%s},\"executor_available\":%s,\"exit_code\":%s,\"actual_sha256\":\"%s\",\"output_valid\":%s}\\n' \"$GENERATED_AT\" \"$EXECUTOR\" \"$EXISTS\" \"$REGULAR\" \"$READABLE\" \"$AVAILABLE\" \"$EXIT_CODE\" \"$ACTUAL\" \"$OUTPUT_VALID\" > \"$REPORT_PATH\"\n",
        "timeoutSeconds": 30,
        "useHelper": false,
        "useShizuku": false
      },
