        "dontLogIfConditionIsFalse": false
      },
      {
        "disableLogging": false,
        "m_SIGUID": -4096156049327197005,
        "m_classType": "JavaScriptAction",
        "m_comment": "Valida entradas, restringe o path ao base_path CDXMS e cria paths temporários seguros.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Validar operação e caminho",
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ARTIFACT_ID = \"file_integrity\";\nconst VERSION = \"1.0.0\";\nconst SOURCE_NAME = \"[CDXMS] File Integrity\";\nconst BASE_PATH = \"/storage/emulated/0/Documents/CDXMS_Solutions\";\nconst REPORT_FOLDER = BASE_PATH + \"/cache/file_integrity/runtime\";\nconst SUPPORTED = [\"calculate_sha256\", \"verify_sha256\"];\nfunction raw(v){ return String(v == null ? \"\" : v); }\nfunction txt(v){ return raw(v).trim(); }\nfunction result(success,status,operation,message,data,error){\n  return {schema_version:1,namespace:\"CDXMS\",success:success===true,status:status||(success?\"success\":\"error\"),artifact_type:\"capability\",artifact_id:ARTIFACT_ID,operation:operation||\"\",message:message||\"\",data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:SOURCE_NAME,version:VERSION,session_id:txt(`{lv=Session Id}`),correlation_id:txt(`{lv=Correlation Id}`)}};\n}\nfunction err(code,message,details,recoverable){ return {code:code,message:message,details:details||{},recoverable:recoverable===true}; }\nfunction normalizePath(value){\n  let p=txt(value).replace(/\\\\+/g,\"/\").replace(/\\/{2,}/g,\"/\");\n  if(p.length>1 && p.endsWith(\"/\")) p=p.slice(0,-1);\n  return p;\n}\nfunction safePath(path){\n  if(!path || path.indexOf(BASE_PATH + \"/\")!==0) return {valid:false,reason:\"outside_base_path\"};\n  const parts=path.split(\"/\");\n  if(parts.indexOf(\"..\")>=0 || parts.indexOf(\".\")>=0) return {valid:false,reason:\"path_traversal\"};\n  if(/[\\u0000\\r\\n\\\"'`$;&|<>\\\\*?\\[\\]{}()!]/.test(path)) return {valid:false,reason:\"unsafe_character\"};\n  return {valid:true,reason:\"\"};\n}\nconst op=txt(`{lv=Operation}`).toLowerCase();\nconst filePath=normalizePath(`{lv=File Path}`);\nconst expected=txt(`{lv=Expected SHA-256}`).toLowerCase();\nlet preResult=null;\nlet shouldExecute=false;\nlet __fiOutput=\"\";\ntry {\n  if(!op) throw {code:\"MISSING_REQUIRED_INPUT\",message:\"A entrada Operation é obrigatória.\",details:{input:\"Operation\"}};\n  if(SUPPORTED.indexOf(op)<0) throw {code:\"UNSUPPORTED_OPERATION\",message:\"A operação informada não é suportada pelo File Integrity.\",details:{operation:op,supported_operations:SUPPORTED}};\n  if(!filePath) throw {code:\"MISSING_REQUIRED_INPUT\",message:\"A entrada File Path é obrigatória.\",details:{input:\"File Path\"}};\n  const checked=safePath(filePath);\n  if(!checked.valid) throw {code:\"UNSAFE_FILE_PATH\",message:\"O caminho informado é inválido ou está fora do escopo seguro do CDXMS.\",details:{file_path:filePath,reason:checked.reason}};\n  if(op===\"verify_sha256\" && !expected) throw {code:\"MISSING_REQUIRED_INPUT\",message:\"Expected SHA-256 é obrigatório para verify_sha256.\",details:{input:\"Expected SHA-256\"}};\n  if(op===\"verify_sha256\" && !/^[0-9a-f]{64}$/.test(expected)) throw {code:\"INVALID_INPUT_TYPE\",message:\"Expected SHA-256 deve conter exatamente 64 caracteres hexadecimais.\",details:{input:\"Expected SHA-256\",value:expected}};\n  shouldExecute=true;\n} catch(e){\n  const code=e&&e.code?e.code:\"PROCESSING_FAILED\";\n  const message=e&&e.message?e.message:\"Falha ao preparar a validação de integridade.\";\n  preResult=result(false,\"error\",op,message,{algorithm:\"sha256\",executor:\"/system/bin/sha256sum\",file_path:filePath,expected_sha256:expected||\"\",actual_sha256:\"\",matches:false,verification_state:\"preflight_rejected\"},err(code,message,e&&e.details?e.details:{},false));\n}\nconst nonce=Date.now().toString(36)+\"_\"+Math.random().toString(16).slice(2,10);\nconst reportFilePath=REPORT_FOLDER+\"/file_integrity_\"+nonce+\".json\";\n__fiOutput=JSON.stringify({operation:op,file_path:filePath,expected_sha256:expected,should_execute:shouldExecute,report_folder_path:REPORT_FOLDER,report_file_path:reportFilePath,pre_result:preResult});\n__fiOutput;",
        "stringVariableName": "Tmp_WorkJson"
      },
      {
        "disableLogging": false,
        "m_SIGUID": -4096156049327197006,
        "m_classType": "JavaScriptAction",
        "m_comment": "Materializa should_execute como texto para constraints nativas.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Extrair flag de execução",
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const w=JSON.parse(`{lv=Tmp_WorkJson}`); String(w.should_execute===true);",
        "stringVariableName": "Tmp_ShouldExecuteText"
