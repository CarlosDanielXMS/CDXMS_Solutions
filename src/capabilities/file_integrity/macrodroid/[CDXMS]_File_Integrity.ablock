        "m_comment": "Fecha o grupo.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Fim — Calcular SHA-256"
      },
      {
        "disableLogging": false,
        "m_SIGUID": -4096156049327197020,
        "m_classType": "ActionGroupAction",
        "m_comment": "",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "03 — Finalizar Resultado",
        "actionGroupName": "03 — Finalizar Resultado",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false
      },
      {
        "disableLogging": false,
        "m_SIGUID": -4096156049327197021,
        "m_classType": "JavaScriptAction",
        "m_comment": "Classifica existência, executor, saída, comparação e limpeza sem falso sucesso.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Consolidar Resultado de integridade",
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "const ARTIFACT_ID=\"file_integrity\";\nconst VERSION=\"1.0.0\";\nconst SOURCE_NAME=\"[CDXMS] File Integrity\";\nfunction raw(v){return String(v==null?\"\":v);} function txt(v){return raw(v).trim();}\nfunction parse(v,f){const s=txt(v);if(!s)return f;try{return JSON.parse(s);}catch(e){return f;}}\nfunction result(success,status,operation,message,data,error){return JSON.stringify({schema_version:1,namespace:\"CDXMS\",success:success===true,status:status||(success?\"success\":\"error\"),artifact_type:\"capability\",artifact_id:ARTIFACT_ID,operation:operation||\"\",message:message||\"\",data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:SOURCE_NAME,version:VERSION,session_id:txt(`{lv=Session Id}`),correlation_id:txt(`{lv=Correlation Id}`)}});}\nfunction err(code,message,details,recoverable){return {code:code,message:message,details:details||{},recoverable:recoverable===true};}\nconst work=parse(`{lv=Tmp_WorkJson}`,{});\nconst pre=work.pre_result&&typeof work.pre_result===\"object\"&&!Array.isArray(work.pre_result)?work.pre_result:null;\nlet __fiOutput=\"\";\nif(pre){__fiOutput=JSON.stringify(pre);}else{\n const op=txt(work.operation||`{lv=Operation}`);\n const filePath=txt(work.file_path);\n const expected=txt(work.expected_sha256).toLowerCase();\n const ensure=parse(`{lv=Tmp_JcmEnsureResultJson}`,{});\n const report=parse(`{lv=Tmp_ShellReportJson}`,null);\n const cleanup=parse(`{lv=Tmp_JcmDeleteResultJson}`,{});\n const ensureOk=ensure&&ensure.success===true;\n const cleanupOk=cleanup&&cleanup.success===true;\n const baseData={algorithm:\"sha256\",executor:\"/system/bin/sha256sum\",execution_context:{non_root:true,use_helper:false,use_shizuku:false},file_path:filePath,expected_sha256:expected,actual_sha256:\"\",matches:op===\"verify_sha256\"?false:null,verification_state:\"failed\",runtime:{executor_available:false,exit_code:0,output_valid:false},cleanup:{requested:true,verified:cleanupOk}};\n if(!ensureOk){\n  const message=\"Não foi possível preparar o cache temporário do File Integrity.\";\n  __fiOutput=result(false,\"error\",op,message,baseData,err(\"CHECKSUM_EXECUTION_FAILED\",message,{jcm_status:txt(ensure&&ensure.status),jcm_message:txt(ensure&&ensure.message)},true));\n }else if(!report||report.schema_version!==1||report.namespace!==\"CDXMS\"||report.file_type!==\"file_integrity_runtime_report\"){\n  const message=\"O executor SHA-256 não produziu um relatório válido.\";\n  __fiOutput=result(false,\"error\",op,message,baseData,err(\"CHECKSUM_EXECUTION_FAILED\",message,{report_present:!!report},true));\n }else{\n  const file=report.file||{};\n  const actual=txt(report.actual_sha256).toLowerCase();\n  const exitCode=Number(report.exit_code);\n  const available=report.executor_available===true;\n  const outputValid=report.output_valid===true&&/^[0-9a-f]{64}$/.test(actual);\n  baseData.actual_sha256=actual;\n  baseData.runtime={executor_available:available,exit_code:isFinite(exitCode)?exitCode:0,output_valid:outputValid};\n  if(file.exists!==true){\n   const message=\"O arquivo informado não foi encontrado.\";\n   baseData.verification_state=\"file_not_found\";\n   __fiOutput=result(false,\"not_found\",op,message,baseData,err(\"FILE_NOT_FOUND\",message,{file_path:filePath},true));\n  }else if(file.regular!==true){\n   const message=\"O caminho informado não representa um arquivo regular.\";\n   baseData.verification_state=\"invalid_file_type\";\n   __fiOutput=result(false,\"error\",op,message,baseData,err(\"INVALID_INPUT_TYPE\",message,{file_path:filePath},false));\n  }else if(file.readable!==true){\n   const message=\"O arquivo informado não pode ser lido pelo executor de integridade.\";\n   baseData.verification_state=\"permission_denied\";\n   __fiOutput=result(false,\"error\",op,message,baseData,err(\"PERMISSION_DENIED\",message,{file_path:filePath},true));\n  }else if(!available||exitCode===127){\n   const message=\"O executor SHA-256 homologado não está disponível neste dispositivo.\";\n   baseData.verification_state=\"executor_unavailable\";\n   __fiOutput=result(false,\"blocked\",op,message,baseData,err(\"CHECKSUM_EXECUTOR_UNAVAILABLE\",message,{executor:\"/system/bin/sha256sum\",exit_code:exitCode},true));\n  }else if(exitCode!==0){\n   const message=\"O executor SHA-256 falhou ao processar o arquivo.\";\n   baseData.verification_state=\"execution_failed\";\n   __fiOutput=result(false,\"error\",op,message,baseData,err(\"CHECKSUM_EXECUTION_FAILED\",message,{executor:\"/system/bin/sha256sum\",exit_code:exitCode},true));\n  }else if(!outputValid){\n   const message=\"O executor SHA-256 retornou uma saída inválida.\";\n   baseData.verification_state=\"invalid_output\";\n   __fiOutput=result(false,\"error\",op,message,baseData,err(\"CHECKSUM_INVALID_OUTPUT\",message,{actual_sha256:actual,exit_code:exitCode},false));\n  }else if(op===\"verify_sha256\"){\n   const matches=actual===expected;\n   baseData.matches=matches;\n   baseData.verification_state=matches?\"verified\":\"mismatch\";\n   if(matches){__fiOutput=result(true,cleanupOk?\"success\":\"partial\",op,\"O SHA-256 do arquivo corresponde ao valor esperado.\",baseData,null);}\n   else{const message=\"O SHA-256 do arquivo não corresponde ao valor esperado.\";__fiOutput=result(false,\"error\",op,message,baseData,err(\"CHECKSUM_MISMATCH\",message,{expected_sha256:expected,actual_sha256:actual,file_path:filePath},false));}\n  }else{\n   baseData.verification_state=\"calculated\";\n   __fiOutput=result(true,cleanupOk?\"success\":\"partial\",op,\"SHA-256 calculado com sucesso.\",baseData,null);\n  }\n }\n}\n__fiOutput;",
        "stringVariableName": "Tmp_ResultJson"
      },
      {
        "disableLogging": false,
        "m_SIGUID": -4096156049327197022,
        "m_classType": "JsonParseAction",
        "m_comment": "Publica a saída única Resultado.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "Publicar Resultado",
        "dictionaryKeys": {
          "keys": []
        },
        "dictionaryVarName": "Resultado",
        "stringVarName": "Tmp_ResultJson"
      },
