    "m_actionList": [
      {
        "disableLogging": false,
        "m_SIGUID": -4096156049327197004,
        "m_classType": "ActionGroupAction",
        "m_comment": "",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false,
        "actionLabel": "01 — Preparar integridade",
