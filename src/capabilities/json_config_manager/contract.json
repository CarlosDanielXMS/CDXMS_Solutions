{
  "schema_version": 1,
  "namespace": "CDXMS",
  "artifact_type": "capability_contract",
  "artifact_id": "json_config_manager",
  "version": "1.0.0",
  "action_block": "[CDXMS] Json Config Manager",
  "description": "Contrato da capability [CDXMS] Json Config Manager v1.0.0.",
  "inputs": [
    {
      "name": "Operation",
      "type": "string",
      "required": true,
      "description": "Operação técnica.",
      "options": [
        "ensure_core",
        "repair_core",
        "ensure_folder",
        "validate_json",
        "read_json",
        "exists",
        "write_json",
        "merge_json",
        "ensure_file",
        "backup_file",
        "delete_file"
      ]
    },
    {
      "name": "File Path",
      "type": "string",
      "required": "conditional",
      "description": "Arquivo JSON alvo."
    },
    {
      "name": "Folder Path",
      "type": "string",
      "required": "conditional",
      "description": "Pasta alvo."
    },
    {
      "name": "Json Path",
      "type": "string",
      "required": false,
      "description": "Caminho lógico. Vazio/$ retorna documento completo."
    },
    {
      "name": "Value Json",
      "type": "string(json)",
      "required": "conditional",
      "description": "JSON de entrada."
    },
    {
      "name": "Default Json",
      "type": "string(json)",
      "required": "conditional",
      "description": "JSON padrão."
    },
    {
      "name": "Create If Missing?",
      "type": "boolean",
      "required": false,
      "description": "Autoriza criação."
    },
    {
      "name": "Pretty Print?",
      "type": "boolean",
      "required": false,
      "description": "Formata JSON."
    },
    {
      "name": "Merge Strategy",
      "type": "string",
      "required": "conditional",
      "description": "deep_merge, preserve_existing, overwrite_existing ou replace."
    }
  ],
  "outputs": [
    {
      "name": "Resultado",
      "type": "dictionary",
      "description": "Saída pública única no contrato CDXMS."
    }
  ],
  "operations": {
    "ensure_core": {
      "description": "Cria/atualiza seed mínimo do core local sem lifecycle de artifacts.",
      "required_inputs": [
        "Operation"
      ],
      "data_fields": [
        "base_path",
        "created_files",
        "version"
      ]
    },
    "repair_core": {
      "description": "Reaplica seed mínimo do core.",
      "required_inputs": [
        "Operation"
      ],
      "data_fields": [
        "base_path",
        "created_files",
        "version"
      ]
    },
    "ensure_folder": {
      "description": "Garante pasta local dentro do base_path.",
      "required_inputs": [
        "Operation",
        "Folder Path"
      ],
      "data_fields": [
        "folder_path"
      ]
    },
    "validate_json": {
      "description": "Valida Value Json e opcionalmente Json Path.",
      "required_inputs": [
        "Operation",
        "Value Json"
      ],
      "data_fields": [
        "valid",
        "json_path",
        "found",
        "match_count",
        "value",
        "values",
        "content"
      ]
    },
    "read_json": {
      "description": "Lê documento completo ou trecho por JsonPath.",
      "required_inputs": [
        "Operation",
        "File Path"
      ],
      "data_fields": [
        "file_path",
        "json_path",
        "exists",
        "found",
        "match_count",
        "value",
        "values",
        "content"
      ]
    },
    "exists": {
      "description": "Verifica existência de arquivo/nó.",
      "required_inputs": [
        "Operation",
        "File Path"
      ],
      "data_fields": [
        "file_path",
        "exists",
        "json_path",
        "found",
        "match_count"
      ]
    },
    "write_json": {
      "description": "Grava Value Json no documento ou alvo único.",
      "required_inputs": [
        "Operation",
        "File Path",
        "Value Json"
      ],
      "data_fields": [
        "file_path",
        "json_path",
        "created",
        "value",
        "content"
      ]
    },
    "merge_json": {
      "description": "Mescla Value Json no documento ou alvo único.",
      "required_inputs": [
        "Operation",
        "File Path",
        "Value Json",
        "Merge Strategy"
      ],
      "data_fields": [
        "file_path",
        "json_path",
        "created",
        "merge_strategy",
        "value",
        "content"
      ]
    },
    "ensure_file": {
      "description": "Cria arquivo ausente usando Default Json quando autorizado.",
      "required_inputs": [
        "Operation",
        "File Path",
        "Default Json",
        "Create If Missing?"
      ],
      "data_fields": [
        "file_path",
        "created",
        "content"
      ]
    },
    "backup_file": {
      "description": "Cria backup textual .bak.",
      "required_inputs": [
        "Operation",
        "File Path"
      ],
      "data_fields": [
        "file_path",
        "backup_path"
      ]
    },
    "delete_file": {
      "description": "Remove arquivo JSON dentro do base_path.",
      "required_inputs": [
        "Operation",
        "File Path"
      ],
      "data_fields": [
        "file_path"
      ]
    }
  },
  "errors": [
    "INVALID_JSON_PATH",
    "JSON_PATH_NOT_FOUND",
    "JSON_PATH_AMBIGUOUS_MATCH",
    "JSON_PATH_TARGET_NOT_OBJECT",
    "JSON_PATH_TARGET_NOT_ARRAY",
    "JSON_PATH_INDEX_OUT_OF_RANGE",
    "JSON_PATH_UNSUPPORTED_EXPRESSION",
    "JSON_PATH_WRITE_NOT_ALLOWED",
    "JSON_PATH_CREATE_NOT_SUPPORTED",
    "INVALID_JSON",
    "FILE_NOT_FOUND",
    "FILE_READ_ERROR",
    "FILE_WRITE_ERROR",
    "PERMISSION_DENIED",
    "INVALID_ENUM_VALUE",
    "PROCESSING_FAILED",
    "UNSUPPORTED_OPERATION"
  ],
  "result": {
    "output_variable": "Resultado",
    "top_level_fields": [
      "schema_version",
      "namespace",
      "success",
      "status",
      "artifact_type",
      "artifact_id",
      "operation",
      "message",
      "data",
      "error",
      "meta"
    ],
    "forbidden_top_level_fields": [
      "data_json",
      "error_code",
      "error_message",
      "error_json"
    ]
  },
  "json_path_engine": {
    "name": "JCM JsonPath Engine v1",
    "supported_syntax": [
      "$",
      "a.b.c",
      "a[\"b\"]",
      "a[0]",
      "a[*]",
      "a[0:5]",
      "a[0,2,4]",
      "a[id=\"x\"]",
      "a[?(@.id==\"x\")]",
      "a[?(@.enabled==true)]",
      "a[id=\"x\"].name",
      "$..artifact_id"
    ],
    "read_semantics": "read_json e exists aceitam zero, um ou múltiplos matches.",
    "write_semantics": "write_json e merge_json só alteram a raiz ou um único alvo.",
    "complete_config_read": "Json Path vazio ou $ retorna o documento completo."
  }
}
