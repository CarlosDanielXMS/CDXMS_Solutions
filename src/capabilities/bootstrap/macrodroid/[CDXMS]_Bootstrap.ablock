        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "\nconst ARTIFACT_ID = \"bootstrap\";\nconst VERSION = \"1.0.0\";\nfunction parseMaybe(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s) return {};\n  try { return JSON.parse(s); } catch(e) { return s; }\n}\nfunction boolText(raw) { return String(raw || \"\").toLowerCase() === \"true\"; }\nfunction result(success, status, operation, message, data, error) {\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success: success === true,\n    status: String(status || (success ? \"success\" : \"error\")),\n    artifact_type: \"capability\",\n    artifact_id: ARTIFACT_ID,\n    operation: String(operation || \"\"),\n    message: String(message || \"\"),\n    data: data && typeof data === \"object\" && !Array.isArray(data) ? data : {},\n    error: error || null,\n    meta: { timestamp: new Date().toISOString(), source: \"[CDXMS] Bootstrap\", version: VERSION, session_id: String(`{lv=Session Id}` || \"\"), correlation_id: String(`{lv=Correlation Id}` || \"\") }\n  });\n}\nconst extra = (() => { const checks = [\n {file_path:\".cdxms_root.json\", exists: boolText(`{lv=Tmp_RootResult[data][exists]}`)},\n {file_path:\"core/manifest.json\", exists: boolText(`{lv=Tmp_CoreManifestResult[data][exists]}`)},\n {file_path:\"core/settings.json\", exists: boolText(`{lv=Tmp_SettingsResult[data][exists]}`)},\n {file_path:\"core/registry.json\", exists: boolText(`{lv=Tmp_RegistryResult[data][exists]}`)},\n {file_path:\"core/enums.json\", exists: boolText(`{lv=Tmp_EnumsResult[data][exists]}`)},\n {file_path:\"core/errors.json\", exists: boolText(`{lv=Tmp_ErrorsResult[data][exists]}`)},\n {file_path:\"core/result_contract.json\", exists: boolText(`{lv=Tmp_ResultContractResult[data][exists]}`)},\n {file_path:\"core/compatibility.json\", exists: boolText(`{lv=Tmp_CompatibilityResult[data][exists]}`)}\n]; const missing = checks.filter(x=>!x.exists).map(x=>x.file_path); return { bootstrap_status: missing.length===0 ? \"core_valid\" : \"core_incomplete\", checks, missing_files: missing, valid: missing.length===0 }; })();\nresult(true, \"success\", \"verify_core\", \"Verificação local do core concluída.\", extra, null);\n",
