          "Pretty Print?": "true",
          "Operation": "ensure_file",
          "Default Json": "{\n  \"schema_version\": 1,\n  \"namespace\": \"CDXMS\",\n  \"file_type\": \"capability_config\",\n  \"artifact_id\": \"bootstrap\",\n  \"settings\": {\n    \"base_path\": \"/storage/emulated/0/Documents/CDXMS_Solutions\",\n    \"auto_repair_on_initialize\": false,\n    \"load_context_by_default\": true,\n    \"preserve_user_config\": true,\n    \"runtime_paths\": [\n      \"runtime\",\n      \"runtime/capabilities\",\n      \"runtime/solutions\",\n      \"logs\",\n      \"cache\",\n      \"cache/remote\",\n      \"packages/downloaded\",\n      \"packages/installed\",\n      \"backups\"\n    ],\n    \"required_core_files\": [\n      \".cdxms_root.json\",\n      \"core/manifest.json\",\n      \"core/registry.json\",\n      \"core/settings.json\",\n      \"core/enums.json\",\n      \"core/errors.json\",\n      \"core/result_contract.json\",\n      \"core/compatibility.json\"\n    ]\n  },\n  \"updated_at\": \"\"\n}",
