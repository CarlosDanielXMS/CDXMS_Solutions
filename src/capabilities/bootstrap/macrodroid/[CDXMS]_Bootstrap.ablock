        "scriptText": "\nconst ARTIFACT_ID = \"bootstrap\";\nconst VERSION = \"1.0.0\";\nfunction parseMaybe(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s) return {};\n  try { return JSON.parse(s); } catch(e) { return s; }\n}\nfunction boolText(raw) { return String(raw || \"\").toLowerCase() === \"true\"; }\nfunction result(success, status, operation, message, data, error) {\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success: success === true,\n    status: String(status || (success ? \"success\" : \"error\")),\n    artifact_type: \"capability\",\n    artifact_id: ARTIFACT_ID,\n    operation: String(operation || \"\"),\n    message: String(message || \"\"),\n    data: data && typeof data === \"object\" && !Array.isArray(data) ? data : {},\n    error: error || null,\n    meta: { timestamp: new Date().toISOString(), source: \"[CDXMS] Bootstrap\", version: VERSION, session_id: String(`{lv=Session Id}` || \"\"), correlation_id: String(`{lv=Correlation Id}` || \"\") }\n  });\n}\nconst extra = { bootstrap_status:\"context_loaded\", requested_artifact_type:String(`{lv=Requested Artifact Type}`||\"\"), requested_artifact_id:String(`{lv=Requested Artifact Id}`||\"\"), context:{ settings:parseMaybe(`{lv=Tmp_SettingsResult[data][value]}`), registry:parseMaybe(`{lv=Tmp_RegistryResult[data][value]}`), bootstrap_config:parseMaybe(`{lv=Tmp_BootstrapConfigResult[data][value]}`), artifact_config:parseMaybe(`{lv=Tmp_ArtifactConfigResult[data][value]}`) } };\nresult(true, \"success\", \"load_context\", \"Contexto local carregado pelo Bootstrap.\", extra, null);\n",
