    "localVarsAlphabetical": true,
    "m_GUID": -8974663416693308000,
    "m_actionList": [
      {
        "actionGroupName": "01 — Initialize Runtime",
        "childrenCollapsed": false,
        "dontLogIfConditionIsFalse": false,
        "actionLabel": "01 — Initialize Runtime",
        "disableLogging": false,
        "m_SIGUID": -5909601187089823000,
        "m_classType": "ActionGroupAction",
        "m_comment": "Valida a operação do Bootstrap e publica erro padronizado antes de qualquer efeito colateral.",
        "m_constraintList": [],
        "m_isDisabled": false,
        "m_isOrCondition": false
      },
      {
        "blockNextAction": true,
        "javascriptEngine": "JetPack JavascriptEngine",
        "scriptText": "\nconst ARTIFACT_ID = \"bootstrap\";\nconst VERSION = \"1.0.0\";\nconst SUPPORTED = [\"initialize_ecosystem\",\"verify_core\",\"repair_core\",\"ensure_runtime\",\"load_context\",\"get_status\"];\nfunction result(success, status, operation, message, data, error) {\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success: success === true,\n    status: String(status || (success ? \"success\" : \"error\")),\n    artifact_type: \"capability\",\n    artifact_id: ARTIFACT_ID,\n    operation: String(operation || \"\"),\n    message: String(message || \"\"),\n    data: data && typeof data === \"object\" && !Array.isArray(data) ? data : {},\n    error: error || null,\n    meta: {\n      timestamp: new Date().toISOString(),\n      source: \"[CDXMS] Bootstrap\",\n      version: VERSION,\n      session_id: String(`{lv=Session Id}` || \"\"),\n      correlation_id: String(`{lv=Correlation Id}` || \"\")\n    }\n  });\n}\nfunction err(code, message, details, recoverable) {\n  return { code: String(code || \"UNKNOWN_ERROR\"), message: String(message || \"Erro desconhecido.\"), details: details || {}, recoverable: recoverable === true };\n}\nconst op = String(`{lv=Operation}` || \"\").trim();\nif (!op) {\n  result(false, \"error\", op, \"A operação do Bootstrap não foi informada.\", {}, err(\"MISSING_REQUIRED_INPUT\", \"A entrada obrigatória Operation não foi informada.\", { input: \"Operation\" }, false));\n} else if (SUPPORTED.indexOf(op) < 0) {\n  result(false, \"error\", op, \"A operação informada não é suportada pelo Bootstrap.\", { supported_operations: SUPPORTED }, err(\"UNSUPPORTED_OPERATION\", \"A operação informada não é suportada.\", { operation: op }, false));\n} else {\n  result(true, \"success\", op, \"Operação validada para execução pelo Bootstrap.\", {\n    bootstrap_status: \"validated\",\n    requested_artifact_type: String(`{lv=Requested Artifact Type}` || \"\"),\n    requested_artifact_id: String(`{lv=Requested Artifact Id}` || \"\"),\n    load_context: String(`{lv=Load Context?}`).toLowerCase() === \"true\",\n    force_repair: String(`{lv=Force Repair?}`).toLowerCase() === \"true\"\n  }, null);\n}\n",
        "stringVariableName": "Tmp_ResultJson",
        "disableLogging": false,
        "m_SIGUID": -3959916641090148400,
        "m_classType": "JavaScriptAction",
        "m_comment": "Valida Operation e prepara Resultado inicial.",
