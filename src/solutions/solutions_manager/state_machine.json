{
  "schema_version": 1,
  "namespace": "CDXMS",
  "file_type": "solution_state_machine",
  "artifact_id": "solutions_manager",
  "version": "1.0.0",
  "initial_state": "starting",
  "terminal_states": ["closed", "failed"],
  "states": [
    "starting",
    "checking_environment",
    "bootstrapping",
    "repairing",
    "loading_context",
    "validating_ecosystem",
    "loading_catalog",
    "building_view_model",
    "building_ui",
    "rendering_ui",
    "waiting_ui_event",
    "processing_operation",
    "refreshing_ui",
    "degraded_read_only",
    "closed",
    "failed"
  ],
  "transitions": [
    {"from": "starting", "event": "session_ready", "to": "checking_environment"},
    {"from": "checking_environment", "event": "ecosystem_absent", "to": "bootstrapping"},
    {"from": "checking_environment", "event": "ecosystem_partial", "to": "repairing"},
    {"from": "checking_environment", "event": "ecosystem_ready", "to": "loading_context"},
    {"from": "bootstrapping", "event": "bootstrap_succeeded", "to": "loading_context"},
    {"from": "repairing", "event": "repair_succeeded", "to": "loading_context"},
    {"from": "loading_context", "event": "context_loaded", "to": "validating_ecosystem"},
    {"from": "validating_ecosystem", "event": "validation_succeeded", "to": "loading_catalog"},
    {"from": "loading_catalog", "event": "catalog_ready", "to": "building_view_model"},
    {"from": "building_view_model", "event": "view_model_ready", "to": "building_ui"},
    {"from": "building_ui", "event": "ui_contract_ready", "to": "rendering_ui"},
    {"from": "rendering_ui", "event": "ui_visible", "to": "waiting_ui_event"},
    {"from": "waiting_ui_event", "event": "business_action", "to": "processing_operation"},
    {"from": "processing_operation", "event": "operation_succeeded", "to": "refreshing_ui"},
    {"from": "refreshing_ui", "event": "view_model_ready", "to": "building_ui"},
    {"from": "waiting_ui_event", "event": "close", "to": "closed"}
  ]
}
