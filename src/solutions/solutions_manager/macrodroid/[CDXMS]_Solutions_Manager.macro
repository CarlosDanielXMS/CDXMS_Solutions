ta interface.\\\"},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Navigation Rail\\\",\\\"subtitle\\\":\\\"Indicado para layouts amplos ou fluxos com poucas áreas principais.\\\",\\\"children\\\":[{\\\"type\\\":\\\"navigation_rail\\\",\\\"key\\\":\\\"rail_demo\\\",\\\"selected\\\":\\\"navigation\\\",\\\"item_width\\\":72,\\\"items\\\":[{\\\"id\\\":\\\"home\\\",\\\"label\\\":\\\"Início\\\",\\\"target\\\":\\\"overview\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"navigation\\\",\\\"label\\\":\\\"Navegação\\\",\\\"target\\\":\\\"catalog_navigation\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"lab\\\",\\\"label\\\":\\\"Lab\\\",\\\"target\\\":\\\"playground\\\",\\\"action\\\":\\\"replace\\\"}]}]},{\\\"type\\\":\\\"section\\\",\\\"title\\\":\\\"Comportamento do shell\\\",\\\"children\\\":[{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Top App Bar\\\",\\\"value\\\":\\\"Contexto e ações globais\\\"},{\\\"type\\\":\\\"divider\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Tab Bar\\\",\\\"value\\\":\\\"Categorias relacionadas\\\"},{\\\"type\\\":\\\"divider\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Bottom Navigation\\\",\\\"value\\\":\\\"Áreas principais\\\"},{\\\"type\\\":\\\"divider\\\"},{\\\"type\\\":\\\"key_value\\\",\\\"label\\\":\\\"Drawer\\\",\\\"value\\\":\\\"Mapa completo da documentação\\\"}]},{\\\"type\\\":\\\"button\\\",\\\"text\\\":\\\"Abrir Navigation Drawer\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"open_drawer\\\"}]},\\\"playground\\\":{\\\"title\\\":\\\"Laboratório\\\",\\\"subtitle\\\":\\\"Edite, formate, copie e renderize contratos JUIF.\\\",\\\"show_header\\\":false,\\\"components\\\":[{\\\"type\\\":\\\"container\\\",\\\"variant\\\":\\\"surface2\\\",\\\"radius\\\":24,\\\"children\\\":[{\\\"type\\\":\\\"text\\\",\\\"variant\\\":\\\"label\\\",\\\"text\\\":\\\"AMBIENTE DE TESTE\\\"},{\\\"type\\\":\\\"text\\\",\\\"variant\\\":\\\"title\\\",\\\"text\\\":\\\"Do schema ao preview\\\"},{\\\"type\\\":\\\"text\\\",\\\"variant\\\":\\\"subtitle\\\",\\\"text\\\":\\\"Use o exemplo mínimo como referência e experimente alterações no sandbox.\\\"}]},{\\\"type\\\":\\\"code_block\\\",\\\"id\\\":\\\"schema_example\\\",\\\"title\\\":\\\"UI Schema Json mínimo\\\",\\\"language\\\":\\\"json\\\",\\\"bind\\\":\\\"docs.schema_example\\\",\\\"auto_indent\\\":true,\\\"key\\\":\\\"schema_example\\\",\\\"code\\\":\\\"{\\\\\\\"schema_version\\\\\\\": 1, \\\\\\\"initial_page\\\\\\\": \\\\\\\"home\\\\\\\", \\\\\\\"pages\\\\\\\": [{\\\\\\\"id\\\\\\\": \\\\\\\"home\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Minha interface\\\\\\\", \\\\\\\"components\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"text\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"title\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Olá, JUIF\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Continuar\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"primary\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"continue\\\\\\\"}]}]}\\\"},{\\\"type\\\":\\\"sandbox\\\",\\\"id\\\":\\\"tutorial_sandbox\\\",\\\"bind\\\":\\\"docs.sandbox\\\",\\\"key\\\":\\\"tutorial_sandbox\\\",\\\"initial_json\\\":\\\"{\\\\\\\"initial_page\\\\\\\": \\\\\\\"preview\\\\\\\", \\\\\\\"state\\\\\\\": {\\\\\\\"enabled\\\\\\\": true}, \\\\\\\"pages\\\\\\\": {\\\\\\\"preview\\\\\\\": {\\\\\\\"title\\\\\\\": \\\\\\\"Preview JUIF\\\\\\\", \\\\\\\"subtitle\\\\\\\": \\\\\\\"Contrato renderizado pelo sandbox.\\\\\\\", \\\\\\\"components\\\\\\\": [{\\\\\\\"type\\\\\\\": \\\\\\\"alert\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"success\\\\\\\", \\\\\\\"title\\\\\\\": \\\\\\\"Tudo certo\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"O contrato é válido e está pronto para interação.\\\\\\\"}, {\\\\\\\"type\\\\\\\": \\\\\\\"switch\\\\\\\", \\\\\\\"key\\\\\\\": \\\\\\\"enabled\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Recurso habilitado\\\\\\\", \\\\\\\"checked\\\\\\\": true}, {\\\\\\\"type\\\\\\\": \\\\\\\"button\\\\\\\", \\\\\\\"text\\\\\\\": \\\\\\\"Emitir evento\\\\\\\", \\\\\\\"variant\\\\\\\": \\\\\\\"primary\\\\\\\", \\\\\\\"action\\\\\\\": \\\\\\\"preview_action\\\\\\\"}]}}}\\\"},{\\\"type\\\":\\\"button_group\\\",\\\"buttons\\\":[{\\\"text\\\":\\\"Voltar ao início\\\",\\\"variant\\\":\\\"ghost\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"overview\\\",\\\"type\\\":\\\"button\\\"},{\\\"text\\\":\\\"Abrir catálogo\\\",\\\"variant\\\":\\\"secondary\\\",\\\"action\\\":\\\"replace\\\",\\\"target\\\":\\\"catalog_layout\\\",\\\"type\\\":\\\"button\\\"}]}]}},\\\"shell\\\":{\\\"top_app_bar\\\":{\\\"use_page_title\\\":true,\\\"navigation_action\\\":\\\"open_drawer\\\",\\\"navigation_text\\\":\\\"≡\\\",\\\"actions\\\":[{\\\"text\\\":\\\"×\\\",\\\"action\\\":\\\"close\\\"}],\\\"type\\\":\\\"top_app_bar\\\"},\\\"bottom_navigation\\\":{\\\"key\\\":\\\"primary_navigation\\\",\\\"selected\\\":\\\"overview\\\",\\\"items\\\":[{\\\"id\\\":\\\"overview\\\",\\\"label\\\":\\\"Início\\\",\\\"target\\\":\\\"overview\\\",\\\"active_pages\\\":[\\\"overview\\\"],\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"catalog\\\",\\\"label\\\":\\\"Catálogo\\\",\\\"target\\\":\\\"catalog_layout\\\",\\\"active_pages\\\":[\\\"catalog_layout\\\",\\\"catalog_forms\\\",\\\"catalog_data\\\",\\\"catalog_feedback\\\",\\\"catalog_navigation\\\"],\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"playground\\\",\\\"label\\\":\\\"Laboratório\\\",\\\"target\\\":\\\"playground\\\",\\\"active_pages\\\":[\\\"playground\\\"],\\\"action\\\":\\\"replace\\\"}],\\\"type\\\":\\\"bottom_navigation\\\"},\\\"navigation_drawer\\\":{\\\"key\\\":\\\"drawer_navigation\\\",\\\"title\\\":\\\"JUIF\\\",\\\"subtitle\\\":\\\"Java UI Framework\\\",\\\"footer\\\":\\\"CDXMS Solutions · capability v1.0.0\\\",\\\"width\\\":304,\\\"items\\\":[{\\\"id\\\":\\\"overview\\\",\\\"label\\\":\\\"Visão geral\\\",\\\"subtitle\\\":\\\"Arquitetura e fluxo da capability\\\",\\\"target\\\":\\\"overview\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"layout\\\",\\\"label\\\":\\\"Layout\\\",\\\"subtitle\\\":\\\"Composição, tipografia e superfícies\\\",\\\"target\\\":\\\"catalog_layout\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"forms\\\",\\\"label\\\":\\\"Formulários\\\",\\\"subtitle\\\":\\\"Bindings, entradas e filtros\\\",\\\"target\\\":\\\"catalog_forms\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"data\\\",\\\"label\\\":\\\"Dados\\\",\\\"subtitle\\\":\\\"Métricas, listas e conteúdo\\\",\\\"target\\\":\\\"catalog_data\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"feedback\\\",\\\"label\\\":\\\"Feedback\\\",\\\"subtitle\\\":\\\"Estados e comunicação visual\\\",\\\"target\\\":\\\"catalog_feedback\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"navigation\\\",\\\"label\\\":\\\"Navegação\\\",\\\"subtitle\\\":\\\"Shell, abas, rail e drawer\\\",\\\"target\\\":\\\"catalog_navigation\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"playground\\\",\\\"label\\\":\\\"Laboratório\\\",\\\"subtitle\\\":\\\"Edite e renderize contratos\\\",\\\"target\\\":\\\"playground\\\",\\\"action\\\":\\\"replace\\\"}],\\\"type\\\":\\\"navigation_drawer\\\",\\\"selected\\\":\\\"overview\\\"},\\\"tab_bar\\\":{\\\"key\\\":\\\"catalog_section\\\",\\\"selected\\\":\\\"layout\\\",\\\"visible_pages\\\":[\\\"catalog_layout\\\",\\\"catalog_forms\\\",\\\"catalog_data\\\",\\\"catalog_feedback\\\",\\\"catalog_navigation\\\"],\\\"items\\\":[{\\\"id\\\":\\\"layout\\\",\\\"label\\\":\\\"Layout\\\",\\\"target\\\":\\\"catalog_layout\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"forms\\\",\\\"label\\\":\\\"Formulários\\\",\\\"target\\\":\\\"catalog_forms\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"data\\\",\\\"label\\\":\\\"Dados\\\",\\\"target\\\":\\\"catalog_data\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"feedback\\\",\\\"label\\\":\\\"Feedback\\\",\\\"target\\\":\\\"catalog_feedback\\\",\\\"action\\\":\\\"replace\\\"},{\\\"id\\\":\\\"navigation\\\",\\\"label\\\":\\\"Navegação\\\",\\\"target\\\":\\\"catalog_navigation\\\",\\\"action\\\":\\\"replace\\\"}],\\\"type\\\":\\\"tab_bar\\\"}}}",
