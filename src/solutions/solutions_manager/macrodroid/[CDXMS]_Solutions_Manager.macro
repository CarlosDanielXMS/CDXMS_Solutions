            "m_name": "JUIF UI Json",
            "m_stringValue": "{\"schema_version\":1,\"component_catalog_version\":\"1.0.0\",\"initial_page\":\"overview\",\"state\":{\"primary_navigation\":\"overview\",\"catalog_section\":\"layout\",\"drawer_navigation\":\"overview\",\"metrics_components\":\"36\",\"metrics_coverage\":\"100\",\"docs_flow\":\"UI Schema Json → JUIF UI Builder → JUIF UI Json → Java UI Framework → Resultado\",\"tutorial_search\":\"\",\"interactive_only\":false,\"category_filters\":[\"navigation\",\"forms\"],\"profile_name\":\"Usuário JUIF\",\"profile_email\":\"usuario@exemplo.com\",\"profile_description\":\"Interfaces declarativas, modulares e orientadas a estado para automações profissionais.\",\"profile_level\":\"intermediate\",\"profile_theme\":\"dark_gold\",\"profile_notifications\":true,\"profile_terms\":true,\"metrics_categories\":\"6\",\"catalog_topics\":[{\"title\":\"Composição declarativa\",\"subtitle\":\"Estruture páginas com primitives previsíveis.\",\"value\":\"layout\"},{\"title\":\"Estado e bindings\",\"subtitle\":\"Conecte Config Json, state e eventos sem acoplamento.\",\"value\":\"forms\"},{\"title\":\"Navegação de aplicação\",\"subtitle\":\"Use shell persistente, drawer, tabs e bottom navigation.\",\"value\":\"navigation\"}],\"schema_example\":\"{\\\"schema_version\\\": 1, \\\"initial_page\\\": \\\"home\\\", \\\"pages\\\": [{\\\"id\\\": \\\"home\\\", \\\"title\\\": \\\"Minha interface\\\", \\\"components\\\": [{\\\"type\\\": \\\"text\\\", \\\"variant\\\": \\\"title\\\", \\\"text\\\": \\\"Olá, JUIF\\\"}, {\\\"type\\\": \\\"button\\\", \\\"text\\\": \\\"Continuar\\\", \\\"variant\\\": \\\"primary\\\", \\\"action\\\": \\\"continue\\\"}]}]}\",\"tutorial_sandbox\":\"{\\\"initial_page\\\": \\\"preview\\\", \\\"state\\\": {\\\"enabled\\\": true}, \\\"pages\\\": {\\\"preview\\\": {\\\"title\\\": \\\"Preview JUIF\\\", \\\"subtitle\\\": \\\"Contrato renderizado pelo sandbox.\\\", \\\"components\\\": [{\\\"type\\\": \\\"alert\\\", \\\"variant\\\": \\\"success\\\", \\\"title\\\": \\\"Tudo certo\\\", \\\"text\\\": \\\"O contrato é válido e está pronto para interação.\\\"}, {\\\"type\\\": \\\"switch\\\", \\\"key\\\": \\\"enabled\\\", \\\"text\\\": \\\"Recurso habilitado\\\", \\\"checked\\\": true}, {\\\"type\\\": \\\"button\\\", \\\"text\\\": \\\"Emitir evento\\\", \\\"variant\\\": \\\"primary\\\", \\\"action\\\": \\\"preview_action\\\"}]}}}\"},\"pages\":{\"overview\":{\"title\":\"JUIF\",\"subtitle\":\"Interfaces declarativas sofisticadas para o ecossistema CDXMS.\",\"show_header\":false,\"components\":[{\"type\":\"container\",\"variant\":\"surface2\",\"radius\":26,\"padding_left\":20,\"padding_top\":20,\"padding_right\":20,\"padding_bottom\":20,\"children\":[{\"type\":\"text\",\"variant\":\"label\",\"text\":\"CAPABILITY DE INTERFACE\"},{\"type\":\"spacer\",\"height\":6},{\"type\":\"text\",\"variant\":\"title\",\"text\":\"Uma camada visual consistente para todas as solutions\"},{\"type\":\"text\",\"variant\":\"subtitle\",\"text\":\"Defina páginas, estado, bindings e eventos em JSON. O JUIF transforma o contrato em uma experiência móvel elegante e previsível.\"},{\"type\":\"spacer\",\"height\":12},{\"type\":\"row\",\"children\":[{\"type\":\"stat_card\",\"label\":\"Componentes\",\"bind\":\"metrics.components\",\"value_type\":\"number\",\"variant\":\"primary\",\"key\":\"metrics_components\",\"value\":\"36\"},{\"type\":\"stat_card\",\"label\":\"Cobertura\",\"bind\":\"metrics.coverage\",\"value_type\":\"number\",\"variant\":\"success\",\"key\":\"metrics_coverage\",\"value\":\"100\"}]},{\"type\":\"progress_bar\",\"label\":\"Catálogo documentado\",\"bind\":\"metrics.coverage\",\"value_type\":\"number\",\"variant\":\"success\",\"key\":\"metrics_coverage\",\"progress\":\"100\"}]},{\"type\":\"section\",\"title\":\"Arquitetura em quatro etapas\",\"subtitle\":\"Cada capability mantém uma responsabilidade clara.\",\"children\":[{\"type\":\"key_value\",\"label\":\"01 · Dados\",\"value\":\"Config Json\"},{\"type\":\"divider\"},{\"type\":\"key_value\",\"label\":\"02 · Estrutura\",\"value\":\"UI Schema Json\"},{\"type\":\"divider\"},{\"type\":\"key_value\",\"label\":\"03 · Normalização\",\"value\":\"JUIF UI Builder\"},{\"type\":\"divider\"},{\"type\":\"key_value\",\"label\":\"04 · Runtime\",\"value\":\"Java UI Framework\"}]},{\"type\":\"alert\",\"variant\":\"info\",\"title\":\"Contrato antes de aparência\",\"text\":\"O schema descreve intenção, estado e comportamento. O renderer aplica o padrão visual oficial do ecossistema.\"},{\"type\":\"card\",\"children\":[{\"type\":\"text\",\"variant\":\"label\",\"text\":\"PRÓXIMO PASSO\"},{\"type\":\"text\",\"variant\":\"body\",\"text\":\"Explore o catálogo por categoria ou abra o laboratório para editar um contrato real.\"},{\"type\":\"button_group\",\"buttons\":[{\"text\":\"Explorar catálogo\",\"variant\":\"primary\",\"action\":\"replace\",\"target\":\"catalog_layout\",\"type\":\"button\"},{\"text\":\"Abrir laboratório\",\"variant\":\"secondary\",\"action\":\"replace\",\"target\":\"playground\",\"type\":\"button\"}]}]},{\"type\":\"copyable_text\",\"label\":\"Fluxo completo\",\"bind\":\"docs.flow\",\"copy_text\":\"Copiar fluxo\",\"key\":\"docs_flow\",\"text\":\"UI Schema Json → JUIF UI Builder → JUIF UI Json → Java UI Framework → Resultado\"}]},\"catalog_layout\":{\"title\":\"Layout\",\"subtitle\":\"Hierarquia, superfícies, ritmo e tipografia.\",\"show_header\":false,\"components\":[{\"type\":\"section\",\"title\":\"Tipografia semântica\",\"subtitle\":\"Use variantes em vez de tamanhos e cores soltos.\",\"children\":[{\"type\":\"text\",\"variant\":\"label\",\"text\":\"RÓTULO DE CONTEXTO\"},{\"type\":\"text\",\"variant\":\"title\",\"text\":\"Título principal\"},{\"type\":\"text\",\"variant\":\"subtitle\",\"text\":\"Subtítulo para contexto adicional.\"},{\"type\":\"text\",\"variant\":\"body\",\"text\":\"Texto de corpo para instruções, descrições e conteúdo corrente.\"},{\"type\":\"text\",\"variant\":\"muted\",\"text\":\"Informação secundária com menor ênfase.\"}]},{\"type\":\"container\",\"variant\":\"surface3\",\"radius\":24,\"children\":[{\"type\":\"column\",\"children\":[{\"type\":\"text\",\"variant\":\"label\",\"text\":\"COMPOSIÇÃO\"},{\"type\":\"text\",\"variant\":\"body\",\"text\":\"Container → Column → Row → Card\"},{\"type\":\"spacer\",\"height\":10},{\"type\":\"row\",\"children\":[{\"type\":\"card\",\"children\":[{\"type\":\"badge\",\"variant\":\"success\",\"text\":\"Estável\"},{\"type\":\"text\",\"variant\":\"body\",\"text\":\"Primeiro bloco\"}]},{\"type\":\"card\",\"children\":[{\"type\":\"badge\",\"variant\":\"info\",\"text\":\"Modular\"},{\"type\":\"text\",\"variant\":\"body\",\"text\":\"Segundo bloco\"}]}]}]}]},{\"type\":\"section\",\"title\":\"Ritmo visual\",\"children\":[{\"type\":\"text\",\"variant\":\"body\",\"text\":\"Spacer cria respiro. Divider separa grupos sem introduzir uma nova superfície.\"},{\"type\":\"spacer\",\"height\":12},{\"type\":\"divider\"},{\"type\":\"spacer\",\"height\":8},{\"type\":\"text\",\"variant\":\"muted\",\"text\":\"Conteúdo após a separação.\"}]}]},\"catalog_forms\":{\"title\":\"Formulários\",\"subtitle\":\"Entradas consistentes, filtros e estado vinculado.\",\"show_header\":false,\"components\":[{\"type\":\"section\",\"title\":\"Busca e filtros\",\"subtitle\":\"Os controles atualizam state e emitem eventos estruturados.\",\"children\":[{\"type\":\"search_bar\",\"id\":\"tutorial_search\",\"label\":\"Pesquisar componentes\",\"bind\":\"tutorial.search\",\"clearable\":true,\"key\":\"tutorial_search\",\"value\":\"\",\"hint\":\"Pesquisar componentes\"},{\"type\":\"chip\",\"id\":\"interactive_only\",\"text\":\"Somente interativos\",\"bind\":\"tutorial.interactive_only\",\"value_type\":\"boolean\",\"key\":\"interactive_only\",\"selected\":false},{\"type\":\"chip_group\",\"id\":\"category_filters\",\"bind\":\"tutorial.filters\",\"value_type\":\"array\",\"selection_mode\":\"multiple\",\"items\":[{\"id\":\"navigation\",\"label\":\"Navegação\",\"action\":\"navigation_selected\"},{\"id\":\"forms\",\"label\":\"F