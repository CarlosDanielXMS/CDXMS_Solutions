        "scriptText": "function md(f){var s=String(f);return s.replace(/^[\\s\\S]*?\\/\\*/,\"\").replace(/\\*\\/[\\s\\S]*$/,\"\");}function r(ok,status,msg,data,error){return JSON.stringify({schema_version:1,namespace:\"CDXMS\",success:ok,status:status,artifact_type:\"solution\",artifact_id:\"solutions_manager\",operation:\"receive_ui_event\",message:msg,data:data||{},error:error||null,meta:{protocol_version:1,source:\"[CDXMS] Solutions Manager\",version:\"1.0.0\"}});}var out=\"\";try{var e=JSON.parse(md(function(){/*\n{lv=Tmp_SmEventJson}\n*/}));var last=md(function(){/*\n{lv=Tmp_SmLastConsumedEventId}\n*/});var allowed={refresh_catalog:1,validate_ecosystem:1,download_test_solution:1,closed:1};var f=[];if(e.schema_version!==1)f.push(\"schema_version\");if(e.namespace!==\"CDXMS\")f.push(\"namespace\");if(e.event_type!==\"juif_ui_event\")f.push(\"event_type\");if(e.protocol_version!==1)f.push(\"protocol_version\");if(e.session_id!==\"solutions-manager-session-v1\")f.push(\"session_id\");if(!e.event_id)f.push(\"event_id\");if(e.event_id&&String(e.event_id)===String(last||\"\"))f.push(\"duplicate_event_id\");if(!e.source||e.source.artifact_id!==\"solutions_manager\")f.push(\"source\");if(!allowed[String(e.action||\"\")])f.push(\"action\");if(e.consumed!==false)f.push(\"consumed\");out=f.length?r(false,\"blocked\",\"Evento JUIF rejeitado.\",{event_id:e.event_id||\"\",action:e.action||\"\",failures:f},{code:f.indexOf(\"duplicate_event_id\")>=0?\"DUPLICATE_EVENT\":\"EVENT_VALIDATION_FAILED\",message:\"Contrato divergente.\",details:{failures:f},recoverable:true}):r(true,\"success\",\"Evento JUIF recebido.\",{event_id:e.event_id,action:e.action,current_page:e.current_page||\"\",payload:e.payload||{},state:e.state||{},consumed:true},null);}catch(x){out=r(false,\"error\",\"Evento JUIF inválido.\",{}, {code:\"INVALID_EVENT_JSON\",message:String(x&&x.message?x.message:x),details:{},recoverable:true});}out;",
