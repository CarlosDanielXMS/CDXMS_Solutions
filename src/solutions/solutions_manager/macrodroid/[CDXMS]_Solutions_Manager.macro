            "javascriptEngine": "JetPack JavascriptEngine",
            "scriptText": "\nfunction result(success,status,operation,message,data,error){return JSON.stringify({schema_version:1,namespace:\"CDXMS\",success:success===true,status:String(status),artifact_type:\"capability\",artifact_id:\"bootstrap\",operation:String(operation),message:String(message),data:data||{},error:error||null,meta:{timestamp:new Date().toISOString(),source:\"[CDXMS] Bootstrap\",version:\"1.0.0\",session_id:String(`{lv=Session Id}`||\"\"),correlation_id:String(`{lv=Correlation Id}`||\"\")}});}\nresult(false,\"error\",\"initialize_ecosystem\",\"O Bootstrap não conseguiu garantir o core mínimo local.\",{},{code:\"BOOTSTRAP_CORE_UNAVAILABLE\",message:\"O Bootstrap não conseguiu garantir o core mínimo local.\",details:{},recoverable:false});\n",
