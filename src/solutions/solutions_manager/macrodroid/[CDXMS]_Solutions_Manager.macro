              "Resultado": "Tmp_SchemaEscapeResult"
            },
            "actionLabel": "Escapar UI Schema Json",
            "disableLogging": false,
            "m_SIGUID": -7051298459320190012,
            "m_classType": "ActionBlockAction",
            "m_comment": "Prepara UI Schema Json para entrada segura no JavaScript.",
