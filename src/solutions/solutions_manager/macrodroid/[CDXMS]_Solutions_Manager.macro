            "inputDictionaryMap": {},
            "inputVarsMap": {
              "Merge Strategy": "deep_merge",
              "Pretty Print?": "true",
              "Operation": "ensure_file",
              "Default Json": "{\n  \"schema_version\": 1,\n  \"namespace\": \"CDXMS\",\n  \"file_type\": \"capability_config\",\n  \"artifact_id\": \"bootstrap\",\n  \"settings\": {\n    \"base_path\": \"/storage/emulated/0/Documents/CDXMS_Solutions\",\n    \"auto_repair_on_initialize\": false,\n    \"load_context_by_default\": true,\n    \"preserve_user_config\": true,\n    \"runtime_paths\": [\n      \"runtime\",\n      \"runtime/capabilities\",\n      \"runtime/solutions\",\n      \"logs\",\n      \"cache\",\n      \"cache/remote\",\n      \"packages/downloaded\",\n      \"packages/installed\",\n      \"backups\"\n    ],\n    \"required_core_files\": [\n      \".cdxms_root.json\",\n      \"core/manifest.json\",\n      \"core/registry.json\",\n      \"core/settings.json\",\n      \"core/enums.json\",\n      \"core/errors.json\",\n      \"core/result_contract.json\",\n      \"core/compatibility.json\"\n    ]\n  },\n  \"updated_at\": \"\"\n}",
              "Create If Missing?": "true",
              "Value Json": "",
              "File Path": "capabilities/bootstrap/config.json",
              "Json Path": "",
              "Folder Path": ""
            },
            "outputDictionaryMap": {
              "Resultado": {
                "keys": []
              }
            },
            "outputVarsMap": {
              "Resultado": "Tmp_JcmResult"
            },
            "disableLogging": false,
            "m_SIGUID": -4853610494899697000,
            "m_classType": "ActionBlockAction",
            "m_comment": "Garante config local do Bootstrap.",
            "m_constraintList": [],
            "m_isDisabled": false,
            "m_isOrCondition": false
          },
          {
            "blockNextAction": true,
            "javascriptEngine": "JetPack JavascriptEngine",
            "scriptText": "\nconst ARTIFACT_ID = \"bootstrap\";\nconst VERSION = \"1.0.0\";\nfunction parseMaybe(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s) return {};\n  try { return JSON.parse(s); } catch(e) { return s; }\n}\nfunction boolText(raw) { return String(raw || \"\").toLowerCase() === \"true\"; }\nfunction result(success, status, operation, message, data, error) {\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success: success === true,\n    status: String(status || (success ? \"success\" : \"error\")),\n    artifact_type: \"capability\",\n    artifact_id: ARTIFACT_ID,\n    operation: String(operation || \"\"),\n    message: String(message || \"\"),\n    data: data && typeof data === \"object\" && !Array.isArray(data) ? data : {},\n    error: error || null,\n    meta: { timestamp: new Date().toISOString(), source: \"[CDXMS] Bootstrap\", version: VERSION, session_id: String(`{lv=Session Id}` || \"\"), correlation_id: String(`{lv=Correlation Id}` || \"\") }\n  });\n}\nconst extra = { bootstrap_status:\"runtime_ready\", created_paths:[\"runtime\",\"runtime/capabilities\",\"runtime/solutions\",\"logs\",\"cache\",\"cache/remote\",\"packages\",\"packages/downloaded\",\"packages/installed\",\"backups\",\"catalogs\",\"capabilities/bootstrap\",\"capabilities/bootstrap/macrodroid\"] };\nresult(true, \"success\", \"ensure_runtime\", \"Estrutura local de runtime preparada.\", extra, null);\n",
            "stringVariableName": "Tmp_ResultJson",
            "disableLogging": false,
            "m_SIGUID": -2979904946199191000,
            "m_classType": "JavaScriptAction",
            "m_comment": "Monta Resultado de ensure_runtime.",
            "m_constraintList": [],
