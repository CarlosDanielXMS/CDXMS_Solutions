          {
            "blockNextAction": true,
            "consoleVariableName": "",
            "javascriptEngine": "JetPack JavascriptEngine",
            "scriptText": "// CDXMS JUIF UI Builder v1.0.0\nfunction nowIso() {\n  try {\n    return new Date().toISOString();\n  } catch (e) {\n    return \"\";\n  }\n}\n\nfunction buildResult(success, status, message, data, error) {\n  var safeData = data && typeof data === \"object\" && !Array.isArray(data) ? data : {};\n  var safeError = error && typeof error === \"object\" && !Array.isArray(error) ? error : null;\n\n  return JSON.stringify({\n    schema_version: 1,\n    namespace: \"CDXMS\",\n    success: success === true,\n    status: status || (success ? \"success\" : \"error\"),\n    artifact_type: \"capability\",\n    artifact_id: \"juif_ui_builder\",\n    operation: \"build_ui\",\n    message: message || (success ? \"JUIF UI gerada com sucesso.\" : \"Falha ao gerar JUIF UI.\"),\n    data: safeData,\n    error: safeError,\n    meta: {\n      source: \"[CDXMS] JUIF UI Builder\",\n      version: \"1.0.0\",\n      component_catalog_version: \"1.0.0\",\n      timestamp: nowIso()\n    }\n  });\n}\n\nfunction buildError(code, message, details, recoverable) {\n  return {\n    code: code || \"PROCESSING_FAILED\",\n    message: message || \"Falha ao processar a interface JUIF.\",\n    details: details || {},\n    recoverable: recoverable === true\n  };\n}\n\nfunction parseJson(value, name) {\n  var text = String(value == null ? \"\" : value).trim();\n  if (text.length === 0 || text.indexOf(\"{lv=\") === 0) {\n    throw buildError(\"MISSING_REQUIRED_INPUT\", \"Entrada obrigatória ausente: \" + name + \".\", { input: name }, false);\n  }\n\n  // O MacroDroid pode entregar JSON por Magic Text com aspas escapadas,\n  // objeto embrulhado ou quebras/entidades. Normalizamos antes do parse real.\n  text = text.replace(/^﻿/, \"\");\n  text = text.replace(/\\r/g, \"\\n\");\n\n  if ((text.charAt(0) === '\"' && text.charAt(text.length - 1) === '\"') ||\n      (text.charAt(0) === \"'\" && text.charAt(text.length - 1) === \"'\")) {\n    try { text = JSON.parse(text); } catch(ignoreQuoted) { text = text.slice(1, -1); }\n  }\n\n  if (text.indexOf('\\\\\"') >= 0 && text.indexOf('\"') < 0) {\n    text = text.replace(/\\\\\"/g, '\"');\n  }\n\n  // Caso observado em alguns testes: JSON chega como {{...}}.\n  if (text.charAt(0) === \"{\" && text.charAt(1) === \"{\" && text.charAt(text.length - 1) === \"}\" && text.charAt(text.length - 2) === \"}\") {\n    text = text.slice(1, -1).trim();\n  }\n\n  try {\n    return JSON.parse(text);\n  } catch (e) {\n    var preview = text.length > 160 ? text.slice(0, 160) + \"...\" : text;\n    throw buildError(\"INVALID_JSON\", \"JSON inválido em \" + name + \".\", { input: name, reason: String(e && e.message ? e.message : e), preview: preview }, false);\n  }\n}\n\nfunction normalizeBool(value, fallback) {\n  if (value === true || value === false) return value;\n  var normalized = String(value == null ? \"\" : value).trim().toLowerCase();\n  if ([\"true\", \"1\", \"sim\", \"s\", \"verdadeiro\"].indexOf(normalized) >= 0) return true;\n  if ([\"false\", \"0\", \"não\", \"nao\", \"n\", \"falso\"].indexOf(normalized) >= 0) return false;\n  return fallback === true;\n}\n\nfunction pathGet(obj, path, fallback) {\n  try {\n    if (!path || path === \"$\" || String(path).trim().length === 0) return obj;\n    var clean = String(path).trim();\n    clean = clean.replace(/^\\$\\./, \"\");\n    clean = clean.replace(/^\\$/, \"\");\n    if (clean.length === 0) return obj;\n    var parts = clean.split(\".\");\n    var current = obj;\n    for (var i = 0; i < parts.length; i++) {\n      if (current === null || current === undefined) return fallback;\n      var part = parts[i];\n      var arrayMatch = part.match(/^([^\\[]+)\\[(\\d+)\\]$/);\n      if (arrayMatch) {\n        var key = arrayMatch[1];\n        var index = parseInt(arrayMatch[2], 10);\n        current = current[key];\n        if (!Array.isArray(current)) return fallback;\n        current = current[index];\n      } else {\n        current = current[part];\n      }\n    }\n    return current === undefined ? fallback : current;\n  } catch (e) {\n    return fallback;\n  }\n}\n\nfunction toStateValue(value, type) {\n  if (value === null || value === undefined) {\n    if (type === \"boolean\") return false;\n    if (type === \"array\") return [];\n    if (type === \"object\") return {};\n    return \"\";\n  }\n  if (type === \"number\") return String(value);\n  if (type === \"boolean\") return value === true || value === \"true\" || value === \"TRUE\" || value === \"1\";\n  if (type === \"array\") return Array.isArray(value) ? value : [];\n  if (type === \"object\") return typeof value === \"object\" ? value : {};\n  return value;\n}\n\nfunction slug(value) {\n  return String(value == null ? \"\" : value)\n    .trim()\n    .replace(/[^A-Za-z0-9_]+/g, \"_\")\n    .replace(/^_+|_+$/g, \"\") || \"component\";\n}\n\nvar SUPPORTED_COMPONENT_TYPES = {\n  text: true,\n  button: true,\n  button_group: true,\n  input: true,\n  textarea: true,\n  checkbox: true,\n  switch: true,\n  select: true,\n  radio_group: true,\n  card: true,\n  section: true,\n  container: true,\n  column: true,\n  row: true,\n  spacer: true,\n  divider: true,\n  alert: true,\n  badge: true,\n  key_value: true,\n  list_item: true,\n  copyable_text: true,\n  stat_card: true,\n  progress_bar: true,\n  code_block: true,\n  dynamic_list: true,\n  sandbox: true,\n  top_app_bar: true,\n  bottom_navigation: true,\n  navigation_rail: true,\n  navigation_drawer: true,\n  tab_bar: true,\n  search_bar: true,\n  chip: true,\n  chip_group: true,\n  empty_state: true,\n  loading_indicator: true\n};\n\nfunction clonePrimitive(value) {\n  if (Array.isArray(value)) {\n    var arr = [];\n    for (var i = 0; i < value.length; i++) arr.push(clonePrimitive(value[i]));\n    return arr;\n  }\n  if (value && typeof value === \"object\") {\n    var obj = {};\n    for (var k in value) if (Object.prototype.hasOwnProperty.call(value, k)) obj[k] = clonePrimitive(value[k]);\n    return obj;\n  }\n  return value;\n}\n\nfunction inferValueType(node) {\n  var explicit = node.value_type || node.valueType;\n  if (explicit) return String(explicit);\n  var type = node.type || node.component || \"input\";\n  if (type === \"switch\" || type === \"checkbox\" || type === \"chip\") return \"boolean\";\n  if (type === \"chip_group\" && String(node.selection_mode || \"single\") === \"multiple\") return \"array\";\n  if (type === \"dynamic_list\") return \"array\";\n  if (type === \"progress_bar\") return \"number\";\n  if (node.type_hint) return String(node.type_hint);\n  return \"string\";\n}\n\nfunction valuePropertyFor(type, node) {\n  if (node.value_property) return String(node.value_property);\n  if (type === \"switch\" || type === \"checkbox\") return \"checked\";\n  if (type === \"chip\") return \"selected\";\n  if (type === \"chip_group\" || type === \"bottom_navigation\" || type === \"navigation_rail\" || type === \"navigation_drawer\" || type === \"tab_bar\") return \"selected\";\n  if (type === \"search_bar\") return \"value\";\n  if (type === \"select\" || type === \"radio_group\" || type === \"input\" || type === \"textarea\") return \"value\";\n  if (type === \"progress_bar\") return \"progress\";\n  if (type === \"code_block\") return \"code\";\n  if (type === \"sandbox\") return \"initial_json\";\n  if (type === \"stat_card\" || type === \"key_value\") return \"value\";\n  if (type === \"badge\" || type === \"text\" || type === \"copyable_text\") return \"text\";\n  return \"value\";\n}\n\nfunction ensureSupported(type, context) {\n  if (!SUPPORTED_COMPONENT_TYPES[type]) {\n    throw buildError(\"INVALID_ENUM_VALUE\", \"Componente JUIF não suportado pelo Java UI Framework atual.\", { component_type: type, context: context || \"\" }, false);\n  }\n}\n\nfunction normalizeOptions(options) {\n  if (!Array.isArray(options)) return [];\n  return clonePrimitive(options);\n}\n\nfunction applyLabelAliases(node) {\n  var type = node.type;\n  if (node.label && !node.text && (type === \"switch\" || type === \"checkbox\" || type === \"button\" || type === \"badge\")) {\n    node.text = node.label;\n  }\n  if (node.label && !node.hint && (type === \"input\" || type === \"textarea\")) {\n    node.hint = node.label;\n  }\n}\n\nfunction hydrateBinding(node, config, state, mapping, context) {\n  if (!node.bind) return node;\n\n  var type = node.type;\n  var key = node.key || node.id || slug(node.bind);\n  var valueType = inferValueType(node);\n  var rawValue = pathGet(config, node.bind, node.default);\n  var stateValue = toStateValue(rawValue, valueType);\n  var prop = valuePropertyFor(type, node);\n\n  node.key = key;\n  state[key] = stateValue;\n\n  if (type === \"dynamic_list\") {\n    node.source = node.source || key;\n  } else {\n    node[prop] = stateValue;\n  }\n\n  mapping.push({\n    key: key,\n    path: node.bind,\n    type: valueType,\n    component: type,\n    property: prop,\n    operation: node.operation || \"SET\"\n  });\n\n  return node;\n}\n\nfunction normalizeButton(node, context) {\n  var out = clonePrimitive(node || {});\n  out.type = \"button\";\n  if (out.label && !out.text) out.text = out.label;\n  if (!out.text) out.text = out.action || \"Ação\";\n  return out;\n}\n\n\nfunction normalizeNavigationItems(items, context) {\n  if (!Array.isArray(items)) return [];\n  var out = [];\n  for (var i = 0; i < items.length; i++) {\n    var raw = items[i];\n    if (typeof raw === \"string\") raw = { id: slug(raw), label: raw };\n    if (!raw || typeof raw !== \"object\" || Array.isArray(raw)) {\n      throw buildError(\"INVALID_INPUT_TYPE\", \"Item de navegação inválido.\", { context: context, item_index: i }, false);\n    }\n    var item = clonePrimitive(raw);\n    item.id = item.id || item.value || slug(item.label || item.text || item.target || (\"item_\" + i));\n    item.label = item.label || item.text || item.id;\n    if (!item.action && item.target) item.action = \"replace\";\n    if (!item.action) item.action = \"navigation_selected\";\n    out.push(item);\n  }\n  return out;\n}\n\nfunction normalizeShell(schema, config, state, mapping) {\n  var source = schema.shell || schema.navigation;\n  if (!source || typeof source !== \"object\" || Array.isArray(source)) return null;\n\n  var aliases = {\n    top_app_bar: source.top_app_bar || source.top_bar,\n    bottom_navigation: source.bottom_navigation || source.bottom_bar,\n    navigation_rail: source.navigation_rail || source.rail,\n    navigation_drawer: source.navigation_drawer || source.drawer,\n    tab_bar: source.tab_bar || source.tabs\n  };\n\n  var shell = {};\n  for (var type in aliases) {\n    if (!Object.prototype.hasOwnProperty.call(aliases, type) || !aliases[type]) continue;\n    var node = clonePrimitive(aliases[type]);\n    node.type = type;\n    shell[type] = normalizeComponent(node, config, state, mapping, \"shell.\" + type);\n  }\n\n  return Object.keys(shell).length > 0 ? shell : null;\n}\n\nfunction normalizeComponent(node, config, state, mapping, context) {\n  if (!node || typeof node !== \"object\" || Array.isArray(node)) {\n    throw buildError(\"INVALID_INPUT_TYPE\", \"Componente JUIF inválido.\", { context: context || \"\" }, false);\n  }\n\n  var out = clonePrimitive(node);\n  out.type = out.type || out.component || \"text\";\n  ensureSupported(out.type, context);\n  applyLabelAliases(out);\n  hydrateBinding(out, config, state, mapping, context);\n\n  if (out.type === \"input\") {\n    if (!out.input_type) out.input_type = out.value_type === \"number\" || out.type_hint === \"number\" ? \"number\" : \"text\";\n    if (!out.hint && out.label) out.hint = out.label;\n  }\n\n  if (out.type === \"textarea\") {\n    if (!out.min_lines) out.min_lines = 3;\n    if (!out.hint && out.label) out.hint = out.label;\n  }\n\n  if (out.type === \"select\" || out.type === \"radio_group\") {\n    out.options = normalizeOptions(out.options || []);\n  }\n\n  if (out.type === \"button\") {\n    out = normalizeButton(out, context);\n  }\n\n  if (out.type === \"button_group\") {\n    var buttons = out.buttons || [];\n    if (!Array.isArray(buttons)) buttons = [];\n    out.buttons = [];\n    for (var b = 0; b < buttons.length; b++) out.buttons.push(normalizeButton(buttons[b], context + \".buttons[\" + b + \"]\"));\n  }\n\n\n  if (out.type === \"top_app_bar\") {\n    var appBarActions = out.actions || [];\n    if (!Array.isArray(appBarActions)) appBarActions = [];\n    out.actions = [];\n    for (var aba = 0; aba < appBarActions.length; aba++) {\n      var appBarAction = clonePrimitive(appBarActions[aba]);\n      appBarAction.text = appBarAction.text || appBarAction.label || appBarAction.icon || \"Ação\";\n      appBarAction.action = appBarAction.action || \"app_bar_action\";\n      out.actions.push(appBarAction);\n    }\n  }\n\n  if (out.type === \"bottom_navigation\" || out.type === \"navigation_rail\" || out.type === \"navigation_drawer\" || out.type === \"tab_bar\") {\n    out.items = normalizeNavigationItems(out.items || out.options || [], context + \".items\");\n    if (!out.key) out.key = out.id || slug(context + \"_selection\");\n    if (!out.selected && state[out.key] !== undefined) out.selected = state[out.key];\n  }\n\n  if (out.type === \"search_bar\") {\n    if (!out.key) out.key = out.id || slug(context + \"_search\");\n    if (!out.hint) out.hint = out.label || \"Pesquisar\";\n  }\n\n  if (out.type === \"chip\") {\n    if (out.label && !out.text) out.text = out.label;\n    if (!out.key) out.key = out.id || slug(out.text || context + \"_chip\");\n  }\n\n  if (out.type === \"chip_group\") {\n    out.items = normalizeNavigationItems(out.items || out.options || [], context + \".items\");\n    if (!out.key) out.key = out.id || slug(context + \"_chips\");\n    if (!out.selection_mode) out.selection_mode = \"single\";\n  }\n\n  if (out.type === \"empty_state\" && out.action) {\n    var emptyAction = clonePrimitive(out.action);\n    emptyAction.type = \"button\";\n    out.action = normalizeButton(emptyAction, context + \".action\");\n  }\n\n  if (out.type === \"loading_indicator\" && !out.text) out.text = out.label || \"Carregando...\";\n\n  if (out.type === \"dynamic_list\") {\n    if (!out.source && out.key) out.source = out.key;\n    if (!out.empty_text) out.empty_text = \"Nenhum item encontrado.\";\n    if (out.item_template) out.item_template = normalizeComponent(out.item_template, config, state, mapping, context + \".item_template\");\n  }\n\n  var directChildren = out.children || out.components;\n  if (Array.isArray(directChildren)) {\n    out.children = [];\n    for (var c = 0; c < directChildren.length; c++) {\n      out.children.push(normalizeComponent(directChildren[c], config, state, mapping, context + \".children[\" + c + \"]\"));\n    }\n    if (out.components) delete out.components;\n  }\n\n  return out;\n}\n\nfunction validateField(field, pageId, sectionIndex, fieldIndex) {\n  if (!field || typeof field !== \"object\") {\n    throw buildError(\"INVALID_INPUT_TYPE\", \"Campo de UI inválido.\", { page_id: pageId, section_index: sectionIndex, field_index: fieldIndex }, false);\n  }\n  if (!field.id || String(field.id).trim().length === 0) {\n    throw buildError(\"MISSING_REQUIRED_INPUT\", \"Campo de UI sem id.\", { page_id: pageId, section_index: sectionIndex, field_index: fieldIndex }, false);\n  }\n  if (!field.bind || String(field.bind).trim().length === 0) {\n    throw buildError(\"MISSING_REQUIRED_INPUT\", \"Campo de UI sem bind.\", { field_id: field.id }, false);\n  }\n}\n\nfunction fieldToComponent(field, config, state, mapping, context) {\n  var component = field.component || \"input\";\n  var node = clonePrimitive(field);\n  node.type = component;\n  node.key = field.id;\n  node.id = field.id;\n\n  if (field.label) {\n    if (component === \"switch\" || component === \"checkbox\" || component === \"button\" || component === \"badge\") node.text = field.label;\n    if (component === \"input\" || component === \"textarea\") node.hint = field.label;\n    if (component === \"select\") node.label = field.label;\n  }\n\n  return normalizeComponent(node, config, state, mapping, context);\n}\n\nfunction buildDynamicList(listSchema, config, state, mapping, context) {\n  if (!listSchema.id || !listSchema.bind) {\n    throw buildError(\"MISSING_REQUIRED_INPUT\", \"Lista dinâmica sem id ou bind.\", { context: context }, false);\n  }\n\n  var node = clonePrimitive(listSchema);\n  node.type = \"dynamic_list\";\n  node.key = listSchema.id;\n  node.bind = listSchema.bind;\n  node.value_type = \"array\";\n  node.empty_text = listSchema.empty_text || \"Nenhum item encontrado.\";\n  node.item_template = listSchema.item_template || {\n    type: \"list_item\",\n    title: \"{{title}}\",\n    subtitle: \"{{subtitle}}\",\n    value: \"{{value}}\",\n    action: \"item_selected\"\n  };\n\n  return normalizeComponent(node, config, state, mapping, context);\n}\n\nfunction buildSection(section, config, state, mapping, pageId, sectionIndex) {\n  var sectionComponent = {\n    type: \"section\",\n    title: section.title || \"\",\n    subtitle: section.subtitle || \"\",\n    children: []\n  };\n\n  var fields = section.fields || [];\n  if (!Array.isArray(fields)) {\n    throw buildError(\"INVALID_INPUT_TYPE\", \"A propriedade fields deve ser uma lista.\", { page_id: pageId, section_index: sectionIndex }, false);\n  }\n\n  for (var i = 0; i < fields.length; i++) {\n    validateField(fields[i], pageId, sectionIndex, i);\n    sectionComponent.children.push(fieldToComponent(fields[i], config, state, mapping, \"pages.\" + pageId + \".sections[\" + sectionIndex + \"].fields[\" + i + \"]\"));\n  }\n\n  var lists = section.lists || [];\n  if (!Array.isArray(lists)) {\n    throw buildError(\"INVALID_INPUT_TYPE\", \"A propriedade lists deve ser uma lista.\", { page_id: pageId, section_index: sectionIndex }, false);\n  }\n\n  for (var j = 0; j < lists.length; j++) {\n    sectionComponent.children.push(buildDynamicList(lists[j], config, state, mapping, \"pages.\" + pageId + \".sections[\" + sectionIndex + \"].lists[\" + j + \"]\"));\n  }\n\n  var children = section.children || section.components || [];\n  if (Array.isArray(children)) {\n    for (var c = 0; c < children.length; c++) {\n      sectionComponent.children.push(normalizeComponent(children[c], config, state, mapping, \"pages.\" + pageId + \".sections[\" + sectionIndex + \"].children[\" + c + \"]\"));\n    }\n  }\n\n  var actions = section.actions || [];\n  if (Array.isArray(actions)) {\n    for (var a = 0; a < actions.length; a++) {\n      var actionNode = clonePrimitive(actions[a]);\n      if (!actionNode.type) actionNode.type = \"button\";\n      sectionComponent.children.push(normalizeComponent(actionNode, config, state, mapping, \"pages.\" + pageId + \".sections[\" + sectionIndex + \"].actions[\" + a + \"]\"));\n    }\n  }\n\n  return sectionComponent;\n}\n\nfunction buildUi(config, schema) {\n  if (!schema || typeof schema !== \"object\") {\n    throw buildError(\"INVALID_INPUT_TYPE\", \"UI Schema Json deve ser um objeto JSON.\", { input: \"UI Schema Json\" }, false);\n  }\n\n  var state = clonePrimitive(schema.state || {});\n  var mapping = [];\n  var pages = {};\n  var schemaPages = schema.pages || [];\n\n  if (!Array.isArray(schemaPages) || schemaPages.length === 0) {\n    throw buildError(\"MISSING_REQUIRED_INPUT\", \"UI Schema Json.pages deve conter pelo menos uma página.\", { input: \"UI Schema Json.pages\" }, false);\n  }\n\n  for (var p = 0; p < schemaPages.length; p++) {\n    var pageSchema = schemaPages[p];\n    if (!pageSchema.id || String(pageSchema.id).trim().length === 0) {\n      throw buildError(\"MISSING_REQUIRED_INPUT\", \"Página de UI sem id.\", { page_index: p }, false);\n    }\n\n    var page = {\n      title: pageSchema.title || schema.title || \"JUIF\",\n      subtitle: pageSchema.subtitle || \"\",\n      show_header: pageSchema.show_header !== false,\n      components: []\n    };\n\n    var sections = pageSchema.sections || [];\n    if (Array.isArray(sections)) {\n      for (var s = 0; s < sections.length; s++) {\n        page.components.push(buildSection(sections[s], config, state, mapping, pageSchema.id, s));\n      }\n    }\n\n    var directComponents = pageSchema.components || [];\n    if (Array.isArray(directComponents)) {\n      for (var dc = 0; dc < directComponents.length; dc++) {\n        page.components.push(normalizeComponent(directComponents[dc], config, state, mapping, \"pages.\" + pageSchema.id + \".components[\" + dc + \"]\"));\n      }\n    }\n\n    var pageActions = pageSchema.actions || [];\n    if (Array.isArray(pageActions)) {\n      for (var pa = 0; pa < pageActions.length; pa++) {\n        var pageAction = clonePrimitive(pageActions[pa]);\n        if (!pageAction.type) pageAction.type = \"button\";\n        page.components.push(normalizeComponent(pageAction, config, state, mapping, \"pages.\" + pageSchema.id + \".actions[\" + pa + \"]\"));\n      }\n    }\n\n    pages[pageSchema.id] = page;\n  }\n\n  var initialPage = schema.initial_page || schemaPages[0].id;\n  if (!pages[initialPage]) initialPage = schemaPages[0].id;\n\n  var ui = {\n    schema_version: 1,\n    component_catalog_version: \"1.0.0\",\n    initial_page: initialPage,\n    state: state,\n    pages: pages\n  };\n\n  var shell = normalizeShell(schema, config, state, mapping);\n  if (shell) ui.shell = shell;\n\n  var eventBridge = schema.event_bridge;\n  if (eventBridge && typeof eventBridge === \"object\" && !Array.isArray(eventBridge)) {\n    ui.event_bridge = clonePrimitive(eventBridge);\n  }\n\n  var juifUiJson = JSON.stringify(ui);\n  var mappingJson = JSON.stringify(mapping);\n\n  return {\n    juif_ui_json: juifUiJson,\n    juif_ui_json_escaped: juifUiJson,\n    mapping_json: mappingJson,\n    component_catalog_version: \"1.0.0\",\n    supported_components: Object.keys(SUPPORTED_COMPONENT_TYPES).sort(),\n    supported_component_count: Object.keys(SUPPORTED_COMPONENT_TYPES).length\n  };\n}\n\nvar __cdxms_result = \"\";\ntry {\n  var configJson = \"{lv=Tmp_ConfigEscapeResult[data][value]}\";\n  var schemaJson = \"{lv=Tmp_SchemaEscapeResult[data][value]}\";\n\n  var config = parseJson(configJson, \"Config Json\");\n  var schema = parseJson(schemaJson, \"UI Schema Json\");\n  var built = buildUi(config, schema);\n\n  __cdxms_result = buildResult(true, \"success\", \"JUIF UI gerada com sucesso.\", built, null);\n} catch (e) {\n  var err = e && e.code ? e : buildError(\"PROCESSING_FAILED\", String(e && e.message ? e.message : e), {}, false);\n  __cdxms_result = buildResult(false, \"error\", err.message || \"Falha ao gerar JUIF UI.\", {}, err);\n}\n__cdxms_result;\n",
